 492+ 6B0F              ; ==============================================================================
 493+ 6B0F              ; DrawBgSpriteByIdAtChar - Dibuja un BG sprite (pixels + attrs) por id en (B, C)
 494+ 6B0F              ; ==============================================================================
 495+ 6B0F              ; IN: A = sprite id (lookup en BgGfxPtrById), B = charX, C = charY
 496+ 6B0F              ;     charY se da SIN BG_Y_OFFSET (DrawBgGfxSprite lo aplica internamente).
 497+ 6B0F              ; OUT: -
 498+ 6B0F              ; Destruye: AF, BC, DE, HL, IX.
 499+ 6B0F              ; ID 0 -> retorno silencioso (no exportado / sin sprite).
 500+ 6B0F              ; Usado por: DrawScreen .sprSkipHidden (dibujar restos en lugar de estatua),
 501+ 6B0F              ;            ApplyChurchTrapDone (dibujar restos al terminar cutscene).
 502+ 6B0F              ; ==============================================================================
 503+ 6B0F              DrawBgSpriteByIdAtChar:
 504+ 6B0F B7               OR A
 505+ 6B10 C8               RET Z                                   ; id 0 = no sprite, salir
 506+ 6B11 C5               PUSH BC
 507+ 6B12 6F               LD L, A
 508+ 6B13 26 00            LD H, 0
 509+ 6B15 54               LD D, H
 510+ 6B16 5D               LD E, L                                 ; DE = id
 511+ 6B17 29               ADD HL, HL                              ; *2
 512+ 6B18 19               ADD HL, DE                              ; *3
 513+ 6B19 11 D0 DF         LD DE, BgGfxPtrById
 514+ 6B1C 19               ADD HL, DE
 515+ 6B1D 5E               LD E, (HL)
 516+ 6B1E 23               INC HL
 517+ 6B1F 56               LD D, (HL)                              ; DE = ptr
 518+ 6B20 23               INC HL
 519+ 6B21 7E               LD A, (HL)                              ; A = bank
 520+ 6B22 32 76 D2         LD (CurrentBgSpriteBank), A
 521+ 6B25 EB               EX DE, HL                               ; HL = ptr
 522+ 6B26 CD C2 6C         CALL LoadBgSpriteToBuffer               ; preserva BC
 523+ 6B29 DD 21 F5 86      LD IX, BgSpriteBuffer
 524+ 6B2D C1               POP BC
 525+ 6B2E C3 6A D1         JP DrawBgGfxSprite                      ; tail call
 526+ 6B31
 527+ 6B31              ; ==============================================================================
 528+ 6B31              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 529+ 6B31              ; ==============================================================================
 530+ 6B31              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 531+ 6B31              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 532+ 6B31              ;
 533+ 6B31              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 534+ 6B31              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 535+ 6B31              ;     E = pixel X (0-255).
 536+ 6B31              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 537+ 6B31              ; Solo XOR de pixels (no toca attrs).
 538+ 6B31              ; Destruye: AF, BC, DE, HL, IX.
 539+ 6B31              ; ==============================================================================
 540+ 6B31              DrawBgSprite16XorAtPixel:
 541+ 6B31 DD 21 F5 86      LD IX, BgSpriteBuffer
 542+ 6B35 DD 7E 00         LD A, (IX+0)                            ; height_px
 543+ 6B38 B7               OR A
 544+ 6B39 C8               RET Z
 545+ 6B3A 32 9D 6B         LD (.dbsHeight), A
 546+ 6B3D DD 23            INC IX
 547+ 6B3F DD 23            INC IX                                  ; -> pixel data
 548+ 6B41                  ; Shift = E & 7 ; aligned X = E & ~7
 549+ 6B41 7B               LD A, E
 550+ 6B42 E6 07            AND $07
 551+ 6B44 32 9E 6B         LD (.dbsShift), A
 552+ 6B47 7B               LD A, E
 553+ 6B48 E6 F8            AND $F8
 554+ 6B4A 5F               LD E, A
 555+ 6B4B CD 5A 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
 556+ 6B4E              .dbsRow:
 557+ 6B4E E5               PUSH HL                                 ; save row start
 558+ 6B4F                  ; --- Byte 0 del sprite ---
 559+ 6B4F DD 7E 00         LD A, (IX+0)
 560+ 6B52 2F               CPL                                     ; un-invert
 561+ 6B53 57               LD D, A                                 ; D = sprite byte
 562+ 6B54 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 563+ 6B56 3A 9E 6B         LD A, (.dbsShift)
 564+ 6B59 B7               OR A
 565+ 6B5A 28 07            JR Z, .dbsNoShift0
 566+ 6B5C 47               LD B, A
 567+ 6B5D              .dbsShift0Loop:
 568+ 6B5D CB 3A            SRL D
 569+ 6B5F CB 1B            RR E
 570+ 6B61 10 FA            DJNZ .dbsShift0Loop
 571+ 6B63              .dbsNoShift0:
 572+ 6B63 7A               LD A, D
 573+ 6B64 AE               XOR (HL)
 574+ 6B65 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 575+ 6B66 23               INC HL
 576+ 6B67 4B               LD C, E                                 ; C = carry para siguiente byte
 577+ 6B68                  ; --- Byte 1 del sprite ---
 578+ 6B68 DD 7E 01         LD A, (IX+1)
 579+ 6B6B 2F               CPL
 580+ 6B6C 57               LD D, A
 581+ 6B6D 1E 00            LD E, 0
 582+ 6B6F 3A 9E 6B         LD A, (.dbsShift)
 583+ 6B72 B7               OR A
 584+ 6B73 28 07            JR Z, .dbsNoShift1
 585+ 6B75 47               LD B, A
 586+ 6B76              .dbsShift1Loop:
 587+ 6B76 CB 3A            SRL D
 588+ 6B78 CB 1B            RR E
 589+ 6B7A 10 FA            DJNZ .dbsShift1Loop
 590+ 6B7C              .dbsNoShift1:
 591+ 6B7C 7A               LD A, D
 592+ 6B7D B1               OR C                                    ; combinar con carry de byte 0
 593+ 6B7E AE               XOR (HL)
 594+ 6B7F 77               LD (HL), A
 595+ 6B80 23               INC HL
 596+ 6B81 4B               LD C, E                                 ; carry para byte final
 597+ 6B82                  ; --- Byte final (solo si shift>0) ---
 598+ 6B82 3A 9E 6B         LD A, (.dbsShift)
 599+ 6B85 B7               OR A
 600+ 6B86 28 03            JR Z, .dbsNoFinal
 601+ 6B88 79               LD A, C
 602+ 6B89 AE               XOR (HL)
 603+ 6B8A 77               LD (HL), A
 604+ 6B8B              .dbsNoFinal:
 605+ 6B8B E1               POP HL                                  ; restore row start
 606+ 6B8C CD C6 9A         CALL NextPixelLine
 607+ 6B8F DD 23            INC IX                                  ; advance sprite ptr by 2 (width)
 608+ 6B91 DD 23            INC IX
 609+ 6B93 3A 9D 6B         LD A, (.dbsHeight)
 610+ 6B96 3D               DEC A
 611+ 6B97 32 9D 6B         LD (.dbsHeight), A
 612+ 6B9A 20 B2            JR NZ, .dbsRow
 613+ 6B9C C9               RET
 614+ 6B9D 00           .dbsHeight: DEFB 0
 615+ 6B9E 00           .dbsShift:  DEFB 0
