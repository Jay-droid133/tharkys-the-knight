 470+ D400              ; ==============================================================================
 471+ D400              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 472+ D400              ; Usa font custom (DayHudFont) en vez de ROM font
 473+ D400              ; ==============================================================================
 474+ D400              DrawDayCycleHUD:
 475+ D400                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 476+ D400 21 88 D6         LD HL, DayHudFont + 0 * 8          ; 'D'
 477+ D403 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 478+ D406 CD 75 D4         CALL .drawChar
 479+ D409 21 90 D6         LD HL, DayHudFont + 1 * 8          ; 'A'
 480+ D40C 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 481+ D40F CD 75 D4         CALL .drawChar
 482+ D412 21 98 D6         LD HL, DayHudFont + 2 * 8          ; 'Y'
 483+ D415 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 484+ D418 CD 75 D4         CALL .drawChar
 485+ D41B                  ; Col 7 = espacio (limpiar)
 486+ D41B 11 07 40         LD DE, $4007
 487+ D41E CD 7E D4         CALL .clearChar
 488+ D421
 489+ D421                  ; --- Digito decenas (col 8) ---
 490+ D421 3A D2 B8         LD A, (DayCycleCount)
 491+ D424 FE 0A            CP 10
 492+ D426 38 20            JR C, .singleDigit
 493+ D428                  ; Dos digitos: dividir A / 10
 494+ D428 06 00            LD B, 0
 495+ D42A              .divLoop:
 496+ D42A D6 0A            SUB 10
 497+ D42C 04               INC B
 498+ D42D FE 0A            CP 10
 499+ D42F 30 F9            JR NC, .divLoop
 500+ D431                  ; B = decenas, A = unidades
 501+ D431 F5               PUSH AF                             ; Guardar unidades
 502+ D432 78               LD A, B
 503+ D433 CD 68 D4         CALL .getDigitFont
 504+ D436 11 08 40         LD DE, $4008                        ; Col 8
 505+ D439 CD 75 D4         CALL .drawChar
 506+ D43C F1               POP AF                              ; Recuperar unidades
 507+ D43D CD 68 D4         CALL .getDigitFont
 508+ D440 11 09 40         LD DE, $4009                        ; Col 9
 509+ D443 CD 75 D4         CALL .drawChar
 510+ D446 18 14            JR .setAttrs
 511+ D448
 512+ D448              .singleDigit:
 513+ D448                  ; Una cifra: decena = 0, unidad = A
 514+ D448 F5               PUSH AF
 515+ D449 21 A0 D6         LD HL, DayHudFont + 3 * 8          ; '0'
 516+ D44C 11 08 40         LD DE, $4008                        ; Col 8
 517+ D44F CD 75 D4         CALL .drawChar
 518+ D452 F1               POP AF
 519+ D453 CD 68 D4         CALL .getDigitFont
 520+ D456 11 09 40         LD DE, $4009                        ; Col 9
 521+ D459 CD 75 D4         CALL .drawChar
 522+ D45C
 523+ D45C              .setAttrs:
 524+ D45C                  ; Atributos: bright white en cols 4-9
 525+ D45C 3E 47            LD A, $47
 526+ D45E 21 04 58         LD HL, ATTR_BASE + 4
 527+ D461 06 06            LD B, 6
 528+ D463              .attrLoop:
 529+ D463 77               LD (HL), A
 530+ D464 23               INC HL
 531+ D465 10 FC            DJNZ .attrLoop
 532+ D467 C9               RET
 533+ D468
 534+ D468              ; Devuelve HL = puntero a font data del digito en A (0-9)
 535+ D468              ; A se destruye
 536+ D468              .getDigitFont:
 537+ D468 C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 538+ D46A 6F               LD L, A
 539+ D46B 26 00            LD H, 0
 540+ D46D 29               ADD HL, HL
 541+ D46E 29               ADD HL, HL
 542+ D46F 29               ADD HL, HL                          ; HL = indice * 8
 543+ D470 01 88 D6         LD BC, DayHudFont
 544+ D473 09               ADD HL, BC
 545+ D474 C9               RET
 546+ D475
 547+ D475              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 548+ D475              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 549+ D475              .drawChar:
 550+ D475 06 08            LD B, 8
 551+ D477              .charLoop:
 552+ D477 7E               LD A, (HL)
 553+ D478 12               LD (DE), A
 554+ D479 23               INC HL
 555+ D47A 14               INC D
 556+ D47B 10 FA            DJNZ .charLoop
 557+ D47D C9               RET
 558+ D47E
 559+ D47E              ; Limpia 8 scan lines en VRAM (DE)
 560+ D47E              .clearChar:
 561+ D47E 06 08            LD B, 8
 562+ D480 AF               XOR A
 563+ D481              .clearLoop:
 564+ D481 12               LD (DE), A
 565+ D482 14               INC D
 566+ D483 10 FC            DJNZ .clearLoop
 567+ D485 C9               RET
