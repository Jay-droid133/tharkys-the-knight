 190+ 9AA4              .shiftedLine:
 191+ 9AA4 E5               PUSH HL                     ; Guardar inicio de linea
 192+ 9AA5 3A C5 9A         LD A, (.widthSave)
 193+ 9AA8 DD 6F            LD IXL, A                   ; IXL = width counter (8T vs 13T mem write)
 194+ 9AAA
 195+ 9AAA              .shiftedByte:
 196+ 9AAA                  ; === Inner loop optimizado: contadores en IXH/IXL ===
 197+ 9AAA 1A               LD A, (DE)                  ; Leer byte de sprite
 198+ 9AAB 4F               LD C, A                     ; C = byte value (indice en tabla)
 199+ 9AAC 0A               LD A, (BC)                  ; A = byte >> shift (high part)
 200+ 9AAD AE               XOR (HL)                    ; XOR con VRAM
 201+ 9AAE 77               LD (HL), A                  ; Escribir
 202+ 9AAF 2C               INC L                       ; Siguiente columna VRAM
 203+ 9AB0 04               INC B                       ; Pagina overflow
 204+ 9AB1 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
 205+ 9AB2 AE               XOR (HL)                    ; XOR con VRAM
 206+ 9AB3 77               LD (HL), A                  ; Escribir
 207+ 9AB4 05               DEC B                       ; Restaurar pagina high
 208+ 9AB5 13               INC DE                      ; Siguiente byte de sprite
 209+ 9AB6                  ; Siguiente byte de ancho
 210+ 9AB6 DD 2D            DEC IXL                     ; 8T (era LD+DEC+LD mem = 30T)
 211+ 9AB8 20 F0            JR NZ, .shiftedByte         ; 12/7T
 212+ 9ABA
 213+ 9ABA E1               POP HL                      ; Restaurar inicio de linea
 214+ 9ABB DD 25            DEC IXH                     ; 8T (era LD+DEC+LD mem = 30T)
 215+ 9ABD C8               RET Z                       ; Terminamos todas las lineas
 216+ 9ABE CD C9 9A         CALL NextPixelLine          ; HL = siguiente linea
 217+ 9AC1 18 E1            JR .shiftedLine
