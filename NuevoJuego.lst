 877+ D227 DD 23            INC IX
 878+ D229 CB 7F            BIT 7, A
 879+ D22B 20 18            JR NZ, .rleNewRun
 880+ D22D                  ; --- Literal group: A = count (1-127) ---
 881+ D22D ED 44            NEG                         ; A = -count (negativo)
 882+ D22F 32 B3 D2         LD (.rlePending), A
 883+ D232                  ; fall through: emitir primer byte literal
 884+ D232
