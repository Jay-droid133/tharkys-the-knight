 398+ 8F53              ; ==============================================================================
 399+ 8F53              ; WipeMonsterSlot - Limpia COMPLETAMENTE las tablas per-slot de un monster
 400+ 8F53              ; ==============================================================================
 401+ 8F53              ; Llamado cuando un monster sale por su gap al amanecer (flee-despawn) para
 402+ 8F53              ; que no quede rastro en memoria. KB-despawn NO usa esta rutina porque ahi
 403+ 8F53              ; queremos preservar MonsterRoomId/EntryBorder/ReturnTimer para la migracion
 404+ 8F53              ; al room vecino.
 405+ 8F53              ;
 406+ 8F53              ; IX = entity record. IX se preserva (excepto via PUSH/POP). Tras esto, las
 407+ 8F53              ; rutinas de respawn (TryRespawnMonsters / SpawnMonsters) tratan el slot
 408+ 8F53              ; como vacio y lo re-inicializaran fresco en la siguiente medianoche.
 409+ 8F53              ;
 410+ 8F53              ; MonsterRoomId se setea a $FF (sentinela = "no-room") para que la
 411+ 8F53              ; comparacion con el screen actual nunca matchee → no auto-respawn.
 412+ 8F53              ; ==============================================================================
 413+ 8F53              WipeMonsterSlot:
 414+ 8F53 DD E5            PUSH IX
 415+ 8F55 E1               POP HL
 416+ 8F56 11 AE 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
 417+ 8F59 B7               OR A
 418+ 8F5A ED 52            SBC HL, DE
 419+ 8F5C CB 3D            SRL L
 420+ 8F5E CB 3D            SRL L
 421+ 8F60 CB 3D            SRL L
 422+ 8F62 CB 3D            SRL L                               ; HL = slot * 1
 423+ 8F64 5D               LD E, L
 424+ 8F65 16 00            LD D, 0                             ; DE = slot (0..2)
 425+ 8F67
 426+ 8F67 21 96 8D         LD HL, MonsterAiFlags
 427+ 8F6A 19               ADD HL, DE
 428+ 8F6B 36 00            LD (HL), 0
 429+ 8F6D 21 8A 8D         LD HL, MonsterRoomId
 430+ 8F70 19               ADD HL, DE
 431+ 8F71 36 FF            LD (HL), $FF                        ; sentinela: no-room
 432+ 8F73 21 90 8D         LD HL, MonsterEntryBorder
 433+ 8F76 19               ADD HL, DE
 434+ 8F77 36 00            LD (HL), 0
 435+ 8F79 21 93 8D         LD HL, MonsterExitCoord
 436+ 8F7C 19               ADD HL, DE
 437+ 8F7D 36 00            LD (HL), 0
 438+ 8F7F 21 16 B3         LD HL, MonsterReturnTimer
 439+ 8F82 19               ADD HL, DE
 440+ 8F83 36 00            LD (HL), 0
 441+ 8F85 21 97 5F         LD HL, MonsterShakeOrigX
 442+ 8F88 19               ADD HL, DE
 443+ 8F89 36 00            LD (HL), 0
 444+ 8F8B 21 9A 5F         LD HL, MonsterShakeOrigY
 445+ 8F8E 19               ADD HL, DE
 446+ 8F8F 36 00            LD (HL), 0
 447+ 8F91 C9               RET
