 206+ A1CE              ; ==============================================================================
 207+ A1CE              ; ComputePlayerDrawY - Calcula PlayerDrawY = POSY + (1 si hay celda ocupada justo encima)
 208+ A1CE              ; ==============================================================================
 209+ A1CE              ; Dibuja el player 1 px más abajo solo cuando tiene un char sólido justo encima
 210+ A1CE              ; (techo pegado). En espacios abiertos, el sprite se dibuja sin offset — evita
 211+ A1CE              ; que los pies parezcan hundirse en el suelo.
 212+ A1CE              ; ==============================================================================
 213+ A1CE              ComputePlayerDrawY:
 214+ A1CE                  ; --- Death anim: sprite 16x16 (vs player normal 16x21). Bajar +5 para que la
 215+ A1CE                  ;     base del cadaver coincida con la base del player vivo. SPRITEID en
 216+ A1CE                  ;     [SPRID_PLAYER_DEATH .. SPRID_PLAYER_DEATH+5] = los 6 frames de la anim.
 217+ A1CE 3A 9B 81         LD A, (EntityTable + ENT_SPRITEID)
 218+ A1D1 D6 6E            SUB SPRID_PLAYER_DEATH
 219+ A1D3 FE 06            CP 6
 220+ A1D5 30 09            JR NC, .cpdyNotDeath
 221+ A1D7 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 222+ A1DA C6 05            ADD A, 5
 223+ A1DC 32 DC 82         LD (PlayerDrawY), A         ; death anim → POSY+5 (sin ceiling check)
 224+ A1DF C9               RET
 225+ A1E0              .cpdyNotDeath:
 226+ A1E0 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 227+ A1E3 C6 08            ADD A, 8                    ; center X del player
 228+ A1E5 47               LD B, A
 229+ A1E6 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 230+ A1E9 4F               LD C, A
 231+ A1EA 32 DC 82         LD (PlayerDrawY), A         ; default: sin offset
 232+ A1ED B7               OR A
 233+ A1EE C8               RET Z
 234+ A1EF 0D               DEC C                       ; Y - 1 (pixel justo encima de la cabeza)
 235+ A1F0 CD F0 D7         CALL IsPointBlocked
 236+ A1F3 C8               RET Z                       ; libre → sin offset
 237+ A1F4 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 238+ A1F7 3C               INC A
 239+ A1F8 32 DC 82         LD (PlayerDrawY), A         ; techo pegado → offset +1
 240+ A1FB C9               RET
 241+ A1FC
 242+ A1FC              ; ==============================================================================
 243+ A1FC              ; ComputeEnemyDrawY - EnemyDrawY = POSY + (ceiling pegado ? 1 : 0) para
 244+ A1FC              ; TYPE_MONSTER, POSY sin offset para otros. IX = entity.
 245+ A1FC              ; Mismo concepto que ComputePlayerDrawY: separa 1 px del BG superior para
 246+ A1FC              ; no parecer que se hunde en el techo.
 247+ A1FC              ; Preserva: IX. Destruye: AF, BC.
 248+ A1FC              ; ==============================================================================
 249+ A1FC              ComputeEnemyDrawY:
 250+ A1FC DD 7E 04         LD A, (IX+ENT_POSY)
 251+ A1FF 32 DD 82         LD (EnemyDrawY), A          ; default = POSY
 252+ A202 DD 7E 01         LD A, (IX+ENT_TYPE)
 253+ A205 FE 02            CP TYPE_MONSTER
 254+ A207 C0               RET NZ                      ; no monster → sin offset
 255+ A208 DD 7E 03         LD A, (IX+ENT_POSX)
 256+ A20B C6 08            ADD A, 8                    ; center X
 257+ A20D 47               LD B, A
 258+ A20E DD 7E 04         LD A, (IX+ENT_POSY)
 259+ A211 4F               LD C, A
 260+ A212 B7               OR A
 261+ A213 C8               RET Z
 262+ A214 0D               DEC C                       ; Y - 1 (pixel encima de la cabeza)
 263+ A215 CD F0 D7         CALL IsPointBlocked
 264+ A218 C8               RET Z                       ; libre → sin offset
 265+ A219 DD 7E 04         LD A, (IX+ENT_POSY)
 266+ A21C 3C               INC A
 267+ A21D 32 DD 82         LD (EnemyDrawY), A          ; techo pegado → offset +1
 268+ A220 C9               RET
 269+ A221
 270+ A221              ; ==============================================================================
 271+ A221              ; ProcessPlayer - Procesa player completo: erase + logic + draw (cada frame)
 272+ A221              ; ==============================================================================
 273+ A221              ; Fiel a Sabre Wulf: no se separa render de logica. Todo junto tras HALT.
 274+ A221              ; ==============================================================================
 275+ A221              ProcessPlayer:
 276+ A221 DD 21 9B 81      LD IX, EntityTable
 277+ A225
 278+ A225                  ; --- Fresh check ---
 279+ A225 3A 12 83         LD A, (ScreenJustRedrawn)
 280+ A228 B7               OR A
 281+ A229 C2 F5 A2         JP NZ, .plFresh
 282+ A22C DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 283+ A230 C2 F5 A2         JP NZ, .plFresh
 284+ A233
 285+ A233                  ; --- Logica PRIMERO: actualizar estado, movimiento, animacion ---
 286+ A233                  ; Skip UpdatePlayer durante la fase de muerte (DeathBorderPhase != 0):
 287+ A233                  ; el sprite y los deltas estan controlados por OnPlayerHealthDepleted /
 288+ A233                  ; UpdateDeathAnim / UpdateDeathBorder. El draw normal sigue corriendo.
 289+ A233                  ; Skip tambien durante phase 1 del respawn (countdown 3-2-1): el blink
 290+ A233                  ; sincronizado con beats pone SPRITEID a IDLE/BLANK desde UpdateRespawnBlink
 291+ A233                  ; y UpdatePlayerAnimation lo sobrescribiria.
 292+ A233 3A E7 82         LD A, (DeathBorderPhase)
 293+ A236 B7               OR A
 294+ A237 20 0A            JR NZ, .plSkipUpdate
 295+ A239 3A EB 82         LD A, (PlayerRespawnPhase)
 296+ A23C FE 01            CP 1
 297+ A23E 28 03            JR Z, .plSkipUpdate
 298+ A240 CD 4B A8         CALL UpdatePlayer
 299+ A243              .plSkipUpdate:
 300+ A243 CD 64 A7         CALL CalcDrawX
 301+ A246 CD CE A1         CALL ComputePlayerDrawY
 302+ A249
 303+ A249                  ; --- Skip si nada cambio (compara DESPUES de logica) ---
 304+ A249 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 305+ A24C DD BE 0C         CP (IX+ENT_OLDX)
 306+ A24F 20 3C            JR NZ, .plDoErase
 307+ A251 3A DC 82         LD A, (PlayerDrawY)         ; Y renderizado actual (POSY o POSY+1 según ceiling)
 308+ A254 DD BE 0D         CP (IX+ENT_OLDY)
 309+ A257 20 34            JR NZ, .plDoErase
 310+ A259 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 311+ A25C DD BE 0E         CP (IX+ENT_OLDSPRID)
 312+ A25F 20 2C            JR NZ, .plDoErase
 313+ A261                  ; Nada cambio: pero si PlayerHitTimer activo, repintar attrs
 314+ A261 3A 8A C7         LD A, (PlayerHitTimer)
 315+ A264 B7               OR A
 316+ A265 20 01            JR NZ, .plRepaintAttr
 317+ A267 C9               RET                                 ; Nada cambio → skip todo
 318+ A268              .plRepaintAttr:
 319+ A268 3A DC 82         LD A, (PlayerDrawY)
 320+ A26B 57               LD D, A
 321+ A26C DD 7E 0F         LD A, (IX+ENT_DRAWX)
 322+ A26F 5F               LD E, A
 323+ A270 DD E5            PUSH IX
 324+ A272 CD A9 A7         CALL GetSpriteAddr
 325+ A275 DD 2A D8 A7      LD IX, (SpriteAddrTemp)
 326+ A279 CD EA 9D         CALL CalcEntityAttrSize
 327+ A27C DD E1            POP IX
 328+ A27E 3A DC 82         LD A, (PlayerDrawY)
 329+ A281 57               LD D, A
 330+ A282 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 331+ A285 5F               LD E, A
 332+ A286 DD 7E 05         LD A, (IX+ENT_ATTR)
 333+ A289 CD BD 9D         CALL SetEntityAttr
