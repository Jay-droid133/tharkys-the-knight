5378+ BCA9              ; --- CheckMonsterOverlap: AABB 16x21 vs otros TYPE_MONSTER en EntityTable ---
5379+ BCA9              ; IX = monster a testear (su POSX/POSY actual). Returns Z=no overlap, NZ=overlap.
5380+ BCA9              ; Itera SLOT_MONSTER0..+5, skipea el slot propio y los no-monster.
5381+ BCA9              CheckMonsterOverlap:
5382+ BCA9 C5               PUSH BC
5383+ BCAA FD E5            PUSH IY
5384+ BCAC FD 21 B3 81      LD IY, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5385+ BCB0 06 06            LD B, NUM_MONSTERS
5386+ BCB2              .cmoLoop:
5387+ BCB2                  ; Skip self (IY == IX)
5388+ BCB2 DD E5            PUSH IX
5389+ BCB4 E1               POP HL
5390+ BCB5 FD E5            PUSH IY
5391+ BCB7 D1               POP DE
5392+ BCB8 B7               OR A
5393+ BCB9 ED 52            SBC HL, DE
5394+ BCBB 28 3D            JR Z, .cmoNext                  ; same slot
5395+ BCBD
5396+ BCBD FD 7E 01         LD A, (IY+ENT_TYPE)
5397+ BCC0 FE 02            CP TYPE_MONSTER
5398+ BCC2 20 36            JR NZ, .cmoNext
5399+ BCC4
5400+ BCC4                  ; AABB overlap (rect 16x21 cada uno):
5401+ BCC4                  ;   overlap = (ix.x+16 > iy.x) AND (iy.x+16 > ix.x)
5402+ BCC4                  ;          AND (ix.y+21 > iy.y) AND (iy.y+21 > ix.y)
5403+ BCC4 DD 7E 03         LD A, (IX+ENT_POSX)
5404+ BCC7 C6 10            ADD A, 16
5405+ BCC9 4F               LD C, A
5406+ BCCA FD 7E 03         LD A, (IY+ENT_POSX)
5407+ BCCD B9               CP C                            ; iy.x cmp ix.x+16
5408+ BCCE 30 2A            JR NC, .cmoNext                 ; iy.x >= ix.x+16 -> no overlap X
5409+ BCD0 FD 7E 03         LD A, (IY+ENT_POSX)
5410+ BCD3 C6 10            ADD A, 16
5411+ BCD5 4F               LD C, A
5412+ BCD6 DD 7E 03         LD A, (IX+ENT_POSX)
5413+ BCD9 B9               CP C
5414+ BCDA 30 1E            JR NC, .cmoNext                 ; ix.x >= iy.x+16 -> no overlap X
5415+ BCDC DD 7E 04         LD A, (IX+ENT_POSY)
5416+ BCDF C6 15            ADD A, 21
5417+ BCE1 4F               LD C, A
5418+ BCE2 FD 7E 04         LD A, (IY+ENT_POSY)
5419+ BCE5 B9               CP C
5420+ BCE6 30 12            JR NC, .cmoNext
5421+ BCE8 FD 7E 04         LD A, (IY+ENT_POSY)
5422+ BCEB C6 15            ADD A, 21
5423+ BCED 4F               LD C, A
5424+ BCEE DD 7E 04         LD A, (IX+ENT_POSY)
5425+ BCF1 B9               CP C
5426+ BCF2 30 06            JR NC, .cmoNext
5427+ BCF4                  ; Overlap en ambos ejes
5428+ BCF4 FD E1            POP IY
5429+ BCF6 C1               POP BC
5430+ BCF7 F6 01            OR 1                            ; NZ
5431+ BCF9 C9               RET
5432+ BCFA              .cmoNext:
5433+ BCFA 11 10 00         LD DE, ENT_SIZE
5434+ BCFD FD 19            ADD IY, DE
5435+ BCFF 10 B1            DJNZ .cmoLoop
5436+ BD01 FD E1            POP IY
5437+ BD03 C1               POP BC
5438+ BD04 AF               XOR A                           ; Z = no overlap
5439+ BD05 C9               RET
