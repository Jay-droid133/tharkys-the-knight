 354+ 73F1              MagicCompassJingleTable:
 355+ 73F1 C0 00            DEFW $00C0
 356+ 73F3 04 01            DEFB 4, 1                            ; nota 1: ~570 Hz, 160 ms
 357+ 73F5 A0 00            DEFW $00A0
 358+ 73F7 04 01            DEFB 4, 1                            ; nota 2: ~684 Hz
 359+ 73F9 70 00            DEFW $0070
 360+ 73FB 06 00            DEFB 6, 0                            ; nota 3: ~970 Hz, 240 ms (last)
