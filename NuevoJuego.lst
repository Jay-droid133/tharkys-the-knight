5711+ C29F 00           .rmTimer: DEFB 0
5712+ C2A0 01 02 04     .rmTrapBits: DEFB $01, $02, $04         ; bit mask por slot 0/1/2 (church trap)
5713+ C2A3
5714+ C2A3              ; --- Timers de regreso: knockback -> MAI_LINGER_PUSHED -> reaparece (Regla 4) ---
5715+ C2A3              ; Al expirar, reposiciona segun el borde de salida (guardado en ENT_DIR por
5716+ C2A3              ; .moKbOffscreen) aplicando MAI_REENTRY_OFFSET hacia dentro. El eje
5717+ C2A3              ; perpendicular al borde se preserva (mantiene la Y/X que tenia al ser
5718+ C2A3              ; empujado).
5719+ C2A3              .rmUpdateReturnTimers:
5720+ C2A3 21 E0 B6         LD HL, MonsterReturnTimer
5721+ C2A6 DD 21 46 81      LD IX, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
5722+ C2AA 06 03            LD B, MONSTERS_TO_SPAWN
5723+ C2AC              .rmRtLoop:
