1513+ F77A              ; ==============================================================================
1514+ F77A              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1515+ F77A              ; ==============================================================================
1516+ F77A              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1517+ F77A              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1518+ F77A              ; suficiente para corromper visualmente).
1519+ F77A              ; IN: IX = entity ptr.
1520+ F77A              ; ==============================================================================
1521+ F77A              RedrawTrappedMonster:
1522+ F77A                  ; --- Erase viejo en (OLDX, OLDY) ---
1523+ F77A CD 2E A8         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1524+ F77D DD 7E 0D         LD A, (IX+ENT_OLDY)
1525+ F780 57               LD D, A
1526+ F781 DD 7E 0C         LD A, (IX+ENT_OLDX)
1527+ F784 5F               LD E, A
1528+ F785 DD E5            PUSH IX
1529+ F787 DD 2A B6 A7      LD IX, (OldSprAddr)
1530+ F78B CD 33 9D         CALL DrawSprite
1531+ F78E DD E1            POP IX
1532+ F790                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1533+ F790                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1534+ F790 DD 56 0D         LD D, (IX+ENT_OLDY)
1535+ F793 DD 5E 0C         LD E, (IX+ENT_OLDX)
1536+ F796 CD EB D5         CALL RestoreOldAttr
1537+ F799                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1538+ F799                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1539+ F799                  ; reponer attrs de pickups que el flujo de entidades pisa con
1540+ F799                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1541+ F799                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1542+ F799                  ; estar bajo el monster.
1543+ F799 DD E5            PUSH IX
1544+ F79B CD B2 DC         CALL RefreshPickupAttrs
1545+ F79E DD E1            POP IX
1546+ F7A0                  ; --- Compute new draw pos ---
1547+ F7A0 CD B8 A7         CALL CalcDrawX
1548+ F7A3 CD 50 A2         CALL ComputeEnemyDrawY
1549+ F7A6                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1550+ F7A6 CD FD A7         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1551+ F7A9 3A 83 82         LD A, (EnemyDrawY)
1552+ F7AC 57               LD D, A
1553+ F7AD DD 7E 0F         LD A, (IX+ENT_DRAWX)
1554+ F7B0 5F               LD E, A
1555+ F7B1 DD E5            PUSH IX
1556+ F7B3 DD 2A 2C A8      LD IX, (SpriteAddrTemp)
1557+ F7B7 CD 50 9E         CALL CalcEntityAttrSize
1558+ F7BA DD E1            POP IX
1559+ F7BC 3A 83 82         LD A, (EnemyDrawY)
1560+ F7BF 57               LD D, A
1561+ F7C0 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1562+ F7C3 5F               LD E, A
1563+ F7C4 DD 7E 05         LD A, (IX+ENT_ATTR)
1564+ F7C7 CD 23 9E         CALL SetEntityAttr
1565+ F7CA                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1566+ F7CA 3A 83 82         LD A, (EnemyDrawY)
1567+ F7CD 57               LD D, A
1568+ F7CE DD 7E 0F         LD A, (IX+ENT_DRAWX)
1569+ F7D1 5F               LD E, A
1570+ F7D2 DD E5            PUSH IX
1571+ F7D4 DD 2A 2C A8      LD IX, (SpriteAddrTemp)
1572+ F7D8 CD 33 9D         CALL DrawSprite
1573+ F7DB DD E1            POP IX
1574+ F7DD                  ; --- Save OLD = current ---
1575+ F7DD DD 7E 0F         LD A, (IX+ENT_DRAWX)
1576+ F7E0 DD 77 0C         LD (IX+ENT_OLDX), A
1577+ F7E3 3A 83 82         LD A, (EnemyDrawY)
1578+ F7E6 DD 77 0D         LD (IX+ENT_OLDY), A
1579+ F7E9 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1580+ F7EC DD 77 0E         LD (IX+ENT_OLDSPRID), A
1581+ F7EF C9               RET
