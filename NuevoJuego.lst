 108+ E980 FE 09            CP 9
 109+ E982 30 21            JR NC, .cmtDone
 110+ E984 87               ADD A, A
 111+ E985 6F               LD L, A
 112+ E986 26 00            LD H, 0
 113+ E988 11 22 E9         LD DE, MilestoneTable
 114+ E98B 19               ADD HL, DE
 115+ E98C 7E               LD A, (HL)
 116+ E98D FE 02            CP MILESTONE_TYPE_TRIGGER
 117+ E98F 20 14            JR NZ, .cmtDone
 118+ E991 23               INC HL
 119+ E992 7E               LD A, (HL)
 120+ E993 B8               CP B
 121+ E994 20 0F            JR NZ, .cmtDone
 122+ E996 3A F7 81         LD A, (CurrentObjective)
 123+ E999 3C               INC A
 124+ E99A 32 F7 81         LD (CurrentObjective), A
 125+ E99D CD FA E9         CALL ResolveObjectiveScreen
 126+ E9A0 3E FF            LD A, $FF
 127+ E9A2 32 FA 81         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 128+ E9A5              .cmtDone:
 129+ E9A5 F1               POP AF
 130+ E9A6 C1               POP BC
 131+ E9A7 D1               POP DE
 132+ E9A8 E1               POP HL
 133+ E9A9 C9               RET
 134+ E9AA
 135+ E9AA              ; ==============================================================================
 136+ E9AA              ; CheckMilestoneDebugKey - Tecla M: skip de hito (debug). Siempre avanza.
 137+ E9AA              ; ==============================================================================
 138+ E9AA              CheckMilestoneDebugKey:
 139+ E9AA 3E 7F            LD A, $7F                           ; semi-fila SPACE-SS-M-N-B
 140+ E9AC DB FE            IN A, ($FE)
 141+ E9AE CB 57            BIT 2, A                            ; M = bit 2 (0 = pulsada)
 142+ E9B0 20 1D            JR NZ, .cmdkNotPressed
 143+ E9B2 3A D4 E9         LD A, (MilestoneKeyDebounce)
 144+ E9B5 B7               OR A
 145+ E9B6 C0               RET NZ
 146+ E9B7 3E 01            LD A, 1
 147+ E9B9 32 D4 E9         LD (MilestoneKeyDebounce), A
 148+ E9BC 3A F7 81         LD A, (CurrentObjective)
 149+ E9BF FE 09            CP 9
 150+ E9C1 D0               RET NC
 151+ E9C2 3C               INC A
