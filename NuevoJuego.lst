 230+ FA09              SFX_ChurchDoorOpen:
 231+ FA09 0C 32 00 01      DEFB 12,  50,  0, 1          ; click: 12 iter ruido pitch 50
 232+ FA0D 5A D2 FF 00      DEFB 90, 210, -1, 0          ; crujido grave: pitch 210→120
 233+ FA11 50 78 FF 00      DEFB 80, 120, -1, 0          ; crujido medio→agudo: pitch 120→40
 234+ FA15 00               DEFB  0                       ; fin
 235+ FA16
 236+ FA16              ; --- SFX_BlockedExit: "BUZZ - BUZZ - BUZZ" triple tono profundo (~500 ticks) ---
 237+ FA16              ; Disparado cuando el jugador intenta salir de la iglesia hacia el sur
 238+ FA16              ; mientras el reloj esta congelado (fase de captura). Tres tonos cuadrados
 239+ FA16              ; muy graves separados por breves pausas para sugerir "no, no, no" como
 240+ FA16              ; un buzzer triple de concurso televisivo.
 241+ FA16              ;
 242+ FA16              ; En modo noise el pitch real esta limitado a 0-31 por AND $1F, por eso
 243+ FA16              ; usamos modo tono (noise=0) con pitch alto: el delay loop usa C
 244+ FA16              ; directamente, asi que pitch=220 da un periodo mucho mas largo (~7x mas
 245+ FA16              ; profundo que el max del modo noise).
 246+ FA16              SFX_BlockedExit:
 247+ FA16                  ; "Contraseña incorrecta" estilo pelicula: dos pulsos cortos harsh
 248+ FA16                  ; con noise (texture digital "BRRRT-BRRRT" tipo "ACCESS DENIED").
 249+ FA16                  ; Cada burst se hace con dos phases consecutivas porque cada phase
 250+ FA16                  ; en modo noise tiene duracion real corta (iter ~80us a pitch=8).
 251+ FA16 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1a: noise harsh
 252+ FA1A FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 1b: continua
 253+ FA1E 50 28 00 00      DEFB  80, 40, 0, 0          ; gap tonal audible para separacion
 254+ FA22 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2a
 255+ FA26 FA 08 00 01      DEFB 250,  8, 0, 1          ; burst 2b
 256+ FA2A 00               DEFB   0                    ; fin
 257+ FA2B
 258+ FA2B              ; --- SFX_KeyDrop: "clink-bounce" llave/moneda cayendo al suelo (~40ms) ---
 259+ FA2B              ; Clink metalico agudo + ring breve + decay rapido, 3 rebotes decrecientes.
 260+ FA2B              ; Pitch bajo = mas agudo (semi-periodo); pitchDelta=0 = sostenido,
 261+ FA2B              ; +1 = decay tonal. Acortado vs version anterior para minimizar el
 262+ FA2B              ; bloqueo de PlaySFX (~1.5 frames a 25fps, antes eran ~3).
 263+ FA2B              SFX_KeyDrop:
 264+ FA2B 12 05 00 01      DEFB  18,   5,  0, 1          ; clink agudo (noise pitch 5)
 265+ FA2F 50 07 00 00      DEFB  80,   7,  0, 0          ; ring 1 sostenido corto: campanita
 266+ FA33 32 07 01 00      DEFB  50,   7,  1, 0          ; ring 1 decay rapido (pitch 7→57)
 267+ FA37 06 12 00 01      DEFB   6,  18,  0, 1          ; rebote 1: tink metalico
 268+ FA3B 32 0A 00 00      DEFB  50,  10,  0, 0          ; ring 2 sostenido
 269+ FA3F 23 0B 01 00      DEFB  35,  11,  1, 0          ; ring 2 decay (pitch 11→46)
 270+ FA43 04 18 00 01      DEFB   4,  24,  0, 1          ; rebote 2: tink mas pequeño
 271+ FA47 23 10 00 00      DEFB  35,  16,  0, 0          ; ring 3 sostenido medio-agudo
 272+ FA4B 19 11 01 00      DEFB  25,  17,  1, 0          ; ring 3 decay final (pitch 17→42)
 273+ FA4F 00               DEFB   0                       ; fin
 274+ FA50
 275+ FA50              ; --- Sistema de campanadas con pausa entre ellas ---
 276+ FA50              ; Usa la variable de sistema FRAMES ($5C78, 16 bits low) que avanza con cada
 277+ FA50              ; interrupcion de raster — sigue contando aunque PlaySFX bloquee la CPU.
 278+ FA50              ; Asi el ritmo de campanadas se mantiene aunque haya SFX beeper de por medio.
 279+ FA50 00           BellCount:      DEFB 0          ; campanadas restantes (0 = inactivo)
 280+ FA51 00 00        BellNextFrame:  DEFW 0          ; valor de FRAMES en el que toca la siguiente
 281+ FA53              BELL_PAUSE      EQU 75          ; frames de pausa entre campanadas (~1.5s a 50fps)
 282+ FA53              SYS_FRAMES      EQU $5C78       ; ROM system var, contador 16-bit avanza con interrupts
 283+ FA53
 284+ FA53              ; --- Cadena de eventos tras la ultima campanada ---
 285+ FA53              ; last chime → (delay) → windows off → (delay) → monster spawn
 286+ FA53              POST_BELL_WINDOWS_DELAY   EQU 45    ; 45 frames a 25fps = 1.8s (era 90 a 50fps)
 287+ FA53              POST_WINDOWS_SPAWN_DELAY  EQU 38    ; 38 frames a 25fps = 1.5s (era 75 a 50fps)
 288+ FA53 00           BellsDoneTimer:       DEFB 0        ; >0 = contando hasta windows off
 289+ FA54 00           SpawnAfterWinTimer:   DEFB 0        ; >0 = contando hasta monster spawn
 290+ FA55
 291+ FA55              ; ==============================================================================
 292+ FA55              ; StartBellChimes - Inicia secuencia de 12 campanadas
 293+ FA55              ; ==============================================================================
 294+ FA55              StartBellChimes:
 295+ FA55                  ; Silenciar musica activa (death o cualquier otra). Bell escribe R7 (mixer
 296+ FA55                  ; all-on), R0-R5 (period A/B/C) y R8-R10 (vols), clobbeando lo que la musica
 297+ FA55                  ; mantenga en canal B. Mejor parar limpiamente que oir glitches.
 298+ FA55 F5               PUSH AF
 299+ FA56 3E FF            LD A, $FF
 300+ FA58 CD 05 9D         CALL StartMusic
 301+ FA5B F1               POP AF
 302+ FA5C 3E 03            LD A, 3                             ; DEBUG: 3 campanadas (era 12)
 303+ FA5E 32 50 FA         LD (BellCount), A
 304+ FA61                  ; Sonar la primera inmediatamente: deadline = FRAMES actual
 305+ FA61 2A 78 5C         LD HL, (SYS_FRAMES)
 306+ FA64 22 51 FA         LD (BellNextFrame), HL
 307+ FA67 3E 7D            LD A, SCARE_TIMER_BELLS
 308+ FA69 32 07 B9         LD (ScareTimer), A
 309+ FA6C C9               RET
 310+ FA6D
 311+ FA6D              ; ==============================================================================
 312+ FA6D              ; UpdateBellChimes - Llamar cada frame desde el main loop
 313+ FA6D              ; ==============================================================================
 314+ FA6D              UpdateBellChimes:
 315+ FA6D 3A 50 FA         LD A, (BellCount)
 316+ FA70 B7               OR A
 317+ FA71 C8               RET Z                       ; sin campanadas pendientes
 318+ FA72
 319+ FA72                  ; Comparar FRAMES actual con BellNextFrame
 320+ FA72 2A 78 5C         LD HL, (SYS_FRAMES)
 321+ FA75 ED 5B 51 FA      LD DE, (BellNextFrame)
 322+ FA79 B7               OR A
 323+ FA7A ED 52            SBC HL, DE                  ; HL = FRAMES - BellNextFrame
 324+ FA7C D8               RET C                       ; FRAMES < deadline → aun no toca
 325+ FA7D
 326+ FA7D                  ; Sonar campanada (AY, no bloquea CPU)
 327+ FA7D C5               PUSH BC
 328+ FA7E D5               PUSH DE
 329+ FA7F CD 28 9C         CALL AY_PlayBellChime
 330+ FA82 D1               POP DE
 331+ FA83 C1               POP BC
 332+ FA84
 333+ FA84                  ; Resincronizar: deadline siguiente = FRAMES actual + BELL_PAUSE
 334+ FA84                  ; Esto evita acumular drift cuando los SFX bloquean interrupts
 335+ FA84 2A 78 5C         LD HL, (SYS_FRAMES)
 336+ FA87 11 4B 00         LD DE, BELL_PAUSE
 337+ FA8A 19               ADD HL, DE
 338+ FA8B 22 51 FA         LD (BellNextFrame), HL
 339+ FA8E
 340+ FA8E 21 50 FA         LD HL, BellCount
 341+ FA91 35               DEC (HL)
 342+ FA92 C0               RET NZ
 343+ FA93 18 00            JR .bellsDone
 344+ FA95
 345+ FA95              .bellsDone:
 346+ FA95                  ; Ultima campanada:
 347+ FA95                  ;   1) matar todos los nasties vivos (puff)
 348+ FA95                  ;   2) arrancar cadena diferida: windows off → monster spawn
 349+ FA95 CD 47 BD         CALL KillAllActiveNasties
 350+ FA98 3E 2D            LD A, POST_BELL_WINDOWS_DELAY
 351+ FA9A 32 53 FA         LD (BellsDoneTimer), A
 352+ FA9D C9               RET
 353+ FA9E
 354+ FA9E              ; ==============================================================================
 355+ FA9E              ; UpdateBellsDoneTimer - Llamar cada frame tras UpdateBellChimes
 356+ FA9E              ; ==============================================================================
 357+ FA9E              ; Maneja la cadena diferida tras la ultima campanada:
 358+ FA9E              ;   1) BellsDoneTimer cuenta hasta 0 → apagar ventanas (UpdateRemapTables)
 359+ FA9E              ;      y arranca SpawnAfterWinTimer
 360+ FA9E              ;   2) SpawnAfterWinTimer cuenta hasta 0 → SpawnMonsters
 361+ FA9E              ; ==============================================================================
 362+ FA9E              UpdateBellsDoneTimer:
 363+ FA9E 3A 53 FA         LD A, (BellsDoneTimer)
 364+ FAA1 B7               OR A
 365+ FAA2 28 21            JR Z, .ubdCheckSpawn
 366+ FAA4 3D               DEC A
 367+ FAA5 32 53 FA         LD (BellsDoneTimer), A
 368+ FAA8 20 1B            JR NZ, .ubdCheckSpawn
 369+ FAAA                  ; Llego a 0: apagar ventanas
 370+ FAAA CD 68 E5         CALL UpdateRemapTables
 371+ FAAD 3E 01            LD A, 1
 372+ FAAF 32 B6 82         LD (AttrsDirty), A
 373+ FAB2                  ; Si las campanadas las disparo el jugador abriendo la iglesia (i.e.
 374+ FAB2                  ; ChurchDoorOpen=1 al terminar bells), resaltar la estatua del
 375+ FAB2                  ; monstruo esperado. Si fueron campanadas naturales de medianoche,
 376+ FAB2                  ; ChurchDoorOpen sigue en 0 y este call es no-op.
 377+ FAB2 3A 61 82         LD A, (ChurchDoorOpen)
 378+ FAB5 B7               OR A
 379+ FAB6 28 03            JR Z, .ubdSkipHighlight
 380+ FAB8 CD A6 F4         CALL StartStatueBlink
 381+ FABB              .ubdSkipHighlight:
 382+ FABB 3E 26            LD A, POST_WINDOWS_SPAWN_DELAY
 383+ FABD 32 54 FA         LD (SpawnAfterWinTimer), A
 384+ FAC0                  ; Musica de tension organica entre lights-off y monster spawn (track 0)
 385+ FAC0 AF               XOR A                           ; A = 0 = MUSIC_TENSION
 386+ FAC1 CD 05 9D         CALL StartMusic
 387+ FAC4 C9               RET
 388+ FAC5              .ubdCheckSpawn:
 389+ FAC5 3A 54 FA         LD A, (SpawnAfterWinTimer)
 390+ FAC8 B7               OR A
 391+ FAC9 C8               RET Z
 392+ FACA 3D               DEC A
 393+ FACB 32 54 FA         LD (SpawnAfterWinTimer), A
 394+ FACE C0               RET NZ
 395+ FACF                  ; Llego a 0: spawnear monsters
 396+ FACF C3 66 C0         JP SpawnMonsters
 397+ FAD2
# file closed: sound.asm
