   1+ A9C8              ; ==============================================================================
   2+ A9C8              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
   3+ A9C8              ; ==============================================================================
   4+ A9C8              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
   5+ A9C8              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
   6+ A9C8              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
   7+ A9C8              ; ==============================================================================
   8+ A9C8
   9+ A9C8              ; ==============================================================================
  10+ A9C8              ; InitScreenSystem - Inicializa el sistema de pantallas
  11+ A9C8              ; ==============================================================================
  12+ A9C8              InitScreenSystem:
  13+ A9C8 3E 08            LD A, START_SCREEN_X
  14+ A9CA 32 AF 81         LD (CurrentScreenX), A
  15+ A9CD 3E 08            LD A, START_SCREEN_Y
  16+ A9CF 32 B0 81         LD (CurrentScreenY), A
  17+ A9D2 3E 01            LD A, 1
  18+ A9D4 32 B4 81         LD (ScreenDirty), A         ; Forzar dibujado inicial
  19+ A9D7 AF               XOR A
  20+ A9D8 32 B3 81         LD (ScreenTransition), A
  21+ A9DB CD DF A9         CALL CalcScreenAddress
  22+ A9DE C9               RET
  23+ A9DF
  24+ A9DF              ; ==============================================================================
  25+ A9DF              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
  26+ A9DF              ; ==============================================================================
  27+ A9DF              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
  28+ A9DF              ; ==============================================================================
  29+ A9DF              CalcScreenAddress:
  30+ A9DF 3A B0 81         LD A, (CurrentScreenY)
  31+ A9E2 6F               LD L, A
  32+ A9E3 26 00            LD H, 0
  33+ A9E5 29               ADD HL, HL                  ; x2
  34+ A9E6 29               ADD HL, HL                  ; x4
  35+ A9E7 29               ADD HL, HL                  ; x8
  36+ A9E8 29               ADD HL, HL                  ; x16
  37+ A9E9 3A AF 81         LD A, (CurrentScreenX)
  38+ A9EC 5F               LD E, A
  39+ A9ED 16 00            LD D, 0
  40+ A9EF 19               ADD HL, DE                  ; HL = Y*16 + X
  41+ A9F0 11 2E B7         LD DE, MapTable
  42+ A9F3 19               ADD HL, DE                  ; HL = &MapTable[index]
  43+ A9F4 7E               LD A, (HL)                  ; A = room index (0-47)
  44+ A9F5                  ; Lookup en RoomTable (tabla de DEFWs)
  45+ A9F5 6F               LD L, A
  46+ A9F6 26 00            LD H, 0
  47+ A9F8 29               ADD HL, HL                  ; index * 2
  48+ A9F9 11 CC B6         LD DE, RoomTable
  49+ A9FC 19               ADD HL, DE
  50+ A9FD 5E               LD E, (HL)
  51+ A9FE 23               INC HL
  52+ A9FF 56               LD D, (HL)                  ; DE = puntero a room data
  53+ AA00 ED 53 B1 81      LD (CurrentScreenAddr), DE
  54+ AA04 C9               RET
  55+ AA05
  56+ AA05              ; ==============================================================================
  57+ AA05              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
  58+ AA05              ; ==============================================================================
  59+ AA05              CheckScreenTransition:
  60+ AA05 AF               XOR A
  61+ AA06 32 B3 81         LD (ScreenTransition), A
  62+ AA09
  63+ AA09                  ; --- Comprobar borde OESTE (izquierdo) ---
  64+ AA09 3A 88 80         LD A, (EntityTable + ENT_POSX)
  65+ AA0C FE 04            CP TRANSITION_ZONE
  66+ AA0E 30 32            JR NC, .noWest
  67+ AA10 3A AF 81         LD A, (CurrentScreenX)
  68+ AA13 B7               OR A
  69+ AA14 28 2C            JR Z, .noWest
  70+ AA16                  ; Comprobar si hay colision en col 0 antes de transicionar (top + bottom)
  71+ AA16 06 00            LD B, 0
  72+ AA18 3A 89 80         LD A, (EntityTable + ENT_POSY)
  73+ AA1B 4F               LD C, A
  74+ AA1C CD CC AE         CALL IsPointBlocked
  75+ AA1F 20 21            JR NZ, .noWest
  76+ AA21 06 00            LD B, 0
  77+ AA23 3A 89 80         LD A, (EntityTable + ENT_POSY)
  78+ AA26 C6 14            ADD A, 20
  79+ AA28 4F               LD C, A
  80+ AA29 CD CC AE         CALL IsPointBlocked
  81+ AA2C 20 14            JR NZ, .noWest
  82+ AA2E 3A AF 81         LD A, (CurrentScreenX)
  83+ AA31 3D               DEC A
  84+ AA32 32 AF 81         LD (CurrentScreenX), A
  85+ AA35 3E 08            LD A, DIR_W
  86+ AA37 32 B3 81         LD (ScreenTransition), A
  87+ AA3A 3E E0            LD A, SCREEN_MAX_X - 8
  88+ AA3C 32 88 80         LD (EntityTable + ENT_POSX), A
  89+ AA3F C3 F4 AA         JP .doTransition
  90+ AA42
  91+ AA42              .noWest:
  92+ AA42                  ; --- Comprobar borde ESTE (derecho) ---
  93+ AA42 3A 88 80         LD A, (EntityTable + ENT_POSX)
  94+ AA45 FE E8            CP SCREEN_MAX_X
  95+ AA47 DA 80 AA         JP C, .noEast
  96+ AA4A 3A AF 81         LD A, (CurrentScreenX)
  97+ AA4D FE 0F            CP MAP_WIDTH - 1
  98+ AA4F CA 80 AA         JP Z, .noEast
  99+ AA52                  ; Comprobar si hay colision en col 31 antes de transicionar (top + bottom del player)
 100+ AA52 06 F8            LD B, SCREEN_MAX_X + 16     ; borde derecho del sprite (248 = col 31)
 101+ AA54 3A 89 80         LD A, (EntityTable + ENT_POSY)
 102+ AA57 4F               LD C, A
 103+ AA58 CD CC AE         CALL IsPointBlocked
 104+ AA5B C2 80 AA         JP NZ, .noEast
 105+ AA5E 06 F8            LD B, SCREEN_MAX_X + 16
 106+ AA60 3A 89 80         LD A, (EntityTable + ENT_POSY)
 107+ AA63 C6 14            ADD A, 20
 108+ AA65 4F               LD C, A
 109+ AA66 CD CC AE         CALL IsPointBlocked
 110+ AA69 C2 80 AA         JP NZ, .noEast
 111+ AA6C 3A AF 81         LD A, (CurrentScreenX)
 112+ AA6F 3C               INC A
 113+ AA70 32 AF 81         LD (CurrentScreenX), A
 114+ AA73 3E 04            LD A, DIR_E
 115+ AA75 32 B3 81         LD (ScreenTransition), A
 116+ AA78 3E 05            LD A, TRANSITION_ZONE + 1
 117+ AA7A 32 88 80         LD (EntityTable + ENT_POSX), A
 118+ AA7D C3 F4 AA         JP .doTransition
 119+ AA80
 120+ AA80              .noEast:
 121+ AA80                  ; --- Comprobar borde NORTE (superior) ---
 122+ AA80 3A 89 80         LD A, (EntityTable + ENT_POSY)
 123+ AA83 FE 14            CP SCREEN_MIN_Y + TRANSITION_ZONE
 124+ AA85 D2 BD AA         JP NC, .noNorth
 125+ AA88 3A B0 81         LD A, (CurrentScreenY)
 126+ AA8B B7               OR A
 127+ AA8C CA BD AA         JP Z, .noNorth
 128+ AA8F                  ; Comprobar colision en fila superior (left + right del player)
 129+ AA8F 3A 88 80         LD A, (EntityTable + ENT_POSX)
 130+ AA92 47               LD B, A
 131+ AA93 0E 10            LD C, SCREEN_MIN_Y
 132+ AA95 CD CC AE         CALL IsPointBlocked
 133+ AA98 C2 BD AA         JP NZ, .noNorth
 134+ AA9B 3A 88 80         LD A, (EntityTable + ENT_POSX)
 135+ AA9E C6 0F            ADD A, 15
 136+ AAA0 47               LD B, A
 137+ AAA1 0E 10            LD C, SCREEN_MIN_Y
 138+ AAA3 CD CC AE         CALL IsPointBlocked
 139+ AAA6 C2 BD AA         JP NZ, .noNorth
 140+ AAA9 3A B0 81         LD A, (CurrentScreenY)
 141+ AAAC 3D               DEC A
 142+ AAAD 32 B0 81         LD (CurrentScreenY), A
 143+ AAB0 3E 01            LD A, DIR_N
 144+ AAB2 32 B3 81         LD (ScreenTransition), A
 145+ AAB5 3E A3            LD A, SCREEN_MAX_Y - 8
 146+ AAB7 32 89 80         LD (EntityTable + ENT_POSY), A
 147+ AABA C3 F4 AA         JP .doTransition
 148+ AABD
 149+ AABD              .noNorth:
 150+ AABD                  ; --- Comprobar borde SUR (inferior) ---
 151+ AABD 3A 89 80         LD A, (EntityTable + ENT_POSY)
 152+ AAC0 FE AB            CP SCREEN_MAX_Y
 153+ AAC2 38 4B            JR C, .noSouth
 154+ AAC4 3A B0 81         LD A, (CurrentScreenY)
 155+ AAC7 FE 0F            CP MAP_HEIGHT - 1
 156+ AAC9 28 44            JR Z, .noSouth
 157+ AACB                  ; Comprobar colision en fila inferior (left + right del player)
 158+ AACB 3A 88 80         LD A, (EntityTable + ENT_POSX)
 159+ AACE 47               LD B, A
 160+ AACF 0E AB            LD C, SCREEN_MAX_Y
 161+ AAD1 CD CC AE         CALL IsPointBlocked
 162+ AAD4 20 39            JR NZ, .noSouth
 163+ AAD6 3A 88 80         LD A, (EntityTable + ENT_POSX)
 164+ AAD9 C6 0F            ADD A, 15
 165+ AADB 47               LD B, A
 166+ AADC 0E AB            LD C, SCREEN_MAX_Y
 167+ AADE CD CC AE         CALL IsPointBlocked
 168+ AAE1 20 2C            JR NZ, .noSouth
 169+ AAE3 3A B0 81         LD A, (CurrentScreenY)
 170+ AAE6 3C               INC A
 171+ AAE7 32 B0 81         LD (CurrentScreenY), A
 172+ AAEA 3E 02            LD A, DIR_S
 173+ AAEC 32 B3 81         LD (ScreenTransition), A
 174+ AAEF 3E 15            LD A, SCREEN_MIN_Y + TRANSITION_ZONE + 1
 175+ AAF1 32 89 80         LD (EntityTable + ENT_POSY), A
