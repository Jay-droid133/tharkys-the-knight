 199  6F4B
 200  6F4B                  ; --- Magic compass: power-up que muestra ruta sala-a-sala (slot 1) ---
 201  6F4B                  ; ApplyMagicCompassBuff/UpdateMagicCompass/CancelMagicCompass + BFS reverse
 202  6F4B                  ; con state (sid, comp_local) via RoomCompGapsTable (vive en slot 1, no
 203  6F4B                  ; necesita paginar bank 6). Evita cul-de-sacs internos.
 204  6F4B                  ;
 205  6F4B                  ; Scratch BFS (Queue 128 B + Visited 96 B = 224 B) está EQU'd a $5B00 /
 206  6F4B                  ; $5B80 (printer buffer, bank 5, always-on en slot 1). Antes vivían como
 207  6F4B                  ; DEFS al final del archivo y solapaban la IM 2 table en $7A00..$7A3B; en
 208  6F4B                  ; hardware funcionaba por el bus flotante (IRQ ack lee $FF → vector $7B7B)
 209  6F4B                  ; pero en emuladores con bus indefinido el vector caía en basura y colgaba.
 210  6F4B                  ; SAVETAP excluye $5B00..$5DFF de la cinta, así que 0 bytes de coste en .tap.
 211  6F4B                  INCLUDE "magic_compass.asm"
# file opened: magic_compass.asm
   1+ 6F4B              ; ==============================================================================
   2+ 6F4B              ; MAGIC COMPASS - Power-up que muestra ruta exacta sala-a-sala
   3+ 6F4B              ; ==============================================================================
   4+ 6F4B              ; Recogido por el player (sprite ID34, "compass pickup", BgGfx_pickup_compass).
   5+ 6F4B              ; Mientras MagicCompassTimer>0:
   6+ 6F4B              ;   - DrawCompass override: flecha apunta a la salida correcta de la sala
   7+ 6F4B              ;     actual (BFS reverse desde ObjectiveScreen hasta CurrentScreen via
   8+ 6F4B              ;     RoomCompGapsTable, respetando componentes walkable internas).
   9+ 6F4B              ;   - Atributo HUD: paper amarillo, blink ~3 Hz (6 Hz en últimos 5 s).
  10+ 6F4B              ;   - SFX (canal B): jingle al recoger + tick heartbeat 1/s (2/s en warning).
  11+ 6F4B              ; Cancela en muerte y al cumplir hito (CurrentObjective avanza).
  12+ 6F4B              ; Refresh al recoger otra (timer reset a MAGIC_COMPASS_FRAMES).
  13+ 6F4B              ; Convive con rayo/caracol/mushroom (ortogonal: solo afecta HUD/SFX).
  14+ 6F4B              ;
  15+ 6F4B              ; BFS sala-a-sala con estado (sid, comp_local) — comp_local es la zona
  16+ 6F4B              ; walkable interna (re-indexada por tamaño desc). Esto evita cul-de-sacs
  17+ 6F4B              ; internos: dos gaps de la misma sala solo conectan internamente si
  18+ 6F4B              ; comparten comp. Cada gap individual tiene su comp en RoomCompGapsTable.
  19+ 6F4B              ; La asociación gap-físico↔comp se preserva via el coord (cuando dos gaps
  20+ 6F4B              ; del mismo side existen en distintas comps, mantienen distintos coords).
  21+ 6F4B              ;
  22+ 6F4B              ; Vive en slot 1 ($6000+, no contended). Cero coste en bank 0/2.
  23+ 6F4B              ; ==============================================================================
  24+ 6F4B
  25+ 6F4B              ; ==============================================================================
  26+ 6F4B              ; ApplyMagicCompassBuff - Activa el power-up (refresh-on-pickup)
  27+ 6F4B              ; ==============================================================================
  28+ 6F4B              ; Llamado desde el dispatcher de pickup (CheckRandomSyntheticPickup +
  29+ 6F4B              ; CheckPickupCollect). Refresh: si ya estaba activo, reinicia timer.
  30+ 6F4B              ; Destruye: AF, HL.
  31+ 6F4B              ; ==============================================================================
  32+ 6F4B              ApplyMagicCompassBuff:
  33+ 6F4B                  ; Si la compass YA estaba activa (timer > 0), saltamos PathDirty=1: el
  34+ 6F4B                  ; player no se ha movido de sala y el objetivo no ha cambiado, asi que
  35+ 6F4B                  ; el path cacheado sigue siendo valido. Evita el tiron de re-BFS al
  36+ 6F4B                  ; recoger una segunda compass.
  37+ 6F4B 2A BF 5F         LD HL, (MagicCompassTimer)
  38+ 6F4E 7C               LD A, H
  39+ 6F4F B5               OR L
  40+ 6F50 20 05            JR NZ, .amcbAlreadyActive            ; timer != 0 → path ya computado
  41+ 6F52 3E 01            LD A, 1
  42+ 6F54 32 C3 5F         LD (MagicCompassPathDirty), A       ; primera vez: marcar para recompute
  43+ 6F57              .amcbAlreadyActive:
  44+ 6F57 21 71 02         LD HL, MAGIC_COMPASS_FRAMES
  45+ 6F5A 22 BF 5F         LD (MagicCompassTimer), HL          ; siempre refrescar el timer
  46+ 6F5D AF               XOR A
  47+ 6F5E 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; arranca con bright off (sin tick sonando)
  48+ 6F61 3E 19            LD A, MAGIC_COMPASS_TICK_NORMAL
  49+ 6F63 32 C5 5F         LD (MagicCompassTickCounter), A
  50+ 6F66                  ; Desactivar el jingle viejo (3 notas via .umcUpdateJingle): el chime de
  51+ 6F66                  ; recogida lo hace ahora un sweep AY tipo PlayerHit (mas chuleria). Idx
  52+ 6F66                  ; queda en $FF para que el ticker viejo sea no-op pero quede por si en
  53+ 6F66                  ; el futuro se quiere reactivar.
  54+ 6F66 3E FF            LD A, $FF
  55+ 6F68 32 C6 5F         LD (MagicCompassJingleIdx), A
  56+ 6F6B C9               RET
  57+ 6F6C                  ; SFX al recoger MOVIDO al caller (screen_system) — ApplyMagicCompassBuff
  58+ 6F6C                  ; ya no dispara AY_Play*. Esto evita el bug "dos AY_PlaySFX back-to-back"
  59+ 6F6C                  ; cuando random_pickups dispara primero AY_PlayCompassPickup en .crsSpecialSfx
  60+ 6F6C                  ; y luego JP ApplyMagicCompassBuff_B7 -> tail JP a AY_PlayCompassPickup
  61+ 6F6C                  ; otra vez. La segunda call enmudecia el canal B silenciosamente.
  62+ 6F6C
  63+ 6F6C              ; ==============================================================================
  64+ 6F6C              ; CancelMagicCompass - Cancela el efecto (muerte / hito cumplido / llegar al
  65+ 6F6C              ; hito / timeout). Cleanup exhaustivo para que ni el jingle ni el tick AY
  66+ 6F6C              ; sigan sonando un frame extra y para que el HUD no quede con cache stale.
  67+ 6F6C              ; ==============================================================================
  68+ 6F6C              ; Entry points:
  69+ 6F6C              ;   CancelMagicCompass    - chequea timer; RET Z si ya inactivo. Llamado por
  70+ 6F6C              ;                           muerte / hito cumplido / llegar a sala destino,
  71+ 6F6C              ;                           sites que no saben si la brujula estaba activa.
  72+ 6F6C              ;   _DoCancelMagicCompass - fall-through directo, sin check de timer. Usado
  73+ 6F6C              ;                           por el branch del timeout natural (Timer ya es 0
  74+ 6F6C              ;                           tras el DEC, asi que el check daria RET Z falso
  75+ 6F6C              ;                           positivo y se saltaria el cleanup).
  76+ 6F6C              ; ==============================================================================
  77+ 6F6C              CancelMagicCompass:
  78+ 6F6C 3A CD 82         LD A, (MagicCompassPermanent)
  79+ 6F6F B7               OR A
  80+ 6F70 C0               RET NZ                               ; lasting compass: nunca cancelar
  81+ 6F71 3A BF 5F         LD A, (MagicCompassTimer)
  82+ 6F74 47               LD B, A
  83+ 6F75 3A C0 5F         LD A, (MagicCompassTimer + 1)
  84+ 6F78 B0               OR B
  85+ 6F79 C8               RET Z                                ; ya inactivo
  86+ 6F7A                  ; fall through al cleanup compartido
  87+ 6F7A              _DoCancelMagicCompass:
  88+ 6F7A AF               XOR A
  89+ 6F7B 32 BF 5F         LD (MagicCompassTimer), A
  90+ 6F7E 32 C0 5F         LD (MagicCompassTimer + 1), A
  91+ 6F81 32 C5 5F         LD (MagicCompassTickCounter), A
  92+ 6F84 32 C4 5F         LD (MagicCompassTickActiveFrames), A ; mata bright residual del tick
  93+ 6F87 32 CD 5F         LD (MagicCompassBfsState), A         ; aborta BFS in-progress (queue stale)
  94+ 6F8A 3E FF            LD A, $FF
  95+ 6F8C 32 C1 5F         LD (MagicCompassPathDir), A          ; borra dir cached → render normal
  96+ 6F8F 32 C2 5F         LD (MagicCompassPathCoord), A        ; borra coord cached (gap hint sprite)
  97+ 6F92 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache de sprite HUD
  98+ 6F95 32 C6 5F         LD (MagicCompassJingleIdx), A        ; detiene jingle (si estaba sonando)
  99+ 6F98 32 C2 82         LD (PreviousObjectiveDistance), A    ; fuerza redraw del HUD el siguiente
 100+ 6F9B                                                       ; frame: DrawCompass detecta $FF y
 101+ 6F9B                                                       ; entra a .dcRedraw, sustituyendo el
 102+ 6F9B                                                       ; sprite_compass_magic stale por la
 103+ 6F9B                                                       ; brujula clasica (8 flechas + X).
 104+ 6F9B C9               RET
 105+ 6F9C
 106+ 6F9C              ; ==============================================================================
 107+ 6F9C              ; RefreshMagicCompassForNewObjective - Recompute path tras avance de hito
 108+ 6F9C              ; ==============================================================================
 109+ 6F9C              ; Llamado desde CheckMilestonePickup/Trigger/DebugKey tras CancelMagicCompass.
 110+ 6F9C              ;
 111+ 6F9C              ; Caso normal (random pickup, no Permanent): CancelMagicCompass ya zappeo el
 112+ 6F9C              ; timer a 0; aqui retornamos inmediatamente sin tocar nada (no-op).
 113+ 6F9C              ;
 114+ 6F9C              ; Caso lasting compass (Permanent=1): CancelMagicCompass retorno sin tocar el
 115+ 6F9C              ; estado, asi que el timer sigue activo. El BFS anterior dejo MagicCompassPathDir
 116+ 6F9C              ; en $FF (current_sid == target_sid en el momento del pickup), lo que hace que
 117+ 6F9C              ; DrawCompass cayera en .dcMagicOff y renderizara la brujula clasica. Sin
 118+ 6F9C              ; recompute aqui, la brujula clasica persistia hasta el siguiente cambio de
 119+ 6F9C              ; sala (donde CheckScreenTransition llama a ForceComputeMagicCompassPath).
 120+ 6F9C              ;
 121+ 6F9C              ; Recompute sincrono = brujula magica vuelve a apuntar al NUEVO objetivo en el
 122+ 6F9C              ; mismo frame del pickup. Coste: ~10K T-states (~14% del frame), una sola vez
 123+ 6F9C              ; por avance de hito; gameplay normal no afectado.
 124+ 6F9C              ;
 125+ 6F9C              ; Destruye: AF, BC, DE, HL.
 126+ 6F9C              ; ==============================================================================
 127+ 6F9C              RefreshMagicCompassForNewObjective:
 128+ 6F9C 3A BF 5F         LD A, (MagicCompassTimer)
 129+ 6F9F 47               LD B, A
 130+ 6FA0 3A C0 5F         LD A, (MagicCompassTimer + 1)
 131+ 6FA3 B0               OR B
 132+ 6FA4 C8               RET Z                                ; magic inactiva: no-op
 133+ 6FA5 3E FF            LD A, $FF
 134+ 6FA7 32 CC 5F         LD (LastMagicCompassDrawn), A        ; invalida cache HUD
 135+ 6FAA C3 AD 6F         JP ForceComputeMagicCompassPath      ; tail call: BFS sincrono al nuevo goal
 136+ 6FAD
 137+ 6FAD              ; ==============================================================================
 138+ 6FAD              ; ForceComputeMagicCompassPath - Corre el BFS COMPLETO sincronicamente.
 139+ 6FAD              ; ==============================================================================
 140+ 6FAD              ; Llamado desde CheckScreenTransition al cruzar borde con magic activa.
 141+ 6FAD              ; Garantiza que MagicCompassPathDir refleja la sala NUEVA antes de que el
 142+ 6FAD              ; HUD se redibuje y antes de que UpdateMagicCompass pueda disparar el primer
 143+ 6FAD              ; tick post-cruce. Sin esto, el BFS amortizado tarda 3-4 frames en converger
 144+ 6FAD              ; y los primeros ticks de la nueva sala muestran el flash apuntando a la
 145+ 6FAD              ; direccion vieja (de la sala anterior).
 146+ 6FAD              ;
 147+ 6FAD              ; Coste: ~10000 T-states una sola vez por cruce (~14% de un frame). El frame
 148+ 6FAD              ; del cruce ya es el mas pesado por DrawScreen, asi que nos comemos el spike
 149+ 6FAD              ; solo en transiciones — nunca en frames de gameplay normal.
 150+ 6FAD              ;
 151+ 6FAD              ; Estrategia: setea BfsState=0 (descartando cualquier BFS in-progress de la
 152+ 6FAD              ; sala anterior, que tendria current_sid stale) y loop CALL/check hasta
 153+ 6FAD              ; BfsState vuelva a 0 (= terminado, sea con path o sin path). Cada call
 154+ 6FAD              ; ejecuta un chunk de MAGIC_COMPASS_BFS_ITERS_PER_FRAME iteraciones; el
 155+ 6FAD              ; overhead extra de los chunks (~30 T-states por loop) es despreciable.
 156+ 6FAD              ;
 157+ 6FAD              ; Destruye: AF, BC, DE, HL.
 158+ 6FAD              ; ==============================================================================
 159+ 6FAD              ForceComputeMagicCompassPath:
 160+ 6FAD AF               XOR A
 161+ 6FAE 32 CD 5F         LD (MagicCompassBfsState), A         ; descarta BFS amortizado in-progress
 162+ 6FB1              .fcmcpLoop:
 163+ 6FB1 CD 69 70         CALL ComputeMagicCompassPath         ; ejecuta un chunk; setea state=0 al
 164+ 6FB4                                                       ; terminar (.cmcpFound o .cmcpNoPath)
 165+ 6FB4 3A CD 5F         LD A, (MagicCompassBfsState)
 166+ 6FB7 B7               OR A
 167+ 6FB8 20 F7            JR NZ, .fcmcpLoop                    ; aun en progreso → otro chunk
 168+ 6FBA AF               XOR A
 169+ 6FBB 32 C3 5F         LD (MagicCompassPathDirty), A        ; ya recalculado, no necesita rerun
 170+ 6FBE                  ; Forzar tick INMEDIATO en la nueva sala: TickCounter=0 hace que
 171+ 6FBE                  ; UpdateMagicCompass dispare .umcTickFire en el siguiente frame, sin
 172+ 6FBE                  ; esperar a que el contador llegue a 0 de forma natural (que podia
 173+ 6FBE                  ; tardar hasta 50 frames = 1 segundo). El player ve flash + suena AY
 174+ 6FBE                  ; al instante de cruzar, con la flecha correcta.
 175+ 6FBE                  ; TickActiveFrames=0 mata cualquier flash residual del tick que estaba
 176+ 6FBE                  ; en curso en la sala anterior — evita 1-2 frames de bright apuntando
 177+ 6FBE                  ; a la dir vieja entre el cruce y el nuevo tick.
 178+ 6FBE 32 C5 5F         LD (MagicCompassTickCounter), A
 179+ 6FC1 32 C4 5F         LD (MagicCompassTickActiveFrames), A
 180+ 6FC4 C9               RET
 181+ 6FC5
 182+ 6FC5              ; ==============================================================================
 183+ 6FC5              ; UpdateMagicCompass - Tick por frame (timer, blink, AY tick, path)
 184+ 6FC5              ; ==============================================================================
 185+ 6FC5              ; (Jingle viejo de 3 notas eliminado — el SFX de pickup ahora usa _AY_PlaySweep
 186+ 6FC5              ; via AY_PlayCompassPickup/AY_PlayLastingPickup, no necesita ticker).
 187+ 6FC5              ; ==============================================================================
 188+ 6FC5              UpdateMagicCompass:
 189+ 6FC5 2A BF 5F         LD HL, (MagicCompassTimer)
 190+ 6FC8 7C               LD A, H
 191+ 6FC9 B5               OR L
 192+ 6FCA C8               RET Z                                ; inactivo
 193+ 6FCB
 194+ 6FCB 2B               DEC HL
 195+ 6FCC 22 BF 5F         LD (MagicCompassTimer), HL
 196+ 6FCF
 197+ 6FCF 7C               LD A, H
 198+ 6FD0 B5               OR L
 199+ 6FD1 20 08            JR NZ, .umcStillActive
 200+ 6FD3                  ; Timeout natural: Timer acaba de pasar a 0. Cleanup completo (saltando
 201+ 6FD3                  ; el check del entry point publico, que daria RET Z falso positivo).
 202+ 6FD3                  ; Disparar wobble del HUD compass clasico como senal visual de que el
 203+ 6FD3                  ; power-up se acabo: 9 frames de oscilacion antes de quedarse en la
 204+ 6FD3                  ; flecha del target. .dcWobbleStartNormal en DrawCompass aplica los
 205+ 6FD3                  ; overrides per-frame; idx==4 (X) sigue sin oscilar (early-skip ya en
 206+ 6FD3                  ; el codigo del wobble).
 207+ 6FD3 3E 09            LD A, 9
 208+ 6FD5 32 C5 82         LD (CompassWobbleCounter), A
 209+ 6FD8 C3 7A 6F         JP _DoCancelMagicCompass             ; tail call: cleanup + force HUD redraw
 210+ 6FDB              .umcStillActive:
 211+ 6FDB
 212+ 6FDB                  ; ¿Llegamos a la sala del hito? Si sí, cancelar el power-up entero —
 213+ 6FDB                  ; no esperamos a coger el pickup. Esto detiene tick AY, jingle y libera
 214+ 6FDB                  ; el HUD compass al estado clásico (X blanca normal vía DrawCompass).
 215+ 6FDB 3A C0 82         LD A, (ObjectiveScreenX)
 216+ 6FDE FE FF            CP $FF
 217+ 6FE0 28 12            JR Z, .umcNotAtTarget                ; sin objetivo resuelto → skip
 218+ 6FE2 21 10 83         LD HL, CurrentScreenX
 219+ 6FE5 BE               CP (HL)
 220+ 6FE6 20 0C            JR NZ, .umcNotAtTarget
 221+ 6FE8 3A C1 82         LD A, (ObjectiveScreenY)
 222+ 6FEB 21 11 83         LD HL, CurrentScreenY
 223+ 6FEE BE               CP (HL)
 224+ 6FEF 20 03            JR NZ, .umcNotAtTarget
 225+ 6FF1 C3 6C 6F         JP CancelMagicCompass                ; tail call — RET incluido
 226+ 6FF4              .umcNotAtTarget:
 227+ 6FF4
 228+ 6FF4                  ; Decrementar TickActiveFrames si > 0 (controla la duración visual del bright)
 229+ 6FF4 21 C4 5F         LD HL, MagicCompassTickActiveFrames
 230+ 6FF7 7E               LD A, (HL)
 231+ 6FF8 B7               OR A
 232+ 6FF9 28 01            JR Z, .umcAfterTickActive
 233+ 6FFB 35               DEC (HL)
 234+ 6FFC              .umcAfterTickActive:
 235+ 6FFC
 236+ 6FFC 21 C5 5F         LD HL, MagicCompassTickCounter
