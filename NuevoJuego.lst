1002+ EEDA 21 7E F8         LD HL, BgGfx_pickup_reverse
1003+ EEDD C3 02 EF         JP .urpActivate
1004+ EEE0              .urpDoRoulette:
1005+ EEE0                  ; Activar modo roulette: idx random, counter=full, sprite del tipo elegido.
1006+ EEE0                  ; El idx inicial se aleatoriza con R mod ROULETTE_ORDER_LEN para que cada
1007+ EEE0                  ; activacion empiece en un punto distinto del ciclo (antes siempre LIFE).
1008+ EEE0                  ; Tras el primer tick, UpdateRoulette sigue el orden preestablecido normal.
1009+ EEE0 3E 06            LD A, ROLLED_ROULETTE
1010+ EEE2 32 D5 5F         LD (RP_TmpRolled), A
1011+ EEE5 3E 01            LD A, 1
1012+ EEE7 32 BC 5F         LD (RouletteActive), A
1013+ EEEA                  ; --- Random initial idx: R mod ROULETTE_ORDER_LEN ---
1014+ EEEA ED 5F            LD A, R
1015+ EEEC 06 06            LD B, ROULETTE_ORDER_LEN
1016+ EEEE              .urpRouletteModLoop:
1017+ EEEE 90               SUB B
1018+ EEEF 30 FD            JR NC, .urpRouletteModLoop
1019+ EEF1 80               ADD A, B                            ; A = R mod ORDER_LEN (0..N-1)
1020+ EEF2 CD 62 EB         CALL SkipCompassIfNeeded            ; si idx cae en COMPASS y lasting activo, avanza
1021+ EEF5 32 BD 5F         LD (RouletteIdx), A
1022+ EEF8 47               LD B, A                             ; B = idx para GetRoulettePtrByIdx
1023+ EEF9 3E 0C            LD A, ROULETTE_CYCLE_FRAMES
1024+ EEFB 32 BE 5F         LD (RouletteFrameCounter), A
1025+ EEFE 78               LD A, B
1026+ EEFF CD CF EA         CALL GetRoulettePtrByIdx            ; HL = ptr al tipo random elegido
1027+ EF02              .urpActivate:
1028+ EF02                  ; --- Set ptr/attr + cargar sprite + activar entry sintetica ---
1029+ EF02 CD 2E EB         CALL LoadSynthSpriteAndExtractAttr
1030+ EF05 3A 10 83         LD A, (CurrentScreenX)
1031+ EF08 32 B4 5F         LD (RandomSynthMapX), A             ; activa la entry
1032+ EF0B 3A 11 83         LD A, (CurrentScreenY)
1033+ EF0E 32 B5 5F         LD (RandomSynthMapY), A
1034+ EF11 3E FF            LD A, $FF
1035+ EF13 32 BA 5F         LD (RandomSynthTint), A             ; sin tint
1036+ EF16 18 07            JR .urpRotateAndRet                 ; saltar ZeroAndRotate (TmpSlot/TmpRolled
1037+ EF18                                                      ; ya están set por .urpDoXxx — no resetear)
1038+ EF18
1039+ EF18              ; ==============================================================================
1040+ EF18              ; .urpRotateAndRet — al terminar UpdateRandomPickup, rotar cache y RET.
1041+ EF18              ; ==============================================================================
1042+ EF18              ; prev ← cur (data de la sala que dejamos).
1043+ EF18              ; cur  ← (newSid, RP_TmpSlot, RP_TmpRolled) (data de la sala donde estamos).
1044+ EF18              ;
1045+ EF18              ; .urpZeroAndRotate: entrada con rolled=NONE (sin spawn). Setea TmpSlot=0 y
1046+ EF18              ; TmpRolled=0 antes de rotar. NO se llega aquí desde .urpActivate (skipped).
1047+ EF18              ; ==============================================================================
1048+ EF18              .urpZeroAndRotate:
1049+ EF18 AF               XOR A
1050+ EF19 32 D4 5F         LD (RP_TmpSlot), A
1051+ EF1C 32 D5 5F         LD (RP_TmpRolled), A
1052+ EF1F              .urpRotateAndRet:
1053+ EF1F                  ; prev ← cur
1054+ EF1F 3A CE 5F         LD A, (RP_CurSid)
1054+ EF22 32 D1 5F       LD (RP_PrevSid), A
1055+ EF25 3A CF 5F         LD A, (RP_CurSlot)
1055+ EF28 32 D2 5F       LD (RP_PrevSlot), A
1056+ EF2B 3A D0 5F         LD A, (RP_CurRolled)
1056+ EF2E 32 D3 5F       LD (RP_PrevRolled), A
1057+ EF31 3A D6 5F         LD A, (RP_CurVariant)
1057+ EF34 32 D7 5F       LD (RP_PrevVariant), A
1058+ EF37                  ; cur ← (newSid, TmpSlot, TmpRolled, TmpVariant)
1059+ EF37 3A 11 83         LD A, (CurrentScreenY)
1060+ EF3A 07               RLCA
1060+ EF3B 07             RLCA
1060+ EF3C 07             RLCA
1060+ EF3D 07             RLCA           ; Y*16
1061+ EF3E 21 10 83         LD HL, CurrentScreenX
1062+ EF41 86               ADD A, (HL)                         ; A = newSid
1063+ EF42 32 CE 5F         LD (RP_CurSid), A
1064+ EF45 3A D4 5F         LD A, (RP_TmpSlot)
1064+ EF48 32 CF 5F       LD (RP_CurSlot), A
1065+ EF4B 3A D5 5F         LD A, (RP_TmpRolled)
1065+ EF4E 32 D0 5F       LD (RP_CurRolled), A
1066+ EF51 3A D8 5F         LD A, (RP_TmpVariant)
1066+ EF54 32 D6 5F       LD (RP_CurVariant), A
1067+ EF57 C9               RET
