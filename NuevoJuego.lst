 256+ 9E23              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9E23              ; ==============================================================================
 258+ 9E23              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9E23              ; Entrada:
 260+ 9E23              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9E23              ;   A = atributo a pintar
