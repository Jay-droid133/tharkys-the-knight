   1+ F9C5              ; ==============================================================================
   2+ F9C5              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F9C5              ; ==============================================================================
   4+ F9C5              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F9C5              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F9C5              ;
   7+ F9C5              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F9C5              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F9C5              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F9C5              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F9C5              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F9C5              ; ==============================================================================
  13+ F9C5
  14+ F9C5              ; ==============================================================================
  15+ F9C5              ; PlaySFX - Reproduce un efecto de sonido
  16+ F9C5              ; ==============================================================================
  17+ F9C5              ; Entrada: HL = puntero a datos del efecto
  18+ F9C5              ; Modifica: AF, BC, DE, HL
  19+ F9C5              ; ==============================================================================
  20+ F9C5              PlaySFX:
  21+ F9C5 F3               DI                          ; Sin interrupciones para audio limpio
  22+ F9C6 3A 8B 8D         LD A, (CurrentBorderColor)
  23+ F9C9 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F9CB 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F9CC
  26+ F9CC              .nextStep:
  27+ F9CC 7E               LD A, (HL)                  ; Leer duration
  28+ F9CD B7               OR A
  29+ F9CE 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F9D0
  31+ F9D0 47               LD B, A                     ; B = duration (bucle externo)
  32+ F9D1 23               INC HL
  33+ F9D2 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F9D3 23               INC HL
  35+ F9D4 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F9D5 23               INC HL
  37+ F9D6 7E               LD A, (HL)                  ; A = flags
  38+ F9D7 23               INC HL
  39+ F9D8 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F9D9 CB 47            BIT 0, A
  41+ F9DB 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F9DD
  43+ F9DD              ; --- Bucle de tono normal ---
  44+ F9DD              .toneLoop:
  45+ F9DD                  ; Semi-periodo HIGH
  46+ F9DD 7B               LD A, E
  47+ F9DE F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F9E0 D3 FE            OUT ($FE), A
  49+ F9E2 79               LD A, C                     ; A = pitch actual
  50+ F9E3              .toneDelayHi:
  51+ F9E3 3D               DEC A
  52+ F9E4 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F9E6
  54+ F9E6                  ; Semi-periodo LOW
  55+ F9E6 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F9E7 D3 FE            OUT ($FE), A
  57+ F9E9 79               LD A, C
  58+ F9EA              .toneDelayLo:
  59+ F9EA 3D               DEC A
  60+ F9EB 20 FD            JR NZ, .toneDelayLo
  61+ F9ED
  62+ F9ED                  ; Aplicar pitch sweep
  63+ F9ED 79               LD A, C
  64+ F9EE 82               ADD A, D                    ; pitch += pitchDelta
  65+ F9EF 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F9F1 FA F9 F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F9F4 4F               LD C, A
  68+ F9F5              .toneAfterClamp:
  69+ F9F5 10 E6            DJNZ .toneLoop
  70+ F9F7 18 30            JR .stepDone
  71+ F9F9
  72+ F9F9              .toneClamp:
  73+ F9F9 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F9FB 18 F8            JR .toneAfterClamp
  75+ F9FD
  76+ F9FD              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F9FD              .noiseLoop:
  78+ F9FD                  ; Semi-periodo HIGH con ruido
  79+ F9FD 7B               LD A, E
  80+ F9FE F6 10            OR $10
  81+ FA00 D3 FE            OUT ($FE), A
  82+ FA02 ED 5F            LD A, R                     ; R register como PRNG
  83+ FA04 A9               XOR C                       ; mezclar con pitch base
  84+ FA05 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ FA07 F6 01            OR $01                      ; minimo 1
  86+ FA09              .noiseDelayHi:
  87+ FA09 3D               DEC A
  88+ FA0A 20 FD            JR NZ, .noiseDelayHi
  89+ FA0C
  90+ FA0C                  ; Semi-periodo LOW
  91+ FA0C 7B               LD A, E
  92+ FA0D D3 FE            OUT ($FE), A
  93+ FA0F ED 5F            LD A, R
  94+ FA11 A9               XOR C
  95+ FA12 E6 1F            AND $1F
  96+ FA14 F6 01            OR $01
  97+ FA16              .noiseDelayLo:
  98+ FA16 3D               DEC A
  99+ FA17 20 FD            JR NZ, .noiseDelayLo
 100+ FA19
 101+ FA19                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ FA19 79               LD A, C
 103+ FA1A 82               ADD A, D
 104+ FA1B 28 08            JR Z, .noiseClamp
 105+ FA1D FA 25 FA         JP M, .noiseClamp
 106+ FA20 4F               LD C, A
 107+ FA21              .noiseAfterClamp:
 108+ FA21 10 DA            DJNZ .noiseLoop
 109+ FA23 18 04            JR .stepDone
 110+ FA25
 111+ FA25              .noiseClamp:
 112+ FA25 0E 01            LD C, 1
 113+ FA27 18 F8            JR .noiseAfterClamp
 114+ FA29
 115+ FA29              .stepDone:
 116+ FA29 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ FA2A 18 A0            JR .nextStep
 118+ FA2C
 119+ FA2C              .done:
 120+ FA2C 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ FA2D D3 FE            OUT ($FE), A
 122+ FA2F FB               EI
 123+ FA30 C9               RET
