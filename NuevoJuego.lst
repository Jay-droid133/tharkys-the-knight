5460+ C046 FE 04            CP STATE_SPAWNING
5461+ C048 28 10            JR Z, .samStateNext
5462+ C04A DD 36 0A 00      LD (IX+ENT_DIR), 0                  ; clear stun (igual que .peDoScare)
5463+ C04E DD 36 02 05      LD (IX+ENT_STATE), STATE_SCARED
5464+ C052 DD 36 06 00      LD (IX+ENT_DELTAX), 0
5465+ C056 DD 36 07 00      LD (IX+ENT_DELTAY), 0
5466+ C05A              .samStateNext:
5467+ C05A 11 10 00         LD DE, ENT_SIZE
5468+ C05D DD 19            ADD IX, DE
5469+ C05F 10 D7            DJNZ .samStateLoop
