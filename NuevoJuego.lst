 497+ E7D9              ; ---- Phase 12: walk-S con slide-out ----
 498+ E7D9              ; El slide del player continua hasta TGCS_PLAYER_BOTTOM_Y (off-screen total).
 499+ E7D9              ; Pero el cartel "The End" se dispara antes — en el momento en que el ultimo
 500+ E7D9              ; pixel de la cabeza entra detras del arco (POSY = TGCS_ARCH_PX_TOP = 120).
 501+ E7D9              ; Asi el "The End" aparece sincronizado con la desaparicion visual del player,
 502+ E7D9              ; y el slide subsecuente queda detras del arco (invisible) hasta off-screen.
 503+ E7D9              ; TownGateEndDrawn evita redibujar el sprite cada frame entre 120 y 192.
 504+ E7D9              .tgPhPlayerExit:
 505+ E7D9 CD 31 E9         CALL TownGateExitStep
 506+ E7DC DD 21 A3 81      LD IX, EntityTable
 507+ E7E0 DD 7E 04         LD A, (IX+ENT_POSY)
 508+ E7E3                  ; --- Trigger one-shot del "The End" cuando POSY cruza arch top ---
 509+ E7E3 FE 78            CP TGCS_ARCH_PX_TOP
 510+ E7E5 38 11            JR C, .tgPhExitCheckBottom          ; aun por encima del arco
 511+ E7E7 3A AA 5F         LD A, (TownGateEndDrawn)
 512+ E7EA B7               OR A
 513+ E7EB 20 0B            JR NZ, .tgPhExitCheckBottom         ; ya pintado este episodio
 514+ E7ED CD 62 E9         CALL TownGateDrawTheEnd
 515+ E7F0 CD 03 EA         CALL SFX_TownGate_OnTheEnd
 516+ E7F3 3E 01            LD A, 1
 517+ E7F5 32 AA 5F         LD (TownGateEndDrawn), A
 518+ E7F8              .tgPhExitCheckBottom:
 519+ E7F8                  ; --- El slide continua hasta que POSY alcanza el bottom off-screen ---
 520+ E7F8 3A A7 81         LD A, (EntityTable + ENT_POSY)
 521+ E7FB FE C0            CP TGCS_PLAYER_BOTTOM_Y
 522+ E7FD D8               RET C                               ; aun deslizandose
 523+ E7FE                  ; Player completamente off-screen: transicion a END_HOLD.
 524+ E7FE 3E 96            LD A, TGCS_T_END_HOLD
 525+ E800 32 A5 5F         LD (TownGateTimer), A
 526+ E803 3E 0D            LD A, TGP_END_HOLD
 527+ E805 32 D0 82         LD (TownGatePhase), A
 528+ E808 C9               RET
 529+ E809
 530+ E809              ; ---- Phase 13: "The End" hold ----
 531+ E809              .tgPhEndHold:
 532+ E809 CD 2B E8         CALL TownGateDecTimer
