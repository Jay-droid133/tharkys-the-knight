 473+ 6FE6              ; ==============================================================================
 474+ 6FE6              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
 475+ 6FE6              ; ==============================================================================
 476+ 6FE6              ; Se llama desde:
 477+ 6FE6              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
 478+ 6FE6              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
 479+ 6FE6              ;     por encima y los borro.
 480+ 6FE6              ;
 481+ 6FE6              ; Bypass total de tint swap + day/night remap → siempre brillan:
 482+ 6FE6              ;   life          = $47 (white bright, paper black)
 483+ 6FE6              ;   health_pickup = $42 (red bright,   paper black)
 484+ 6FE6              ;   stamina_pickup= $45 (cyan bright,  paper black)
 485+ 6FE6              ;
 486+ 6FE6              ; Pickup es 16x16 = 2x2 char attrs.
 487+ 6FE6              ; Early-out si RandomSynthMapX = $FE (no activo).
 488+ 6FE6              ; Destruye AF, BC, DE, HL.
 489+ 6FE6              ; ==============================================================================
 490+ 6FE6              PaintSynthPickupAttrs:
 491+ 6FE6 3A B4 5F         LD A, (RandomSynthMapX)
 492+ 6FE9 FE FE            CP $FE
 493+ 6FEB C8               RET Z                               ; no activo
 494+ 6FEC                  ; --- Attr byte: leido del sprite al activar (RandomSynthAttr en RAM) ---
 495+ 6FEC                  ; Respeta el color que el usuario puso en el BG editor. Bypass del remap
 496+ 6FEC                  ; dia/noche garantizado al escribir directo a VRAM (sin DrawBgAttrOnly).
 497+ 6FEC 3A BB 5F         LD A, (RandomSynthAttr)
 498+ 6FEF 4F               LD C, A                             ; C = attr byte
 499+ 6FF0                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
 500+ 6FF0 3A B9 5F         LD A, (RandomSynthCharY)
 501+ 6FF3 C6 02            ADD A, BG_Y_OFFSET
 502+ 6FF5 26 00            LD H, 0
 503+ 6FF7 6F               LD L, A
 504+ 6FF8 29               ADD HL, HL
 505+ 6FF9 29               ADD HL, HL
 506+ 6FFA 29               ADD HL, HL
 507+ 6FFB 29               ADD HL, HL
 508+ 6FFC 29               ADD HL, HL                          ; *32
 509+ 6FFD 3A B8 5F         LD A, (RandomSynthCharX)
 510+ 7000 85               ADD A, L
 511+ 7001 6F               LD L, A
 512+ 7002 30 01            JR NC, .pspaNoCarry
 513+ 7004 24               INC H
 514+ 7005              .pspaNoCarry:
 515+ 7005 11 00 58         LD DE, ATTR_BASE
 516+ 7008 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 517+ 7009                  ; --- Escribir 4 attrs (2x2) ---
 518+ 7009 71               LD (HL), C
 519+ 700A 23               INC HL
 520+ 700B 71               LD (HL), C                          ; fila 0
 521+ 700C 7D               LD A, L
 522+ 700D C6 1F            ADD A, 31                           ; +32 a fila siguiente, -1 (al col 0)
 523+ 700F 6F               LD L, A
 524+ 7010 30 01            JR NC, .pspaNoCarry2
 525+ 7012 24               INC H
 526+ 7013              .pspaNoCarry2:
 527+ 7013 71               LD (HL), C
 528+ 7014 23               INC HL
 529+ 7015 71               LD (HL), C                          ; fila 1
 530+ 7016 C9               RET
