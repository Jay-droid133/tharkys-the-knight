7098+ C69F              ; --- UpdateDeathTimer: tick + spawn check (llamado cada frame desde main.asm) ---
7099+ C69F              UpdateDeathTimer:
7100+ C69F                  IF DEBUG_NO_ENEMIES
7101+ C69F ~                RET
7102+ C69F                  ENDIF
7103+ C69F 3A FF 82         LD A, (DeathSpawned)
7104+ C6A2 B7               OR A
7105+ C6A3 C0               RET NZ                              ; ya spawneada: nada que hacer
7106+ C6A4                  ; Inhibida en esta sala (puerta de iglesia abierta -> cinematica de
7107+ C6A4                  ; captura corre sin interferencia). Se limpia al cambiar de sala.
7108+ C6A4 3A FE 82         LD A, (DeathInhibitInRoom)
7109+ C6A7 B7               OR A
7110+ C6A8 C0               RET NZ
7111+ C6A9                  ; Bloquear durante la secuencia de muerte del player (yellow + red border)
7112+ C6A9                  ; y el countdown 3-2-1 (PlayerRespawnPhase=1, sin control). El contador
7113+ C6A9                  ; arranca de cero al recuperar el control (urb1LastBeat).
7114+ C6A9 3A EC 82         LD A, (DeathBorderPhase)
7115+ C6AC B7               OR A
7116+ C6AD C0               RET NZ
7117+ C6AE 3A F0 82         LD A, (PlayerRespawnPhase)
7118+ C6B1 FE 01            CP 1
7119+ C6B3 C8               RET Z
7120+ C6B4                  ; Death aparece normalmente desde medianoche en adelante, en cualquier
7121+ C6B4                  ; sala. NO bloqueamos por MonstersActive — eso era confundir "monsters
7122+ C6B4                  ; activos en general" con "fase del cutscene de trampa de iglesia",
7123+ C6B4                  ; cosas distintas. Si el player esta en cutscene de iglesia su input
7124+ C6B4                  ; ya esta congelado, asi que Death no presiona ahi tampoco.
7125+ C6B4 2A FC 82         LD HL, (DeathScreenTimer)
7126+ C6B7 11 FA 00         LD DE, DEATH_SPAWN_FRAMES
7127+ C6BA E5               PUSH HL
7128+ C6BB B7               OR A
7129+ C6BC ED 52            SBC HL, DE
