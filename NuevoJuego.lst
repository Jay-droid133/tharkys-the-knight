 638+ A590                  ; === STATE_SCARED: pausa dramatica + huida ===
 639+ A590              .peScared:
 640+ A590 DD CB 0B 5E      BIT ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 641+ A594 C2 59 A6         JP NZ, .peScaredFresh
 642+ A597
 643+ A597                  ; Fase de pausa (ScareTimer > SCARE_FLEE_THRESHOLD): quieto mirando lados
 644+ A597 3A 97 B8         LD A, (ScareTimer)
 645+ A59A FE 33            CP SCARE_FLEE_THRESHOLD + 1
 646+ A59C DA 3C A6         JP C, .peScaredFlee
 647+ A59F                  ; Pausa: no moverse por DELTAX/DELTAY, alternar sprite L/R cada 8 frames,
 648+ A59F                  ; y (solo para monsters) agitar POSX/POSY ±1px aleatorio desde orig.
 649+ A59F DD 36 06 00      LD (IX+ENT_DELTAX), 0
 650+ A5A3 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 651+ A5A7                  ; Shake monster-only (nasties durante bells no se agitan)
 652+ A5A7 DD 7E 01         LD A, (IX+ENT_TYPE)
 653+ A5AA FE 02            CP TYPE_MONSTER
 654+ A5AC C2 22 A6         JP NZ, .peScaredSpriteToggle
 655+ A5AF                  ; --- Shake ---
 656+ A5AF CD 22 93         CALL MaiGetMonsterSlot              ; A = slot (0/1/2)
 657+ A5B2 5F               LD E, A
 658+ A5B3 16 00            LD D, 0
 659+ A5B5 21 53 90         LD HL, MonsterAiFlags
 660+ A5B8 19               ADD HL, DE
 661+ A5B9 7E               LD A, (HL)
 662+ A5BA CB 5F            BIT 3, A                            ; MAI_FLAG_SHAKE_SAVED
 663+ A5BC 20 15            JR NZ, .peShakeActive
 664+ A5BE                  ; Primer frame: guardar orig POSX/POSY, set flag, saltar shake
 665+ A5BE F6 08            OR MAI_FLAG_SHAKE_SAVED
 666+ A5C0 77               LD (HL), A
 667+ A5C1 21 97 5F         LD HL, MonsterShakeOrigX
 668+ A5C4 19               ADD HL, DE
 669+ A5C5 DD 7E 03         LD A, (IX+ENT_POSX)
 670+ A5C8 77               LD (HL), A
 671+ A5C9 21 9A 5F         LD HL, MonsterShakeOrigY
 672+ A5CC 19               ADD HL, DE
 673+ A5CD DD 7E 04         LD A, (IX+ENT_POSY)
 674+ A5D0 77               LD (HL), A
 675+ A5D1 18 4F            JR .peScaredSpriteToggle
 676+ A5D3              .peShakeActive:
 677+ A5D3                  ; Pick random direccion cardinal ±1px (4 valores via R & 3)
 678+ A5D3 ED 5F            LD A, R
 679+ A5D5 E6 03            AND 3
 680+ A5D7 28 0C            JR Z, .peShakeUp
 681+ A5D9 3D               DEC A
 682+ A5DA 28 0F            JR Z, .peShakeDown
 683+ A5DC 3D               DEC A
 684+ A5DD 28 12            JR Z, .peShakeLeft
 685+ A5DF                  ; 3: right
 686+ A5DF 06 01            LD B, 1
 687+ A5E1 0E 00            LD C, 0
 688+ A5E3 18 10            JR .peShakeApply
 689+ A5E5              .peShakeUp:
 690+ A5E5 06 00            LD B, 0
 691+ A5E7 0E FF            LD C, -1
 692+ A5E9 18 0A            JR .peShakeApply
 693+ A5EB              .peShakeDown:
 694+ A5EB 06 00            LD B, 0
 695+ A5ED 0E 01            LD C, 1
 696+ A5EF 18 04            JR .peShakeApply
 697+ A5F1              .peShakeLeft:
 698+ A5F1 06 FF            LD B, -1
 699+ A5F3 0E 00            LD C, 0
 700+ A5F5              .peShakeApply:
 701+ A5F5                  ; new POSX = orig + B, new POSY = orig + C
 702+ A5F5 21 97 5F         LD HL, MonsterShakeOrigX
 703+ A5F8 19               ADD HL, DE
 704+ A5F9 7E               LD A, (HL)
 705+ A5FA 80               ADD A, B
 706+ A5FB DD 77 03         LD (IX+ENT_POSX), A
 707+ A5FE 21 9A 5F         LD HL, MonsterShakeOrigY
 708+ A601 19               ADD HL, DE
 709+ A602 7E               LD A, (HL)
 710+ A603 81               ADD A, C
 711+ A604 DD 77 04         LD (IX+ENT_POSY), A
 712+ A607                  ; Collision check: si bloqueado → revertir a orig (sin shake este frame)
 713+ A607 CD 66 B9         CALL CheckEnemyCollision
 714+ A60A 28 16            JR Z, .peScaredSpriteToggle
 715+ A60C                  ; Blocked: recompute slot (CheckEnemyCollision destruye DE/HL/BC)
 716+ A60C CD 22 93         CALL MaiGetMonsterSlot
 717+ A60F 5F               LD E, A
 718+ A610 16 00            LD D, 0
 719+ A612 21 97 5F         LD HL, MonsterShakeOrigX
 720+ A615 19               ADD HL, DE
 721+ A616 7E               LD A, (HL)
 722+ A617 DD 77 03         LD (IX+ENT_POSX), A
 723+ A61A 21 9A 5F         LD HL, MonsterShakeOrigY
 724+ A61D 19               ADD HL, DE
 725+ A61E 7E               LD A, (HL)
 726+ A61F DD 77 04         LD (IX+ENT_POSY), A
