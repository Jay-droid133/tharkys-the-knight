 526+ 912E              ; ==============================================================================
 527+ 912E              DrawDebugInfo:
 528+ 912E 3A C8 81         LD A, (CurrentScreenX)
 529+ 9131 1E 00            LD E, 0
 530+ 9133 CD 50 91         CALL .drawHexDigit
 531+ 9136
 532+ 9136 3E 2C            LD A, ','
 533+ 9138 1E 01            LD E, 1
 534+ 913A CD 5C 91         CALL .drawChar
 535+ 913D
 536+ 913D 3A C9 81         LD A, (CurrentScreenY)
 537+ 9140 1E 02            LD E, 2
 538+ 9142 CD 50 91         CALL .drawHexDigit
