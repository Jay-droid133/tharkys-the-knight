 110+ 62FE              ; ==============================================================================
 111+ 62FE              ; TownGateErasePlayer - XOR-erase del sprite del player en (OLDX, OLDY)
 112+ 62FE              ; ==============================================================================
 113+ 62FE              TownGateErasePlayer:
 114+ 62FE DD 21 A3 81      LD IX, EntityTable
 115+ 6302 DD E5            PUSH IX
 116+ 6304 CD 23 A5         CALL GetOldSpriteAddr
 117+ 6307 DD 56 0D         LD D, (IX+ENT_OLDY)
 118+ 630A DD 7E 0C         LD A, (IX+ENT_OLDX)
 119+ 630D 5F               LD E, A
 120+ 630E DD 2A AB A4      LD IX, (OldSprAddr)
 121+ 6312 CD EF 99         CALL DrawSprite
 122+ 6315 DD E1            POP IX
 123+ 6317 DD 56 0D         LD D, (IX+ENT_OLDY)
 124+ 631A DD 5E 0C         LD E, (IX+ENT_OLDX)
 125+ 631D CD 5D D3         CALL RestoreOldAttr
 126+ 6320 C9               RET
 127+ 6321
 128+ 6321              ; ==============================================================================
 129+ 6321              ; TownGateAllNastiesDeadCheck - Z si todos los nasty slots son TYPE_NONE
 130+ 6321              ; ==============================================================================
 131+ 6321              TownGateAllNastiesDeadCheck:
 132+ 6321 DD 21 13 82      LD IX, EntityTable + (SLOT_NASTY0 * ENT_SIZE)
 133+ 6325 06 03            LD B, NUM_NASTIES
 134+ 6327              .tgandcLoop:
 135+ 6327 DD 7E 01         LD A, (IX+ENT_TYPE)
 136+ 632A B7               OR A
 137+ 632B C0               RET NZ                              ; algun nasty aun activo
 138+ 632C 11 10 00         LD DE, ENT_SIZE
 139+ 632F DD 19            ADD IX, DE
 140+ 6331 10 F4            DJNZ .tgandcLoop
 141+ 6333 AF               XOR A                               ; Z = todos TYPE_NONE
 142+ 6334 C9               RET
 143+ 6335
 144+ 6335              ; ==============================================================================
 145+ 6335              ; TownGatePlayerXOR_BiClip - XOR player pixels skipping rows en rect de part1
 146+ 6335              ; ==============================================================================
 147+ 6335              ; Vive aqui porque TownGatePlayerSlideErase/Draw (slot 1) la llaman tras
 148+ 6335              ; paginar bank 6. Si BiClip viviera en bank 7, las Slide* no podrian llamarla
 149+ 6335              ; sin paginar bank 7 antes — sobrecarga innecesaria.
 150+ 6335              ;
 151+ 6335              ; Las constantes TGCS_ARCH_PX_TOP / BOTTOM las define town_gate_cutscene_bank7.asm.
 152+ 6335              ; Necesitan estar disponibles aqui. Para evitar duplicate EQU error, las
 153+ 6335              ; declaramos solo en el archivo bank 7 y dejamos que sjasmplus las resuelva
 154+ 6335              ; cross-file via include order.
 155+ 6335              ;
 156+ 6335              ; IN: D = Y, E = X (aligned a 8). IY = sprite ptr CON header. Bank 6 paginado.
 157+ 6335              ; ==============================================================================
 158+ 6335              TownGatePlayerXOR_BiClip:
 159+ 6335 FD 23            INC IY
 160+ 6337 FD 23            INC IY                              ; skip header
 161+ 6339 D5               PUSH DE
 162+ 633A CD 62 9D         CALL CalcPixelAddr                  ; HL = VRAM at (D, E)
 163+ 633D D1               POP DE
 164+ 633E 06 15            LD B, PLAYER_H_PX                   ; B = row counter
 165+ 6340 4A               LD C, D                             ; C = current pixel Y
 166+ 6341              .tgpxbcRow:
 167+ 6341 79               LD A, C
 168+ 6342 FE C0            CP 192
 169+ 6344 30 16            JR NC, .tgpxbcAdvance               ; off-screen
 170+ 6346 FE 78            CP TGCS_ARCH_PX_TOP
 171+ 6348 38 06            JR C, .tgpxbcDraw                   ; arriba del arco: dibujar
 172+ 634A FE 98            CP TGCS_ARCH_PX_BOTTOM + 1
 173+ 634C 30 02            JR NC, .tgpxbcDraw                  ; abajo del arco: dibujar
 174+ 634E 18 0C            JR .tgpxbcAdvance                   ; in [120, 151] → skip
 175+ 6350              .tgpxbcDraw:
 176+ 6350 FD 7E 00         LD A, (IY+0)
 177+ 6353 AE               XOR (HL)
 178+ 6354 77               LD (HL), A
 179+ 6355 23               INC HL
 180+ 6356 FD 7E 01         LD A, (IY+1)
 181+ 6359 AE               XOR (HL)
 182+ 635A 77               LD (HL), A
 183+ 635B 2B               DEC HL
 184+ 635C              .tgpxbcAdvance:
 185+ 635C FD 23            INC IY
 186+ 635E FD 23            INC IY
 187+ 6360 0C               INC C
 188+ 6361 C5               PUSH BC
 189+ 6362 CD CE 9A         CALL NextPixelLine
 190+ 6365 C1               POP BC
 191+ 6366 10 D9            DJNZ .tgpxbcRow
 192+ 6368 C9               RET
 193+ 6369
 194+ 6369              ; ==============================================================================
 195+ 6369              ; TownGatePlayerSlideErase / SlideDraw - wrappers con paging bank 6
 196+ 6369              ; ==============================================================================
 197+ 6369              ; Paginan slot 3 a bank 6 internamente para que TownGatePlayerXOR_BiClip
 198+ 6369              ; lea los pixels del player sprite. Llamadas por el body bank 7 via
 199+ 6369              ; TownGatePlayerSlideErase_B7 / SlideDraw_B7 thunks (que solo añaden el
 200+ 6369              ; post-wrap a bank 7).
 201+ 6369              ; ==============================================================================
 202+ 6369              TownGatePlayerSlideErase:
 203+ 6369 DD 21 A3 81      LD IX, EntityTable
 204+ 636D DD E5            PUSH IX
 205+ 636F CD 23 A5         CALL GetOldSpriteAddr               ; pages bank 6, restora bank 0
 206+ 6372 DD E1            POP IX
 207+ 6374 3A 8A 8D         LD A, (CurrentPaging)
 208+ 6377 E6 F8            AND $F8
 209+ 6379 F6 06            OR 6
 210+ 637B 32 8A 8D         LD (CurrentPaging), A
 211+ 637E 01 FD 7F         LD BC, $7FFD
 212+ 6381 ED 79            OUT (C), A
 213+ 6383 FD 2A AB A4      LD IY, (OldSprAddr)
 214+ 6387 DD 56 0D         LD D, (IX+ENT_OLDY)
 215+ 638A DD 7E 0C         LD A, (IX+ENT_OLDX)
 216+ 638D 5F               LD E, A
 217+ 638E CD 35 63         CALL TownGatePlayerXOR_BiClip
 218+ 6391 3A 8A 8D         LD A, (CurrentPaging)
 219+ 6394 E6 F8            AND $F8
 220+ 6396 32 8A 8D         LD (CurrentPaging), A
 221+ 6399 01 FD 7F         LD BC, $7FFD
 222+ 639C ED 79            OUT (C), A
 223+ 639E C9               RET
 224+ 639F
 225+ 639F              TownGatePlayerSlideDraw:
 226+ 639F DD 21 A3 81      LD IX, EntityTable
 227+ 63A3 DD E5            PUSH IX
 228+ 63A5 CD F2 A4         CALL GetSpriteAddr
 229+ 63A8 DD E1            POP IX
 230+ 63AA 3A 8A 8D         LD A, (CurrentPaging)
 231+ 63AD E6 F8            AND $F8
 232+ 63AF F6 06            OR 6
 233+ 63B1 32 8A 8D         LD (CurrentPaging), A
 234+ 63B4 01 FD 7F         LD BC, $7FFD
 235+ 63B7 ED 79            OUT (C), A
 236+ 63B9 FD 2A 21 A5      LD IY, (SpriteAddrTemp)
 237+ 63BD 3A E4 82         LD A, (PlayerDrawY)
 238+ 63C0 57               LD D, A
 239+ 63C1 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 240+ 63C4 5F               LD E, A
 241+ 63C5 CD 35 63         CALL TownGatePlayerXOR_BiClip
 242+ 63C8 3A 8A 8D         LD A, (CurrentPaging)
 243+ 63CB E6 F8            AND $F8
 244+ 63CD 32 8A 8D         LD (CurrentPaging), A
 245+ 63D0 01 FD 7F         LD BC, $7FFD
 246+ 63D3 ED 79            OUT (C), A
 247+ 63D5 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 248+ 63D8 DD 77 0C         LD (IX+ENT_OLDX), A
 249+ 63DB 3A E4 82         LD A, (PlayerDrawY)
 250+ 63DE DD 77 0D         LD (IX+ENT_OLDY), A
 251+ 63E1 DD 7E 00         LD A, (IX+ENT_SPRITEID)
 252+ 63E4 DD 77 0E         LD (IX+ENT_OLDSPRID), A
 253+ 63E7 C9               RET
