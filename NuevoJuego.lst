6788+ C4F8              ; ==============================================================================
6789+ C4F8              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6790+ C4F8              ; ==============================================================================
6791+ C4F8              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6792+ C4F8              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6793+ C4F8              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6794+ C4F8              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6795+ C4F8              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6796+ C4F8              ; main.asm; aqui no hace falta guard adicional).
6797+ C4F8              ; ==============================================================================
6798+ C4F8
6799+ C4F8              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6800+ C4F8              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6801+ C4F8              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6802+ C4F8              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6803+ C4F8              ;
6804+ C4F8              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6805+ C4F8              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6806+ C4F8              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6807+ C4F8              ;
6808+ C4F8              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6809+ C4F8              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6810+ C4F8              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6811+ C4F8              ; en vez de 8 + orientacion invertida).
6812+ C4F8              UpdateDeath:
6813+ C4F8                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6814+ C4F8                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6815+ C4F8                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6816+ C4F8                  ; progreso real, no solo quedar inmovil. ---
6817+ C4F8 2A 02 83         LD HL, (DeathGhostStuckTimer)
6818+ C4FB 23               INC HL
6819+ C4FC 22 02 83         LD (DeathGhostStuckTimer), HL
6820+ C4FF 7C               LD A, H
6821+ C500 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6822+ C502 38 1A            JR C, .udGhostCheckDone
6823+ C504 20 05            JR NZ, .udGhostOn
6824+ C506 7D               LD A, L
6825+ C507 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6826+ C509 38 13            JR C, .udGhostCheckDone
6827+ C50B              .udGhostOn:
6828+ C50B                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6829+ C50B                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6830+ C50B                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6831+ C50B                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6832+ C50B                  ; re-disparar restart).
6833+ C50B 3A 04 83         LD A, (DeathGhostMode)
6834+ C50E B7               OR A
6835+ C50F 20 0D            JR NZ, .udGhostCheckDone
6836+ C511 3E 01            LD A, 1
6837+ C513 32 04 83         LD (DeathGhostMode), A
6838+ C516 32 E3 99         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6839+ C519 3E FE            LD A, $FE                       ; sentinel restart-current-track
6840+ C51B CD BD 99         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6841+ C51E              .udGhostCheckDone:
6842+ C51E
6843+ C51E                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6844+ C51E 3A 04 83         LD A, (DeathGhostMode)
6845+ C521 B7               OR A
6846+ C522 C2 69 C5         JP NZ, DeathGhostChase
6847+ C525
6848+ C525                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6849+ C525 DD 7E 03         LD A, (IX+ENT_POSX)
6850+ C528 32 FF 82         LD (DeathPrevX), A
6851+ C52B DD 7E 04         LD A, (IX+ENT_POSY)
6852+ C52E 32 00 83         LD (DeathPrevY), A
6853+ C531                  ; Sub-pixel acc 1/2
6854+ C531 3A FE 82         LD A, (DeathSubPixelAcc)
6855+ C534 EE 01            XOR 1
6856+ C536 32 FE 82         LD (DeathSubPixelAcc), A
6857+ C539 28 05            JR Z, .udSkip
6858+ C53B CD E2 AD         CALL UpdateMonster                  ; activo: chase + move + animate
6859+ C53E 18 03            JR .udPost
6860+ C540              .udSkip:
6861+ C540 CD BC C5         CALL DeathAnimate                   ; skip: solo animacion
6862+ C543              .udPost:
6863+ C543                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6864+ C543 3A FF 82         LD A, (DeathPrevX)
6865+ C546 DD BE 03         CP (IX+ENT_POSX)
6866+ C549 20 19            JR NZ, .udMoved
6867+ C54B 3A 00 83         LD A, (DeathPrevY)
6868+ C54E DD BE 04         CP (IX+ENT_POSY)
6869+ C551 20 11            JR NZ, .udMoved
6870+ C553                  ; No movio: incrementar BFS counter
6871+ C553 3A 01 83         LD A, (DeathStuckCounter)
6872+ C556 3C               INC A
6873+ C557 32 01 83         LD (DeathStuckCounter), A
6874+ C55A FE 06            CP DEATH_STUCK_THRESHOLD
6875+ C55C D8               RET C
6876+ C55D AF               XOR A
6877+ C55E 32 01 83         LD (DeathStuckCounter), A
6878+ C561 C3 28 C7         JP DeathBfsRescue
6879+ C564              .udMoved:
6880+ C564 AF               XOR A
6881+ C565 32 01 83         LD (DeathStuckCounter), A
6882+ C568 C9               RET
6883+ C569
6884+ C569              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6885+ C569              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6886+ C569              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6887+ C569              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6888+ C569              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6889+ C569              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6890+ C569              DeathGhostChase:
6891+ C569                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6892+ C569 3A A1 81         LD A, (EntityTable + ENT_POSX)
6893+ C56C DD 96 03         SUB (IX+ENT_POSX)
6894+ C56F 30 02            JR NC, .udgAbsDxOk
6895+ C571 ED 44            NEG
6896+ C573              .udgAbsDxOk:
6897+ C573 47               LD B, A                             ; B = |dx|
6898+ C574 3A A2 81         LD A, (EntityTable + ENT_POSY)
6899+ C577 DD 96 04         SUB (IX+ENT_POSY)
6900+ C57A 30 02            JR NC, .udgAbsDyOk
6901+ C57C ED 44            NEG
6902+ C57E              .udgAbsDyOk:
6903+ C57E                  ; A = |dy|, B = |dx|
6904+ C57E B8               CP B
6905+ C57F 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6906+ C581
6907+ C581                  ; --- Eje X primario ---
6908+ C581 AF               XOR A
6909+ C582 DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6910+ C585 3A A1 81         LD A, (EntityTable + ENT_POSX)
6911+ C588 DD 96 03         SUB (IX+ENT_POSX)
6912+ C58B 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6913+ C58D 3E 04            LD A, DEATH_GHOST_SPEED
6914+ C58F 30 02            JR NC, .udgXSet
6915+ C591 3E FC            LD A, -DEATH_GHOST_SPEED
6916+ C593              .udgXSet:
6917+ C593 DD 77 06         LD (IX+ENT_DELTAX), A
6918+ C596 DD 86 03         ADD A, (IX+ENT_POSX)
6919+ C599 DD 77 03         LD (IX+ENT_POSX), A
