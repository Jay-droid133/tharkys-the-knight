1154+ CFD4              ; SkipPixelData - Avanza IX pasando cabecera + pixel data (literal o RLE)
1155+ CFD4              ; ==============================================================================
1156+ CFD4              ; Entrada: IX = inicio del sprite (byte 0 = height_px, byte 1 = width_bytes|flag)
1157+ CFD4              ; Salida:  IX = primer byte tras pixel data (tintPaper)
1158+ CFD4              ; Modifica: AF, BC, DE, HL
1159+ CFD4              ; ==============================================================================
1160+ CFD4              SkipPixelData:
1161+ CFD4 DD 7E 00         LD A, (IX+0)                ; height_px
1162+ CFD7 57               LD D, A                     ; D = height_px
1163+ CFD8 DD 7E 01         LD A, (IX+1)                ; width_bytes (bit 7 = RLE flag)
1164+ CFDB 5F               LD E, A                     ; E = raw value con flag
1165+ CFDC DD 23            INC IX
1166+ CFDE DD 23            INC IX                      ; IX -> pixel data
1167+ CFE0
1168+ CFE0 CB 7B            BIT 7, E
1169+ CFE2 20 0A            JR NZ, .spSkipRle
1170+ CFE4
1171+ CFE4                  ; --- Path literal: saltar height * width bytes ---
1172+ CFE4 7B               LD A, E                     ; width_bytes (sin flag, bit7=0)
1173+ CFE5              .spLitRow:
1174+ CFE5 47               LD B, A
1175+ CFE6              .spLitCol:
1176+ CFE6 DD 23            INC IX
1177+ CFE8 10 FC            DJNZ .spLitCol
1178+ CFEA 15               DEC D
1179+ CFEB 20 F8            JR NZ, .spLitRow
1180+ CFED C9               RET
1181+ CFEE
1182+ CFEE                  ; --- Path RLE: recorrer tokens para saltar el stream ---
1183+ CFEE                  ; Total pixeles = height_px * (width_bytes & $7F)
1184+ CFEE              .spSkipRle:
1185+ CFEE 7B               LD A, E
1186+ CFEF E6 7F            AND $7F                     ; width_bytes real
1187+ CFF1                  ; Calcular total = D * A (height * width)
1188+ CFF1 42               LD B, D                     ; B = height
1189+ CFF2 21 00 00         LD HL, 0
1190+ CFF5 16 00            LD D, 0
1191+ CFF7 5F               LD E, A                     ; DE = width
