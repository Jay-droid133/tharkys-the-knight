 169+ 6AC5                  ; cambiar SP — el PUSH va al stack normal. El LD SP siguiente preserva
 170+ 6AC5                  ; ese frame; al restaurar SP el POP BC final lo recupera.
 171+ 6AC5 C5               PUSH BC
 172+ 6AC6 ED 73 55 6B      LD (.lbsSavedSP), SP            ; salva SP normal (con PC + BC pushed)
 173+ 6ACA 31 CE 6B         LD SP, PagingAltStackTop        ; SP -> stack alterno (slot 1)
 174+ 6ACD                  ; Page bank deseado inline (SIN DI)
 175+ 6ACD 3A 82 8D         LD A, (CurrentPaging)
 176+ 6AD0 E6 F8            AND $F8
 177+ 6AD2 47               LD B, A                         ; B = paging limpio sin bank
 178+ 6AD3 3A 54 6B         LD A, (.lbsBankSave)
 179+ 6AD6 E6 07            AND $07                         ; safety: solo bits 0-2
 180+ 6AD8 B0               OR B                            ; merge bank en paging
 181+ 6AD9 32 82 8D         LD (CurrentPaging), A
 182+ 6ADC 01 FD 7F         LD BC, $7FFD
 183+ 6ADF ED 79            OUT (C), A
