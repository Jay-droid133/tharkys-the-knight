  19+ 8D9B              ; MaiComputeFlowField
  20+ 8D9B              ; ==============================================================================
  21+ 8D9B              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 8D9B              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 8D9B              ; quedan en $FF).
  24+ 8D9B              ;
  25+ 8D9B              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 8D9B              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 8D9B              ;
  28+ 8D9B              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 8D9B              ; Output: FlowField relleno en bank 6
  30+ 8D9B              ; Destruye: AF, BC, DE, HL
  31+ 8D9B              ; ==============================================================================
  32+ 8D9B              MaiComputeFlowField:
  33+ 8D9B                  ; --- Celda del player en char-space (antes de cambiar stack) ---
  34+ 8D9B 3A A3 81         LD A, (EntityTable + ENT_POSX)
  35+ 8D9E 0F               RRCA
  36+ 8D9F 0F               RRCA
  37+ 8DA0 0F               RRCA
  38+ 8DA1 E6 1F            AND $1F
  39+ 8DA3 32 B6 97         LD (MaiFlowPlCx), A
