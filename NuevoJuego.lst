 370+ E55F              ; .cmcpComputeNeighbor - Calcula V dado R y side, con bounds check
 371+ E55F              ; ==============================================================================
 372+ E55F              ; IN:  B = R sid, C = side (0=N,1=S,2=W,3=E)
 373+ E55F              ; OUT: A = V sid (0..255) si valid; A = $FF si neighbor sale del mapa.
 374+ E55F              ; Destruye: AF.
 375+ E55F              ; ==============================================================================
 376+ E55F              .cmcpComputeNeighbor:
