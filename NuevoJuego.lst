 502  EEF2                  INCLUDE "milestones.asm"
# file opened: milestones.asm
   1+ EEF2              ; ==============================================================================
   2+ EEF2              ; CADENA DE HITOS (CurrentObjective + resolucion de coordenadas)
   3+ EEF2              ; ==============================================================================
   4+ EEF2              ; CurrentObjective vive en variables.asm. Valor:
   5+ EEF2              ;   0..10 = hito que el jugador esta buscando ahora mismo (1..11 humano)
   6+ EEF2              ;   11    = todos los hitos completados (juego ganado)
   7+ EEF2              ;
   8+ EEF2              ; ----------------------------------------------------------------------------
   9+ EEF2              ; MilestoneTable: 11 entradas x 2 bytes {tipo, ref} - regla de AVANCE.
  10+ EEF2              ;   tipo 1 (PICKUP)  -> ref es key id 1..7 (ver KeyLockTable). Avanza al
  11+ EEF2              ;                       recoger el sprite cuyo behavior coincide.
  12+ EEF2              ;   tipo 2 (TRIGGER) -> ref es action id (1=townhall, 2=churchdoor, 3=towngate,
  13+ EEF2              ;                       4=bankdoor). Avanza al disparar el trigger correspondiente.
  14+ EEF2              ;   tipo 3 (SPECIAL) -> ref ignorado. Solo avanza con la tecla M (debug stub).
  15+ EEF2              ;
  16+ EEF2              ; MilestoneResolveTable: 11 x 2 bytes {tipo, ref} - regla de RESOLUCION
  17+ EEF2              ; (a que pantalla apunta la brujula). Igual que MilestoneTable salvo:
  18+ EEF2              ;   - Hito 7 (SPECIAL para advance): se resuelve como TRIGGER action 2
  19+ EEF2              ;     (puerta de la iglesia), donde se "encerrara" a los monsters.
  20+ EEF2              ;   - Hito 9 (TRIGGER 4 banco): TODO añadir trigger 4 a BumpTriggerTable o
  21+ EEF2              ;     hacer special-case para resolver $FF, $FF hasta que exista.
  22+ EEF2              ;   - Hito 11 (TRIGGER 3): puerta sur, sin trigger en BumpTriggerTable
  23+ EEF2              ;     todavia -> $FF, $FF (la cinematica final tiene CheckTownGateTriggerBg
  24+ EEF2              ;     custom AABB y no esta en BumpTriggerTable).
  25+ EEF2              ;
  26+ EEF2              ; Cambio respecto a la version 9-hitos: insertados 2 hitos intermedios
  27+ EEF2              ; (#8 cheque del banco, #9 cinematica del banco) entre #7 (encerrar monsters)
  28+ EEF2              ; y los antiguos #8/#9 (que pasan a #10/#11). Ver docs/bank_cutscene.md.
  29+ EEF2              ;
  30+ EEF2              ; Tecla M (debug): incrementa CurrentObjective sin chequear tipo. Skip libre.
  31+ EEF2              ; Util para saltarse hitos durante test (incluido M#7 SPECIAL si quisieras
  32+ EEF2              ; saltarte la cinematica de captura entera, aunque ya avanza solo desde
  33+ EEF2              ; UpdatePostTrapPause.uptpKey al soltar el cheque).
  34+ EEF2              ; ==============================================================================
  35+ EEF2
  36+ EEF2              MILESTONE_TYPE_PICKUP   EQU 1
  37+ EEF2              MILESTONE_TYPE_TRIGGER  EQU 2
  38+ EEF2              MILESTONE_TYPE_SPECIAL  EQU 3
  39+ EEF2
  40+ EEF2              MilestoneTable:
  41+ EEF2 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1 llave del bosque
  42+ EEF4 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2 llave de las ruinas
  43+ EEF6 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3 llave del cementerio
  44+ EEF8 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4 llave del reloj
  45+ EEFA 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 puerta del ayuntamiento
  46+ EEFC 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 llave de la iglesia (dinamica)
  47+ EEFE 03 00            DEFB MILESTONE_TYPE_SPECIAL,  0     ; #7 encerrar monsters (avanza desde
  48+ EF00                                                      ;    UpdatePostTrapPause.uptpKey al soltar
  49+ EF00                                                      ;    el cheque, no por tecla M en runtime)
  50+ EF00 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 cheque del banco (player tiene que
  51+ EF02                                                      ;    ir a recogerlo tras drop de la
  52+ EF02                                                      ;    cinematica de la iglesia)
  53+ EF02 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: cinematica del banco
  54+ EF04 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): llave de la ciudad (dinamica)
  55+ EF06 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): puerta sur (cutscene final)
  56+ EF08
  57+ EF08              MilestoneResolveTable:
  58+ EF08 01 01            DEFB MILESTONE_TYPE_PICKUP,   1     ; #1
  59+ EF0A 01 02            DEFB MILESTONE_TYPE_PICKUP,   2     ; #2
  60+ EF0C 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  61+ EF0E 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  62+ EF10 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  63+ EF12 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  64+ EF14 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  65+ EF16 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  66+ EF18 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
  67+ EF1A 01 06            DEFB MILESTONE_TYPE_PICKUP,   6     ; #10 (was #8): bank key (dropped por cinematica del banco)
  68+ EF1C 02 03            DEFB MILESTONE_TYPE_TRIGGER,  3     ; #11 (was #9): south door (sin trigger -> $FF)
  69+ EF1E
  70+ EF1E              ; ==============================================================================
  71+ EF1E              ; CheckMilestonePickup - Avanza CurrentObjective si el pickup recogido coincide
  72+ EF1E              ; ==============================================================================
  73+ EF1E              ; IN:  A = key id (1..6) recien recogida
  74+ EF1E              ; Preserva: AF, BC, DE, HL (el caller esta en medio del bucle de pickups).
  75+ EF1E              ; ==============================================================================
  76+ EF1E              CheckMilestonePickup:
  77+ EF1E E5               PUSH HL
  78+ EF1F D5               PUSH DE
  79+ EF20 C5               PUSH BC
  80+ EF21 F5               PUSH AF
  81+ EF22 47               LD B, A                             ; B = key id recibida
  82+ EF23 3A B0 82         LD A, (CurrentObjective)
  83+ EF26 FE 0B            CP 11                               ; chain extendida a 11 hitos (era 9)
  84+ EF28 30 27            JR NC, .cmpDone                     ; sin hitos pendientes
  85+ EF2A 87               ADD A, A                            ; *2 (entry size)
  86+ EF2B 6F               LD L, A
  87+ EF2C 26 00            LD H, 0
  88+ EF2E 11 F2 EE         LD DE, MilestoneTable
  89+ EF31 19               ADD HL, DE
  90+ EF32 7E               LD A, (HL)                          ; tipo
  91+ EF33 FE 01            CP MILESTONE_TYPE_PICKUP
  92+ EF35 20 1A            JR NZ, .cmpDone
  93+ EF37 23               INC HL
  94+ EF38 7E               LD A, (HL)                          ; ref esperada
  95+ EF39 B8               CP B
  96+ EF3A 20 15            JR NZ, .cmpDone
  97+ EF3C 3A B0 82         LD A, (CurrentObjective)
  98+ EF3F 3C               INC A
  99+ EF40 32 B0 82         LD (CurrentObjective), A
 100+ EF43 CD E4 EF         CALL ResolveObjectiveScreen
 101+ EF46 3E FF            LD A, $FF
 102+ EF48 32 B3 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 103+ EF4B CD D7 6D         CALL CancelMagicCompass             ; magic compass normal: cancela al cumplir hito
 104+ EF4E CD 07 6E         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 105+ EF51              .cmpDone:
 106+ EF51 F1               POP AF
 107+ EF52 C1               POP BC
 108+ EF53 D1               POP DE
 109+ EF54 E1               POP HL
 110+ EF55 C9               RET
 111+ EF56
 112+ EF56              ; ==============================================================================
 113+ EF56              ; CheckMilestoneTrigger - Avanza CurrentObjective si el trigger coincide
 114+ EF56              ; ==============================================================================
 115+ EF56              ; IN:  A = action id (1=townhall, 2=churchdoor, ...)
 116+ EF56              ; Preserva: AF, BC, DE, HL.
 117+ EF56              ; ==============================================================================
 118+ EF56              CheckMilestoneTrigger:
 119+ EF56 E5               PUSH HL
 120+ EF57 D5               PUSH DE
 121+ EF58 C5               PUSH BC
 122+ EF59 F5               PUSH AF
 123+ EF5A 47               LD B, A
 124+ EF5B 3A B0 82         LD A, (CurrentObjective)
 125+ EF5E FE 0B            CP 11
 126+ EF60 30 27            JR NC, .cmtDone
 127+ EF62 87               ADD A, A
 128+ EF63 6F               LD L, A
 129+ EF64 26 00            LD H, 0
 130+ EF66 11 F2 EE         LD DE, MilestoneTable
 131+ EF69 19               ADD HL, DE
 132+ EF6A 7E               LD A, (HL)
 133+ EF6B FE 02            CP MILESTONE_TYPE_TRIGGER
 134+ EF6D 20 1A            JR NZ, .cmtDone
 135+ EF6F 23               INC HL
 136+ EF70 7E               LD A, (HL)
 137+ EF71 B8               CP B
 138+ EF72 20 15            JR NZ, .cmtDone
 139+ EF74 3A B0 82         LD A, (CurrentObjective)
 140+ EF77 3C               INC A
 141+ EF78 32 B0 82         LD (CurrentObjective), A
 142+ EF7B CD E4 EF         CALL ResolveObjectiveScreen
 143+ EF7E 3E FF            LD A, $FF
 144+ EF80 32 B3 82         LD (PreviousObjectiveDistance), A   ; brujula: primer cruce -> blanco
 145+ EF83 CD D7 6D         CALL CancelMagicCompass             ; magic compass normal: cancela al cumplir hito
 146+ EF86 CD 07 6E         CALL RefreshMagicCompassForNewObjective ; lasting compass: recompute path al nuevo goal
 147+ EF89              .cmtDone:
