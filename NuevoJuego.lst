 154+ F195              ; --- SFX_PlayerHit: "ouch" ascendente + snap (~80ms) ---
 155+ F195              ; Tono ascendente rapido seguido de ruido seco
 156+ F195              SFX_PlayerHit:
 157+ F195 23 28 FE 00      DEFB 35, 40, -2, 0         ; tono ascendente (grave → agudo)
 158+ F199 14 06 00 01      DEFB 20, 6, 0, 1           ; snap de ruido corto
 159+ F19D 0F 0C 01 00      DEFB 15, 12, 1, 0          ; cola tonal descendente
 160+ F1A1 00               DEFB 0                      ; fin
