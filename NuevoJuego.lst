  60+ EFFA 01 03            DEFB MILESTONE_TYPE_PICKUP,   3     ; #3
  61+ EFFC 01 04            DEFB MILESTONE_TYPE_PICKUP,   4     ; #4
  62+ EFFE 02 01            DEFB MILESTONE_TYPE_TRIGGER,  1     ; #5 town hall door
  63+ F000 01 05            DEFB MILESTONE_TYPE_PICKUP,   5     ; #6 church key (en town hall)
  64+ F002 02 02            DEFB MILESTONE_TYPE_TRIGGER,  2     ; #7 church door (apunta a la iglesia)
  65+ F004 01 07            DEFB MILESTONE_TYPE_PICKUP,   7     ; #8 NUEVO: cheque (resolverá a la iglesia tras drop)
  66+ F006 02 04            DEFB MILESTONE_TYPE_TRIGGER,  4     ; #9 NUEVO: bank trigger (sin entrada en BumpTriggerTable -> $FF)
