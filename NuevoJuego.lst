 332+ EF21              ; ==============================================================================
 333+ EF21              ; FindPickupScreen - Localiza un sprite en PickupTable y devuelve (mapX, mapY)
 334+ EF21              ; ==============================================================================
 335+ EF21              ; PickupTable layout (per-entry, 7 bytes):
 336+ EF21              ;   mapX, mapY, ptr_lo, ptr_hi, charX, charY, variant
 337+ EF21              ; Terminator: $FF (single byte).
 338+ EF21              ;
 339+ EF21              ; IN:  DE = ptr a buscar
 340+ EF21              ; OUT: B = mapX, C = mapY si encontrado (NZ).
 341+ EF21              ;      B = C = $FF si no encontrado (Z).
 342+ EF21              ; Destruye: AF, HL. Preserva DE.
 343+ EF21              ; ==============================================================================
 344+ EF21              FindPickupScreen:
 345+ EF21 21 7B DE         LD HL, PickupTable
 346+ EF24              .fpsLoop:
 347+ EF24 7E               LD A, (HL)
 348+ EF25 FE FF            CP $FF
 349+ EF27 28 1C            JR Z, .fpsNotFound
 350+ EF29 E5               PUSH HL
 351+ EF2A 23               INC HL                              ; -> mapY
 352+ EF2B 23               INC HL                              ; -> ptr_lo
 353+ EF2C 7E               LD A, (HL)
 354+ EF2D BB               CP E
 355+ EF2E 20 0C            JR NZ, .fpsNoMatch
 356+ EF30 23               INC HL                              ; -> ptr_hi
 357+ EF31 7E               LD A, (HL)
 358+ EF32 BA               CP D
 359+ EF33 20 07            JR NZ, .fpsNoMatch
 360+ EF35 E1               POP HL                              ; back to entry start (mapX)
 361+ EF36 46               LD B, (HL)                          ; B = mapX
 362+ EF37 23               INC HL
 363+ EF38 4E               LD C, (HL)                          ; C = mapY
 364+ EF39 F6 01            OR 1                                ; clear Z (NZ = encontrado)
 365+ EF3B C9               RET
 366+ EF3C              .fpsNoMatch:
 367+ EF3C E1               POP HL
 368+ EF3D C5               PUSH BC
 369+ EF3E 01 07 00         LD BC, 7
 370+ EF41 09               ADD HL, BC
 371+ EF42 C1               POP BC
 372+ EF43 18 DF            JR .fpsLoop
 373+ EF45              .fpsNotFound:
 374+ EF45 06 FF            LD B, $FF
 375+ EF47 0E FF            LD C, $FF
 376+ EF49 AF               XOR A                               ; set Z
 377+ EF4A C9               RET
 378+ EF4B
 379+ EF4B              ; ==============================================================================
 380+ EF4B              ; BRUJULA - HUD compass (16x16 px = 2 cols x 2 char rows)
 381+ EF4B              ; ==============================================================================
 382+ EF4B              ; Posicion relocatable via constantes (cambiar en un solo sitio).
 383+ EF4B              ; Ocupa COMPASS_COL..COMPASS_COL+1 en char rows COMPASS_CHARROW..+1 (top
 384+ EF4B              ; third). El brujula se redibuja solo cuando:
 385+ EF4B              ;   - cambias de pantalla (LastCompassScreen != Current)
 386+ EF4B              ;   - acabas de avanzar de hito (PreviousObjectiveDistance == $FF)
 387+ EF4B              ; En reposo es un no-op barato (solo unas comparaciones).
 388+ EF4B              ;
 389+ EF4B              ; Color (atributo de las 4 celdas):
 390+ EF4B              ;   PreviousObjectiveDistance == $FF (primer cruce)        -> BLANCO
 391+ EF4B              ;   distancia_nueva  <  distancia_anterior (te acercas)    -> VERDE
 392+ EF4B              ;   distancia_nueva  >  distancia_anterior (te alejas)     -> ROJO
 393+ EF4B              ;   distancia_nueva  == distancia_anterior (lateral)       -> BLANCO
 394+ EF4B              ;
 395+ EF4B              ; Sprite (pixel data): 9 placeholders 16x16 inline. Sustituibles luego.
 396+ EF4B              ; ==============================================================================
 397+ EF4B
 398+ EF4B              COMPASS_COL     EQU 24
 399+ EF4B              COMPASS_CHARROW EQU 0           ; char row 0 del third superior
 400+ EF4B
 401+ EF4B              ; ==============================================================================
 402+ EF4B              ; DrawCompass - Llamada cada frame; redibuja solo si hay cambio
 403+ EF4B              ; ==============================================================================
 404+ EF4B              DrawCompass:
 405+ EF4B                  ; Sin objetivo resuelto -> limpiar y salir
 406+ EF4B 3A B8 82         LD A, (ObjectiveScreenX)
 407+ EF4E FE FF            CP $FF
 408+ EF50 CA F2 F0         JP Z, ClearCompass
 409+ EF53
 410+ EF53                  ; Necesita redraw? screen cambio, PrevDist == $FF, wobble activo, o
 411+ EF53                  ; magic compass activo (que necesita redibujar para el blink y para
 412+ EF53                  ; reflejar la dir del path al cambiar de sala).
 413+ EF53 3A 08 83         LD A, (CurrentScreenX)
 414+ EF56 47               LD B, A
 415+ EF57 3A BB 82         LD A, (LastCompassScreenX)
 416+ EF5A B8               CP B
 417+ EF5B C2 81 EF         JP NZ, .dcRedrawNewScreen
 418+ EF5E 3A 09 83         LD A, (CurrentScreenY)
 419+ EF61 47               LD B, A
 420+ EF62 3A BC 82         LD A, (LastCompassScreenY)
 421+ EF65 B8               CP B
 422+ EF66 C2 81 EF         JP NZ, .dcRedrawNewScreen
 423+ EF69 3A BA 82         LD A, (PreviousObjectiveDistance)
 424+ EF6C FE FF            CP $FF
 425+ EF6E 28 16            JR Z, .dcRedraw
 426+ EF70 3A BD 82         LD A, (CompassWobbleCounter)
 427+ EF73 B7               OR A
 428+ EF74 20 10            JR NZ, .dcRedraw
 429+ EF76                  ; Modo magic compass: forzar redraw cada frame mientras esté activo
 430+ EF76                  ; (el blink + el path direction se manejan en .dcMagicCheck).
 431+ EF76 3A BF 5F         LD A, (MagicCompassTimer)
 432+ EF79 47               LD B, A
 433+ EF7A 3A C0 5F         LD A, (MagicCompassTimer + 1)
 434+ EF7D B0               OR B
 435+ EF7E C8               RET Z                               ; sin cambios + sin wobble + sin magic
 436+ EF7F 18 05            JR .dcRedraw
 437+ EF81
 438+ EF81              .dcRedrawNewScreen:
 439+ EF81                  ; Cambio de sala: el BFS del magic compass YA se recalculo
 440+ EF81                  ; sincronicamente en CheckScreenTransition.doTransition (via
 441+ EF81                  ; ForceComputeMagicCompassPath), asi que PathDir ya refleja la sala
 442+ EF81                  ; nueva. No marcamos PathDirty aqui — eso dispararia un BFS amortizado
 443+ EF81                  ; redundante que recalcularia el mismo path durante 3-4 frames.
 444+ EF81                  ;
 445+ EF81                  ; Invalidar cache del sprite dibujado: aunque el PathDir no cambio, los
 446+ EF81                  ; pixels del HUD pueden haberse pisado durante el redraw de la sala —
 447+ EF81                  ; hay que volver a dibujar el sprite minimo una vez.
 448+ EF81 3E FF            LD A, $FF
 449+ EF83 32 CB 5F         LD (LastMagicCompassDrawn), A
 450+ EF86                  ; fall through a .dcRedraw
 451+ EF86
 452+ EF86              .dcRedraw:
 453+ EF86                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 454+ EF86 3A B8 82         LD A, (ObjectiveScreenX)
 455+ EF89 47               LD B, A
 456+ EF8A 3A 08 83         LD A, (CurrentScreenX)
 457+ EF8D 4F               LD C, A
 458+ EF8E 78               LD A, B
 459+ EF8F 91               SUB C                               ; A = dx (signed)
 460+ EF90                  ; abs(dx) -> H, sign(dx)+1 -> L
 461+ EF90 F2 9A EF         JP P, .dcDxNonNeg
 462+ EF93 ED 44            NEG
 463+ EF95 67               LD H, A                             ; abs(dx)
 464+ EF96 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 465+ EF98 18 0A            JR .dcDxDone
 466+ EF9A              .dcDxNonNeg:
 467+ EF9A 67               LD H, A
 468+ EF9B B7               OR A
 469+ EF9C 20 04            JR NZ, .dcDxPositive
 470+ EF9E 2E 01            LD L, 1                             ; dx == 0
 471+ EFA0 18 02            JR .dcDxDone
 472+ EFA2              .dcDxPositive:
 473+ EFA2 2E 02            LD L, 2
 474+ EFA4              .dcDxDone:
 475+ EFA4 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
 476+ EFA5
 477+ EFA5                  ; --- dy = ObjectiveScreenY - CurrentScreenY (signed) ---
 478+ EFA5 3A B9 82         LD A, (ObjectiveScreenY)
 479+ EFA8 47               LD B, A
 480+ EFA9 3A 09 83         LD A, (CurrentScreenY)
 481+ EFAC 4F               LD C, A
 482+ EFAD 78               LD A, B
 483+ EFAE 91               SUB C
 484+ EFAF F2 B9 EF         JP P, .dcDyNonNeg
 485+ EFB2 ED 44            NEG
 486+ EFB4 67               LD H, A
 487+ EFB5 2E 00            LD L, 0
 488+ EFB7 18 0A            JR .dcDyDone
 489+ EFB9              .dcDyNonNeg:
 490+ EFB9 67               LD H, A
 491+ EFBA B7               OR A
 492+ EFBB 20 04            JR NZ, .dcDyPositive
 493+ EFBD 2E 01            LD L, 1
 494+ EFBF 18 02            JR .dcDyDone
 495+ EFC1              .dcDyPositive:
 496+ EFC1 2E 02            LD L, 2
 497+ EFC3              .dcDyDone:
 498+ EFC3                  ; HL = [abs_dy, signdy+1], stack top = [abs_dx, signdx+1]
 499+ EFC3 D1               POP DE                              ; D = abs_dx, E = signdx+1
 500+ EFC4                  ; idx = (signdy+1)*3 + (signdx+1)
 501+ EFC4 7D               LD A, L
 502+ EFC5 87               ADD A, A
 503+ EFC6 85               ADD A, L                            ; A = (signdy+1)*3
 504+ EFC7 83               ADD A, E                            ; A = idx (0..8)
 505+ EFC8 32 BF F0         LD (.dcSpriteIdx), A
 506+ EFCB                  ; distance = abs_dx + abs_dy
 507+ EFCB 7A               LD A, D
 508+ EFCC 84               ADD A, H
 509+ EFCD 32 C0 F0         LD (.dcDistance), A
 510+ EFD0
 511+ EFD0                  ; --- Wobble: oscilacion al entrar a una pantalla ---
 512+ EFD0                  ; SKIP el wobble si magic compass activa: en magic mode siempre dibujo
 513+ EFD0                  ; Sprite_Compass_Magic (no oscila); el wobble logic solo gastaría CPU
 514+ EFD0                  ; durante 9 frames post-transición sin efecto visible. Ese ahorro libera
 515+ EFD0                  ; presupuesto del frame para que las agujas del reloj HUD no parpadeen
 516+ EFD0                  ; cuando el frame de transición está apretado.
 517+ EFD0 3A BF 5F         LD A, (MagicCompassTimer)
 518+ EFD3 47               LD B, A
 519+ EFD4 3A C0 5F         LD A, (MagicCompassTimer + 1)
 520+ EFD7 B0               OR B
 521+ EFD8 28 06            JR Z, .dcWobbleStartNormal           ; magic inactivo → wobble normal
 522+ EFDA AF               XOR A
 523+ EFDB 32 BD 82         LD (CompassWobbleCounter), A         ; magic activo → fuerza counter=0, no override
 524+ EFDE 18 53            JR .dcWobbleEnd
 525+ EFE0              .dcWobbleStartNormal:
 526+ EFE0                  ; Patron (9 frames totales, 1 frame por fase, 9 fases):
 527+ EFE0                  ;   prev2 -> prev -> target -> next -> next2 -> prev -> target -> prev -> target
 528+ EFE0                  ; La X (idx 4) no vibra. Si el target cambia mid-wobble, se mantiene la
 529+ EFE0                  ; cuenta atras y los prev/next/prev2/next2 se recalculan respecto al
 530+ EFE0                  ; nuevo idx.
 531+ EFE0                  ; Counter == 0 -> sin override, idx = target.
 532+ EFE0 3A BF F0         LD A, (.dcSpriteIdx)
 533+ EFE3 FE 04            CP 4
 534+ EFE5 20 06            JR NZ, .dcWobbleNotX
 535+ EFE7                  ; X -> sin wobble. Forzar counter a 0 para que el early-exit del proximo
 536+ EFE7                  ; frame no redibuje innecesariamente.
 537+ EFE7 AF               XOR A
 538+ EFE8 32 BD 82         LD (CompassWobbleCounter), A
 539+ EFEB 18 46            JR .dcWobbleEnd
 540+ EFED              .dcWobbleNotX:
 541+ EFED                  ; Si pantalla cambio, arrancar wobble (counter = 9)
 542+ EFED 3A 08 83         LD A, (CurrentScreenX)
 543+ EFF0 47               LD B, A
 544+ EFF1 3A BB 82         LD A, (LastCompassScreenX)
 545+ EFF4 B8               CP B
 546+ EFF5 20 0A            JR NZ, .dcWobbleStart
 547+ EFF7 3A 09 83         LD A, (CurrentScreenY)
 548+ EFFA 47               LD B, A
 549+ EFFB 3A BC 82         LD A, (LastCompassScreenY)
 550+ EFFE B8               CP B
 551+ EFFF 28 05            JR Z, .dcWobbleResolve              ; misma pantalla -> usar counter actual
 552+ F001              .dcWobbleStart:
 553+ F001 3E 09            LD A, 9
 554+ F003 32 BD 82         LD (CompassWobbleCounter), A
 555+ F006              .dcWobbleResolve:
 556+ F006 3A BD 82         LD A, (CompassWobbleCounter)
 557+ F009 B7               OR A
 558+ F00A 28 27            JR Z, .dcWobbleEnd                  ; counter 0 -> idx queda como target
 559+ F00C 3D               DEC A
 560+ F00D 32 BD 82         LD (CompassWobbleCounter), A
 561+ F010                                                      ; A = phase 0..8 (1 frame por fase)
 562+ F010 21 18 F5         LD HL, WobblePhaseTable
 563+ F013 5F               LD E, A
 564+ F014 16 00            LD D, 0
 565+ F016 19               ADD HL, DE
 566+ F017 7E               LD A, (HL)                          ; 0=prev2, 1=prev, 2=target, 3=next, 4=next2
 567+ F018 FE 02            CP 2
 568+ F01A 28 17            JR Z, .dcWobbleEnd                  ; target -> no override
 569+ F01C                  ; A in {0,1,3,4}. Compactar a offset {0,1,2,3} dentro de WobbleTable
 570+ F01C                  ; (entry 4 bytes: prev2, prev, next, next2). 0,1 quedan; 3,4 -> 2,3.
 571+ F01C FE 03            CP 3
 572+ F01E 38 01            JR C, .dcWobbleOffsetReady
 573+ F020 3D               DEC A
 574+ F021              .dcWobbleOffsetReady:
 575+ F021 5F               LD E, A
 576+ F022 3A BF F0         LD A, (.dcSpriteIdx)
 577+ F025 87               ADD A, A                            ; idx*2
 578+ F026 87               ADD A, A                            ; idx*4 (stride 4 bytes por entry)
 579+ F027 83               ADD A, E                            ; +offset
 580+ F028 21 F4 F4         LD HL, CompassWobbleTable
 581+ F02B 5F               LD E, A
 582+ F02C 16 00            LD D, 0
 583+ F02E 19               ADD HL, DE
 584+ F02F 7E               LD A, (HL)
 585+ F030 32 BF F0         LD (.dcSpriteIdx), A                ; override
 586+ F033
 587+ F033              .dcWobbleEnd:
 588+ F033
 589+ F033                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 590+ F033                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 591+ F033                  ; sin bright + char activo white bright; en warning el char activo
 592+ F033                  ; parpadea bright on/off a ~6 Hz).
 593+ F033                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 594+ F033                  ; blanca se mantiene tal cual.
 595+ F033 3A BF 5F         LD A, (MagicCompassTimer)
 596+ F036 47               LD B, A
 597+ F037 3A C0 5F         LD A, (MagicCompassTimer + 1)
 598+ F03A B0               OR B
 599+ F03B 28 29            JR Z, .dcMagicOff
 600+ F03D 3A BF F0         LD A, (.dcSpriteIdx)
 601+ F040 FE 04            CP 4
 602+ F042 28 22            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 603+ F044 3A C1 5F         LD A, (MagicCompassPathDir)
 604+ F047 FE FF            CP $FF
 605+ F049 28 1B            JR Z, .dcMagicOff                   ; sin path → render normal
 606+ F04B                  ; --- MAGIC HUD ---
 607+ F04B                  ; Cache: el sprite Sprite_Compass_Magic es siempre el mismo; sólo se
 608+ F04B                  ; redibuja cuando cambia PathDir (o no estaba dibujado todavía). El
 609+ F04B                  ; resto de frames basta con repintar los 4 attrs (ultra-barato), lo que
 610+ F04B                  ; libera CPU durante el wobble post-transición y evita que las agujas
 611+ F04B                  ; del reloj queden parcialmente actualizadas en frames con poco margen.
 612+ F04B 3A C1 5F         LD A, (MagicCompassPathDir)
 613+ F04E 47               LD B, A
 614+ F04F 3A CB 5F         LD A, (LastMagicCompassDrawn)
 615+ F052 B8               CP B
 616+ F053 28 0C            JR Z, .dcMagicAttrsOnly             ; mismo path → solo attrs
 617+ F055 11 24 77         LD DE, Sprite_Compass_Magic
 618+ F058 CD C2 F0         CALL DrawCompassSprite
 619+ F05B 3A C1 5F         LD A, (MagicCompassPathDir)
 620+ F05E 32 CB 5F         LD (LastMagicCompassDrawn), A
 621+ F061              .dcMagicAttrsOnly:
 622+ F061 CD 06 74         CALL PaintMagicCompassAttrs
 623+ F064 18 40            JR .dcDrawDone
 624+ F066
 625+ F066              .dcMagicOff:
 626+ F066                  ; Saliendo del modo magic (o no entrando): invalidar cache para que el
 627+ F066                  ; próximo frame magic redibuje el sprite Sprite_Compass_Magic limpio.
 628+ F066 3E FF            LD A, $FF
 629+ F068 32 CB 5F         LD (LastMagicCompassDrawn), A
 630+ F06B
 631+ F06B                  ; --- Color normal ---
 632+ F06B                  ; idx 4 = X (estamos sobre el target) -> siempre blanco, sin comparar
 633+ F06B 3A BF F0         LD A, (.dcSpriteIdx)
 634+ F06E FE 04            CP 4
 635+ F070 28 18            JR Z, .dcWhite
 636+ F072 3A BA 82         LD A, (PreviousObjectiveDistance)
 637+ F075 FE FF            CP $FF
 638+ F077 28 11            JR Z, .dcWhite
 639+ F079 47               LD B, A
 640+ F07A 3A C0 F0         LD A, (.dcDistance)
 641+ F07D B8               CP B
 642+ F07E 28 0A            JR Z, .dcWhite                      ; igual = blanco
 643+ F080 38 04            JR C, .dcGreen                      ; nueva < prev = te acercas
 644+ F082 3E 42            LD A, RED | $40                     ; nueva > prev = te alejas
 645+ F084 18 06            JR .dcColorDone
 646+ F086              .dcGreen:
 647+ F086 3E 44            LD A, GREEN | $40
 648+ F088 18 02            JR .dcColorDone
 649+ F08A              .dcWhite:
 650+ F08A 3E 47            LD A, WHITE | $40
 651+ F08C              .dcColorDone:
 652+ F08C 32 C1 F0         LD (.dcAttr), A
 653+ F08F
 654+ F08F                  ; --- Sprite ptr de CompassSprites[idx] ---
 655+ F08F 3A BF F0         LD A, (.dcSpriteIdx)
 656+ F092 87               ADD A, A                            ; *2
 657+ F093 6F               LD L, A
 658+ F094 26 00            LD H, 0
 659+ F096 11 E2 F4         LD DE, CompassSprites
 660+ F099 19               ADD HL, DE
 661+ F09A 5E               LD E, (HL)
 662+ F09B 23               INC HL
 663+ F09C 56               LD D, (HL)                          ; DE = sprite ptr (32 bytes)
 664+ F09D CD C2 F0         CALL DrawCompassSprite
 665+ F0A0
 666+ F0A0                  ; --- Attrs ---
 667+ F0A0 3A C1 F0         LD A, (.dcAttr)
 668+ F0A3 CD E5 F0         CALL SetCompassAttrs
 669+ F0A6
 670+ F0A6              .dcDrawDone:
 671+ F0A6
 672+ F0A6                  ; --- Cachear estado ---
 673+ F0A6                  ; PreviousObjectiveDistance solo se guarda cuando el wobble termino. Si
 674+ F0A6                  ; lo guardasemos cada frame, los frames 2..N del wobble compararian la
 675+ F0A6                  ; distancia actual contra si misma -> "igual" -> blanco -> el color
 676+ F0A6                  ; (verde acercas, rojo alejas) se perderia tras el primer frame.
 677+ F0A6                  ; Asi PrevDist mantiene el valor de la pantalla anterior durante todo
 678+ F0A6                  ; el wobble y la comparacion sigue siendo correcta.
 679+ F0A6 3A BD 82         LD A, (CompassWobbleCounter)
 680+ F0A9 B7               OR A
 681+ F0AA 20 06            JR NZ, .dcSkipPrevDistSave
 682+ F0AC 3A C0 F0         LD A, (.dcDistance)
 683+ F0AF 32 BA 82         LD (PreviousObjectiveDistance), A
 684+ F0B2              .dcSkipPrevDistSave:
 685+ F0B2 3A 08 83         LD A, (CurrentScreenX)
 686+ F0B5 32 BB 82         LD (LastCompassScreenX), A
 687+ F0B8 3A 09 83         LD A, (CurrentScreenY)
 688+ F0BB 32 BC 82         LD (LastCompassScreenY), A
 689+ F0BE C9               RET
 690+ F0BF
 691+ F0BF 00           .dcSpriteIdx: DEFB 0
 692+ F0C0 00           .dcDistance:  DEFB 0
 693+ F0C1 00           .dcAttr:      DEFB 0
 694+ F0C2
 695+ F0C2              ; ==============================================================================
 696+ F0C2              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 697+ F0C2              ; ==============================================================================
 698+ F0C2              ; IN: DE = ptr a 16 filas x 2 bytes
 699+ F0C2              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 700+ F0C2              ; Destruye: AF, B, HL.
 701+ F0C2              ; ==============================================================================
 702+ F0C2              DrawCompassSprite:
 703+ F0C2                  ; Char row 0 (rows 0-7 del sprite)
 704+ F0C2 26 40            LD H, $40
 705+ F0C4 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 706+ F0C6 06 08            LD B, 8
 707+ F0C8              .dcsRow0:
 708+ F0C8 1A               LD A, (DE)
 709+ F0C9 77               LD (HL), A
 710+ F0CA 13               INC DE
 711+ F0CB 23               INC HL
 712+ F0CC 1A               LD A, (DE)
 713+ F0CD 77               LD (HL), A
 714+ F0CE 13               INC DE
 715+ F0CF 2B               DEC HL
 716+ F0D0 24               INC H
 717+ F0D1 10 F5            DJNZ .dcsRow0
 718+ F0D3                  ; Char row 1 (rows 8-15 del sprite)
 719+ F0D3 26 40            LD H, $40
 720+ F0D5 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 721+ F0D7 06 08            LD B, 8
 722+ F0D9              .dcsRow1:
 723+ F0D9 1A               LD A, (DE)
 724+ F0DA 77               LD (HL), A
 725+ F0DB 13               INC DE
 726+ F0DC 23               INC HL
 727+ F0DD 1A               LD A, (DE)
 728+ F0DE 77               LD (HL), A
 729+ F0DF 13               INC DE
 730+ F0E0 2B               DEC HL
 731+ F0E1 24               INC H
 732+ F0E2 10 F5            DJNZ .dcsRow1
 733+ F0E4 C9               RET
 734+ F0E5
 735+ F0E5              ; ==============================================================================
 736+ F0E5              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
 737+ F0E5              ; ==============================================================================
 738+ F0E5              SetCompassAttrs:
 739+ F0E5 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 740+ F0E8 77               LD (HL), A
 741+ F0E9 23               INC HL
 742+ F0EA 77               LD (HL), A
 743+ F0EB 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 744+ F0EE 77               LD (HL), A
 745+ F0EF 23               INC HL
 746+ F0F0 77               LD (HL), A
 747+ F0F1 C9               RET
 748+ F0F2
 749+ F0F2              ; ==============================================================================
 750+ F0F2              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 751+ F0F2              ; ==============================================================================
 752+ F0F2              ClearCompass:
 753+ F0F2 26 40            LD H, $40
 754+ F0F4 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 755+ F0F6 06 08            LD B, 8
 756+ F0F8 AF               XOR A
 757+ F0F9              .ccRow0:
 758+ F0F9 77               LD (HL), A
 759+ F0FA 23               INC HL
 760+ F0FB 77               LD (HL), A
 761+ F0FC 2B               DEC HL
 762+ F0FD 24               INC H
 763+ F0FE 10 F9            DJNZ .ccRow0
 764+ F100 26 40            LD H, $40
 765+ F102 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 766+ F104 06 08            LD B, 8
 767+ F106 AF               XOR A
 768+ F107              .ccRow1:
 769+ F107 77               LD (HL), A
 770+ F108 23               INC HL
 771+ F109 77               LD (HL), A
 772+ F10A 2B               DEC HL
 773+ F10B 24               INC H
 774+ F10C 10 F9            DJNZ .ccRow1
 775+ F10E AF               XOR A                               ; attr 0 (negro/negro, invisible)
 776+ F10F 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 777+ F112 77               LD (HL), A
 778+ F113 23               INC HL
 779+ F114 77               LD (HL), A
 780+ F115 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 781+ F118 77               LD (HL), A
 782+ F119 23               INC HL
 783+ F11A 77               LD (HL), A
 784+ F11B C9               RET
 785+ F11C
 786+ F11C              ; ==============================================================================
 787+ F11C              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 788+ F11C              ; ==============================================================================
 789+ F11C              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 790+ F11C              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 791+ F11C              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 792+ F11C              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 793+ F11C              ; monstruo cae alli con la puerta abierta:
 794+ F11C              ;   - Bit slot en MonsterTrappedFlags
 795+ F11C              ;   - Despawn del monstruo (puff)
 796+ F11C              ;   - Puerta se re-cierra (sprite + flag)
 797+ F11C              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 798+ F11C              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 799+ F11C              ;
 800+ F11C              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 801+ F11C              ; auto-generadas por el level editor segun la posicion de la puerta y los
 802+ F11C              ; markers AltKey1/AltKey2.
 803+ F11C              ; ==============================================================================
 804+ F11C
 805+ F11C              ; ==============================================================================
 806+ F11C              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 807+ F11C              ; ==============================================================================
 808+ F11C              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 809+ F11C              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 810+ F11C              ; Destruye: AF, BC.
 811+ F11C              ; ==============================================================================
 812+ F11C              CheckChurchTrap:
 813+ F11C                  ; --- Solo en pantalla de la iglesia ---
 814+ F11C 3A 08 83         LD A, (CurrentScreenX)
 815+ F11F FE 0F            CP CHURCH_TRAP_SCREEN_X
 816+ F121 20 5D            JR NZ, .cctNoTrap
 817+ F123 3A 09 83         LD A, (CurrentScreenY)
 818+ F126 FE 06            CP CHURCH_TRAP_SCREEN_Y
 819+ F128 20 56            JR NZ, .cctNoTrap
 820+ F12A                  ; --- Solo con la puerta abierta ---
 821+ F12A 3A B1 82         LD A, (ChurchDoorOpen)
 822+ F12D B7               OR A
 823+ F12E 28 50            JR Z, .cctNoTrap
 824+ F130                  ; --- Solo si el knockback es DIRECTO del player ---
 825+ F130                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 826+ F130                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 827+ F130                  ; espada y se clear cuando se hereda kb por colision.
 828+ F130 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 829+ F134 28 4A            JR Z, .cctNoTrap
 830+ F136                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 831+ F136                  ; (acepta sprites de 16, 21 o 24 px de alto)
 832+ F136 DD 7E 04         LD A, (IX+ENT_POSY)
 833+ F139 CB 3F            SRL A
 834+ F13B CB 3F            SRL A
 835+ F13D CB 3F            SRL A                                   ; A = top charY del monster
 836+ F13F 47               LD B, A
 837+ F140 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 838+ F142 90               SUB B                                   ; A = trap_charY - mon_charY
 839+ F143 FE 03            CP 3
 840+ F145 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 841+ F147                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 842+ F147 DD 7E 03         LD A, (IX+ENT_POSX)
 843+ F14A CB 3F            SRL A
 844+ F14C CB 3F            SRL A
 845+ F14E CB 3F            SRL A
 846+ F150 47               LD B, A                                 ; B = left charX del monster
 847+ F151 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 848+ F153 3C               INC A                                   ; A = LO_X + 1
 849+ F154 90               SUB B                                   ; A = LO_X+1 - charX
 850+ F155 FE 03            CP 3
 851+ F157 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 852+ F159                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 853+ F159                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 854+ F159 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 855+ F15C D6 4C            SUB SPRID_MONSTER_0
 856+ F15E CB 3F            SRL A
 857+ F160 CB 3F            SRL A
 858+ F162 CB 3F            SRL A                                   ; A = type idx 0..2
 859+ F164 47               LD B, A
 860+ F165                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 861+ F165 3A BF 82         LD A, (NextChurchTrapStep)
 862+ F168 FE 03            CP 3
 863+ F16A 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 864+ F16C 21 82 F1         LD HL, ChurchTrapOrderTable
 865+ F16F 5F               LD E, A
 866+ F170 16 00            LD D, 0
 867+ F172 19               ADD HL, DE
 868+ F173 7E               LD A, (HL)                              ; A = type esperado
 869+ F174 B8               CP B
 870+ F175 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 871+ F177                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 872+ F177 CD 1A F2         CALL TriggerChurchTrap
 873+ F17A 3E 01            LD A, 1
 874+ F17C C9               RET
 875+ F17D              .cctBlockAsWall:
 876+ F17D                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 877+ F17D                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 878+ F17D 3E 02            LD A, 2
 879+ F17F C9               RET
 880+ F180              .cctNoTrap:
 881+ F180 AF               XOR A
 882+ F181 C9               RET
 883+ F182
 884+ F182              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 885+ F182              ChurchTrapOrderTable:
 886+ F182 00 02 01         DEFB 0, 2, 1
 887+ F185
 888+ F185              ; ==============================================================================
 889+ F185              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 890+ F185              ; blanco brillante sobre paper negro ($47).
 891+ F185              ; ==============================================================================
 892+ F185              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 893+ F185              ; - No-op fuera de la sala de la iglesia.
 894+ F185              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 895+ F185              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 896+ F185              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 897+ F185              ;   aun no toca) conservan sus attrs originales del sprite.
 898+ F185              ; Destruye: AF, BC, DE, HL.
 899+ F185              ; ==============================================================================
 900+ F185              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 901+ F185              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 902+ F185              HighlightExpectedStatue:
 903+ F185 3E 47            LD A, $47
 904+ F187 18 00            JR PaintExpectedStatueAttr
 905+ F189
 906+ F189              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 907+ F189              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 908+ F189              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 909+ F189              PaintExpectedStatueAttr:
 910+ F189 32 F3 F1         LD (.hesAttr), A
 911+ F18C                  ; --- Solo en la sala de la iglesia ---
 912+ F18C 3A 08 83         LD A, (CurrentScreenX)
 913+ F18F FE 0F            CP CHURCH_TRAP_SCREEN_X
 914+ F191 C0               RET NZ
 915+ F192 3A 09 83         LD A, (CurrentScreenY)
 916+ F195 FE 06            CP CHURCH_TRAP_SCREEN_Y
 917+ F197 C0               RET NZ
 918+ F198                  ; --- Solo tras abrir la iglesia 1a vez ---
 919+ F198                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 920+ F198                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 921+ F198                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 922+ F198                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 923+ F198                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 924+ F198 3A B2 82         LD A, (ChurchEverOpened)
 925+ F19B B7               OR A
 926+ F19C C8               RET Z
 927+ F19D                  ; --- Solo si quedan monstruos por atrapar ---
 928+ F19D 3A BF 82         LD A, (NextChurchTrapStep)
 929+ F1A0 FE 03            CP 3
 930+ F1A2 D0               RET NC
 931+ F1A3                  ; --- Type esperado -> statue id ---
 932+ F1A3 21 82 F1         LD HL, ChurchTrapOrderTable
 933+ F1A6 5F               LD E, A
 934+ F1A7 16 00            LD D, 0
 935+ F1A9 19               ADD HL, DE
 936+ F1AA 7E               LD A, (HL)                              ; type idx esperado
 937+ F1AB 21 A9 67         LD HL, StatueIdTable
 938+ F1AE 5F               LD E, A
 939+ F1AF 16 00            LD D, 0
 940+ F1B1 19               ADD HL, DE
 941+ F1B2 7E               LD A, (HL)                              ; A = statue id
 942+ F1B3 B7               OR A
 943+ F1B4 C8               RET Z
 944+ F1B5 32 F4 F1         LD (.hesTargetId), A
 945+ F1B8                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 946+ F1B8 2A 0A 83         LD HL, (CurrentScreenAddr)
 947+ F1BB              .hesLoop:
 948+ F1BB 7E               LD A, (HL)
 949+ F1BC FE FF            CP $FF
 950+ F1BE C8               RET Z                                   ; estatua no en esta sala
 951+ F1BF 47               LD B, A
 952+ F1C0 3A F4 F1         LD A, (.hesTargetId)
 953+ F1C3 B8               CP B
 954+ F1C4 28 06            JR Z, .hesFound
 955+ F1C6 11 04 00         LD DE, 4
 956+ F1C9 19               ADD HL, DE
 957+ F1CA 18 EF            JR .hesLoop
 958+ F1CC              .hesFound:
 959+ F1CC 23               INC HL
 960+ F1CD 7E               LD A, (HL)                              ; charX
 961+ F1CE 47               LD B, A
 962+ F1CF 23               INC HL
 963+ F1D0 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 964+ F1D1 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 965+ F1D3 4F               LD C, A                                 ; C = charY (post-HUD)
 966+ F1D4                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 967+ F1D4 26 00            LD H, 0
 968+ F1D6 69               LD L, C
 969+ F1D7 29               ADD HL, HL
 970+ F1D8 29               ADD HL, HL
 971+ F1D9 29               ADD HL, HL
 972+ F1DA 29               ADD HL, HL
 973+ F1DB 29               ADD HL, HL                              ; HL = charY * 32
 974+ F1DC 58               LD E, B
 975+ F1DD 16 00            LD D, 0
 976+ F1DF 19               ADD HL, DE                              ; + charX
 977+ F1E0 11 00 58         LD DE, $5800
 978+ F1E3 19               ADD HL, DE                              ; HL = attr addr top-left
 979+ F1E4                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 980+ F1E4                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 981+ F1E4                  ; no hace falta sincronizar CleanAttrMap.
 982+ F1E4 3A F3 F1         LD A, (.hesAttr)
 983+ F1E7 06 03            LD B, 3                                 ; 3 filas de chars
 984+ F1E9              .hesRow:
 985+ F1E9 77               LD (HL), A
 986+ F1EA 23               INC HL
 987+ F1EB 77               LD (HL), A                              ; (charX+1)
 988+ F1EC 11 1F 00         LD DE, 31
 989+ F1EF 19               ADD HL, DE                              ; siguiente fila col 0
 990+ F1F0 10 F7            DJNZ .hesRow
 991+ F1F2 C9               RET
 992+ F1F3 00           .hesAttr:     DEFB 0
 993+ F1F4 00           .hesTargetId: DEFB 0
 994+ F1F5
 995+ F1F5              ; ==============================================================================
 996+ F1F5              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 997+ F1F5              ; ==============================================================================
 998+ F1F5              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 999+ F1F5              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
1000+ F1F5              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
1001+ F1F5              ; + ON final settle): 8 ciclos de ON-OFF en total.
1002+ F1F5              ; ==============================================================================
1003+ F1F5              STATUE_BLINK_FRAMES   EQU 32
1004+ F1F5
1005+ F1F5              StartStatueBlink:
1006+ F1F5                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
1007+ F1F5                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
1008+ F1F5                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
1009+ F1F5                  ; (caso A), .cbtActChurchDoor (caso B).
1010+ F1F5 3E 20            LD A, STATUE_BLINK_FRAMES
1011+ F1F7 32 C0 82         LD (StatueBlinkCounter), A
1012+ F1FA C3 85 F1         JP HighlightExpectedStatue              ; initial ON paint
1013+ F1FD
1014+ F1FD              UpdateStatueBlink:
1015+ F1FD                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
1016+ F1FD 3A C0 82         LD A, (StatueBlinkCounter)
1017+ F200 B7               OR A
1018+ F201 C8               RET Z
1019+ F202 3D               DEC A
1020+ F203 32 C0 82         LD (StatueBlinkCounter), A
1021+ F206 20 03            JR NZ, .usbInProgress
1022+ F208                  ; Counter recien llego a 0: settle ON
1023+ F208 C3 85 F1         JP HighlightExpectedStatue
1024+ F20B              .usbInProgress:
1025+ F20B                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
1026+ F20B                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
1027+ F20B CB 3F            SRL A
1028+ F20D E6 01            AND $01
1029+ F20F 28 05            JR Z, .usbOff
1030+ F211 3E 47            LD A, $47
1031+ F213 C3 89 F1         JP PaintExpectedStatueAttr
1032+ F216              .usbOff:
1033+ F216 AF               XOR A
1034+ F217 C3 89 F1         JP PaintExpectedStatueAttr
1035+ F21A
1036+ F21A              ; ==============================================================================
1037+ F21A              ; CUTSCENE - parametros ajustables
1038+ F21A              ; ==============================================================================
1039+ F21A              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
1040+ F21A              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
1041+ F21A              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
1042+ F21A              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
1043+ F21A
1044+ F21A              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
1045+ F21A              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
1046+ F21A              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
1047+ F21A
1048+ F21A              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1049+ F21A              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1050+ F21A              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1051+ F21A              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1052+ F21A              ;   tick 12 -> erase smoke[2], pasar a DONE
1053+ F21A              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1054+ F21A              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1055+ F21A
1056+ F21A              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1057+ F21A              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1058+ F21A              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1059+ F21A              ; centrado dentro del vano de la puerta.
1060+ F21A              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1061+ F21A              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1062+ F21A              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1063+ F21A              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1064+ F21A
1065+ F21A              ; ==============================================================================
1066+ F21A              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1067+ F21A              ; ==============================================================================
1068+ F21A              ; IN: IX = monster atrapado.
1069+ F21A              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1070+ F21A              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1071+ F21A              ; en ApplyChurchTrapEffects al final del cutscene.
1072+ F21A              ; ==============================================================================
1073+ F21A              TriggerChurchTrap:
1074+ F21A                  ; --- 1. Calcular slot 0..2 ---
1075+ F21A DD E5            PUSH IX
1076+ F21C E1               POP HL
1077+ F21D 11 AB 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1078+ F220 B7               OR A
1079+ F221 ED 52            SBC HL, DE
1080+ F223 CB 3D            SRL L
1081+ F225 CB 3D            SRL L
1082+ F227 CB 3D            SRL L
1083+ F229 CB 3D            SRL L                                   ; L = slot 0..2
1084+ F22B 7D               LD A, L
1085+ F22C 32 9E 5F         LD (ChurchCutsceneSlot), A
1086+ F22F                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1087+ F22F DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1088+ F232 D6 4C            SUB SPRID_MONSTER_0
1089+ F234 CB 3F            SRL A
1090+ F236 CB 3F            SRL A
1091+ F238 CB 3F            SRL A                                   ; A = type idx
1092+ F23A 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1093+ F23D                  ; --- 2. Mover monster al centro del vano ---
1094+ F23D 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1095+ F23F DD 77 03         LD (IX+ENT_POSX), A
1096+ F242 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1097+ F244 DD 77 04         LD (IX+ENT_POSY), A
1098+ F247 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1099+ F24B DD 36 07 00      LD (IX+ENT_DELTAY), 0
1100+ F24F DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1101+ F253                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1102+ F253                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1103+ F253                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1104+ F253                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1105+ F253                  ; temblor se vea con ink blanco brillante sobre paper negro.
1106+ F253 AF               XOR A
1107+ F254 32 C0 82         LD (StatueBlinkCounter), A              ; parar blink
1108+ F257 DD E5            PUSH IX
1109+ F259 CD 85 F1         CALL HighlightExpectedStatue            ; pintar $47
1110+ F25C                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1111+ F25C                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1112+ F25C                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1113+ F25C                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1114+ F25C CD B5 BA         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1115+ F25F 3E FF            LD A, $FF
1116+ F261 CD BA 99         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1117+ F264 DD E1            POP IX
1118+ F266                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1119+ F266 3E 01            LD A, 1
1120+ F268 32 C6 82         LD (ChurchCutscenePhase), A
1121+ F26B AF               XOR A
1122+ F26C 32 9D 5F         LD (ChurchCutsceneFrame), A
1123+ F26F 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1124+ F271 32 A4 5F         LD (ChurchCutsceneLookCount), A
1125+ F274 C9               RET
1126+ F275
1127+ F275              ; ==============================================================================
1128+ F275              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1129+ F275              ; ==============================================================================
1130+ F275              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1131+ F275              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1132+ F275              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1133+ F275              ; ==============================================================================
1134+ F275              UpdateChurchCutscene:
1135+ F275 3A C6 82         LD A, (ChurchCutscenePhase)
1136+ F278 B7               OR A
1137+ F279 C8               RET Z
1138+ F27A 3D               DEC A
1139+ F27B 28 12            JR Z, .ucsLookPhase
1140+ F27D 3D               DEC A
1141+ F27E 28 38            JR Z, .ucsShakeStatuePhase
1142+ F280 3D               DEC A
1143+ F281 CA 0A F3         JP Z, .ucsSmokePhase
1144+ F284                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1145+ F284 CD 05 67         CALL ApplyChurchTrapDone
1146+ F287 AF               XOR A
1147+ F288 32 C6 82         LD (ChurchCutscenePhase), A
1148+ F28B 32 9D 5F         LD (ChurchCutsceneFrame), A
1149+ F28E C9               RET
1150+ F28F
1151+ F28F              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1152+ F28F              .ucsLookPhase:
1153+ F28F                  ; Frame counter (para detectar fin de fase)
1154+ F28F 21 9D 5F         LD HL, ChurchCutsceneFrame
1155+ F292 34               INC (HL)
1156+ F293                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1157+ F293 21 A4 5F         LD HL, ChurchCutsceneLookCount
1158+ F296 35               DEC (HL)
1159+ F297 20 06            JR NZ, .ucsLookCheckEnd
1160+ F299 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1161+ F29B 77               LD (HL), A
1162+ F29C CD 58 F3         CALL ChurchCutsceneToggleMonsterDir
1163+ F29F              .ucsLookCheckEnd:
1164+ F29F 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1165+ F2A2 FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1166+ F2A4 D8               RET C                                   ; sigue mirando
1167+ F2A5                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1168+ F2A5                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1169+ F2A5                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1170+ F2A5 CD E1 66         CALL EraseChurchTrappedMonster
1171+ F2A8 CD 9F 69         CALL CloseChurchDoor
1172+ F2AB CD 7D F3         CALL ChurchCutsceneInitStatueShake
1173+ F2AE 3E 02            LD A, 2
1174+ F2B0 32 C6 82         LD (ChurchCutscenePhase), A
1175+ F2B3 AF               XOR A
1176+ F2B4 32 9D 5F         LD (ChurchCutsceneFrame), A
1177+ F2B7 C9               RET
1178+ F2B8
1179+ F2B8              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1180+ F2B8              .ucsShakeStatuePhase:
1181+ F2B8 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1182+ F2BB FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1183+ F2BD 30 35            JR NC, .ucsShakeStatueDone
1184+ F2BF                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1185+ F2BF                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1186+ F2BF                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1187+ F2BF                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1188+ F2BF                  ;
1189+ F2BF                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1190+ F2BF                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1191+ F2BF ED 5F            LD A, R
1192+ F2C1 E6 03            AND $03
1193+ F2C3 21 F0 F2         LD HL, .ucsShakeJitterTable
1194+ F2C6 5F               LD E, A
1195+ F2C7 16 00            LD D, 0
1196+ F2C9 19               ADD HL, DE
1197+ F2CA 7E               LD A, (HL)
1198+ F2CB 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1199+ F2CC                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1200+ F2CC 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1201+ F2CF FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1202+ F2D1 21 A9 67         LD HL, StatueIdTable
1203+ F2D4 38 03            JR C, .ucsShakeTablePicked
1204+ F2D6 21 AC 67         LD HL, StatueBrokenIdTable
1205+ F2D9              .ucsShakeTablePicked:
1206+ F2D9 78               LD A, B                                 ; restore jitter para la llamada
1207+ F2DA CD E7 F3         CALL ChurchCutsceneShakeStatueByteShift
1208+ F2DD                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1209+ F2DD                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1210+ F2DD                  ; y al salir de la fase forzamos borde a negro explicitamente.
1211+ F2DD 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1212+ F2E0 E6 01            AND $01
1213+ F2E2 28 04            JR Z, .ucsShakeBorderBlack
1214+ F2E4 3E 07            LD A, WHITE
1215+ F2E6 18 01            JR .ucsShakeBorderOut
1216+ F2E8              .ucsShakeBorderBlack:
1217+ F2E8 AF               XOR A                                   ; BLACK
1218+ F2E9              .ucsShakeBorderOut:
1219+ F2E9 D3 FE            OUT (254), A
1220+ F2EB 21 9D 5F         LD HL, ChurchCutsceneFrame
1221+ F2EE 34               INC (HL)
1222+ F2EF C9               RET
1223+ F2F0              .ucsShakeJitterTable:
1224+ F2F0 00 FF 00 01      DEFB 0, $FF, 0, 1                       ; map(R&3) -> jitter (0=no, FF=-1, 1=+1)
1225+ F2F4              .ucsShakeStatueDone:
1226+ F2F4                  ; Restaurar borde a negro tras el flicker antes de cualquier SFX.
1227+ F2F4 AF               XOR A
1228+ F2F5 D3 FE            OUT (254), A
1229+ F2F7                  ; Erase final via direct write (todo a 0) + SFX + transicion a SMOKE.
1230+ F2F7                  ; (No XOR: el ultimo frame del shake dejo pixels arbitrarios; un erase
1231+ F2F7                  ; directo a 0 garantiza que no queden residuos.)
1232+ F2F7 CD 52 F4         CALL ChurchCutsceneEraseStatueDirect
1233+ F2FA 21 C0 F6         LD HL, SFX_EnemyDeath
1234+ F2FD CD 41 F6         CALL PlaySFX
1235+ F300 3E 03            LD A, 3
1236+ F302 32 C6 82         LD (ChurchCutscenePhase), A
1237+ F305 AF               XOR A
1238+ F306 32 9D 5F         LD (ChurchCutsceneFrame), A             ; reset para SMOKE
1239+ F309 C9               RET
1240+ F30A
1241+ F30A              ; ---- Phase 3: humo desvaneciendose sobre los restos ----
1242+ F30A              ; Tick 0 (entry): dibujar restos del monster + smoke[0] (XOR).
1243+ F30A              ; Tick 8 / 16: erase smoke prev + draw smoke next (XOR de ambos).
1244+ F30A              ; Tick 24: erase smoke[2], pasar a fase 4 (DONE).
1245+ F30A              ; Entre transiciones, solo incrementa frame counter.
1246+ F30A              .ucsSmokePhase:
1247+ F30A 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1248+ F30D B7               OR A
1249+ F30E 28 0E            JR Z, .ucsSmokeEntry
1250+ F310 FE 02            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME              ; tick 4
1251+ F312 28 16            JR Z, .ucsSmokeStep1
1252+ F314 FE 04            CP CHURCH_CUTSCENE_SMOKE_PER_FRAME * 2          ; tick 8
1253+ F316 28 1D            JR Z, .ucsSmokeStep2
1254+ F318 FE 0C            CP CHURCH_CUTSCENE_SMOKE_TOTAL                  ; tick 12
1255+ F31A 28 25            JR Z, .ucsSmokeEnd
1256+ F31C 18 35            JR .ucsSmokeIncFrame
1257+ F31E              .ucsSmokeEntry:
1258+ F31E                  ; Dibujar restos en la base de la estatua (permanecen tras la cutscene)
1259+ F31E 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1260+ F321 CD D4 68         CALL DrawRemainsForType
1261+ F324                  ; Dibujar smoke[0] (XOR)
1262+ F324 AF               XOR A
1263+ F325 CD 1F 68         CALL DrawSmokeFrameXor
1264+ F328 18 29            JR .ucsSmokeIncFrame
1265+ F32A              .ucsSmokeStep1:
1266+ F32A AF               XOR A
1267+ F32B CD 1F 68         CALL DrawSmokeFrameXor                  ; erase smoke[0]
1268+ F32E 3E 01            LD A, 1
1269+ F330 CD 1F 68         CALL DrawSmokeFrameXor                  ; draw smoke[1]
1270+ F333 18 1E            JR .ucsSmokeIncFrame
1271+ F335              .ucsSmokeStep2:
1272+ F335 3E 01            LD A, 1
1273+ F337 CD 1F 68         CALL DrawSmokeFrameXor                  ; erase smoke[1]
1274+ F33A 3E 02            LD A, 2
1275+ F33C CD 1F 68         CALL DrawSmokeFrameXor                  ; draw smoke[2]
1276+ F33F 18 12            JR .ucsSmokeIncFrame
1277+ F341              .ucsSmokeEnd:
1278+ F341 3E 02            LD A, 2
1279+ F343 CD 1F 68         CALL DrawSmokeFrameXor                  ; erase smoke[2]
1280+ F346 CD 3E 68         CALL ClearSmokeAttrs                    ; 2x2 chars -> paper/ink black
1281+ F349 3E 04            LD A, 4
1282+ F34B 32 C6 82         LD (ChurchCutscenePhase), A
1283+ F34E AF               XOR A
1284+ F34F 32 9D 5F         LD (ChurchCutsceneFrame), A
1285+ F352 C9               RET
1286+ F353              .ucsSmokeIncFrame:
1287+ F353 21 9D 5F         LD HL, ChurchCutsceneFrame
1288+ F356 34               INC (HL)
1289+ F357 C9               RET
1290+ F358
1291+ F358              ; ==============================================================================
1292+ F358              ; ChurchCutsceneToggleMonsterDir - alterna sprite del monster L <-> R
1293+ F358              ; ==============================================================================
1294+ F358              ; ENT_SPRITEID alterna entre ANIMBASE+0 (frente derecha frame 0) y
1295+ F358              ; ANIMBASE+4 (frente izquierda frame 0). Tras cambiar, redibuja.
1296+ F358              ; ==============================================================================
1297+ F358              ChurchCutsceneToggleMonsterDir:
1298+ F358                  ; IX = trapped monster
1299+ F358 3A 9E 5F         LD A, (ChurchCutsceneSlot)
1300+ F35B 3C               INC A
1301+ F35C 6F               LD L, A
1302+ F35D 26 00            LD H, 0
1303+ F35F 29               ADD HL, HL
1304+ F360 29               ADD HL, HL
1305+ F361 29               ADD HL, HL
1306+ F362 29               ADD HL, HL
1307+ F363 11 9B 81         LD DE, EntityTable
1308+ F366 19               ADD HL, DE
1309+ F367 E5               PUSH HL
1310+ F368 DD E1            POP IX
1311+ F36A                  ; Toggle SPRITEID entre +0 y +4 respecto a ANIMBASE
1312+ F36A DD 7E 00         LD A, (IX+ENT_SPRITEID)
1313+ F36D DD 96 08         SUB (IX+ENT_ANIMBASE)
1314+ F370 EE 04            XOR 4
1315+ F372 47               LD B, A
1316+ F373 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1317+ F376 80               ADD A, B
1318+ F377 DD 77 00         LD (IX+ENT_SPRITEID), A
1319+ F37A C3 6C F4         JP RedrawTrappedMonster
1320+ F37D
1321+ F37D              ; ==============================================================================
1322+ F37D              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1323+ F37D              ; ==============================================================================
1324+ F37D              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1325+ F37D              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1326+ F37D              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1327+ F37D              ; ==============================================================================
1328+ F37D              ChurchCutsceneInitStatueShake:
1329+ F37D 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1330+ F380 21 A9 67         LD HL, StatueIdTable
1331+ F383 5F               LD E, A
1332+ F384 16 00            LD D, 0
1333+ F386 19               ADD HL, DE
1334+ F387 7E               LD A, (HL)                              ; A = statue id
1335+ F388 B7               OR A
1336+ F389 C8               RET Z                                   ; sin estatua
1337+ F38A 32 BA F3         LD (.cisTargetId), A
1338+ F38D                  ; Buscar en CurrentScreenBuffer
1339+ F38D 2A 0A 83         LD HL, (CurrentScreenAddr)
1340+ F390              .cisLoop:
1341+ F390 7E               LD A, (HL)
1342+ F391 FE FF            CP $FF
1343+ F393 C8               RET Z                                   ; no encontrada (no se hace shake)
1344+ F394 47               LD B, A
1345+ F395 3A BA F3         LD A, (.cisTargetId)
1346+ F398 B8               CP B
1347+ F399 28 06            JR Z, .cisFound
1348+ F39B 11 04 00         LD DE, 4
1349+ F39E 19               ADD HL, DE
1350+ F39F 18 EF            JR .cisLoop
1351+ F3A1              .cisFound:
1352+ F3A1 23               INC HL
1353+ F3A2 7E               LD A, (HL)                              ; charX
1354+ F3A3                  ; Pixel X = charX * 8
1355+ F3A3 87               ADD A, A
1356+ F3A4 87               ADD A, A
1357+ F3A5 87               ADD A, A
1358+ F3A6 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1359+ F3A9 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1360+ F3AC 23               INC HL
1361+ F3AD 7E               LD A, (HL)                              ; charY
1362+ F3AE                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1363+ F3AE C6 02            ADD A, BG_Y_OFFSET
1364+ F3B0 87               ADD A, A
1365+ F3B1 87               ADD A, A
1366+ F3B2 87               ADD A, A
