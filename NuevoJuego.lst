 401+ 7046 4F               LD C, A                             ; C = cached slot
 402+ 7047 3A AB 5F         LD A, (RandomSlotCount)
 403+ 704A B9               CP C
 404+ 704B 28 10            JR Z, .urpCacheMiss                 ; slot >= count: invalid → fresh
 405+ 704D 38 0E            JR C, .urpCacheMiss
