1639+ F615              ; ==============================================================================
1640+ F615              ; RedrawTrappedMonster - erase old + draw new tras cambiar POSX/POSY
1641+ F615              ; ==============================================================================
1642+ F615              ; Replica el flujo basico de ProcessOneEnemy.peCalcAndDraw sin AI ni attr
1643+ F615              ; handling (el shake es +/-AMP px en torno a centro fijo; attrs no cambian
1644+ F615              ; suficiente para corromper visualmente).
1645+ F615              ; IN: IX = entity ptr.
1646+ F615              ; ==============================================================================
1647+ F615              RedrawTrappedMonster:
1648+ F615                  ; --- Erase viejo en (OLDX, OLDY) ---
1649+ F615 CD ED A4         CALL GetOldSpriteAddr                   ; OldSprAddr setado
1650+ F618 DD 7E 0D         LD A, (IX+ENT_OLDY)
1651+ F61B 57               LD D, A
1652+ F61C DD 7E 0C         LD A, (IX+ENT_OLDX)
1653+ F61F 5F               LD E, A
1654+ F620 DD E5            PUSH IX
1655+ F622 DD 2A 75 A4      LD IX, (OldSprAddr)
1656+ F626 CD E0 99         CALL DrawSprite
1657+ F629 DD E1            POP IX
1658+ F62B                  ; --- Restaurar attrs del fondo en pos vieja desde CleanAttrMap ---
1659+ F62B                  ; (Igual que .peCalcAndDraw del flujo normal de gameplay.)
1660+ F62B DD 56 0D         LD D, (IX+ENT_OLDY)
1661+ F62E DD 5E 0C         LD E, (IX+ENT_OLDX)
1662+ F631 CD 15 D3         CALL RestoreOldAttr
1663+ F634                  ; --- Repintar attrs de pickups sobre el area (puerta abierta etc.) ---
1664+ F634                  ; En gameplay normal RefreshPickupAttrs corre tras ProcessEnemies para
1665+ F634                  ; reponer attrs de pickups que el flujo de entidades pisa con
1666+ F634                  ; CleanAttrMap (que no incluye pickups). Aqui lo necesitamos por la
1667+ F634                  ; misma razon: la puerta abierta es un pickup y sus celdas pueden
1668+ F634                  ; estar bajo el monster.
1669+ F634 DD E5            PUSH IX
1670+ F636 CD 1F DA         CALL RefreshPickupAttrs
1671+ F639 DD E1            POP IX
1672+ F63B                  ; --- Compute new draw pos ---
1673+ F63B CD 77 A4         CALL CalcDrawX
1674+ F63E CD 0F 9F         CALL ComputeEnemyDrawY
1675+ F641                  ; --- Pintar attr nuevo ANTES del sprite (evita flash con color BG) ---
1676+ F641 CD BC A4         CALL GetSpriteAddr                      ; SpriteAddrTemp setado
1677+ F644 3A D6 82         LD A, (EnemyDrawY)
1678+ F647 57               LD D, A
1679+ F648 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1680+ F64B 5F               LD E, A
1681+ F64C DD E5            PUSH IX
1682+ F64E DD 2A EB A4      LD IX, (SpriteAddrTemp)
1683+ F652 CD FD 9A         CALL CalcEntityAttrSize
1684+ F655 DD E1            POP IX
1685+ F657 3A D6 82         LD A, (EnemyDrawY)
1686+ F65A 57               LD D, A
1687+ F65B DD 7E 0F         LD A, (IX+ENT_DRAWX)
1688+ F65E 5F               LD E, A
1689+ F65F DD 7E 05         LD A, (IX+ENT_ATTR)
1690+ F662 CD D0 9A         CALL SetEntityAttr
1691+ F665                  ; --- Draw nuevo en (DRAWX, EnemyDrawY) ---
1692+ F665 3A D6 82         LD A, (EnemyDrawY)
1693+ F668 57               LD D, A
1694+ F669 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1695+ F66C 5F               LD E, A
1696+ F66D DD E5            PUSH IX
1697+ F66F DD 2A EB A4      LD IX, (SpriteAddrTemp)
1698+ F673 CD E0 99         CALL DrawSprite
1699+ F676 DD E1            POP IX
1700+ F678                  ; --- Save OLD = current ---
1701+ F678 DD 7E 0F         LD A, (IX+ENT_DRAWX)
1702+ F67B DD 77 0C         LD (IX+ENT_OLDX), A
1703+ F67E 3A D6 82         LD A, (EnemyDrawY)
1704+ F681 DD 77 0D         LD (IX+ENT_OLDY), A
1705+ F684 DD 7E 00         LD A, (IX+ENT_SPRITEID)
1706+ F687 DD 77 0E         LD (IX+ENT_OLDSPRID), A
1707+ F68A C9               RET
