1821+ F81B
1822+ F81B              ; ==============================================================================
1823+ F81B              ; DrawCompassGapHint - Pinta sprite-flecha 24x24 en el gap por donde el player
1824+ F81B              ;                     debe salir (magic compass activa).
1825+ F81B              ; ==============================================================================
1826+ F81B              ; PathDir mapea a sprite id: 0(N)=78, 1(S)=79, 2(W)=76, 3(E)=77.
1827+ F81B              ; PathCoord: char col (N/S) o char row (W/E) del gap concreto elegido por la BFS.
1828+ F81B              ; Render: XOR sobre BG (DrawBgSpriteXOR). Cachea ultimo dibujo en HintLast*
1829+ F81B              ; para re-dibujar solo cuando cambia (path, sala). En sala distinta no borra
1830+ F81B              ; el viejo porque DrawScreen ya repinta BG limpio.
1831+ F81B              ;
1832+ F81B              ; Llamada cada frame desde MainLoop tras DrawCompass.
1833+ F81B              ; Vive en bank 2 (slot fijo, sin paging). Coste: ~100 B asm + 4 B RAM.
1834+ F81B              ; ==============================================================================
1835+ F81B              DrawCompassGapHint:
1836+ F81B                  ; Magic compass activa + path resuelto + tick visible? Si falta cualquiera,
1837+ F81B                  ; ocultar el sprite. El cache HintLastDir=$FF que deja .dcghHide hace que
1838+ F81B                  ; cuando TickActiveFrames vuelva a >0 el path mismatch dispare .dcghDraw,
1839+ F81B                  ; produciendo el parpadeo sincronizado con el tic AY.
1840+ F81B 2A BF 5F         LD HL, (MagicCompassTimer)
1841+ F81E 7C               LD A, H
1842+ F81F B5               OR L
1843+ F820 28 7B            JR Z, .dcghHide
1844+ F822 3A C1 5F         LD A, (MagicCompassPathDir)
1845+ F825 3C               INC A                               ; A=0 si era $FF
1846+ F826 28 75            JR Z, .dcghHide
1847+ F828 3A C4 5F         LD A, (MagicCompassTickActiveFrames)
1848+ F82B B7               OR A
1849+ F82C 28 6F            JR Z, .dcghHide
1850+ F82E
1851+ F82E                  ; --- Cache check: dibujar solo si (dir, coord, sx, sy) cambio ---
1852+ F82E 21 51 F9         LD HL, HintLastDir
1853+ F831 7E               LD A, (HL)
1854+ F832 47               LD B, A
1855+ F833 3A C1 5F         LD A, (MagicCompassPathDir)
1856+ F836 B8               CP B
1857+ F837 20 1A            JR NZ, .dcghDraw
1858+ F839 23               INC HL
1859+ F83A 7E               LD A, (HL)
1860+ F83B 47               LD B, A
1861+ F83C 3A C2 5F         LD A, (MagicCompassPathCoord)
1862+ F83F B8               CP B
1863+ F840 20 11            JR NZ, .dcghDraw
1864+ F842 23               INC HL
1865+ F843 7E               LD A, (HL)
1866+ F844 47               LD B, A
1867+ F845 3A 0A 83         LD A, (CurrentScreenX)
1868+ F848 B8               CP B
1869+ F849 20 08            JR NZ, .dcghDraw
1870+ F84B 23               INC HL
1871+ F84C 7E               LD A, (HL)
1872+ F84D 47               LD B, A
1873+ F84E 3A 0B 83         LD A, (CurrentScreenY)
1874+ F851 B8               CP B
1875+ F852 C8               RET Z                               ; sin cambio -> nada que hacer
1876+ F853
1877+ F853              .dcghDraw:
1878+ F853                  ; Erase old si misma sala (para no dejar arrows huerfanos al cambiar path
1879+ F853                  ; dentro de una sala, p.ej. tras un avance de hito mid-room).
1880+ F853 3A 51 F9         LD A, (HintLastDir)
1881+ F856 FE FF            CP $FF
1882+ F858 28 1F            JR Z, .dcghDrawNew
1883+ F85A 3A 53 F9         LD A, (HintLastScreenX)
1884+ F85D 47               LD B, A
1885+ F85E 3A 0A 83         LD A, (CurrentScreenX)
1886+ F861 B8               CP B
1887+ F862 20 15            JR NZ, .dcghDrawNew                 ; diferente sala -> BG ya limpio
1888+ F864 3A 54 F9         LD A, (HintLastScreenY)
1889+ F867 47               LD B, A
1890+ F868 3A 0B 83         LD A, (CurrentScreenY)
1891+ F86B B8               CP B
1892+ F86C 20 0B            JR NZ, .dcghDrawNew
1893+ F86E 3A 51 F9         LD A, (HintLastDir)
1894+ F871 47               LD B, A
1895+ F872 3A 52 F9         LD A, (HintLastCoord)
1896+ F875 4F               LD C, A
1897+ F876 CD F4 F8         CALL EraseHintAtPos                 ; XOR + restore attrs (B=dir, C=coord)
1898+ F879              .dcghDrawNew:
1899+ F879 3A C1 5F         LD A, (MagicCompassPathDir)
1900+ F87C 47               LD B, A
1901+ F87D 3A C2 5F         LD A, (MagicCompassPathCoord)
1902+ F880 4F               LD C, A
1903+ F881 CD E7 F8         CALL DrawHintAtPos
1904+ F884                  ; Update cache
1905+ F884 3A C1 5F         LD A, (MagicCompassPathDir)
1906+ F887 32 51 F9         LD (HintLastDir), A
1907+ F88A 3A C2 5F         LD A, (MagicCompassPathCoord)
1908+ F88D 32 52 F9         LD (HintLastCoord), A
1909+ F890 3A 0A 83         LD A, (CurrentScreenX)
1910+ F893 32 53 F9         LD (HintLastScreenX), A
1911+ F896 3A 0B 83         LD A, (CurrentScreenY)
1912+ F899 32 54 F9         LD (HintLastScreenY), A
1913+ F89C C9               RET
1914+ F89D
1915+ F89D              .dcghHide:
1916+ F89D                  ; Compass inactiva: borrar hint si estaba dibujado en esta sala
1917+ F89D 3A 51 F9         LD A, (HintLastDir)
1918+ F8A0 FE FF            CP $FF
1919+ F8A2 C8               RET Z
1920+ F8A3 3A 53 F9         LD A, (HintLastScreenX)
1921+ F8A6 47               LD B, A
1922+ F8A7 3A 0A 83         LD A, (CurrentScreenX)
1923+ F8AA B8               CP B
1924+ F8AB 20 15            JR NZ, .dcghHideInvalidate
1925+ F8AD 3A 54 F9         LD A, (HintLastScreenY)
1926+ F8B0 47               LD B, A
1927+ F8B1 3A 0B 83         LD A, (CurrentScreenY)
1928+ F8B4 B8               CP B
1929+ F8B5 20 0B            JR NZ, .dcghHideInvalidate
1930+ F8B7 3A 51 F9         LD A, (HintLastDir)
1931+ F8BA 47               LD B, A
1932+ F8BB 3A 52 F9         LD A, (HintLastCoord)
1933+ F8BE 4F               LD C, A
1934+ F8BF CD F4 F8         CALL EraseHintAtPos                 ; XOR + restore attrs
1935+ F8C2              .dcghHideInvalidate:
1936+ F8C2 3E FF            LD A, $FF
1937+ F8C4 32 51 F9         LD (HintLastDir), A
1938+ F8C7 C9               RET
1939+ F8C8
1940+ F8C8              ; ==============================================================================
1941+ F8C8              ; ComputeHintPos - (B=dir, C=coord) -> (B=charX, C=charY)
1942+ F8C8              ; ==============================================================================
1943+ F8C8              ; Sprite 16x16 = 2x2 chars. Gaps N/S = 4 chars wide -> sprite centrado:
1944+ F8C8              ; start col = coord + 1 (1 char margen cada lado). Gaps W/E = 3 o 5 chars
1945+ F8C8              ; tall -> sprite (2 char) cabe con 0.5 o 1.5 margin; usamos coord+0.
1946+ F8C8              ;
1947+ F8C8              ; charY se devuelve en BG-coords (0-21) porque DrawBgSpriteXOR y
1948+ F8C8              ; RestorePickupAttrs anaden BG_Y_OFFSET=2 internamente. Pasar VRAM-coords
1949+ F8C8              ; (e.g. 22 para fila inferior) provoca off-screen write -> corrupcion de
1950+ F8C8              ; la zona de atributos ($5800+).
1951+ F8C8              ; Destruye: A.
1952+ F8C8              ; ==============================================================================
1953+ F8C8              ComputeHintPos:
1954+ F8C8 78               LD A, B
1955+ F8C9 B7               OR A
1956+ F8CA 28 0A            JR Z, .chpNorth                     ; 0 = N
1957+ F8CC 3D               DEC A
1958+ F8CD 28 0B            JR Z, .chpSouth                     ; 1 = S
1959+ F8CF 3D               DEC A
1960+ F8D0 28 0C            JR Z, .chpWest                      ; 2 = W
1961+ F8D2                  ; Fall-through: 3 = E
1962+ F8D2 06 1D            LD B, 29                            ; charX = 29 (1 col separacion del wall E)
1963+ F8D4 18 0A            JR .chpVertShift                    ; ajustar charY si gap inferior
1964+ F8D6              .chpNorth:
1965+ F8D6 41               LD B, C                             ; charX = coord
1966+ F8D7 0E 01            LD C, 1                             ; charY BG = 1 -> VRAM row 3 (1 char bajo top)
1967+ F8D9 C9               RET
1968+ F8DA              .chpSouth:
1969+ F8DA 41               LD B, C
1970+ F8DB 0E 13            LD C, 19                            ; charY BG = 19 -> VRAM rows 21-22 (1 char sobre bottom)
1971+ F8DD C9               RET
1972+ F8DE              .chpWest:
1973+ F8DE 06 01            LD B, 1                             ; charX = 1 (1 col separacion del wall W)
1974+ F8E0                  ; fall-through a .chpVertShift
1975+ F8E0              .chpVertShift:
1976+ F8E0                  ; Para W/E inferior (coord >= 7) bajar 1 char (queda mas centrado en
1977+ F8E0                  ; el gap de 5 chars de alto). W/E superior (coord < 7) usa sprite 2x3
1978+ F8E0                  ; que rellena gap de 3 chars exacto -> charY = coord directo.
1979+ F8E0 79               LD A, C
1980+ F8E1 FE 07            CP 7
1981+ F8E3 D8               RET C                               ; coord < 7: gap superior, charY = coord
1982+ F8E4 3C               INC A                               ; gap inferior: charY = coord + 1
1983+ F8E5 4F               LD C, A
1984+ F8E6 C9               RET
1985+ F8E7
1986+ F8E7              ; ==============================================================================
1987+ F8E7              ; DrawHintAtPos - Load sprite + XOR-draw flecha en (B=dir, C=coord)
1988+ F8E7              ; ==============================================================================
1989+ F8E7              ; IN:  B = PathDir (0=N, 1=S, 2=W, 3=E)
1990+ F8E7              ;      C = PathCoord (char col para N/S, char row para W/E)
1991+ F8E7              ; Destruye: AF, BC, DE, HL, IX.
1992+ F8E7              ; ==============================================================================
1993+ F8E7              DrawHintAtPos:
1994+ F8E7 CD 11 F9         CALL LoadHintSprite                 ; HL = ptr cargado a BgSpriteBuffer; preserva BC
1995+ F8EA CD C8 F8         CALL ComputeHintPos                 ; B=charX, C=charY
1996+ F8ED DD 21 F7 86      LD IX, BgSpriteBuffer
1997+ F8F1 C3 07 DC         JP DrawBgSpriteXOR                  ; tail call
1998+ F8F4
1999+ F8F4              ; ==============================================================================
2000+ F8F4              ; EraseHintAtPos - XOR-erase + restore attrs en (B=dir, C=coord)
2001+ F8F4              ; ==============================================================================
2002+ F8F4              ; Llamado al cambiar de path/sala/cancel. Mismo XOR-draw que erase los pixels,
2003+ F8F4              ; mas RestorePickupAttrs para limpiar las attrs (de lo contrario quedan
2004+ F8F4              ; cuadrados verdes huerfanos en pantalla).
2005+ F8F4              ; ==============================================================================
2006+ F8F4              EraseHintAtPos:
2007+ F8F4 CD 11 F9         CALL LoadHintSprite                 ; HL=ptr; BgSpriteBuffer poblado
2008+ F8F7 CD C8 F8         CALL ComputeHintPos                 ; B=charX, C=charY
2009+ F8FA C5               PUSH BC                             ; save charX, charY for RestorePickupAttrs
2010+ F8FB DD 21 F7 86      LD IX, BgSpriteBuffer
2011+ F8FF CD 07 DC         CALL DrawBgSpriteXOR                ; XOR-erase pixels
2012+ F902 C1               POP BC
2013+ F903                  ; height_chars depende del sprite (2 para 16x16, 3 para 16x24).
2014+ F903                  ; Leer del header: BgSpriteBuffer[0] = height_px; /8 = char rows.
2015+ F903 3A F7 86         LD A, (BgSpriteBuffer)
2016+ F906 0F               RRCA
2016+ F907 0F             RRCA
2016+ F908 0F             RRCA                  ; /8
2017+ F909 E6 1F            AND $1F
2018+ F90B 57               LD D, A                             ; height_chars
2019+ F90C 1E 02            LD E, 2                             ; width_chars (siempre 2 para flechas)
2020+ F90E C3 9D DC         JP RestorePickupAttrs               ; tail call: restaura attrs desde CleanAttrMap
2021+ F911
2022+ F911              ; ==============================================================================
2023+ F911              ; LoadHintSprite - HL=ptr cargado a BgSpriteBuffer segun (dir B, coord C)
2024+ F911              ; ==============================================================================
2025+ F911              ; IN:  B = PathDir, C = PathCoord
2026+ F911              ; OUT: BgSpriteBuffer poblado con sprite
2027+ F911              ; Destruye: AF, DE, HL. Preserva BC.
2028+ F911              ;
2029+ F911              ; Para N/S y W/E inferior usa los 2x2 (id 42/49/80/82). Para W/E SUPERIOR
2030+ F911              ; (gap de 3 chars de alto en config dual) usa los 2x3 (id 81/83), que
2031+ F911              ; rellenan el gap mejor. Heuristica: coord < 7 = superior.
2032+ F911              ; ==============================================================================
2033+ F911              LoadHintSprite:
2034+ F911 78               LD A, B
2035+ F912 FE 02            CP 2                                ; W?
2036+ F914 28 12            JR Z, .lhsW
2037+ F916 FE 03            CP 3                                ; E?
2038+ F918 28 1D            JR Z, .lhsE
2039+ F91A                  ; N o S -> tabla base
2040+ F91A 87               ADD A, A                            ; *2
2041+ F91B 5F               LD E, A
2042+ F91C 16 00            LD D, 0
2043+ F91E 21 49 F9         LD HL, HintArrowPtrs
2044+ F921 19               ADD HL, DE
2045+ F922 5E               LD E, (HL)
2046+ F923 23               INC HL
2047+ F924 56               LD D, (HL)
2048+ F925 EB               EX DE, HL                           ; HL = sprite ptr
2049+ F926 18 1C            JR .lhsLoad
2050+ F928              .lhsW:
2051+ F928 79               LD A, C
2052+ F929 FE 07            CP 7
2053+ F92B 30 05            JR NC, .lhsWBase                    ; coord >= 7: gap inferior, usa 2x2
2054+ F92D 21 7C F4         LD HL, BgGfx_arrow_2x3_west         ; gap superior: 2x3
