   1+ 99E3              ; ==============================================================================
   2+ 99E3              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 99E3              ; ==============================================================================
   4+ 99E3              ; Sistema fiel a Sabre Wulf:
   5+ 99E3              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 99E3              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 99E3              ; - NextPixelLine para cruzar character rows y tercios
   8+ 99E3              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 99E3              ; ==============================================================================
  10+ 99E3
  11+ 99E3              ClearScreen:
  12+ 99E3 CD AF 0D         CALL ROM_CLS
  13+ 99E6 C9               RET
  14+ 99E7
  15+ 99E7              ; ==============================================================================
  16+ 99E7              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 99E7              ; ==============================================================================
  18+ 99E7              ; Entrada:
  19+ 99E7              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 99E7              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 99E7              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 99E7              ;
  23+ 99E7              ; Formato del sprite:
  24+ 99E7              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 99E7              ;   DEFB height_pixels
  26+ 99E7              ;   DEFB pixel_data... (width * height bytes)
  27+ 99E7              ;
  28+ 99E7              ; Dos paths:
  29+ 99E7              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 99E7              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 99E7              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 99E7              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 99E7              ;
  34+ 99E7              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 99E7              ;
  36+ 99E7              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 99E7              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 99E7              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 99E7              ; alto la restauracion del bank.
  40+ 99E7              ; ==============================================================================
  41+ 99E7              DrawSprite:
  42+ 99E7                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 99E7                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 99E7                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 99E7 3A 82 8D         LD A, (CurrentPaging)
  46+ 99EA E6 F8            AND $F8
  47+ 99EC F6 06            OR 6
  48+ 99EE 32 82 8D         LD (CurrentPaging), A
  49+ 99F1 01 FD 7F         LD BC, $7FFD
  50+ 99F4 ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 99F6 CD 07 9A         CALL _DrawSpriteImpl
  52+ 99F9                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 99F9                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 99F9 3A 82 8D         LD A, (CurrentPaging)
  55+ 99FC E6 F8            AND $F8
  56+ 99FE 32 82 8D         LD (CurrentPaging), A
  57+ 9A01 01 FD 7F         LD BC, $7FFD
  58+ 9A04 ED 79            OUT (C), A
  59+ 9A06 C9               RET
  60+ 9A07
  61+ 9A07              _DrawSpriteImpl:
  62+ 9A07                  ; Guardar posicion
  63+ 9A07 7A               LD A, D
  64+ 9A08 32 C1 9A         LD (.posY), A
  65+ 9A0B 7B               LD A, E
  66+ 9A0C 32 C0 9A         LD (.posX), A
  67+ 9A0F
  68+ 9A0F                  ; Leer cabecera sprite
  69+ 9A0F DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9A12 32 C2 9A         LD (.widthSave), A
  71+ 9A15 DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9A18 32 C3 9A         LD (.heightSave), A
  73+ 9A1B DD 23            INC IX
  74+ 9A1D DD 23            INC IX                      ; IX → pixel data
  75+ 9A1F
  76+ 9A1F                  ; === Y CLIPPING ===
  77+ 9A1F                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9A1F 3A C1 9A         LD A, (.posY)
  79+ 9A22 FE 10            CP SCREEN_MIN_Y
  80+ 9A24 30 20            JR NC, .clipTopDone
  81+ 9A26                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9A26 47               LD B, A                     ; B = Y
  83+ 9A27 3E 10            LD A, SCREEN_MIN_Y
  84+ 9A29 90               SUB B                       ; A = filas a saltar
  85+ 9A2A 47               LD B, A                     ; B = skip rows
  86+ 9A2B                  ; Reducir altura
  87+ 9A2B 3A C3 9A         LD A, (.heightSave)
  88+ 9A2E 90               SUB B
  89+ 9A2F C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9A30 D8               RET C                       ; Idem
  91+ 9A31 32 C3 9A         LD (.heightSave), A
  92+ 9A34                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9A34 3A C2 9A         LD A, (.widthSave)
  94+ 9A37 4F               LD C, A
  95+ 9A38              .clipSkipRow:
  96+ 9A38 79               LD A, C
  97+ 9A39              .clipSkipByte:
  98+ 9A39 DD 23            INC IX
  99+ 9A3B 3D               DEC A
 100+ 9A3C 20 FB            JR NZ, .clipSkipByte
 101+ 9A3E 10 F8            DJNZ .clipSkipRow
 102+ 9A40                  ; Ajustar Y al borde
 103+ 9A40 3E 10            LD A, SCREEN_MIN_Y
 104+ 9A42 32 C1 9A         LD (.posY), A
 105+ 9A45 57               LD D, A
 106+ 9A46              .clipTopDone:
 107+ 9A46                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9A46 3A C1 9A         LD A, (.posY)
 109+ 9A49 47               LD B, A
 110+ 9A4A 3A C3 9A         LD A, (.heightSave)
 111+ 9A4D 80               ADD A, B                    ; A = Y + height
 112+ 9A4E 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9A50 FE C0            CP 192
 114+ 9A52 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9A54              .clipBot:
 116+ 9A54                  ; Reducir altura: new_height = 192 - Y
 117+ 9A54 3E C0            LD A, 192
 118+ 9A56 90               SUB B                       ; A = 192 - Y
 119+ 9A57 C8               RET Z
 120+ 9A58 D8               RET C
 121+ 9A59 32 C3 9A         LD (.heightSave), A
 122+ 9A5C              .clipBotDone:
 123+ 9A5C
 124+ 9A5C                  ; Comprobar alineacion
 125+ 9A5C 7B               LD A, E
 126+ 9A5D E6 07            AND 7
 127+ 9A5F 20 1E            JR NZ, .shifted
 128+ 9A61
 129+ 9A61                  ; ==================================================================
 130+ 9A61                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9A61                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9A61                  ; ==================================================================
 133+ 9A61 CD 5A 9D         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9A64 DD E5            PUSH IX
 135+ 9A66 D1               POP DE                      ; DE = puntero a pixel data
 136+ 9A67 3A C3 9A         LD A, (.heightSave)
 137+ 9A6A 4F               LD C, A                     ; C = height counter
 138+ 9A6B
 139+ 9A6B              .alignedLine:
 140+ 9A6B 3A C2 9A         LD A, (.widthSave)
 141+ 9A6E 47               LD B, A                     ; B = ancho en bytes
 142+ 9A6F E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 143+ 9A70
 144+ 9A70              .alignedByte:
 145+ 9A70 1A               LD A, (DE)                  ; 7T (era IX+0 = 19T)
 146+ 9A71 AE               XOR (HL)
 147+ 9A72 77               LD (HL), A
 148+ 9A73 23               INC HL                      ; Siguiente columna VRAM
 149+ 9A74 13               INC DE                      ; 6T (era INC IX = 10T)
 150+ 9A75 10 F9            DJNZ .alignedByte
 151+ 9A77
 152+ 9A77 E1               POP HL                      ; Restaurar inicio de linea
 153+ 9A78 0D               DEC C
 154+ 9A79 C8               RET Z                       ; Terminamos todas las lineas
 155+ 9A7A CD C6 9A         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 156+ 9A7D 18 EC            JR .alignedLine
 157+ 9A7F
 158+ 9A7F                  ; ==================================================================
 159+ 9A7F                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 160+ 9A7F                  ; ==================================================================
 161+ 9A7F                  ; A = shift amount (1-7) al llegar aqui
 162+ 9A7F              .shifted:
 163+ 9A7F                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 164+ 9A7F 3D               DEC A                       ; 0-6
 165+ 9A80 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 166+ 9A81 E6 0E            AND $0E
 167+ 9A83 C6 E9            ADD A, SHIFT_TABLE_BASE     ; Base de tablas (ADD permite ALIGN 256)
 168+ 9A85 32 C4 9A         LD (.tablePage), A
 169+ 9A88
 170+ 9A88                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 171+ 9A88 DD E5            PUSH IX
 172+ 9A8A D1               POP DE                      ; DE = puntero a pixel data
 173+ 9A8B D5               PUSH DE                     ; Guardar sprite data ptr en stack
 174+ 9A8C
 175+ 9A8C                  ; Recargar D=Y, E=X para CalcPixelAddr
 176+ 9A8C 3A C1 9A         LD A, (.posY)
 177+ 9A8F 57               LD D, A
 178+ 9A90 3A C0 9A         LD A, (.posX)
