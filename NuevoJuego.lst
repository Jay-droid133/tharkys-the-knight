 286+ E537 20 0E            JR NZ, .ncOn
 287+ E539 3E 20            LD A, 32                    ; espacio (limpia cuando off)
 288+ E53B 1E 1E            LD E, 30
 289+ E53D CD 68 E7         CALL DrawHudChar
 290+ E540 3E 20            LD A, 32
 291+ E542 1E 1F            LD E, 31
 292+ E544 C3 68 E7         JP DrawHudChar
 293+ E547              .ncOn:
 294+ E547 3E 4E            LD A, 'N'
 295+ E549 1E 1E            LD E, 30
 296+ E54B CD 68 E7         CALL DrawHudChar
