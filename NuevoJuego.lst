 124+ EAD3              ; UpdateGameClock
 125+ EAD3              ; ==============================================================================
 126+ EAD3              UpdateGameClock:
 127+ EAD3 3A B6 82         LD A, (TimeFrozen)
 128+ EAD6 B7               OR A
 129+ EAD7 C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EAD8 21 39 E9         LD HL, GameSubMinute
 131+ EADB 34               INC (HL)
 132+ EADC 3A 3C E9         LD A, (SubMinuteMax)
 133+ EADF BE               CP (HL)
 134+ EAE0 C0               RET NZ
 135+ EAE1
 136+ EAE1 AF               XOR A
 137+ EAE2 32 39 E9         LD (GameSubMinute), A
 138+ EAE5 21 3A E9         LD HL, GameMinutes
 139+ EAE8 34               INC (HL)
 140+ EAE9                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EAE9                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EAE9 3A 3A E9         LD A, (GameMinutes)
 143+ EAEC FE 3C            CP 60
 144+ EAEE C0               RET NZ
 145+ EAEF
 146+ EAEF AF               XOR A
 147+ EAF0 32 3A E9         LD (GameMinutes), A
 148+ EAF3 21 3B E9         LD HL, GameHours
 149+ EAF6 34               INC (HL)
 150+ EAF7 7E               LD A, (HL)
 151+ EAF8 FE 18            CP 24
 152+ EAFA 20 04            JR NZ, .checkPhase
 153+ EAFC AF               XOR A
 154+ EAFD 32 3B E9         LD (GameHours), A
 155+ EB00
 156+ EB00              .checkPhase:
 157+ EB00 3A 3B E9         LD A, (GameHours)
 158+ EB03 21 45 E9         LD HL, PhaseTable
 159+ EB06 06 07            LD B, 7
 160+ EB08              .phaseLoop:
 161+ EB08 BE               CP (HL)
 162+ EB09 28 05            JR Z, .phaseFound
 163+ EB0B 23               INC HL
 164+ EB0C 23               INC HL
 165+ EB0D 10 F9            DJNZ .phaseLoop
 166+ EB0F C9               RET
 167+ EB10              .phaseFound:
 168+ EB10 23               INC HL
 169+ EB11 7E               LD A, (HL)
 170+ EB12 F5               PUSH AF
 171+ EB13 CD DB E2         CALL SetTimeOfDay
 172+ EB16 F1               POP AF
 173+ EB17 FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 174+ EB19 C0               RET NZ
 175+ EB1A                  ; Nuevo dia: incrementar ciclo
 176+ EB1A 21 F0 BC         LD HL, DayCycleCount
 177+ EB1D 34               INC (HL)
 178+ EB1E C9               RET
 179+ EB1F
 180+ EB1F              ; ==============================================================================
 181+ EB1F              ; SetClockToPhaseHour
 182+ EB1F              ; ==============================================================================
 183+ EB1F              SetClockToPhaseHour:
 184+ EB1F 21 3E E9         LD HL, PhaseStartHour
 185+ EB22 4F               LD C, A
 186+ EB23 06 00            LD B, 0
 187+ EB25 09               ADD HL, BC
 188+ EB26 7E               LD A, (HL)
 189+ EB27 32 3B E9         LD (GameHours), A
 190+ EB2A AF               XOR A
 191+ EB2B 32 3A E9         LD (GameMinutes), A
 192+ EB2E 32 39 E9         LD (GameSubMinute), A
 193+ EB31 C9               RET
 194+ EB32
 195+ EB32              ; ==============================================================================
 196+ EB32              ; DrawClockHUD - Redibuja cara (cols 15-16) + agujas cada frame
 197+ EB32              ; ==============================================================================
 198+ EB32              DrawClockHUD:
 199+ EB32                  ; Blink "tiempo congelado": decidir ON/OFF antes de cualquier write.
 200+ EB32                  ; En OFF phase: solo escribimos attrs $00 (esfera invisible) y salimos
 201+ EB32                  ; sin tocar pixeles. Asi la ULA nunca ve estados intermedios "$47/$07
 202+ EB32                  ; primero, $00 despues" que producen el efecto de salto sucio. En ON:
 203+ EB32                  ; flujo normal de DrawClockFaceOnly + agujas (sin override final).
 204+ EB32                  ; TimeFrozen=1 -> parpadea (church trap). =2 -> congelado silencioso (death)
 205+ EB32 3A B6 82         LD A, (TimeFrozen)
 206+ EB35 FE 01            CP 1
 207+ EB37 20 07            JR NZ, .clkDrawNormal
 208+ EB39 3A 9B 81         LD A, (GameFrameCounter)
 209+ EB3C E6 10            AND $10                 ; bit 4: toggle cada 16 frames (~0.65s) -> 1.3s periodo
 210+ EB3E 28 2D            JR Z, .clkBlinkOff
 211+ EB40              .clkDrawNormal:
 212+ EB40 CD 7B EB         CALL DrawClockFaceOnly  ; restaura pixels de la esfera (cols 15-16 únicamente)
 213+ EB43
 214+ EB43                  ; --- Aguja de horas ---
 215+ EB43 3A 3B E9         LD A, (GameHours)
 216+ EB46 FE 0C            CP 12
 217+ EB48 38 02            JR C, .hourOk
 218+ EB4A D6 0C            SUB 12
 219+ EB4C              .hourOk:
 220+ EB4C 21 37 EA         LD HL, HourHandPtrs
 221+ EB4F CD 51 ED         CALL DrawHandLine
 222+ EB52
 223+ EB52                  ; --- Aguja de minutos ---
 224+ EB52 3A 3A E9         LD A, (GameMinutes)
 225+ EB55 06 00            LD B, 0
 226+ EB57              .divMin:
 227+ EB57 FE 05            CP 5
 228+ EB59 38 05            JR C, .minOk
 229+ EB5B D6 05            SUB 5
 230+ EB5D 04               INC B
 231+ EB5E 18 F7            JR .divMin
 232+ EB60              .minOk:
 233+ EB60 78               LD A, B
 234+ EB61 21 53 E9         LD HL, MinHandPtrs
 235+ EB64 CD 51 ED         CALL DrawHandLine
 236+ EB67
 237+ EB67                  ; --- Punto central (borra el pixel = marca negra) ---
 238+ EB67 21 0F 47         LD HL, $470F            ; fila 0, col 15, scan 7
 239+ EB6A CB 86            RES 0, (HL)
 240+ EB6C C9               RET
 241+ EB6D
 242+ EB6D              .clkBlinkOff:
 243+ EB6D                  ; OFF phase: solo write atomico de attrs $00 a las 4 celdas. Los pixels
 244+ EB6D                  ; quedan como los pinto la ultima frame ON, pero invisibles bajo
 245+ EB6D                  ; paper=black + ink=black.
 246+ EB6D AF               XOR A
 247+ EB6E 32 0F 58         LD ($580F), A
 248+ EB71 32 2F 58         LD ($582F), A
 249+ EB74 32 10 58         LD ($5810), A
 250+ EB77 32 30 58         LD ($5830), A
 251+ EB7A C9               RET
