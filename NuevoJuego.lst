6991+ C5F6              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6992+ C5F6              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6993+ C5F6              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6994+ C5F6              ; timer >= DEATH_SPAWN_FRAMES).
6995+ C5F6              SpawnDeath:
6996+ C5F6                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6997+ C5F6                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6998+ C5F6                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6999+ C5F6                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
7000+ C5F6                  ; atravesando el mapa.
7001+ C5F6 CD 2B 94         CALL FindFarthestAnyFreeCell
7002+ C5F9 C8               RET Z                               ; sin candidato: reintento siguiente frame
7003+ C5FA              .sdHaveCell:
7004+ C5FA                  ; B = cx, C = cy
7005+ C5FA DD 21 44 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
7006+ C5FE                  ; POSX = cx * 8
7007+ C5FE 78               LD A, B
7008+ C5FF 87               ADD A, A
7009+ C600 87               ADD A, A
7010+ C601 87               ADD A, A
