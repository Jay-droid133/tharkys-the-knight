3508+ A64C              ; ==============================================================================
3509+ A64C              ; UpdateSpawning - Avanza animacion spawn (6 frames), luego → STATE_RUNNING
3510+ A64C              ; ==============================================================================
3511+ A64C              ; IX = entidad en STATE_SPAWNING. ANIMBASE = SPRID_SPAWN.
3512+ A64C              ; ENT_DIR contiene el ANIMBASE real del enemigo.
