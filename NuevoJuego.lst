1102+ 6612              ; ==============================================================================
1103+ 6612              ; TownGateDrawCredits - renderiza la pantalla estatica de creditos
1104+ 6612              ; ==============================================================================
1105+ 6612              ; Itera TownGateCreditsData: cada entry es {row, col, "texto", 0}, terminada
1106+ 6612              ; en $FF. Imprime via PrintStringFontAt. Attrs en $5800+ se dejan a $47
1107+ 6612              ; (white ink, black paper, bright) para todo el area de texto.
1108+ 6612              ; ==============================================================================
1109+ 6612              TownGateDrawCredits:
1110+ 6612                  ; Pintar attrs $5800-$5AFF con $47 (white ink, black paper, bright)
1111+ 6612 21 00 58         LD HL, $5800
1112+ 6615 11 01 58         LD DE, $5801
1113+ 6618 01 FF 02         LD BC, $02FF
1114+ 661B 36 47            LD (HL), $47
1115+ 661D ED B0            LDIR
1116+ 661F                  ; Iterar credits
1117+ 661F 21 73 66         LD HL, TownGateCreditsData
1118+ 6622              .tgdcLoop:
1119+ 6622 7E               LD A, (HL)
1120+ 6623 FE FF            CP $FF
1121+ 6625 C8               RET Z
1122+ 6626 57               LD D, A                             ; D = row
1123+ 6627 23               INC HL
1124+ 6628 7E               LD A, (HL)
1125+ 6629 5F               LD E, A                             ; E = col
1126+ 662A 23               INC HL                              ; HL → string
1127+ 662B CD 30 66         CALL PrintStringFontAt
1128+ 662E 18 F2            JR .tgdcLoop                        ; HL ya avanzado tras el 0
1129+ 6630
1130+ 6630              ; ==============================================================================
1131+ 6630              ; PrintStringFontAt - imprime cadena ASCII (terminada en 0) en (D=row, E=col)
1132+ 6630              ; ==============================================================================
1133+ 6630              ; Usa font del ROM en $3C00 (ASCII * 8 = 8 bytes por char). Avanza HL al
1134+ 6630              ; siguiente byte tras el 0 (para que el caller siga iterando).
1135+ 6630              ; Destruye: AF, BC, DE, HL.
1136+ 6630              ; OUT: HL apunta al byte tras el 0 terminador.
1137+ 6630              ; ==============================================================================
1138+ 6630              PrintStringFontAt:
1139+ 6630              .psfaCharLoop:
1140+ 6630 7E               LD A, (HL)
1141+ 6631 23               INC HL
1142+ 6632 B7               OR A
1143+ 6633 C8               RET Z                               ; fin de string
1144+ 6634 E5               PUSH HL
1145+ 6635 D5               PUSH DE
1146+ 6636 CD 3E 66         CALL DrawCharFontAt                 ; D=row, E=col, A=char
1147+ 6639 D1               POP DE
1148+ 663A E1               POP HL
1149+ 663B 1C               INC E                               ; siguiente columna
1150+ 663C 18 F2            JR .psfaCharLoop
1151+ 663E
1152+ 663E              ; ==============================================================================
1153+ 663E              ; DrawCharFontAt - dibuja un char ASCII en (D=row, E=col) usando font ROM
1154+ 663E              ; ==============================================================================
1155+ 663E              ; D = row (0..23), E = col (0..31), A = ASCII char.
1156+ 663E              ; Calcula VRAM addr para (row, col) usando el formato Spectrum:
1157+ 663E              ;   y = row * 8, x = col * 8
1158+ 663E              ;   pixelAddr = $4000 + (third * $0800) + (charRow_in_third * $20) + (col)
1159+ 663E              ; El char se renderiza con direct write (sobrescribe pixels y attr).
1160+ 663E              ; Destruye: AF, BC, DE, HL.
1161+ 663E              ; ==============================================================================
1162+ 663E              DrawCharFontAt:
1163+ 663E D5               PUSH DE
1164+ 663F                  ; HL = $3C00 + char * 8
1165+ 663F 6F               LD L, A
1166+ 6640 26 00            LD H, 0
1167+ 6642 29               ADD HL, HL
1168+ 6643 29               ADD HL, HL
1169+ 6644 29               ADD HL, HL
1170+ 6645 01 00 3C         LD BC, $3C00
1171+ 6648 09               ADD HL, BC
1172+ 6649 D1               POP DE
1173+ 664A                  ; Calcular VRAM addr para (row, col) char-aligned: y = row*8
1174+ 664A E5               PUSH HL                             ; save font ptr
1175+ 664B 7A               LD A, D
1176+ 664C 87               ADD A, A
1177+ 664D 87               ADD A, A
1178+ 664E 87               ADD A, A                            ; A = row * 8 = pixel Y
1179+ 664F 57               LD D, A
1180+ 6650 7B               LD A, E
1181+ 6651 87               ADD A, A
1182+ 6652 87               ADD A, A
1183+ 6653 87               ADD A, A                            ; A = col * 8 = pixel X
1184+ 6654 5F               LD E, A
1185+ 6655 CD 5A 9D         CALL CalcPixelAddr                  ; HL = VRAM addr
1186+ 6658 EB               EX DE, HL                           ; DE = VRAM addr
1187+ 6659 E1               POP HL                              ; HL = font ptr
1188+ 665A 06 08            LD B, 8
1189+ 665C              .dcfaLoop:
1190+ 665C 7E               LD A, (HL)
1191+ 665D 12               LD (DE), A
1192+ 665E 23               INC HL
1193+ 665F 14               INC D                               ; siguiente scan line (within char)
1194+ 6660 10 FA            DJNZ .dcfaLoop
1195+ 6662 C9               RET
