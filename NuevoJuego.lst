  14  0000
  15  0000                  ; ==========================================================================
  16  0000                  ; ORG $6000 - codigo one-shot de boot
  17  0000                  ; ==========================================================================
  18  0000                  ; Inicio: vive aqui (slot 1, bank 5). $6000-$7FFF es CONTENDED, asi que
  19  0000                  ; el código aqui paga ~5-10% de penalty durante la zona activa de pantalla.
  20  0000                  ; No importa porque solo se ejecuta UNA vez al arrancar (boot path).
  21  0000                  ; Termina con JP MainLoop para saltar al loop principal en $8000.
  22  0000                  ;
  23  0000                  ; Espacio disponible: $6000-$7FFF = 8 KB. Hoy usamos ~100 B; el resto
  24  0000                  ; (~7.9 KB) queda libre para futuras movidas de codigo frio one-shot.
  25  0000                  ; ==========================================================================
  26  0000                  ORG $6000
  27  6000
  28  6000              Inicio:
  29  6000 F3               DI                      ; Deshabilitar interrupciones
  30  6001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
  31  6004
  32  6004                  ; Inicializar paginacion 128K (bank 0 en slot 3, estado conocido)
  33  6004 CD 67 6A         CALL InitPaging
  34  6007 CD 58 9B         CALL AY_Init                ; silenciar AY al arrancar
  35  600A
  36  600A                  ; Configuración inicial (Borde negro, etc.)
  37  600A 3E 00            LD A, BLACK             ; A = 0 (Negro)
  38  600C D3 FE            OUT (254), A            ; Cambia el color del borde a negro
  39  600E 32 83 90         LD (CurrentBorderColor), A  ; Guardar para preservar durante SFX
  40  6011
  41  6011                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
  42  6011                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
  43  6011 21 00 40         LD HL, SCREEN_BASE
  44  6014 11 01 40         LD DE, SCREEN_BASE + 1
  45  6017 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
  46  601A AF               XOR A                   ; A = 0
  47  601B 77               LD (HL), A
  48  601C ED B0            LDIR
  49  601E
  50  601E                  ; Zero-fill del area de variables low-RAM ($5D00..LOW_RAM_END).
  51  601E                  ; Esas variables son EQU (no se emiten en .tap), asi que el loader
  52  601E                  ; deja la zona con valores indeterminados; aqui las dejamos a 0.
  53  601E 21 00 5D         LD HL, LOW_RAM_BASE
  54  6021 11 01 5D         LD DE, LOW_RAM_BASE + 1
  55  6024 01 C9 02         LD BC, LOW_RAM_SIZE - 1
  56  6027 AF               XOR A
  57  6028 77               LD (HL), A
  58  6029 ED B0            LDIR
  59  602B
  60  602B                  ; Defaults no-cero para low-RAM: MonsterLastSeenRoom = $FF,$FF,$FF
  61  602B                  ; RandomSynthMapX = $FE (inactivo: no hay random pickup spawneado al boot).
  62  602B                  ; MagicCompassJingleIdx = $FF (inactivo). MagicCompassPathDir = $FF (no path).
  63  602B                  ; (el resto de low-RAM ya quedo a 0 con el LDIR de arriba).
  64  602B 3E FF            LD A, $FF
  65  602D 32 8E 5F         LD (MonsterLastSeenRoom), A
  66  6030 32 8F 5F         LD (MonsterLastSeenRoom + 1), A
  67  6033 32 90 5F         LD (MonsterLastSeenRoom + 2), A
  68  6036 32 C5 5F         LD (MagicCompassJingleIdx), A
  69  6039 32 C1 5F         LD (MagicCompassPathDir), A
  70  603C 32 C9 5F         LD (LastEntrySide), A               ; sin entry side al boot → BFS fallback comp 0
  71  603F 32 CA 5F         LD (LastEntryCoord), A              ; sin coord (irrelevant si LastEntrySide=$FF)
  72  6042 32 CB 5F         LD (LastMagicCompassDrawn), A       ; sprite no dibujado todavía
  73  6045 AF               XOR A
  74  6046 32 CC 5F         LD (MagicCompassBfsState), A        ; BFS idle al boot
  75  6049 3E FE            LD A, $FE
  76  604B 32 B4 5F         LD (RandomSynthMapX), A
  77  604E
  78  604E                  ; Random pickup memory: cur/prev sids = $FF (sala $00 = (0,0) es válida,
  79  604E                  ; un default 0 daría hit espurio al primer cruce). Slot/Rolled defaults a 0
  80  604E                  ; tras zero-fill (Slot 0 + ROLLED_NONE = "no spawn" si llegase a leer).
  81  604E 3E FF            LD A, $FF
  82  6050 32 CD 5F         LD (RP_CurSid), A
  83  6053 32 D0 5F         LD (RP_PrevSid), A
  84  6056
  85  6056                  ; Inicializar sistema de pantallas
  86  6056 CD D1 CB         CALL InitGameState      ; Reset variables de gameplay (idempotente)
  87  6059 CD 2D CF         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
  88  605C CD 63 A1         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
  89  605F CD 74 E5         CALL UpdateRemapTables  ; Aplicar remap para la hora de inicio
  90  6062 CD 90 BF         CALL UpdateNastyTable   ; Seleccionar tabla de nasties para la fase inicial
  91  6065 CD 8D F1         CALL ResolveObjectiveScreen ; Cachear (sx, sy) del primer hito
  92  6068                  ; (DrawClockSprite y DrawSwordModeHUD se llaman desde el MainLoop, no aqui)
  93  6068
  94  6068                  ; --- Modo de interrupciones 2 con handler propio (musica a wall-clock exacto) ---
  95  6068                  ; I = $7A apunta a la vector table en music_irq.asm. Cualquier byte del data
  96  6068                  ; bus produce vector = $7B7B donde hay un JP MusicIrqHandler. El handler
  97  6068                  ; reemplaza la rutina ROM de $0038: incrementa $5C78 manualmente y tickea
  98  6068                  ; la musica cada 2 IRQs (= 25 Hz).
  99  6068 3E 7A            LD A, $7A
 100  606A ED 47            LD I, A
 101  606C ED 5E            IM 2
 102  606E FB               EI                      ; Habilitar interrupciones
 103  606F 3E 01            LD A, 1                 ; Marcar fin de Inicio: las rutinas de paginacion
 104  6071 32 9A 81         LD (StartupComplete), A ; pueden hacer EI con seguridad a partir de aqui
 105  6074 C3 00 80         JP MainLoop             ; saltar al loop principal en $8000
 106  6077
 107  6077                  ; --- Cutscene final M9 (town_gate_cutscene.asm) ---
 108  6077                  ; Vive aqui en $6000+ (slot 1, siempre visible). Penalty ~5-10% por
 109  6077                  ; contention pero solo durante la cinematica final, una vez por partida —
 110  6077                  ; invisible. CALLs internos a rutinas de bank 0 (RestoreOldAttr,
 111  6077                  ; RedrawPickupByPtr, DrawBgGfxSprite, CheckMilestoneTrigger) funcionan sin
 112  6077                  ; envoltura: bank 0 sigue paginado por defecto y las CALLs cruzan slots
 113  6077                  ; sin tocar paginacion. El intento previo en bank 4 fallo porque slot 3
 114  6077                  ; cambiaba de bank durante el page switch — aqui ese problema no existe.
 115  6077                  INCLUDE "town_gate_cutscene.asm"
# file opened: code/town_gate_cutscene.asm
   1+ 6077              ; ==============================================================================
   2+ 6077              ; town_gate_cutscene.asm - Cutscene final del juego (M9, puerta sur)
   3+ 6077              ; ==============================================================================
   4+ 6077              ; Disparada al chocar contra Town Gate Door Closed (id 240) con TownGateKey.
   5+ 6077              ; Phase machine indexada por TownGatePhase. Cuando != 0, MainLoop salta el
   6+ 6077              ; bloque de gameplay y llama UpdateTownGateCutscene cada frame.
   7+ 6077              ;
   8+ 6077              ; Esquema de fases:
   9+ 6077              ;   1 LOCK         player snap a anchor1 (15,8) facing UP, pausa
  10+ 6077              ;   2 ARM_IN       arm aparece, pausa
  11+ 6077              ;   3 FINGER_IN    finger aparece (instantaneo), entra en SHAKE
  12+ 6077              ;   4 SHAKE        shake 2D random ±1 H/V de arm + finger
  13+ 6077              ;   5 FINGER_PULSE finger quieto antes de erase
  14+ 6077              ;   6 FINGER_OUT   1 frame de gap tras erase
  15+ 6077              ;   7 ARM_HOLD     arm quieto antes de erase
  16+ 6077              ;   8 ARM_OUT      1 frame de gap tras erase
  17+ 6077              ;   9 PLAYER_TURN  player gira a IDLE (mirando jugador)
  18+ 6077              ;  10 PLAYER_HIDE  1 frame con player oculto
  19+ 6077              ;  11 PLAYER_FRAMED player teleport a anchor2 (15,18), enmarcado en puerta
  20+ 6077              ;  12 PLAYER_EXIT  walk-S animado con clip al borde inferior, hasta off-screen
  21+ 6077              ;  13 END_HOLD     "The End" sprite hold
  22+ 6077              ;  14 BLACK        wipe a negro + hold
  23+ 6077              ;  15 CREDITS      pantalla estatica de creditos (loop infinito)
  24+ 6077              ;
  25+ 6077              ; Todos los timings y posiciones via EQU al inicio: ajustables sin tocar
  26+ 6077              ; logica. Hooks SFX por fase como stubs RET, listos para llenar despues.
  27+ 6077              ; ==============================================================================
  28+ 6077
  29+ 6077              ; --- Timings (frames a 50Hz). Ajustables sin recompilar logica ---
  30+ 6077              TGCS_T_LOCK            EQU 60      ; Lock + facing UP, pausa breve
  31+ 6077              TGCS_T_ARM_IN          EQU 30      ; Arm aparece, pausa antes de finger
  32+ 6077              TGCS_T_FINGER_IN       EQU 1       ; Finger instantaneo, transicion a SHAKE
  33+ 6077              TGCS_T_SHAKE           EQU 40      ; Shake 2D rabioso (~1.6s a 25 Hz; antes 90 = 3.6s)
  34+ 6077              TGCS_T_FINGER_PULSE    EQU 20      ; Finger quieto antes de erase
  35+ 6077              TGCS_T_ARM_HOLD        EQU 25      ; Arm quieto tras finger erase
  36+ 6077              TGCS_T_PLAYER_TURN     EQU 50      ; Player IDLE mirando jugador
  37+ 6077              TGCS_T_EXIT_STEP       EQU 2       ; Frames entre cada paso de Y++ en slide-out
  38+ 6077              TGCS_T_END_HOLD        EQU 150     ; "The End" antes de wipe
  39+ 6077              TGCS_T_BLACK_HOLD      EQU 30      ; Pantalla negra antes de credits
  40+ 6077
  41+ 6077              ; --- Posiciones (pixel) ---
  42+ 6077              TGCS_ANCHOR1_X         EQU 120     ; char (15,10) — destino del walk + lock
  43+ 6077              TGCS_ANCHOR1_Y         EQU 80
  44+ 6077              TGCS_END_CHARX         EQU 11      ; "The End" sprite (11,4)
  45+ 6077              TGCS_END_CHARY         EQU 4
  46+ 6077              TGCS_PLAYER_BOTTOM_Y   EQU 192     ; phase 12 termina cuando POSY=192 (player rect entero off-screen)
  47+ 6077
  48+ 6077              ; --- Posiciones de arm + finger (deben coincidir con screen_data PickupTable) ---
  49+ 6077              ; PickupTable los tiene en char (17,6) y (17,5). DrawBgSpriteXOR suma
  50+ 6077              ; BG_Y_OFFSET=2 antes del *8, asi que la pixel Y final renderizada es
  51+ 6077              ; (charY + 2) * 8. Aqui guardamos esa pixel Y final directamente — el
  52+ 6077              ; shake usa DrawBgSpriteAnyXorAtPixel sin offset implicito.
  53+ 6077              ;   arm:    char (17,6) → pixel (136, (6+2)*8 = 64)
  54+ 6077              ;   finger: char (17,5) → pixel (136, (5+2)*8 = 56)
  55+ 6077              TGCS_ARM_PX_X          EQU 136
  56+ 6077              TGCS_ARM_PX_Y          EQU 64
  57+ 6077              TGCS_FINGER_PX_X       EQU 136
  58+ 6077              TGCS_FINGER_PX_Y       EQU 56
  59+ 6077
  60+ 6077              ; --- Phase enum ---
  61+ 6077              TGP_IDLE               EQU 0
  62+ 6077              TGP_LOCK               EQU 1
  63+ 6077              TGP_ARM_IN             EQU 2
  64+ 6077              TGP_FINGER_IN          EQU 3
  65+ 6077              TGP_SHAKE              EQU 4
  66+ 6077              TGP_FINGER_PULSE       EQU 5
  67+ 6077              TGP_FINGER_OUT         EQU 6
  68+ 6077              TGP_ARM_HOLD           EQU 7
  69+ 6077              TGP_ARM_OUT            EQU 8
  70+ 6077              TGP_PLAYER_TURN        EQU 9
  71+ 6077              TGP_PLAYER_HIDE        EQU 10
  72+ 6077              TGP_PLAYER_FRAMED      EQU 11
  73+ 6077              TGP_PLAYER_EXIT        EQU 12
  74+ 6077              TGP_END_HOLD           EQU 13
  75+ 6077              TGP_BLACK              EQU 14
  76+ 6077              TGP_CREDITS            EQU 15
  77+ 6077              TGP_WAIT_NASTIES       EQU 16     ; pre-LOCK wait para que terminen puffs
  78+ 6077              TGP_WALK_TO_ANCHOR     EQU 17     ; walk autonomo desde bump pos hasta anchor1
  79+ 6077
  80+ 6077              TGCS_T_PUFF_WAIT       EQU 100    ; safety timeout. La transicion real es por
  81+ 6077                                                ; check dinamico de "todos los nasties dead".
  82+ 6077                                                ; ProcessEnemies hace 2 slots/frame; con 4
  83+ 6077                                                ; nasties + 3 monsters + 1 death = 8 slots,
  84+ 6077                                                ; cada puff tarda ~50 frames. 100 = margen.
  85+ 6077
  86+ 6077              ; Walk autonomo a anchor1 (post WAIT_NASTIES, pre LOCK)
  87+ 6077              TGCS_WALK_TARGET_X     EQU TGCS_ANCHOR1_X    ; 120
  88+ 6077              TGCS_WALK_TARGET_Y     EQU TGCS_ANCHOR1_Y    ; 80
  89+ 6077              TGCS_WALK_ANIM_PERIOD  EQU 4                 ; toggle anim frame cada N game frames
  90+ 6077
  91+ 6077              ; --- Rect del PART1 del arco (lintel + arco superior) para el bump-trigger ---
  92+ 6077              ; El arco ahora esta partido en 3 sprites: part1 (lintel/arco superior),
  93+ 6077              ; part2 (pilar izq), part3 (pilar der). Trigger solo dispara con part1.
  94+ 6077              ; Placement: DEFB 247, 10, 13 → pixel (10*8, (13+2)*8) = (80, 120).
  95+ 6077              ; Tamano part1 96x32 (12x4 chars) → rect (80-175, 120-151).
  96+ 6077              ;
  97+ 6077              ; Tambien usado para el redraw on-top-of-player durante el slide-down:
  98+ 6077              ; mientras el player overlapea verticalmente con part1 (POSY <= 151), part1
  99+ 6077              ; se re-pinta encima cada step → player visualmente "detras" del lintel.
 100+ 6077              TGCS_ARCH_PX_LEFT      EQU 80        ; 10 * 8
 101+ 6077              TGCS_ARCH_PX_TOP       EQU 120       ; (13 + 2) * 8
 102+ 6077              TGCS_ARCH_PX_RIGHT     EQU 175       ; 80 + 96 - 1
 103+ 6077              TGCS_ARCH_PX_BOTTOM    EQU 151       ; 120 + 32 - 1
 104+ 6077
 105+ 6077              ; --- Posicion de la puerta (closed v2 + open) en char ---
 106+ 6077              ; El closed v2 (id 246) vive en PickupTable a (14, 17). El open (id 250)
 107+ 6077              ; comparte posicion y tamano (4x5 chars). Cuando el cutscene erase el closed,
 108+ 6077              ; dibuja el open in-place via DrawBgGfxSprite.
 109+ 6077              TGCS_DOOR_CHARX        EQU 14
 110+ 6077              TGCS_DOOR_CHARY        EQU 17
 111+ 6077              TGCS_ARCH_TOLERANCE    EQU 4         ; mismo margen que CheckBumpTriggers
 112+ 6077              TGCS_ARCH_ROOM_X       EQU 7
 113+ 6077              TGCS_ARCH_ROOM_Y       EQU 15
 114+ 6077              TGCS_ARCH_KEY_ID       EQU 6         ; TownGateKey
 115+ 6077
 116+ 6077              ; ==============================================================================
 117+ 6077              ; CheckTownGateTriggerBg - bump-trigger del arco (BG sprite, no en PickupTable)
 118+ 6077              ; ==============================================================================
 119+ 6077              ; Llamado cada frame desde MainLoop tras CheckBumpTriggers. Hace el mismo test
 120+ 6077              ; AABB ±tolerance que CheckBumpTriggers haria si el arco fuese pickup, pero
 121+ 6077              ; con todos los parametros hardcodeados (un unico trigger de este tipo).
 122+ 6077              ;
 123+ 6077              ; Condiciones para disparar: TownGatePhase==0 (no en cutscene), CurrentKey==
 124+ 6077              ; TownGateKey, sala (7,15), AABB del player (16x16) overlapea rect del arco
 125+ 6077              ; extendido +-4 px. HIT → StartTownGateCutscene + CheckMilestoneTrigger(3).
 126+ 6077              ; Destruye: AF, BC, DE, HL, IX.
 127+ 6077              ; ==============================================================================
 128+ 6077              CheckTownGateTriggerBg:
 129+ 6077 3A C8 82         LD A, (TownGatePhase)
 130+ 607A B7               OR A
 131+ 607B C0               RET NZ                              ; ya en cutscene
 132+ 607C 3A AE 82         LD A, (CurrentKey)
 133+ 607F FE 06            CP TGCS_ARCH_KEY_ID
 134+ 6081 C0               RET NZ                              ; sin la key correcta
 135+ 6082 3A 08 83         LD A, (CurrentScreenX)
 136+ 6085 FE 07            CP TGCS_ARCH_ROOM_X
 137+ 6087 C0               RET NZ
 138+ 6088 3A 09 83         LD A, (CurrentScreenY)
 139+ 608B FE 0F            CP TGCS_ARCH_ROOM_Y
 140+ 608D C0               RET NZ
 141+ 608E                  ; --- Horizontal AABB ---
 142+ 608E 3A 9E 81         LD A, (EntityTable + ENT_POSX)
 143+ 6091 4F               LD C, A                             ; C = player_left
 144+ 6092 C6 10            ADD A, 16
 145+ 6094 57               LD D, A                             ; D = player_right
 146+ 6095 3E 50            LD A, TGCS_ARCH_PX_LEFT
 147+ 6097 D6 04            SUB TGCS_ARCH_TOLERANCE             ; arch_left_ext (con clamp 0)
 148+ 6099 30 01            JR NC, .ctgtNoUnderL
 149+ 609B AF               XOR A
 150+ 609C              .ctgtNoUnderL:
 151+ 609C BA               CP D
 152+ 609D D0               RET NC                              ; ext_left >= player_right
 153+ 609E 3E AF            LD A, TGCS_ARCH_PX_RIGHT
 154+ 60A0 C6 04            ADD A, TGCS_ARCH_TOLERANCE          ; arch_right_ext (con clamp 255)
 155+ 60A2 30 02            JR NC, .ctgtNoOverR
 156+ 60A4 3E FF            LD A, $FF
 157+ 60A6              .ctgtNoOverR:
 158+ 60A6 B9               CP C
 159+ 60A7 D8               RET C                               ; ext_right < player_left
 160+ 60A8                  ; --- Vertical AABB ---
 161+ 60A8                  ; OJO: el rect de colision del player es 16x21 (Y+0..Y+20, ver puntos
 162+ 60A8                  ; inferiores en logic_game.asm IsPointBlocked sobre el player). Usar +16
 163+ 60A8                  ; aqui dejaria un gap de 4-5 px frente al borde del arco al chocar desde
 164+ 60A8                  ; el norte (no dispararia el trigger). Por eso usamos +21 para coincidir
 165+ 60A8                  ; con la altura real del rect.
 166+ 60A8 3A 9F 81         LD A, (EntityTable + ENT_POSY)
 167+ 60AB 4F               LD C, A                             ; C = player_top
 168+ 60AC C6 15            ADD A, 21
 169+ 60AE 57               LD D, A                             ; D = player_bottom (excl, rect real 21px)
 170+ 60AF 3E 78            LD A, TGCS_ARCH_PX_TOP
 171+ 60B1 D6 04            SUB TGCS_ARCH_TOLERANCE
 172+ 60B3 30 01            JR NC, .ctgtNoUnderT
 173+ 60B5 AF               XOR A
 174+ 60B6              .ctgtNoUnderT:
 175+ 60B6 BA               CP D
 176+ 60B7 D0               RET NC
 177+ 60B8 3E 97            LD A, TGCS_ARCH_PX_BOTTOM
 178+ 60BA C6 04            ADD A, TGCS_ARCH_TOLERANCE
 179+ 60BC 30 02            JR NC, .ctgtNoOverB
 180+ 60BE 3E FF            LD A, $FF
 181+ 60C0              .ctgtNoOverB:
 182+ 60C0 B9               CP C
 183+ 60C1 D8               RET C
 184+ 60C2                  ; HIT
 185+ 60C2 CD CA 60         CALL StartTownGateCutscene
 186+ 60C5 3E 03            LD A, 3                             ; action 3 = TownGate (avance M9)
 187+ 60C7 C3 05 F1         JP CheckMilestoneTrigger            ; tail call
 188+ 60CA
 189+ 60CA              ; ==============================================================================
 190+ 60CA              ; StartTownGateCutscene - llamada desde el handler del bump-trigger action 3
 191+ 60CA              ; ==============================================================================
 192+ 60CA              ; 1. Consume key, abre puerta, KillAllActiveNasties (puff anim).
 193+ 60CA              ; 2. Player se queda en su posicion de bump (no snap a anchor1 todavia).
 194+ 60CA              ; 3. Entra en TGP_WAIT_NASTIES. Cuando todos los nasties hayan muerto
 195+ 60CA              ;    (check dinamico), transicion a TGP_WALK_TO_ANCHOR donde el player
 196+ 60CA              ;    camina autonomamente desde bump pos hasta anchor1 con anim correcta.
 197+ 60CA              ;    Tras llegar, transicion a TGP_LOCK (gesto rabia).
 198+ 60CA              ; Destruye: AF, BC, DE, HL, IX.
 199+ 60CA              ; ==============================================================================
 200+ 60CA              StartTownGateCutscene:
 201+ 60CA AF               XOR A
 202+ 60CB 32 AE 82         LD (CurrentKey), A
 203+ 60CE CD C7 63         CALL TownGateOpenDoor               ; closed v2 → open al disparar trigger
 204+ 60D1 CD CD BC         CALL KillAllActiveNasties           ; nasties → puff (animan en WAIT_NASTIES)
 205+ 60D4 CD E5 60         CALL KillDeathIfActive              ; muerte (slot 11) → puff y despawn
 206+ 60D7 CD 63 66         CALL SFX_TownGate_OnStart
 207+ 60DA 3E 10            LD A, TGP_WAIT_NASTIES
 208+ 60DC 32 C8 82         LD (TownGatePhase), A
 209+ 60DF 3E 64            LD A, TGCS_T_PUFF_WAIT
 210+ 60E1 32 A5 5F         LD (TownGateTimer), A
 211+ 60E4 C9               RET
 212+ 60E5
 213+ 60E5              ; ==============================================================================
 214+ 60E5              ; KillDeathIfActive - death (slot 11) → STATE_DYING con puff
 215+ 60E5              ; ==============================================================================
 216+ 60E5              ; Si TYPE_DEATH activa y no estaba ya muriendo, transicion a STATE_DYING
 217+ 60E5              ; con SPRID_PUFF. ProcessDeath → ProcessOneEnemy.peDying anima puff cada
 218+ 60E5              ; frame en WAIT_NASTIES (igual que nasties). Al terminar puff,
 219+ 60E5              ; UpdateDying pone TYPE_NONE y la check dinamica de WAIT_NASTIES sigue.
 220+ 60E5              ; (DeathSpawned se queda a 1 pero es inocuo: ProcessDeath ya retorna
 221+ 60E5              ; cuando ENT_TYPE=0, y no hay respawn durante cutscene.)
 222+ 60E5              ; ==============================================================================
 223+ 60E5              KillDeathIfActive:
 224+ 60E5 DD 21 4B 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
 225+ 60E9 DD 7E 01         LD A, (IX+ENT_TYPE)
 226+ 60EC B7               OR A
