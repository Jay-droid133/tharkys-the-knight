6756+ C4AA              ; ==============================================================================
6757+ C4AA              ; SISTEMA DE LA MUERTE (TYPE_DEATH, slot 11)
6758+ C4AA              ; ==============================================================================
6759+ C4AA              ; Aparece tras estar DEATH_SPAWN_FRAMES (250 = 10s @ 25fps) en una sala. Persigue
6760+ C4AA              ; al player con FlowField a media velocidad (1px cada 2 frames). Al tocar al
6761+ C4AA              ; player le quita toda la salud y desaparece. Tambien desaparece al cambiar de
6762+ C4AA              ; sala (DrawScreen resetea slot, timer y flag). No avanza durante la cinemática
6763+ C4AA              ; de la iglesia (ChurchCutscenePhase ya saltea todo el bloque de gameplay desde
6764+ C4AA              ; main.asm; aqui no hace falta guard adicional).
6765+ C4AA              ; ==============================================================================
6766+ C4AA
6767+ C4AA              ; --- UpdateDeath: wrapper sub-pixel sobre UpdateMonster + stuck detection ---
6768+ C4AA              ; IX = EntityTable + SLOT_DEATH * ENT_SIZE. Reusa la AI de monsters (chase
6769+ C4AA              ; con wall-escape + persistence + 4-candidate routing). Sub-pixel acc 1/2:
6770+ C4AA              ; en frame activo llama a UpdateMonster; en frame skip llama a DeathAnimate.
6771+ C4AA              ;
6772+ C4AA              ; Stuck detection (option 3 pathfinding): si POSX/Y no cambio durante
6773+ C4AA              ; DEATH_STUCK_THRESHOLD frames consecutivos, activar DeathBfsRescue (mini
6774+ C4AA              ; BFS depth 3 que elige la mejor direccion para escapar del atasco).
6775+ C4AA              ;
6776+ C4AA              ; UpdateMonster espera ENT_DIR=0 (sin stun) → SpawnDeath lo inicializa asi
6777+ C4AA              ; y nada lo cambia. Con DIR=0 entra siempre por .moNormal.
6778+ C4AA              ; .moAnimate redirige TYPE_DEATH a DeathAnimate (animacion R/L con 4 frames
6779+ C4AA              ; en vez de 8 + orientacion invertida).
6780+ C4AA              UpdateDeath:
6781+ C4AA                  ; --- Tick contador on-screen (16-bit). Al llegar a DEATH_GHOST_FRAMES
6782+ C4AA                  ; (15s @ 25fps) activa ghost mode independientemente de si Death ha
6783+ C4AA                  ; movido o no. "Atascada" en gameplay incluye dar botes / oscilar sin
6784+ C4AA                  ; progreso real, no solo quedar inmovil. ---
6785+ C4AA 2A 02 83         LD HL, (DeathGhostStuckTimer)
6786+ C4AD 23               INC HL
6787+ C4AE 22 02 83         LD (DeathGhostStuckTimer), HL
6788+ C4B1 7C               LD A, H
6789+ C4B2 FE 00            CP (DEATH_GHOST_FRAMES) >> 8
6790+ C4B4 38 1A            JR C, .udGhostCheckDone
6791+ C4B6 20 05            JR NZ, .udGhostOn
6792+ C4B8 7D               LD A, L
6793+ C4B9 FE 60            CP (DEATH_GHOST_FRAMES) & $FF
6794+ C4BB 38 13            JR C, .udGhostCheckDone
6795+ C4BD              .udGhostOn:
6796+ C4BD                  ; Detectar transicion 0->1 (PRIMERA vez entrando ghost mode este episodio).
6797+ C4BD                  ; Solo en ese frame setear tempo doble + restart musica desde primera nota:
6798+ C4BD                  ; asi la primera nota cae sincronizada con el "lanzarse" de la muerte. Los
6799+ C4BD                  ; frames subsecuentes con DeathGhostMode=1 son no-op (idempotente sin
6800+ C4BD                  ; re-disparar restart).
6801+ C4BD 3A 04 83         LD A, (DeathGhostMode)
6802+ C4C0 B7               OR A
6803+ C4C1 20 0D            JR NZ, .udGhostCheckDone
6804+ C4C3 3E 01            LD A, 1
6805+ C4C5 32 04 83         LD (DeathGhostMode), A
6806+ C4C8 32 E3 99         LD (MusicSpeedShift), A         ; tempo doble desde la PRIMERA nota
6807+ C4CB 3E FE            LD A, $FE                       ; sentinel restart-current-track
6808+ C4CD CD BD 99         CALL StartMusic                 ; rearranca DeathMusicTable desde nota 0
6809+ C4D0              .udGhostCheckDone:
6810+ C4D0
6811+ C4D0                  ; --- Ghost mode activo: chase directo ignorando colision con BG ---
6812+ C4D0 3A 04 83         LD A, (DeathGhostMode)
6813+ C4D3 B7               OR A
6814+ C4D4 C2 1B C5         JP NZ, DeathGhostChase
6815+ C4D7
6816+ C4D7                  ; Snapshot de la pos pre-call para detectar stuck (BFS rescue)
6817+ C4D7 DD 7E 03         LD A, (IX+ENT_POSX)
6818+ C4DA 32 FF 82         LD (DeathPrevX), A
6819+ C4DD DD 7E 04         LD A, (IX+ENT_POSY)
6820+ C4E0 32 00 83         LD (DeathPrevY), A
6821+ C4E3                  ; Sub-pixel acc 1/2
6822+ C4E3 3A FE 82         LD A, (DeathSubPixelAcc)
6823+ C4E6 EE 01            XOR 1
6824+ C4E8 32 FE 82         LD (DeathSubPixelAcc), A
6825+ C4EB 28 05            JR Z, .udSkip
6826+ C4ED CD 9C AD         CALL UpdateMonster                  ; activo: chase + move + animate
6827+ C4F0 18 03            JR .udPost
6828+ C4F2              .udSkip:
6829+ C4F2 CD 6E C5         CALL DeathAnimate                   ; skip: solo animacion
6830+ C4F5              .udPost:
6831+ C4F5                  ; Stuck check para BFS: comparar POS post-call vs pre-call
6832+ C4F5 3A FF 82         LD A, (DeathPrevX)
6833+ C4F8 DD BE 03         CP (IX+ENT_POSX)
6834+ C4FB 20 19            JR NZ, .udMoved
6835+ C4FD 3A 00 83         LD A, (DeathPrevY)
6836+ C500 DD BE 04         CP (IX+ENT_POSY)
6837+ C503 20 11            JR NZ, .udMoved
6838+ C505                  ; No movio: incrementar BFS counter
6839+ C505 3A 01 83         LD A, (DeathStuckCounter)
6840+ C508 3C               INC A
6841+ C509 32 01 83         LD (DeathStuckCounter), A
6842+ C50C FE 06            CP DEATH_STUCK_THRESHOLD
6843+ C50E D8               RET C
6844+ C50F AF               XOR A
6845+ C510 32 01 83         LD (DeathStuckCounter), A
6846+ C513 C3 DA C6         JP DeathBfsRescue
6847+ C516              .udMoved:
6848+ C516 AF               XOR A
6849+ C517 32 01 83         LD (DeathStuckCounter), A
6850+ C51A C9               RET
6851+ C51B
6852+ C51B              ; --- DeathGhostChase: chase directo al player saltandose colision con BG ---
6853+ C51B              ; Activado cuando DeathGhostMode=1 (15s desde spawn). Velocidad SPEED_RUN
6854+ C51B              ; en un solo eje (greedy primario: el de mayor delta al player). Sin diagonal-
6855+ C51B              ; doble - asi Death no avanza mas rapido que el player en cualquier direccion.
6856+ C51B              ; Atraviesa walls/BG hasta llegar al primer hueco libre (bbox sin overlap).
6857+ C51B              ; Cuando alcanza hueco libre: exit ghost mode + reset timers, AI normal reanuda.
6858+ C51B              DeathGhostChase:
6859+ C51B                  ; --- Computar |dx|, |dy| para elegir eje primario ---
6860+ C51B 3A A1 81         LD A, (EntityTable + ENT_POSX)
6861+ C51E DD 96 03         SUB (IX+ENT_POSX)
6862+ C521 30 02            JR NC, .udgAbsDxOk
6863+ C523 ED 44            NEG
6864+ C525              .udgAbsDxOk:
6865+ C525 47               LD B, A                             ; B = |dx|
6866+ C526 3A A2 81         LD A, (EntityTable + ENT_POSY)
6867+ C529 DD 96 04         SUB (IX+ENT_POSY)
6868+ C52C 30 02            JR NC, .udgAbsDyOk
6869+ C52E ED 44            NEG
6870+ C530              .udgAbsDyOk:
6871+ C530                  ; A = |dy|, B = |dx|
6872+ C530 B8               CP B
6873+ C531 30 1D            JR NC, .udgVertPrim                 ; |dy| >= |dx| -> mover en Y
6874+ C533
6875+ C533                  ; --- Eje X primario ---
6876+ C533 AF               XOR A
6877+ C534 DD 77 07         LD (IX+ENT_DELTAY), A               ; clear Y
6878+ C537 3A A1 81         LD A, (EntityTable + ENT_POSX)
6879+ C53A DD 96 03         SUB (IX+ENT_POSX)
6880+ C53D 28 2C            JR Z, .udgAnim                      ; alineado en X (raro si entramos aqui)
6881+ C53F 3E 04            LD A, DEATH_GHOST_SPEED
6882+ C541 30 02            JR NC, .udgXSet
6883+ C543 3E FC            LD A, -DEATH_GHOST_SPEED
6884+ C545              .udgXSet:
6885+ C545 DD 77 06         LD (IX+ENT_DELTAX), A
6886+ C548 DD 86 03         ADD A, (IX+ENT_POSX)
6887+ C54B DD 77 03         LD (IX+ENT_POSX), A
6888+ C54E 18 1B            JR .udgAnim
6889+ C550
6890+ C550                  ; --- Eje Y primario ---
6891+ C550              .udgVertPrim:
6892+ C550 AF               XOR A
6893+ C551 DD 77 06         LD (IX+ENT_DELTAX), A               ; clear X
6894+ C554 3A A2 81         LD A, (EntityTable + ENT_POSY)
6895+ C557 DD 96 04         SUB (IX+ENT_POSY)
6896+ C55A 28 0F            JR Z, .udgAnim
6897+ C55C 3E 04            LD A, DEATH_GHOST_SPEED
6898+ C55E 30 02            JR NC, .udgYSet
6899+ C560 3E FC            LD A, -DEATH_GHOST_SPEED
6900+ C562              .udgYSet:
6901+ C562 DD 77 07         LD (IX+ENT_DELTAY), A
6902+ C565 DD 86 04         ADD A, (IX+ENT_POSY)
6903+ C568 DD 77 04         LD (IX+ENT_POSY), A
6904+ C56B              .udgAnim:
6905+ C56B                  ; Ghost mode PERSISTENTE: una vez activo, Death sigue lanzandose hasta
6906+ C56B                  ; ser despawneada por una de tres condiciones externas:
6907+ C56B                  ;   1. Caza al player (CheckDeathTouchPlayer.cdtTouched)
6908+ C56B                  ;   2. Player muere por otra causa (OnPlayerHealthDepleted -> SilentKillDeath)
6909+ C56B                  ;   3. Player cambia de pantalla (screen_system reset)
6910+ C56B                  ; En esos hooks se hace DeathSpawned=0 + DeathGhostMode=0 + stop musica,
6911+ C56B                  ; asi que el flag se limpia ahi. No hay reset por "salir de muro" — el
6912+ C56B                  ; jugador no puede sacudirse a la muerte cambiando posicion.
6913+ C56B C3 6E C5         JP DeathAnimate                     ; tail-call para animar (R/L invertido)
6914+ C56E
6915+ C56E              ; --- DeathAnimate: animacion R/L con orientacion invertida ---
6916+ C56E              ; Llamada por:
6917+ C56E              ;   - .moAnimate (redireccion TYPE_DEATH dentro de UpdateMonster).
6918+ C56E              ;   - UpdateDeath en frame skip (sin movimiento).
6919+ C56E              ; El sprite del aseprite tiene la orientacion fisica invertida vs sign de
6920+ C56E              ; DELTAX → DELTAX > 0 mapea a par "L" (offset 2), DELTAX < 0 a par "R" (0).
6921+ C56E              DeathAnimate:
6922+ C56E DD 7E 06         LD A, (IX+ENT_DELTAX)
6923+ C571 B7               OR A
6924+ C572 28 0A            JR Z, .daKeepDir
6925+ C574 0E 02            LD C, ENEMY_FRAMES_LEFT             ; DELTAX > 0 → par L (sprite invertido)
6926+ C576 CB 7F            BIT 7, A
6927+ C578 28 0D            JR Z, .daDir
6928+ C57A 0E 00            LD C, ENEMY_FRAMES_RIGHT            ; DELTAX < 0 → par R
6929+ C57C 18 09            JR .daDir
6930+ C57E              .daKeepDir:
6931+ C57E DD 7E 00         LD A, (IX+ENT_SPRITEID)
6932+ C581 DD 96 08         SUB (IX+ENT_ANIMBASE)
6933+ C584 E6 02            AND 2                               ; bit 1 = par L (offsets 2/3)
6934+ C586 4F               LD C, A
6935+ C587              .daDir:
6936+ C587 DD 35 09         DEC (IX+ENT_ANIMTIMER)
6937+ C58A 20 16            JR NZ, .daFrameSet
6938+ C58C DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6939+ C590 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6940+ C593 47               LD B, A
6941+ C594 DD 96 08         SUB (IX+ENT_ANIMBASE)
6942+ C597 E6 01            AND 1
6943+ C599 20 03            JR NZ, .daFrameDec
6944+ C59B 04               INC B
6945+ C59C 18 01            JR .daFrameStore
6946+ C59E              .daFrameDec:
6947+ C59E 05               DEC B
6948+ C59F              .daFrameStore:
6949+ C59F DD 70 00         LD (IX+ENT_SPRITEID), B
6950+ C5A2              .daFrameSet:
6951+ C5A2 DD 7E 00         LD A, (IX+ENT_SPRITEID)
6952+ C5A5 DD 96 08         SUB (IX+ENT_ANIMBASE)
6953+ C5A8 E6 01            AND 1
6954+ C5AA DD 86 08         ADD A, (IX+ENT_ANIMBASE)
6955+ C5AD 81               ADD A, C
6956+ C5AE DD 77 00         LD (IX+ENT_SPRITEID), A
6957+ C5B1 C9               RET
6958+ C5B2
6959+ C5B2              ; --- SpawnDeath: inicializa slot SLOT_DEATH en la celda mas lejana del player ---
6960+ C5B2              ; Si FindFarthestAnyFreeCell no halla candidato, no spawnea (deja DeathSpawned=0
6961+ C5B2              ; pero NO resetea DeathScreenTimer; el spawn se reintentara cada frame mientras
6962+ C5B2              ; timer >= DEATH_SPAWN_FRAMES).
6963+ C5B2              SpawnDeath:
6964+ C5B2                  ; Picker barato: celda libre mas lejana en Manhattan al player respetando
6965+ C5B2                  ; DEATH_MIN_SPAWN_DIST + footprint 24x24. Sin BFS ni paginar bank 6
6966+ C5B2                  ; (~1M T-states ahorrados vs MaiComputeFlowField+FindFarthestZoneCell).
6967+ C5B2                  ; Si la celda quedase aislada por paredes, ghost mode (15s) cierra el caso
6968+ C5B2                  ; atravesando el mapa.
6969+ C5B2 CD 35 94         CALL FindFarthestAnyFreeCell
6970+ C5B5 C8               RET Z                               ; sin candidato: reintento siguiente frame
6971+ C5B6              .sdHaveCell:
6972+ C5B6                  ; B = cx, C = cy
6973+ C5B6 DD 21 4E 82      LD IX, EntityTable + (SLOT_DEATH * ENT_SIZE)
6974+ C5BA                  ; POSX = cx * 8
6975+ C5BA 78               LD A, B
6976+ C5BB 87               ADD A, A
6977+ C5BC 87               ADD A, A
6978+ C5BD 87               ADD A, A
6979+ C5BE DD 77 03         LD (IX+ENT_POSX), A
6980+ C5C1 DD 77 0C         LD (IX+ENT_OLDX), A                 ; sin valor previo: preinit a pos actual
6981+ C5C4                  ; POSY = cy * 8 + SCREEN_MIN_Y
6982+ C5C4 79               LD A, C
6983+ C5C5 87               ADD A, A
6984+ C5C6 87               ADD A, A
6985+ C5C7 87               ADD A, A
6986+ C5C8 C6 10            ADD A, SCREEN_MIN_Y
6987+ C5CA DD 77 04         LD (IX+ENT_POSY), A
6988+ C5CD DD 77 0D         LD (IX+ENT_OLDY), A
6989+ C5D0                  ; Tipo / estado / sprite
6990+ C5D0 DD 36 01 05      LD (IX+ENT_TYPE), TYPE_DEATH
6991+ C5D4 DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
6992+ C5D8 DD 36 00 64      LD (IX+ENT_SPRITEID), SPRID_DEATH
6993+ C5DC DD 36 0E 64      LD (IX+ENT_OLDSPRID), SPRID_DEATH
6994+ C5E0 DD 36 08 64      LD (IX+ENT_ANIMBASE), SPRID_DEATH
6995+ C5E4 DD 36 09 04      LD (IX+ENT_ANIMTIMER), ENEMY_ANIM_DELAY
6996+ C5E8 DD 36 06 00      LD (IX+ENT_DELTAX), 0
6997+ C5EC DD 36 07 00      LD (IX+ENT_DELTAY), 0
6998+ C5F0 DD 36 0A 00      LD (IX+ENT_DIR), 0
6999+ C5F4                  ; Color: blanco brillante sobre negro (espectral)
7000+ C5F4 DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40
7001+ C5F8                  ; Flags: visible + newspawn (no destructible: la muerte es invulnerable)
7002+ C5F8 DD 36 0B 09      LD (IX+ENT_FLAGS), (1 << ENTF_VISIBLE) | (1 << ENTF_NEWSPAWN)
7003+ C5FC                  ; Sub-pixel acc + ghost mode reset (spawn fresco siempre en chase normal)
7004+ C5FC AF               XOR A
7005+ C5FD 32 FE 82         LD (DeathSubPixelAcc), A
7006+ C600 32 01 83         LD (DeathStuckCounter), A
7007+ C603 32 04 83         LD (DeathGhostMode), A
7008+ C606 21 00 00         LD HL, 0
7009+ C609 22 02 83         LD (DeathGhostStuckTimer), HL
7010+ C60C                  ; Marcar como spawneada
7011+ C60C 3E 01            LD A, 1
7012+ C60E 32 FD 82         LD (DeathSpawned), A
7013+ C611                  ; Arrancar musica de tension de la muerte (track 4, loopable). Suena
7014+ C611                  ; mientras Death este en pantalla; se silencia en transiciones de sala
