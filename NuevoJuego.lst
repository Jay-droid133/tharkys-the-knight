  52+ 9887              ; --- AY_UpdateBell: cada frame ---
  53+ 9887              ; SP alterno (slot 1) durante el page switch para no enmascarar IRQs. DI corto
  54+ 9887              ; SOLO alrededor del Impl (que hace varios OUTs AY que deben ser atomicos
  55+ 9887              ; respecto al handler IRQ que tambien escribe AY). Ver project_paging_alt_stack.
  56+ 9887              AY_UpdateBell:
  57+ 9887 ED 73 B4 98      LD (.aubSavedSP), SP
  58+ 988B 31 D5 68         LD SP, PagingAltStackTop
  59+ 988E 3A 8A 8D         LD A, (CurrentPaging)
  60+ 9891 E6 F8            AND $F8
  61+ 9893 F6 04            OR 4
  62+ 9895 32 8A 8D         LD (CurrentPaging), A
  63+ 9898 01 FD 7F         LD BC, $7FFD
  64+ 989B ED 79            OUT (C), A                      ; slot 3 = bank 4 (sin DI; SP alterno)
  65+ 989D F3               DI                              ; cierra ventana antes de los OUTs AY del Impl
  66+ 989E CD 81 E5         CALL AY_UpdateBellImpl
  67+ 98A1 FB               EI
  68+ 98A2 3A 8A 8D         LD A, (CurrentPaging)
  69+ 98A5 E6 F8            AND $F8
  70+ 98A7 32 8A 8D         LD (CurrentPaging), A
  71+ 98AA 01 FD 7F         LD BC, $7FFD
  72+ 98AD ED 79            OUT (C), A                      ; slot 3 = bank 0 (sin DI; SP alterno)
  73+ 98AF ED 7B B4 98      LD SP, (.aubSavedSP)
  74+ 98B3 C9               RET
  75+ 98B4 00 00        .aubSavedSP: DEFW 0
  76+ 98B6
  77+ 98B6              ; --- UpdateMusic: cada frame (driver tabular generico, content-agnostic) ---
  78+ 98B6              UpdateMusic:
  79+ 98B6 F3               DI
  80+ 98B7 3A 8A 8D         LD A, (CurrentPaging)
  81+ 98BA E6 F8            AND $F8
  82+ 98BC F6 04            OR 4
  83+ 98BE 32 8A 8D         LD (CurrentPaging), A
  84+ 98C1 01 FD 7F         LD BC, $7FFD
  85+ 98C4 ED 79            OUT (C), A
  86+ 98C6 CD 92 7D         CALL UpdateMusicImpl
  87+ 98C9 3A 8A 8D         LD A, (CurrentPaging)
  88+ 98CC E6 F8            AND $F8
  89+ 98CE 32 8A 8D         LD (CurrentPaging), A
  90+ 98D1 01 FD 7F         LD BC, $7FFD
  91+ 98D4 ED 79            OUT (C), A
  92+ 98D6 FB               EI
  93+ 98D7 C9               RET
  94+ 98D8
  95+ 98D8              ; --- AY_PlayBellChime: medianoche/iglesia, cold ---
  96+ 98D8              ; D = pan (-1=izq, 0=centro, +1=der). Preservar D atraviesa el thunk porque
  97+ 98D8              ; el patron page-switch no toca DE.
  98+ 98D8              ; SP alterno + DI corto solo en el Impl (mismo patron que AY_UpdateBell).
  99+ 98D8              AY_PlayBellChime:
 100+ 98D8 ED 73 05 99      LD (.apbcSavedSP), SP
 101+ 98DC 31 D5 68         LD SP, PagingAltStackTop
 102+ 98DF 3A 8A 8D         LD A, (CurrentPaging)
 103+ 98E2 E6 F8            AND $F8
 104+ 98E4 F6 04            OR 4
 105+ 98E6 32 8A 8D         LD (CurrentPaging), A
 106+ 98E9 01 FD 7F         LD BC, $7FFD
 107+ 98EC ED 79            OUT (C), A
 108+ 98EE F3               DI
 109+ 98EF CD D6 E4         CALL AY_PlayBellChimeImpl
 110+ 98F2 FB               EI
 111+ 98F3 3A 8A 8D         LD A, (CurrentPaging)
 112+ 98F6 E6 F8            AND $F8
 113+ 98F8 32 8A 8D         LD (CurrentPaging), A
 114+ 98FB 01 FD 7F         LD BC, $7FFD
 115+ 98FE ED 79            OUT (C), A
 116+ 9900 ED 7B 05 99      LD SP, (.apbcSavedSP)
 117+ 9904 C9               RET
 118+ 9905 00 00        .apbcSavedSP: DEFW 0
