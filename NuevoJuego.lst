 157+ 9E7D              ; ==============================================================================
 158+ 9E7D              ; InitEntities - Inicializa la tabla de entidades
 159+ 9E7D              ; ==============================================================================
 160+ 9E7D              ; Limpia todos los slots y configura el slot 0 como player.
 161+ 9E7D              ; ==============================================================================
 162+ 9E7D              InitEntities:
 163+ 9E7D                  ; Limpiar toda la tabla a ceros
 164+ 9E7D 21 9B 81         LD HL, EntityTable
 165+ 9E80 11 9C 81         LD DE, EntityTable + 1
 166+ 9E83 01 0F 01         LD BC, NUM_ENTITIES * ENT_SIZE - 1
 167+ 9E86 AF               XOR A
 168+ 9E87 77               LD (HL), A
 169+ 9E88 ED B0            LDIR
 170+ 9E8A
 171+ 9E8A                  ; Limpiar tabla de atributos salvados
 172+ 9E8A 21 D7 9B         LD HL, SavedAttrTable
 173+ 9E8D 11 D8 9B         LD DE, SavedAttrTable + 1
 174+ 9E90 01 31 01         LD BC, NUM_ENTITIES * 18 - 1
 175+ 9E93 AF               XOR A
 176+ 9E94 77               LD (HL), A
 177+ 9E95 ED B0            LDIR
 178+ 9E97
 179+ 9E97                  ; Configurar slot 0: Player
 180+ 9E97 DD 21 9B 81      LD IX, EntityTable
 181+ 9E9B DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE
 182+ 9E9F DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
 183+ 9EA3 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
 184+ 9EA7 DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
 185+ 9EAB DD 36 04 A0      LD (IX+ENT_POSY), START_PLAYER_Y
 186+ 9EAF DD 36 05 47      LD (IX+ENT_ATTR), WHITE | $40       ; Bright blanco
 187+ 9EB3 DD 36 06 00      LD (IX+ENT_DELTAX), 0
 188+ 9EB7 DD 36 07 00      LD (IX+ENT_DELTAY), 0
 189+ 9EBB DD 36 08 00      LD (IX+ENT_ANIMBASE), SPRID_IDLE
 190+ 9EBF DD 36 09 0A      LD (IX+ENT_ANIMTIMER), ANIM_DELAY_IDLE
 191+ 9EC3 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
 192+ 9EC7 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
 193+ 9ECB DD 36 0C 78      LD (IX+ENT_OLDX), START_PLAYER_X
 194+ 9ECF DD 36 0D A0      LD (IX+ENT_OLDY), START_PLAYER_Y
 195+ 9ED3 DD 36 0E 00      LD (IX+ENT_OLDSPRID), SPRID_IDLE
 196+ 9ED7 DD 36 0F 78      LD (IX+ENT_DRAWX), START_PLAYER_X
