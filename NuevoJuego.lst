 387  F94F                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ F94F              ; ==============================================================================
   2+ F94F              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ F94F              ; ==============================================================================
   4+ F94F              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ F94F              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ F94F              ;
   7+ F94F              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ F94F              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ F94F              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ F94F              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ F94F              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ F94F              ; ==============================================================================
  13+ F94F
  14+ F94F              ; ==============================================================================
  15+ F94F              ; PlaySFX - Reproduce un efecto de sonido
  16+ F94F              ; ==============================================================================
  17+ F94F              ; Entrada: HL = puntero a datos del efecto
  18+ F94F              ; Modifica: AF, BC, DE, HL
  19+ F94F              ; ==============================================================================
  20+ F94F              PlaySFX:
  21+ F94F F3               DI                          ; Sin interrupciones para audio limpio
  22+ F950 3A E9 90         LD A, (CurrentBorderColor)
  23+ F953 E6 07            AND $07                     ; Solo bits de color del borde
  24+ F955 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ F956
  26+ F956              .nextStep:
  27+ F956 7E               LD A, (HL)                  ; Leer duration
  28+ F957 B7               OR A
  29+ F958 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ F95A
  31+ F95A 47               LD B, A                     ; B = duration (bucle externo)
  32+ F95B 23               INC HL
  33+ F95C 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ F95D 23               INC HL
  35+ F95E 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ F95F 23               INC HL
  37+ F960 7E               LD A, (HL)                  ; A = flags
  38+ F961 23               INC HL
  39+ F962 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ F963 CB 47            BIT 0, A
  41+ F965 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ F967
  43+ F967              ; --- Bucle de tono normal ---
  44+ F967              .toneLoop:
  45+ F967                  ; Semi-periodo HIGH
  46+ F967 7B               LD A, E
  47+ F968 F6 10            OR $10                      ; bit 4 = speaker ON
  48+ F96A D3 FE            OUT ($FE), A
  49+ F96C 79               LD A, C                     ; A = pitch actual
  50+ F96D              .toneDelayHi:
  51+ F96D 3D               DEC A
  52+ F96E 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ F970
  54+ F970                  ; Semi-periodo LOW
  55+ F970 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ F971 D3 FE            OUT ($FE), A
  57+ F973 79               LD A, C
  58+ F974              .toneDelayLo:
  59+ F974 3D               DEC A
  60+ F975 20 FD            JR NZ, .toneDelayLo
  61+ F977
  62+ F977                  ; Aplicar pitch sweep
  63+ F977 79               LD A, C
  64+ F978 82               ADD A, D                    ; pitch += pitchDelta
  65+ F979 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ F97B FA 83 F9         JP M, .toneClamp            ; evitar pitch negativo
  67+ F97E 4F               LD C, A
  68+ F97F              .toneAfterClamp:
  69+ F97F 10 E6            DJNZ .toneLoop
  70+ F981 18 30            JR .stepDone
  71+ F983
  72+ F983              .toneClamp:
  73+ F983 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ F985 18 F8            JR .toneAfterClamp
  75+ F987
  76+ F987              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ F987              .noiseLoop:
  78+ F987                  ; Semi-periodo HIGH con ruido
  79+ F987 7B               LD A, E
  80+ F988 F6 10            OR $10
  81+ F98A D3 FE            OUT ($FE), A
  82+ F98C ED 5F            LD A, R                     ; R register como PRNG
  83+ F98E A9               XOR C                       ; mezclar con pitch base
  84+ F98F E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ F991 F6 01            OR $01                      ; minimo 1
  86+ F993              .noiseDelayHi:
  87+ F993 3D               DEC A
  88+ F994 20 FD            JR NZ, .noiseDelayHi
  89+ F996
  90+ F996                  ; Semi-periodo LOW
  91+ F996 7B               LD A, E
  92+ F997 D3 FE            OUT ($FE), A
  93+ F999 ED 5F            LD A, R
  94+ F99B A9               XOR C
  95+ F99C E6 1F            AND $1F
  96+ F99E F6 01            OR $01
  97+ F9A0              .noiseDelayLo:
  98+ F9A0 3D               DEC A
  99+ F9A1 20 FD            JR NZ, .noiseDelayLo
 100+ F9A3
 101+ F9A3                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ F9A3 79               LD A, C
 103+ F9A4 82               ADD A, D
 104+ F9A5 28 08            JR Z, .noiseClamp
 105+ F9A7 FA AF F9         JP M, .noiseClamp
 106+ F9AA 4F               LD C, A
 107+ F9AB              .noiseAfterClamp:
 108+ F9AB 10 DA            DJNZ .noiseLoop
 109+ F9AD 18 04            JR .stepDone
 110+ F9AF
 111+ F9AF              .noiseClamp:
 112+ F9AF 0E 01            LD C, 1
 113+ F9B1 18 F8            JR .noiseAfterClamp
 114+ F9B3
 115+ F9B3              .stepDone:
 116+ F9B3 E1               POP HL                      ; Recuperar puntero al siguiente paso
 117+ F9B4 18 A0            JR .nextStep
 118+ F9B6
 119+ F9B6              .done:
 120+ F9B6 7B               LD A, E                     ; Asegurar speaker OFF al terminar
 121+ F9B7 D3 FE            OUT ($FE), A
 122+ F9B9 FB               EI
 123+ F9BA C9               RET
 124+ F9BB
 125+ F9BB              ; ==============================================================================
 126+ F9BB              ; DATOS DE EFECTOS DE SONIDO
 127+ F9BB              ; ==============================================================================
 128+ F9BB
 129+ F9BB              ; --- SFX_FootstepTic / Tac: "tic-tac" breve al andar ---
 130+ F9BB              ; Dos variantes alternas: agudo ("tic") y grave ("tac"), muy cortos
 131+ F9BB              SFX_FootstepTic:
 132+ F9BB 03 12 00 00      DEFB 3, 18, 0, 0            ; click agudo brevísimo
 133+ F9BF 00               DEFB 0                      ; fin
 134+ F9C0
 135+ F9C0              SFX_FootstepTac:
 136+ F9C0 03 1E 00 00      DEFB 3, 30, 0, 0            ; click grave brevísimo
 137+ F9C4 00               DEFB 0                      ; fin
 138+ F9C5
 139+ F9C5              ; --- SFX_Attack: "swish" rapido descendente (~60ms) ---
 140+ F9C5              ; Dos pasos: sweep rapido de agudo a grave
