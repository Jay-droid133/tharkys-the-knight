 709+ E08D              ; Tabla scripted de la animacion de la mano abierta. 1 byte por slot visible:
 710+ E08D              ;   0 = BgGfx_BankHandOpen1 (frame 1, primera pose)
 711+ E08D              ;   1 = BgGfx_BankHandOpen2 (frame 2, segunda pose)
 712+ E08D              ; Secuencia: 1 1 2 1 2 1 1 (visible al usuario). Termina en frame 1.
 713+ E08D              ; LABEL LOCAL (con dot) para preservar el scope sjasmplus de UpdateBankCutscene
 714+ E08D              ; — un label global aqui rompe el scope de los .bcPhXxx posteriores en el
 715+ E08D              ; dispatcher.
 716+ E08D              .openHandSeq:
 717+ E08D 00 00 01 00      DEFB 0, 0, 1, 0, 1, 0, 0
