  19+ 8D96              ; MaiComputeFlowField
  20+ 8D96              ; ==============================================================================
  21+ 8D96              ; BFS de distancias desde la celda del player a todas las celdas del screen
  22+ 8D96              ; actual. FlowField[cy*32+cx] = distancia (celdas bloqueadas/inalcanzables
  23+ 8D96              ; quedan en $FF).
  24+ 8D96              ;
  25+ 8D96              ; Usa un stack temporal en bank 2 durante la ventana de paginacion porque el
  26+ 8D96              ; BFS interno hace CALLs a .tryCell que empujan/popean return addresses.
  27+ 8D96              ;
  28+ 8D96              ; Input: EntityTable[SLOT_PLAYER].POSX/POSY (pixeles)
  29+ 8D96              ; Output: FlowField relleno en bank 6
  30+ 8D96              ; Destruye: AF, BC, DE, HL
  31+ 8D96              ; ==============================================================================
  32+ 8D96              MaiComputeFlowField:
  33+ 8D96                  ; --- Celda del player en char-space (antes de cambiar stack) ---
  34+ 8D96 3A 9E 81         LD A, (EntityTable + ENT_POSX)
  35+ 8D99 0F               RRCA
  36+ 8D9A 0F               RRCA
  37+ 8D9B 0F               RRCA
  38+ 8D9C E6 1F            AND $1F
  39+ 8D9E 32 B1 97         LD (MaiFlowPlCx), A
  40+ 8DA1
  41+ 8DA1 3A 9F 81         LD A, (EntityTable + ENT_POSY)
  42+ 8DA4 D6 10            SUB SCREEN_MIN_Y
  43+ 8DA6 0F               RRCA
  44+ 8DA7 0F               RRCA
  45+ 8DA8 0F               RRCA
  46+ 8DA9 E6 1F            AND $1F
  47+ 8DAB 32 B2 97         LD (MaiFlowPlCy), A
  48+ 8DAE
  49+ 8DAE                  ; --- Swap a stack temporal (bank 2) ---
  50+ 8DAE ED 73 B8 97      LD (MaiFlowSavedSP), SP
  51+ 8DB2 31 58 98         LD SP, MaiTempStackTop
  52+ 8DB5
  53+ 8DB5                  ; --- Ventana de paginacion ---
  54+ 8DB5                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 8DB5 F3               DI
  56+ 8DB6 3A 82 8D         LD A, (CurrentPaging)
  57+ 8DB9 E6 F8            AND $F8
  58+ 8DBB F6 06            OR 6
  59+ 8DBD 32 82 8D         LD (CurrentPaging), A
  60+ 8DC0 01 FD 7F         LD BC, $7FFD
  61+ 8DC3 ED 79            OUT (C), A
  62+ 8DC5
  63+ 8DC5                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 8DC5 CD E1 8D         CALL MaiFlowBfs
  65+ 8DC8
  66+ 8DC8                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 8DC8 3A 82 8D         LD A, (CurrentPaging)
  68+ 8DCB E6 F8            AND $F8
  69+ 8DCD 32 82 8D         LD (CurrentPaging), A
  70+ 8DD0 01 FD 7F         LD BC, $7FFD
  71+ 8DD3 ED 79            OUT (C), A
  72+ 8DD5
  73+ 8DD5 ED 7B B8 97      LD SP, (MaiFlowSavedSP)         ; restaurar stack original
  74+ 8DD9 3A 9A 81         LD A, (StartupComplete)
  75+ 8DDC B7               OR A
  76+ 8DDD 28 01            JR Z, .mcffNoEI                 ; aun en Inicio -> dejar DI
  77+ 8DDF FB               EI
  78+ 8DE0              .mcffNoEI:
  79+ 8DE0 C9               RET
  80+ 8DE1
