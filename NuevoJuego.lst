 268+ 9ADF 47               LD B, A                     ; B = atributo (preservar)
 269+ 9AE0 3A D9 9B         LD A, (EntityAttrH)
 270+ 9AE3 4F               LD C, A                     ; C = filas
 271+ 9AE4              .rowLoop:
 272+ 9AE4                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9AE4 E5               PUSH HL
 274+ 9AE5 7C               LD A, H
 275+ 9AE6 FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9AE8 20 08            JR NZ, .rowNotHud
 277+ 9AEA 7D               LD A, L
 278+ 9AEB FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9AED 30 03            JR NC, .rowNotHud
 280+ 9AEF                  ; Fila en HUD → saltar sin pintar
 281+ 9AEF E1               POP HL
 282+ 9AF0 18 0B            JR .rowSkip
 283+ 9AF2              .rowNotHud:
 284+ 9AF2 E1               POP HL
 285+ 9AF3 3A D8 9B         LD A, (EntityAttrW)
 286+ 9AF6 E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9AF7                  ; Pintar una fila
 288+ 9AF7              .colLoop:
 289+ 9AF7 70               LD (HL), B
 290+ 9AF8 23               INC HL
 291+ 9AF9 3D               DEC A
 292+ 9AFA 20 FB            JR NZ, .colLoop
 293+ 9AFC E1               POP HL
 294+ 9AFD              .rowSkip:
 295+ 9AFD                  ; Siguiente fila: HL += 32
