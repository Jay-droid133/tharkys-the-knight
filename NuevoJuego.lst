5223+ BF48 3D               DEC A
5224+ BF49 77               LD (HL), A
5225+ BF4A C2 1A C0         JP NZ, .rmRtNext
5226+ BF4D                  ; Timer expiro: elegir un hueco valido del borde de salida y aplicar
5227+ BF4D                  ; MAI_REENTRY_OFFSET hacia dentro. Usa el filtro ScreenGaps para
5228+ BF4D                  ; garantizar que la huella 2x3 del monster cabe en esa celda.
5229+ BF4D                  ; Calcular target coord: axis variable segun borde de salida.
5230+ BF4D                  ; N/S: cx = POSX/8. W/E: cy = (POSY - BG_Y_OFFSET*8)/8.
5231+ BF4D DD 7E 0A         LD A, (IX+ENT_DIR)
5232+ BF50 FE 01            CP DIR_N
5233+ BF52 28 11            JR Z, .rmRtSideN
5234+ BF54 FE 02            CP DIR_S
5235+ BF56 28 1C            JR Z, .rmRtSideS
