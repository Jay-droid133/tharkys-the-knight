 500+ 68E9              ; ==============================================================================
 501+ 68E9              ; DrawBgSprite16XorAtPixel - draw 16px-wide BG sprite at arbitrary pixel pos
 502+ 68E9              ; ==============================================================================
 503+ 68E9              ; Especializado para sprites de 2 bytes de ancho (16 px, como las 3 estatuas).
 504+ 68E9              ; Permite posicion sub-char en X (shift bits) Y (scan line).
 505+ 68E9              ;
 506+ 68E9              ; IN: BgSpriteBuffer pre-cargado con el sprite completo (header incluido).
 507+ 68E9              ;     D = pixel Y (0-191, post-HUD ya aplicado).
 508+ 68E9              ;     E = pixel X (0-255).
 509+ 68E9              ; Para shift>0, escribe 3 bytes por scan line; para shift=0 escribe 2.
 510+ 68E9              ; Solo XOR de pixels (no toca attrs).
 511+ 68E9              ; Destruye: AF, BC, DE, HL, IX.
 512+ 68E9              ; ==============================================================================
 513+ 68E9              DrawBgSprite16XorAtPixel:
 514+ 68E9 DD 21 87 89      LD IX, BgSpriteBuffer
 515+ 68ED DD 7E 00         LD A, (IX+0)                            ; height_px
 516+ 68F0 B7               OR A
 517+ 68F1 C8               RET Z
 518+ 68F2 32 55 69         LD (.dbsHeight), A
 519+ 68F5 DD 23            INC IX
 520+ 68F7 DD 23            INC IX                                  ; -> pixel data
 521+ 68F9                  ; Shift = E & 7 ; aligned X = E & ~7
 522+ 68F9 7B               LD A, E
 523+ 68FA E6 07            AND $07
 524+ 68FC 32 56 69         LD (.dbsShift), A
 525+ 68FF 7B               LD A, E
 526+ 6900 E6 F8            AND $F8
 527+ 6902 5F               LD E, A
 528+ 6903 CD 92 A0         CALL CalcPixelAddr                      ; HL = VRAM addr
 529+ 6906              .dbsRow:
 530+ 6906 E5               PUSH HL                                 ; save row start
 531+ 6907                  ; --- Byte 0 del sprite ---
 532+ 6907 DD 7E 00         LD A, (IX+0)
 533+ 690A 2F               CPL                                     ; un-invert
 534+ 690B 57               LD D, A                                 ; D = sprite byte
 535+ 690C 1E 00            LD E, 0                                 ; E = bits que caen al siguiente byte
 536+ 690E 3A 56 69         LD A, (.dbsShift)
 537+ 6911 B7               OR A
 538+ 6912 28 07            JR Z, .dbsNoShift0
 539+ 6914 47               LD B, A
 540+ 6915              .dbsShift0Loop:
 541+ 6915 CB 3A            SRL D
 542+ 6917 CB 1B            RR E
 543+ 6919 10 FA            DJNZ .dbsShift0Loop
 544+ 691B              .dbsNoShift0:
 545+ 691B 7A               LD A, D
 546+ 691C AE               XOR (HL)
 547+ 691D 77               LD (HL), A                              ; write VRAM byte 0 (sin prev carry)
 548+ 691E 23               INC HL
 549+ 691F 4B               LD C, E                                 ; C = carry para siguiente byte
 550+ 6920                  ; --- Byte 1 del sprite ---
 551+ 6920 DD 7E 01         LD A, (IX+1)
 552+ 6923 2F               CPL
 553+ 6924 57               LD D, A
 554+ 6925 1E 00            LD E, 0
 555+ 6927 3A 56 69         LD A, (.dbsShift)
 556+ 692A B7               OR A
 557+ 692B 28 07            JR Z, .dbsNoShift1
 558+ 692D 47               LD B, A
 559+ 692E              .dbsShift1Loop:
 560+ 692E CB 3A            SRL D
 561+ 6930 CB 1B            RR E
 562+ 6932 10 FA            DJNZ .dbsShift1Loop
 563+ 6934              .dbsNoShift1:
 564+ 6934 7A               LD A, D
 565+ 6935 B1               OR C                                    ; combinar con carry de byte 0
 566+ 6936 AE               XOR (HL)
 567+ 6937 77               LD (HL), A
 568+ 6938 23               INC HL
