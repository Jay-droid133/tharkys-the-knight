 421+ A03B                  ; --- Primer frame (pantalla recien dibujada): logica + draw, sin erase ---
 422+ A03B              .plFresh:
 423+ A03B DD CB 0B 9E      RES ENTF_NEWSPAWN, (IX+ENT_FLAGS)
 424+ A03F CD 91 A5         CALL UpdatePlayer
 425+ A042 CD AA A4         CALL CalcDrawX
 426+ A045 CD 14 9F         CALL ComputePlayerDrawY
 427+ A048 CD EF A4         CALL GetSpriteAddr
 428+ A04B
 429+ A04B 3A E1 82         LD A, (PlayerDrawY)
 430+ A04E 57               LD D, A
 431+ A04F DD 7E 0F         LD A, (IX+ENT_DRAWX)
 432+ A052 5F               LD E, A
 433+ A053 DD E5            PUSH IX
