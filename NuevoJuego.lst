2290+ DAAC              ; ==============================================================================
2291+ DAAC              ; UpdatePickupFlash - Parpadeo on/off de un pickup recién spawnado.
2292+ DAAC              ; ==============================================================================
2293+ DAAC              ; Cada PICKUP_FLASH_PERIOD frames hace un XOR redraw del sprite (toggle
2294+ DAAC              ; visible/invisible). Tras PickupFlashToggles toggles para de parpadear.
2295+ DAAC              ; Como toggles inicial es par, termina en estado visible.
2296+ DAAC              ; Llamado desde MainLoop tras RefreshPickupAttrs.
2297+ DAAC              ; ==============================================================================
2298+ DAAC              UpdatePickupFlash:
2299+ DAAC 3A D2 82         LD A, (PickupFlashToggles)
2300+ DAAF B7               OR A
2301+ DAB0 C8               RET Z                       ; no hay parpadeo activo
2302+ DAB1 3A D3 82         LD A, (PickupFlashFrames)
2303+ DAB4 3D               DEC A
2304+ DAB5 32 D3 82         LD (PickupFlashFrames), A
2305+ DAB8 B7               OR A
2306+ DAB9 C0               RET NZ                      ; aún no toca toggle
2307+ DABA                  ; Reset frame counter, decrementar toggles
2308+ DABA 3E 03            LD A, PICKUP_FLASH_PERIOD
2309+ DABC 32 D3 82         LD (PickupFlashFrames), A
2310+ DABF 3A D2 82         LD A, (PickupFlashToggles)
2311+ DAC2 3D               DEC A
2312+ DAC3 32 D2 82         LD (PickupFlashToggles), A
2313+ DAC6                  ; Toggle XOR del sprite (church_key hardcoded por ahora)
2314+ DAC6 11 ED D7         LD DE, BgGfx_church_key
2315+ DAC9 C3 48 DA         JP RedrawPickupByPtr        ; tail call
2316+ DACC
2317+ DACC              ; ==============================================================================
2318+ DACC              ; CheckBumpTriggers - cada frame, si player AABB toca un sprite bump-trigger
2319+ DACC              ; ==============================================================================
2320+ DACC              ; en la pantalla actual y tiene la key correcta, dispara la acción.
2321+ DACC              ; Player AABB = 16×16 en (EntityTable[ENT_POSX/POSY]).
2322+ DACC              ; Sprite AABB se extiende +1 pixel en cada lado para detectar "pegado".
2323+ DACC              ; Como los chars del sprite son walls (vía WallAlwaysTable), el player nunca
2324+ DACC              ; se solapa físicamente con él — solo puede estar pegado por algún borde.
2325+ DACC              ; ==============================================================================
2326+ DACC              CheckBumpTriggers:
2327+ DACC 21 5D E1         LD HL, PickupTable
2328+ DACF              .cbtLoop:
2329+ DACF 7E               LD A, (HL)
2330+ DAD0 FE FF            CP $FF
2331+ DAD2 C8               RET Z
2332+ DAD3 FE FE            CP $FE
2333+ DAD5 CA 34 DC         JP Z, .cbtSkipInactive
2334+ DAD8 47               LD B, A                         ; mapX
2335+ DAD9 23               INC HL
2336+ DADA 3A 08 83         LD A, (CurrentScreenX)
2337+ DADD B8               CP B
2338+ DADE C2 2D DC         JP NZ, .cbtSkipMapY
2339+ DAE1 4E               LD C, (HL)                      ; mapY
2340+ DAE2 23               INC HL
2341+ DAE3 3A 09 83         LD A, (CurrentScreenY)
2342+ DAE6 B9               CP C
2343+ DAE7 C2 26 DC         JP NZ, .cbtSkipPtr
2344+ DAEA                  ; Pantalla actual: leer ptr
2345+ DAEA E5               PUSH HL                         ; entry en ptr_lo
2346+ DAEB 5E               LD E, (HL)
2347+ DAEC 23               INC HL
2348+ DAED 56               LD D, (HL)                      ; DE = ptr
2349+ DAEE CD 2A DA         CALL LookupBumpTrigger          ; A = action, C = key
2350+ DAF1 B7               OR A
2351+ DAF2 CA 25 DC         JP Z, .cbtPopNext               ; no es bump-trigger
2352+ DAF5 32 3F DC         LD (.cbtAction), A              ; salvar action (B se reusa abajo)
2353+ DAF8 3A AE 82         LD A, (CurrentKey)
2354+ DAFB B9               CP C
2355+ DAFC C2 25 DC         JP NZ, .cbtPopNext              ; sin la key correcta
2356+ DAFF                  ; Match: cargar sprite para conocer dimensiones y testear AABB.
2357+ DAFF                  ; (action ya está en .cbtAction; BC libre para usar como dimensiones)
2358+ DAFF EB               EX DE, HL                       ; HL = sprite ptr
2359+ DB00 3E 03            LD A, 3                         ; PickupTable ptrs viven en bank 3
2360+ DB02 CD BC 6A         CALL LoadBgSpriteToBuffer
2361+ DB05 21 F5 89         LD HL, BgSpriteBuffer
2362+ DB08 7E               LD A, (HL)                      ; height_px
2363+ DB09 32 3E DC         LD (.cbtSpH), A
2364+ DB0C 23               INC HL
2365+ DB0D 7E               LD A, (HL)
2366+ DB0E E6 7F            AND $7F
2367+ DB10 87               ADD A, A                        ; *2
2368+ DB11 87               ADD A, A                        ; *4
2369+ DB12 87               ADD A, A                        ; *8 = width_px
2370+ DB13 32 3D DC         LD (.cbtSpW), A
2371+ DB16                  ; Recuperar charX/charY de la entry (POP HL → entry ptr_lo, +2 = charX)
2372+ DB16 E1               POP HL                          ; HL en ptr_lo
2373+ DB17 E5               PUSH HL                         ; volver a guardar para el handler
2374+ DB18 23               INC HL
2374+ DB19 23             INC HL                 ; skip ptr
2375+ DB1A 7E               LD A, (HL)                      ; charX
2376+ DB1B 87               ADD A, A
2376+ DB1C 87             ADD A, A
2376+ DB1D 87             ADD A, A  ; *8 = px_left
2377+ DB1E 32 3B DC         LD (.cbtSpX), A
2378+ DB21 23               INC HL
2379+ DB22 7E               LD A, (HL)                      ; charY
2380+ DB23 C6 02            ADD A, BG_Y_OFFSET
2381+ DB25 87               ADD A, A
2381+ DB26 87             ADD A, A
2381+ DB27 87             ADD A, A  ; *8 = px_top
2382+ DB28 32 3C DC         LD (.cbtSpY), A
2383+ DB2B                  ; AABB overlap test con extensión +SPEED_RUN pixels en cada lado.
2384+ DB2B                  ; Motivo: el motor revierte el movimiento al chocar, dejando al player
2385+ DB2B                  ; hasta 4 px del wall. Sin esta tolerancia, el bump nunca dispararía.
2386+ DB2B                  ; Horizontal: ext_left = max(0, sprite_left - 4), ext_right = min(255, sprite_right + 4).
2387+ DB2B 3A 9E 81         LD A, (EntityTable + ENT_POSX)
2388+ DB2E 4F               LD C, A                         ; C = player_left
2389+ DB2F C6 10            ADD A, 16                       ; A = player_right
2390+ DB31 57               LD D, A
2391+ DB32                  ; ext_left: sprite_left - 4 con clamp inferior (sin underflow)
2392+ DB32 3A 3B DC         LD A, (.cbtSpX)
2393+ DB35 D6 04            SUB 4
2394+ DB37 30 01            JR NC, .cbtNoUnderflowL
2395+ DB39 AF               XOR A
