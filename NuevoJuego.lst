   2+ E24C              ; AY SOUND - Driver del chip AY-3-8912 (Spectrum 128K)
   3+ E24C              ; ==============================================================================
   4+ E24C              ; Puertos:
   5+ E24C              ;   $FFFD: write = seleccionar registro AY (0-13)
   6+ E24C              ;   $BFFD: write = escribir valor al registro seleccionado
   7+ E24C              ;
   8+ E24C              ; Registros AY:
   9+ E24C              ;   R0/R1: tono canal A (12 bits, period = 1750000 / (16 * frequency))
  10+ E24C              ;   R2/R3: tono canal B
  11+ E24C              ;   R4/R5: tono canal C
  12+ E24C              ;   R6:    period del ruido (5 bits)
  13+ E24C              ;   R7:    mixer (bit 0-2: tonos A/B/C off, bit 3-5: ruido A/B/C off, bit 6-7: I/O)
  14+ E24C              ;          bit a 0 = canal activo, bit a 1 = silenciado
  15+ E24C              ;   R8:    volumen A (bits 0-3) o envelope (bit 4=1)
  16+ E24C              ;   R9:    volumen B
  17+ E24C              ;   R10:   volumen C
  18+ E24C              ;   R11/R12: period del envelope
  19+ E24C              ;   R13:   forma del envelope (0-15)
  20+ E24C              ; ==============================================================================
  21+ E24C
  22+ E24C              ; ==============================================================================
  23+ E24C              ; AY_WriteReg - Escribe un valor en un registro AY
  24+ E24C              ; ==============================================================================
  25+ E24C              ; Entrada: A = registro (0-13), E = valor
  26+ E24C              ; Destruye: BC, A
  27+ E24C              ; ==============================================================================
  28+ E24C              AY_WriteReg:
  29+ E24C 01 FD FF         LD BC, $FFFD
  30+ E24F ED 79            OUT (C), A                  ; seleccionar registro
  31+ E251 01 FD BF         LD BC, $BFFD
  32+ E254 ED 59            OUT (C), E                  ; escribir valor
  33+ E256 C9               RET
  34+ E257
  35+ E257              ; ==============================================================================
  36+ E257              ; AY_Stop - Silencia inmediatamente cualquier sonido en curso
  37+ E257              ; ==============================================================================
  38+ E257              ; Mismo efecto que AY_Init pero pensado para silenciar antes de un SFX beeper
  39+ E257              ; ==============================================================================
  40+ E257              AY_Stop:
  41+ E257 3E 08            LD A, 8
  42+ E259 1E 00            LD E, 0
  43+ E25B CD 4C E2         CALL AY_WriteReg
  44+ E25E 3E 09            LD A, 9
  45+ E260 1E 00            LD E, 0
  46+ E262 CD 4C E2         CALL AY_WriteReg
  47+ E265 3E 0A            LD A, 10
  48+ E267 1E 00            LD E, 0
  49+ E269 CD 4C E2         CALL AY_WriteReg
  50+ E26C C9               RET
  51+ E26D
  52+ E26D              ; ==============================================================================
  53+ E26D              ; AY_Init - Silencia todos los canales (volumen 0, mixer todo off)
  54+ E26D              ; ==============================================================================
  55+ E26D              AY_Init:
  56+ E26D 3E 07            LD A, 7                     ; mixer
  57+ E26F 1E 3F            LD E, $3F                   ; todos los tonos y ruidos en off
  58+ E271 CD 4C E2         CALL AY_WriteReg
  59+ E274 3E 08            LD A, 8                     ; volumen A
  60+ E276 1E 00            LD E, 0
  61+ E278 CD 4C E2         CALL AY_WriteReg
  62+ E27B 3E 09            LD A, 9                     ; volumen B
  63+ E27D 1E 00            LD E, 0
  64+ E27F CD 4C E2         CALL AY_WriteReg
  65+ E282 3E 0A            LD A, 10                    ; volumen C
  66+ E284 1E 00            LD E, 0
  67+ E286 CD 4C E2         CALL AY_WriteReg
  68+ E289 C9               RET
