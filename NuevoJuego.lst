 338  9BAA                  ; ay_sound_thunks: 5 entry thunks (bank 2 → bank 4) para AY routines.
 339  9BAA                  ; Inclusion temprana garantiza aterrizaje en bank 2 con margen.
 340  9BAA                  INCLUDE "ay_sound_thunks.asm"
# file opened: ay_sound_thunks.asm
   1+ 9BAA              ; ==============================================================================
   2+ 9BAA              ; ay_sound_thunks.asm - Bank 2 entry thunks para ay_sound.asm (vive en bank 4)
   3+ 9BAA              ; ==============================================================================
   4+ 9BAA              ; Las 5 funciones publicas de ay_sound.asm tienen aqui un thunk que paga bank 4
   5+ 9BAA              ; en slot 3, CALLs el Impl, restaura bank 0, y RETurnea. Los thunks viven en
   6+ 9BAA              ; bank 2 ($8000-$BFFF, slot 2) que es siempre visible — el page switch de
   7+ 9BAA              ; slot 3 no mueve el suelo bajo nuestros pies.
   8+ 9BAA              ;
   9+ 9BAA              ; Por que ay_sound es seguro mover (a diferencia de town_gate_cutscene que
  10+ 9BAA              ; fallo en el intento previo):
  11+ 9BAA              ;   1. Self-contained: NO hace ningun CALL/JP a codigo fuera de ay_sound.asm.
  12+ 9BAA              ;      Solo se llama a si mismo (AY_WriteReg, TmAdvanceNote). Cero
  13+ 9BAA              ;      CALL_BANK0 internos, cero superficie de cross-bank.
  14+ 9BAA              ;   2. Variables internas (BellVolL/C/R, BellDecayTimer, MusicPtr,
  15+ 9BAA              ;      MusicTimer) no se leen/escriben desde fuera del modulo. Cuando
  16+ 9BAA              ;      el Impl corre, bank 4 esta paginado → vars accesibles. Externamente
  17+ 9BAA              ;      nadie las toca, asi que no hay corrupcion.
  18+ 9BAA              ;
  19+ 9BAA              ; Patron de cada thunk (pareja DI/EI con page switch):
  20+ 9BAA              ;   - DI durante la ventana: el SP vive en slot 3 ($FF58); cambiar de bank
  21+ 9BAA              ;     mientras una IRQ podria pushear/popear corromperia el stack.
  22+ 9BAA              ;   - CALL <Impl>: pareja CALL/RET sucede con bank 4 paginado, asi que el
  23+ 9BAA              ;     return addr pusheado sale del mismo bank 4 RAM al hacer RET.
  24+ 9BAA              ;   - Tras el RET del Impl, restaura bank 0 (el bank "default" de MainLoop).
  25+ 9BAA              ;   - EI antes del RET final: StartupComplete ya esta a 1 cuando se invocan
  26+ 9BAA              ;     estos thunks (todos requieren el juego ya inicializado), excepto AY_Init
  27+ 9BAA              ;     que se llama en boot — ahi DI sigue en efecto, EI seria prematuro.
  28+ 9BAA              ;     Para AY_Init, hacemos EI condicional via StartupComplete.
  29+ 9BAA              ; ==============================================================================
  30+ 9BAA
  31+ 9BAA              ; --- AY_Init: solo en boot, requiere EI condicional via StartupComplete ---
  32+ 9BAA              AY_Init:
  33+ 9BAA F3               DI
  34+ 9BAB 3A D4 90         LD A, (CurrentPaging)
  35+ 9BAE E6 F8            AND $F8
  36+ 9BB0 F6 04            OR 4
  37+ 9BB2 32 D4 90         LD (CurrentPaging), A
  38+ 9BB5 01 FD 7F         LD BC, $7FFD
  39+ 9BB8 ED 79            OUT (C), A
  40+ 9BBA CD 7E E4         CALL AY_InitImpl
  41+ 9BBD 3A D4 90         LD A, (CurrentPaging)
  42+ 9BC0 E6 F8            AND $F8
  43+ 9BC2 32 D4 90         LD (CurrentPaging), A
  44+ 9BC5 01 FD 7F         LD BC, $7FFD
  45+ 9BC8 ED 79            OUT (C), A
  46+ 9BCA 3A 3E 81         LD A, (StartupComplete)
  47+ 9BCD B7               OR A
  48+ 9BCE C8               RET Z                       ; aun en Inicio -> dejar DI
  49+ 9BCF FB               EI
  50+ 9BD0 C9               RET
  51+ 9BD1
