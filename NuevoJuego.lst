1511+ EFBC              ; ==============================================================================
1512+ EFBC              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1513+ EFBC              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1514+ EFBC              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1515+ EFBC              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1516+ EFBC              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1517+ EFBC              ; ==============================================================================
1518+ EFBC              CompassWobbleTable:
1519+ EFBC 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1520+ EFC0 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1521+ EFC4 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1522+ EFC8 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1523+ EFCC 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1524+ EFD0 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1525+ EFD4 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1526+ EFD8 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1527+ EFDC 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1528+ EFE0
1529+ EFE0              ; ==============================================================================
1530+ EFE0              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1531+ EFE0              ; Indexada por (counter-1) -> 0..8. Valor:
1532+ EFE0              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1533+ EFE0              ; Con counter inicial 9 y decremento por frame:
1534+ EFE0              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1535+ EFE0              ;   counter 8 -> phase 7 -> prev
1536+ EFE0              ;   counter 7 -> phase 6 -> target
1537+ EFE0              ;   counter 6 -> phase 5 -> next
1538+ EFE0              ;   counter 5 -> phase 4 -> next2
1539+ EFE0              ;   counter 4 -> phase 3 -> prev
1540+ EFE0              ;   counter 3 -> phase 2 -> target
1541+ EFE0              ;   counter 2 -> phase 1 -> prev
1542+ EFE0              ;   counter 1 -> phase 0 -> target (estado final, settle)
1543+ EFE0              ; ==============================================================================
1544+ EFE0              WobblePhaseTable:
1545+ EFE0 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1545+ EFE4 04 03 02 01
1545+ EFE8 00
