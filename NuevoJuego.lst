 175+ F1B7 14 05 00 00      DEFB 20, 5, 0, 0           ; tono agudo breve
 176+ F1BB 0F 0C 00 01      DEFB 15, 12, 0, 1          ; crackle de ruido
 177+ F1BF 00               DEFB 0                      ; fin
