2493+ AFF0 CB 7F            BIT 7, A
2494+ AFF2 28 02            JR Z, .eAnimDir
2495+ AFF4 0E 02            LD C, ENEMY_FRAMES_LEFT     ; C = 2 (izquierda)
2496+ AFF6              .eAnimDir:
