 662+ F1F0                  ; --- Magic compass override: ¿activo y fuera de sala destino? ---
 663+ F1F0                  ; Si sí, dibuja Sprite_Compass_Magic + pinta attrs custom (3 chars white
 664+ F1F0                  ; sin bright + char activo white bright; en warning el char activo
 665+ F1F0                  ; parpadea bright on/off a ~6 Hz).
 666+ F1F0                  ; En sala destino (idx 4) o sin path ($FF), cae al render normal — la X
 667+ F1F0                  ; blanca se mantiene tal cual.
 668+ F1F0 3A BF 5F         LD A, (MagicCompassTimer)
 669+ F1F3 47               LD B, A
 670+ F1F4 3A C0 5F         LD A, (MagicCompassTimer + 1)
 671+ F1F7 B0               OR B
 672+ F1F8 28 3E            JR Z, .dcMagicOff
 673+ F1FA 3A 91 F2         LD A, (.dcSpriteIdx)
 674+ F1FD FE 04            CP 4
 675+ F1FF 28 37            JR Z, .dcMagicOff                   ; en sala destino → X blanca normal
 676+ F201 3A C1 5F         LD A, (MagicCompassPathDir)
 677+ F204 FE FF            CP $FF
 678+ F206 28 30            JR Z, .dcMagicOff                   ; sin path → render normal
 679+ F208                  ; --- MAGIC HUD ---
 680+ F208                  ; Cache: el sprite es siempre el mismo dentro de cada modo (temporal vs
 681+ F208                  ; lasting); sólo se redibuja cuando cambia PathDir, cuando MagicCompassPermanent
 682+ F208                  ; cambia (transición temporal↔lasting), o cuando no estaba dibujado todavía.
 683+ F208                  ; El resto de frames basta con repintar los 4 attrs (ultra-barato).
 684+ F208                  ;
 685+ F208                  ; Cache key (LastMagicCompassDrawn, 1 byte):
 686+ F208                  ;   bits 0..1 = MagicCompassPathDir (0=N,1=S,2=W,3=E)
 687+ F208                  ;   bit 7     = MagicCompassPermanent (0=temporal, 1=lasting)
 688+ F208                  ;   $FF       = inválido / no dibujado (set en .dcMagicOff)
 689+ F208                  ; PathDir=$FF queda excluido arriba (.dcMagicOff), así que la composición
 690+ F208                  ; nunca puede coincidir con $FF salvo por bug; cualquier valor real entra
 691+ F208                  ; con bit 7 = MagicCompassPermanent (0 ó $80) y bits bajos en 0..3.
 692+ F208 3A C7 82         LD A, (MagicCompassPermanent)
 693+ F20B B7               OR A
 694+ F20C 28 11            JR Z, .dcMagicTemp
