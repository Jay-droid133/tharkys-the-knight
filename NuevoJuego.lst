4351+ BA57              ; ==============================================================================
4352+ BA57              ; CountActiveNasties / CountActiveMonsters
4353+ BA57              ; ==============================================================================
4354+ BA57              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4355+ BA57              ; Ambas usan _CountSlots internamente.
4356+ BA57              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4357+ BA57              ; ==============================================================================
4358+ BA57              CountActiveNasties:
4359+ BA57 21 BC 81         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4360+ BA5A 06 04            LD B, NUM_NASTIES
4361+ BA5C 18 05            JR _CountSlots
4362+ BA5E
4363+ BA5E              CountActiveMonsters:
4364+ BA5E 21 5C 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4365+ BA61 06 06            LD B, NUM_MONSTERS
