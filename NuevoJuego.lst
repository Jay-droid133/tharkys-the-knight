# file opened: paging.asm
   1+ 8CE1              ; ==============================================================================
   2+ 8CE1              ; PAGING - Control de bancos RAM del Spectrum 128K
   3+ 8CE1              ; ==============================================================================
   4+ 8CE1              ; Port $7FFD (write-only):
   5+ 8CE1              ;   bits 0-2: banco RAM en slot 3 ($C000-$FFFF)
   6+ 8CE1              ;   bit 3:    pantalla (0=normal, 1=shadow)
   7+ 8CE1              ;   bit 4:    ROM (0=128 editor, 1=48 BASIC)
   8+ 8CE1              ;   bit 5:    disable paging (permanent lock — NO tocar)
   9+ 8CE1              ;
  10+ 8CE1              ; Bancos disponibles:
  11+ 8CE1              ;   Bank 0: mapeado en $C000-$FFFF por defecto. Contiene parte del juego actual.
  12+ 8CE1              ;           NO tocar mientras se ejecuta codigo desde $C000+.
  13+ 8CE1              ;   Bank 1: libre para datos nuevos (contended)
  14+ 8CE1              ;   Bank 2: fijo en $8000-$BFFF, no paginable (no-contended)
  15+ 8CE1              ;   Bank 3: libre para datos nuevos (contended)
  16+ 8CE1              ;   Bank 4: libre para datos nuevos (no-contended)
  17+ 8CE1              ;   Bank 5: pantalla en $4000-$5AFF (contended)
  18+ 8CE1              ;   Bank 6: libre para datos nuevos (no-contended)
  19+ 8CE1              ;   Bank 7: libre (no-contended), usar con cuidado (shadow screen)
  20+ 8CE1              ; ==============================================================================
  21+ 8CE1
  22+ 8CE1              ; Rutinas de paginacion — se ejecutan SIEMPRE desde bank 2 ($8000-$BFFF)
  23+ 8CE1              ; para no machacarse a si mismas al cambiar de banco.
  24+ 8CE1
  25+ 8CE1              ; ==============================================================================
  26+ 8CE1              ; PageBankSlot3 - Cambia el banco en slot 3 ($C000-$FFFF)
  27+ 8CE1              ; ==============================================================================
  28+ 8CE1              ; Entrada: A = banco (0-7)
  29+ 8CE1              ; Preserva: HL, DE, IX, IY
  30+ 8CE1              ; Destruye: A, BC
  31+ 8CE1              ; ==============================================================================
  32+ 8CE1              PageBankSlot3:
  33+ 8CE1 E6 07            AND $07                     ; asegurar solo bits 0-2
  34+ 8CE3 47               LD B, A                     ; guardar banco nuevo
  35+ 8CE4 3A DC 8C         LD A, (CurrentPaging)
  36+ 8CE7 E6 F8            AND $F8                     ; limpiar bits de banco
  37+ 8CE9 B0               OR B                        ; poner nuevo banco
  38+ 8CEA 32 DC 8C         LD (CurrentPaging), A
  39+ 8CED 01 FD 7F         LD BC, $7FFD
  40+ 8CF0 ED 79            OUT (C), A
  41+ 8CF2 C9               RET
  42+ 8CF3
  43+ 8CF3              ; ==============================================================================
  44+ 8CF3              ; InitPaging - Estado inicial de paginacion al arrancar
  45+ 8CF3              ; ==============================================================================
  46+ 8CF3              ; Llamar en el startup antes de cualquier acceso paginado.
  47+ 8CF3              ; Deja bank 0 en slot 3 (que es el default del Spectrum 128K al boot).
  48+ 8CF3              ; ==============================================================================
  49+ 8CF3              InitPaging:
  50+ 8CF3 3E 10            LD A, $10                   ; bank 0, screen normal, ROM 48, paging enabled
  51+ 8CF5 32 DC 8C         LD (CurrentPaging), A
  52+ 8CF8 01 FD 7F         LD BC, $7FFD
  53+ 8CFB ED 79            OUT (C), A
  54+ 8CFD C9               RET
  55+ 8CFE
  56+ 8CFE              ; ==============================================================================
  57+ 8CFE              ; LoadRoomToBuffer - Copia un Room_Txx desde bank 1 a CurrentScreenBuffer
  58+ 8CFE              ; ==============================================================================
  59+ 8CFE              ; IN:  HL = puntero al Room_Txx (direccion en $C000-$FFFF, en bank 1)
  60+ 8CFE              ; OUT: CurrentScreenBuffer relleno con los bytes del room (terminador $0000).
  61+ 8CFE              ;      Paginacion restaurada a bank 0.
  62+ 8CFE              ; Destruye: A, BC, DE, HL
  63+ 8CFE              ;
  64+ 8CFE              ; Formato del room: secuencia de entries de 5 B { DEFW BgPtr, DEFB x,y,v }
  65+ 8CFE              ; hasta encontrar un BgPtr = $0000 que marca el final. Copiamos los 2 bytes
  66+ 8CFE              ; del puntero, y si no es $0000 tambien los 3 bytes de coords, hasta terminador.
  67+ 8CFE              ; ==============================================================================
  68+ 8CFE              LoadRoomToBuffer:
  69+ 8CFE                  ; El stack vive en slot 3 ($FF58). Paginar con CALL a PageBankSlot3
  70+ 8CFE                  ; corromperia el stack: CALL empuja la direccion de retorno en bank X,
  71+ 8CFE                  ; el OUT cambia el slot a bank Y, RET popearia de bank Y → garbage.
  72+ 8CFE                  ; Por eso INLINEAMOS el page-switch aqui, sin CALL intermedios.
  73+ 8CFE                  ;
  74+ 8CFE                  ; Entre los dos OUT no se debe tocar el stack: nada de CALLs, PUSHes
  75+ 8CFE                  ; ni interrupciones (DI). Solo LDs al buffer.
  76+ 8CFE ED 57            LD A, I                         ; P/V = IFF2 (interrupts previos)
  77+ 8D00 F5               PUSH AF                         ; push en bank 0 (slot 3 sigue bank 0)
  78+ 8D01 F3               DI
  79+ 8D02                  ; --- Page bank 1 en slot 3 (inline) ---
  80+ 8D02 3A DC 8C         LD A, (CurrentPaging)
  81+ 8D05 E6 F8            AND $F8
  82+ 8D07 F6 01            OR 1
  83+ 8D09 32 DC 8C         LD (CurrentPaging), A
  84+ 8D0C 01 FD 7F         LD BC, $7FFD
  85+ 8D0F ED 79            OUT (C), A                      ; slot 3 = bank 1
  86+ 8D11                  ; --- Copy loop (HL = Room_Txx en bank 1, DE = buffer) ---
  87+ 8D11 11 93 84         LD DE, CurrentScreenBuffer
  88+ 8D14              .lrbLoop:
  89+ 8D14 7E               LD A, (HL)
  90+ 8D15 12               LD (DE), A
  91+ 8D16 23               INC HL
  92+ 8D17 13               INC DE
  93+ 8D18 4F               LD C, A                         ; C = low byte del ptr
  94+ 8D19 7E               LD A, (HL)
  95+ 8D1A 12               LD (DE), A
  96+ 8D1B 23               INC HL
  97+ 8D1C 13               INC DE
  98+ 8D1D B1               OR C                            ; terminador si ambos = 0
  99+ 8D1E 28 0E            JR Z, .lrbDone
 100+ 8D20                  ; Copiar 3 bytes mas (x, y, v)
 101+ 8D20 7E               LD A, (HL)
 102+ 8D21 12               LD (DE), A
 103+ 8D22 23               INC HL
 104+ 8D23 13               INC DE
 105+ 8D24 7E               LD A, (HL)
 106+ 8D25 12               LD (DE), A
 107+ 8D26 23               INC HL
 108+ 8D27 13               INC DE
 109+ 8D28 7E               LD A, (HL)
 110+ 8D29 12               LD (DE), A
 111+ 8D2A 23               INC HL
 112+ 8D2B 13               INC DE
 113+ 8D2C 18 E6            JR .lrbLoop
 114+ 8D2E              .lrbDone:
 115+ 8D2E                  ; --- Page bank 0 en slot 3 (inline) ---
 116+ 8D2E 3A DC 8C         LD A, (CurrentPaging)
 117+ 8D31 E6 F8            AND $F8                         ; bank 0
 118+ 8D33 32 DC 8C         LD (CurrentPaging), A
 119+ 8D36 01 FD 7F         LD BC, $7FFD
 120+ 8D39 ED 79            OUT (C), A                      ; slot 3 = bank 0 → stack accesible otra vez
 121+ 8D3B                  ; Restaurar IFF original: si estaba deshabilitado (startup), no hacer EI
 122+ 8D3B F1               POP AF                          ; pop desde bank 0 (el que pusimos al entrar)
 123+ 8D3C E0               RET PO                          ; P/V odd = IFF2 era 0 → dejar DI
 124+ 8D3D FB               EI
 125+ 8D3E C9               RET
 126+ 8D3F
 127+ 8D3F              ; ==============================================================================
 128+ 8D3F              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* (bank 3) a BgSpriteBuffer
 129+ 8D3F              ; ==============================================================================
 130+ 8D3F              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF, bank 3)
 131+ 8D3F              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 132+ 8D3F              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 133+ 8D3F              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 134+ 8D3F              ;
 135+ 8D3F              ; Mismo patron que LoadRoomToBuffer: inline page switch (CALL corromperia el
 136+ 8D3F              ; stack que vive en slot 3), DI durante la ventana, IFF2 preservado para no
 137+ 8D3F              ; forzar EI prematuro en startup.
 138+ 8D3F              ; ==============================================================================
 139+ 8D3F              LoadBgSpriteToBuffer:
 140+ 8D3F                  ; Preservar BC: los callers (DrawScreen) usan B=x_char, C=y_char y
 141+ 8D3F                  ; esperan que siga intacto tras la carga. Lo salvamos al principio.
 142+ 8D3F C5               PUSH BC
 143+ 8D40 ED 57            LD A, I
 144+ 8D42 F5               PUSH AF                         ; P/V = IFF2
 145+ 8D43 F3               DI
 146+ 8D44                  ; Page bank 3 inline
 147+ 8D44 3A DC 8C         LD A, (CurrentPaging)
 148+ 8D47 E6 F8            AND $F8
 149+ 8D49 F6 03            OR 3
 150+ 8D4B 32 DC 8C         LD (CurrentPaging), A
 151+ 8D4E 01 FD 7F         LD BC, $7FFD
 152+ 8D51 ED 79            OUT (C), A
 153+ 8D53                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 154+ 8D53                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 155+ 8D53                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 156+ 8D53                  ; Si no → calcular bytes exactos y copiar byte a byte.
 157+ 8D53 11 93 85         LD DE, BgSpriteBuffer
 158+ 8D56                  ; Copiar H (header byte 0)
 159+ 8D56 7E               LD A, (HL)
 160+ 8D57 12               LD (DE), A
 161+ 8D58 32 C5 8D         LD (.lbsHsave), A
 162+ 8D5B 23               INC HL
 163+ 8D5C 13               INC DE
 164+ 8D5D                  ; Copiar W|RLE (header byte 1)
 165+ 8D5D 7E               LD A, (HL)
 166+ 8D5E 12               LD (DE), A
 167+ 8D5F 23               INC HL
 168+ 8D60 13               INC DE
 169+ 8D61 CB 7F            BIT 7, A
 170+ 8D63 20 47            JR NZ, .lbsRleFallback
 171+ 8D65 E6 7F            AND $7F
 172+ 8D67 32 C6 8D         LD (.lbsWsave), A
 173+ 8D6A                  ; --- Copiar H filas de W bytes de pixeles ---
 174+ 8D6A 3A C5 8D         LD A, (.lbsHsave)
 175+ 8D6D B7               OR A
 176+ 8D6E 28 11            JR Z, .lbsAfterPixels           ; H=0, sprite vacio
 177+ 8D70 47               LD B, A                         ; B = H (outer loop)
 178+ 8D71              .lbsPixRow:
 179+ 8D71 3A C6 8D         LD A, (.lbsWsave)
 180+ 8D74 B7               OR A
 181+ 8D75 28 08            JR Z, .lbsPixRowDone
 182+ 8D77 4F               LD C, A                         ; C = W (inner loop)
 183+ 8D78              .lbsPixCol:
 184+ 8D78 7E               LD A, (HL)
 185+ 8D79 12               LD (DE), A
 186+ 8D7A 23               INC HL
 187+ 8D7B 13               INC DE
 188+ 8D7C 0D               DEC C
 189+ 8D7D 20 F9            JR NZ, .lbsPixCol
 190+ 8D7F              .lbsPixRowDone:
 191+ 8D7F 10 F0            DJNZ .lbsPixRow
 192+ 8D81              .lbsAfterPixels:
 193+ 8D81                  ; --- Copiar 1 byte tint ---
 194+ 8D81 7E               LD A, (HL)
 195+ 8D82 12               LD (DE), A
 196+ 8D83 23               INC HL
 197+ 8D84 13               INC DE
 198+ 8D85                  ; --- Copiar AH, AW y luego attrs (AH filas x AW cols) ---
 199+ 8D85 7E               LD A, (HL)
 200+ 8D86 12               LD (DE), A
 201+ 8D87 32 C5 8D         LD (.lbsHsave), A               ; reusar var
 202+ 8D8A 23               INC HL
 203+ 8D8B 13               INC DE
 204+ 8D8C 7E               LD A, (HL)
 205+ 8D8D 12               LD (DE), A
 206+ 8D8E 32 C6 8D         LD (.lbsWsave), A
 207+ 8D91 23               INC HL
 208+ 8D92 13               INC DE
 209+ 8D93 3A C5 8D         LD A, (.lbsHsave)
 210+ 8D96 B7               OR A
 211+ 8D97 28 18            JR Z, .lbsLoadDone              ; sin attrs
 212+ 8D99 47               LD B, A
 213+ 8D9A              .lbsAttrRow:
 214+ 8D9A 3A C6 8D         LD A, (.lbsWsave)
 215+ 8D9D B7               OR A
 216+ 8D9E 28 08            JR Z, .lbsAttrRowDone
 217+ 8DA0 4F               LD C, A
 218+ 8DA1              .lbsAttrCol:
 219+ 8DA1 7E               LD A, (HL)
 220+ 8DA2 12               LD (DE), A
 221+ 8DA3 23               INC HL
 222+ 8DA4 13               INC DE
 223+ 8DA5 0D               DEC C
 224+ 8DA6 20 F9            JR NZ, .lbsAttrCol
 225+ 8DA8              .lbsAttrRowDone:
 226+ 8DA8 10 F0            DJNZ .lbsAttrRow
 227+ 8DAA 18 05            JR .lbsLoadDone
 228+ 8DAC
 229+ 8DAC              .lbsRleFallback:
 230+ 8DAC                  ; Sprite RLE: tamaño desconocido sin parsear, copia BG_SPRITE_BUFFER_SIZE-2
 231+ 8DAC 01 FE 03         LD BC, BG_SPRITE_BUFFER_SIZE - 2
 232+ 8DAF ED B0            LDIR
