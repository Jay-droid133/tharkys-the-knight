   2+ 6D97              ; SFX_PLAYER_HIT_AY - Hit del player no bloqueante, ESTILO BEEPER 48K via AY
   3+ 6D97              ; ==============================================================================
   4+ 6D97              ; Vive en slot 1 ($6000+, siempre visible) → cero coste en bank 2.
   5+ 6D97              ; Direct OUTs a $FFFD/$BFFD → no requiere paging ni thunk.
   6+ 6D97              ;
   7+ 6D97              ; Diseño beeper-style:
   8+ 6D97              ;   - Canal B (center en ABC stereo, lo más estandar en emuladores 128K).
   9+ 6D97              ;   - Vol FIJA al maximo ($0F, bit 4 = 0 → SIN hardware envelope) — emula
  10+ 6D97              ;     la naturaleza on/off del beeper 1-bit del 48K.
  11+ 6D97              ;   - Cutoff ABRUPTO al acabar el sweep (mute R9 = 0 en el ultimo frame).
  12+ 6D97              ;     Sin fade. Asi suena "snappy" como un BEEP del 48K, no "ay-decay".
  13+ 6D97              ;   - Pitch sweep per-frame (PlayerHitPeriod += delta cada frame durante N
  14+ 6D97              ;     frames): inicial agudo → final grave (mismo perfil que SFX beeper de
  15+ 6D97              ;     hits clasicos en 48K).
  16+ 6D97              ;   - AY_UpdatePlayerHit se llama cada 2 IRQs (= 25 Hz) desde el handler IM 2
  17+ 6D97              ;     en music_irq.asm (cold path: salta en RET Z si no hay sweep activo).
  18+ 6D97              ;     Tickear desde IRQ inmuniza la duracion del beep frente a la latencia
  19+ 6D97              ;     de MainLoop (transiciones lentas estiraban el beep antes).
  20+ 6D97              ;
  21+ 6D97              ; Diferencias con beeper real: el AY produce onda cuadrada perfecta al 50%
  22+ 6D97              ; duty, mientras que el beeper 1-bit tiene timing imperfecto que da timbre
  23+ 6D97              ; "sucio". Los bordes abruptos (sin envelope, cutoff instantaneo) son lo que
  24+ 6D97              ; mas vende la estetica beeper sin recurrir a CPU-bit-bang del puerto $FE.
  25+ 6D97              ;
  26+ 6D97              ; Conflicto: bell chimes usan canales A/B/C. Si player hit ocurre durante
  27+ 6D97              ; bell decay, R2/R3/R9 del bell son sobrescritos. En la practica casi nunca
  28+ 6D97              ; coinciden (bell = midnight + countdown; hit = combate gameplay).
  29+ 6D97              ;
  30+ 6D97              ; Llamado desde:
  31+ 6D97              ;   - CheckPlayerEnemyCollision.pHpDmgNotZero (cada hit) — start.
  32+ 6D97              ;   - CheckDeathTouchPlayer (toque de la muerte) — start.
  33+ 6D97              ;   - MainLoop cada frame — update.
  34+ 6D97              ; ==============================================================================
  35+ 6D97
  36+ 6D97              ; --- Estado (slot 1, contended pero acceso solo durante sweep activo) ---
  37+ 6D97 00           PlayerHitFrames:    DEFB 0        ; Frames restantes del sweep (0 = inactivo)
  38+ 6D98 00 00        PlayerHitPeriod:    DEFW 0        ; Period actual (16-bit, R2/R3)
  39+ 6D9A 00 00        PlayerHitDelta:     DEFW 0        ; Delta por frame (parametriza speed/depth)
  40+ 6D9C 00           BeepDurationFrames: DEFB 0        ; Frames restantes del beep BASIC-BEEP-style
  41+ 6D9D                                                ; (0 = inactivo o ya muteado)
  42+ 6D9D
  43+ 6D9D              ; --- Hit (golpe no fatal): sweep snappy, vol max constante, cutoff abrupto ---
  44+ 6D9D              PLAYER_HIT_SWEEP_FRAMES   EQU 4          ; 4 frames @ 25 fps = 160 ms
  45+ 6D9D              PLAYER_HIT_PERIOD_INIT    EQU $0080      ; ~853 Hz (agudo)
  46+ 6D9D              PLAYER_HIT_PERIOD_DELTA   EQU 112        ; +112/frame → final $0240 (~150 Hz)
  47+ 6D9D
  48+ 6D9D              ; --- Death (golpe fatal): mas grave que el hit, ~1s ---
  49+ 6D9D              PLAYER_DEATH_SWEEP_FRAMES EQU 25         ; 25 frames @ 25 fps = 1.0 s
  50+ 6D9D              PLAYER_DEATH_PERIOD_INIT  EQU $0080      ; mismo punto de salida agudo
  51+ 6D9D              PLAYER_DEATH_PERIOD_DELTA EQU 80         ; +80/frame → final $0850 (~52 Hz)
  52+ 6D9D
  53+ 6D9D              ; ==============================================================================
  54+ 6D9D              ; AY_PlayPlayerHit / AY_PlayPlayerDeath - wrappers sobre _AY_PlaySweep
  55+ 6D9D              ; ==============================================================================
  56+ 6D9D              ; Ambos arman el mismo sweep "agudo→grave" beeper-style. Diferencias: frames
  57+ 6D9D              ; totales y delta por frame. R2/R3 iniciales son comunes ($0080 ~853 Hz) → la
  58+ 6D9D              ; tabla los hardcodea.
  59+ 6D9D              ; ==============================================================================
  60+ 6D9D              AY_PlayPlayerHit:
  61+ 6D9D 21 80 00         LD HL, PLAYER_HIT_PERIOD_INIT
  62+ 6DA0 06 04            LD B, PLAYER_HIT_SWEEP_FRAMES
  63+ 6DA2 11 70 00         LD DE, PLAYER_HIT_PERIOD_DELTA
  64+ 6DA5 18 08            JR _AY_PlaySweep
  65+ 6DA7
  66+ 6DA7              AY_PlayPlayerDeath:
  67+ 6DA7 21 80 00         LD HL, PLAYER_DEATH_PERIOD_INIT
  68+ 6DAA 06 19            LD B, PLAYER_DEATH_SWEEP_FRAMES
  69+ 6DAC 11 50 00         LD DE, PLAYER_DEATH_PERIOD_DELTA
  70+ 6DAF                  ; fall through
  71+ 6DAF
  72+ 6DAF              ; IN: HL=period inicial, B=frames, DE=delta.
  73+ 6DAF              _AY_PlaySweep:
  74+ 6DAF 22 98 6D         LD (PlayerHitPeriod), HL
  75+ 6DB2 ED 53 9A 6D      LD (PlayerHitDelta), DE
  76+ 6DB6 78               LD A, B
  77+ 6DB7 32 97 6D         LD (PlayerHitFrames), A
  78+ 6DBA F3               DI
  79+ 6DBB 0E FD            LD C, $FD
  80+ 6DBD 21 C3 6D         LD HL, .phRegs
  81+ 6DC0 C3 20 6E         JP _AY_WriteRegPairs                ; tail call: hace EI + RET
  82+ 6DC3
  83+ 6DC3              .phRegs:
  84+ 6DC3 02 80            DEFB  2, $80          ; R2  = period B lo (= $80, period $0080)
  85+ 6DC5 03 00            DEFB  3, $00          ; R3  = period B hi
  86+ 6DC7 09 0F            DEFB  9, $0F          ; R9  = vol B max FIJA (bit 4 = 0 → SIN envelope)
  87+ 6DC9                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
  88+ 6DC9                                        ; aqui para no cortar las voces A/C de la musica poly2)
  89+ 6DC9 FF               DEFB $FF              ; sentinel
  90+ 6DCA
  91+ 6DCA              ; ==============================================================================
  92+ 6DCA              ; AY_PlayBeep - Pitido BASIC-BEEP-style (vol fija + cutoff abrupto tras N frames)
  93+ 6DCA              ; ==============================================================================
  94+ 6DCA              ; Equivalente al BEEP duration, pitch del 48K. Vol max constante durante N
  95+ 6DCA              ; frames, despues mute abrupto via AY_UpdatePlayerHit (que tickea cada frame).
  96+ 6DCA              ; Canal B (center stereo ABC). No bloqueante.
  97+ 6DCA              ;
  98+ 6DCA              ; IN: HL = period AY canal B (mayor = mas grave).
  99+ 6DCA              ;     B  = duracion en frames (a 25 fps: 4 ≈ 160ms, 11 ≈ 440ms).
 100+ 6DCA              ;
 101+ 6DCA              ; Sugerencias:
 102+ 6DCA              ;   HL=$0080 B=4  → ~853 Hz, ~160ms (beep "tick" del countdown).
 103+ 6DCA              ;   HL=$0040 B=11 → ~1707 Hz, ~440ms (beep "GO!" final, mas largo).
 104+ 6DCA              ; Destruye: A, BC, HL.
 105+ 6DCA              ; ==============================================================================
 106+ 6DCA              AY_PlayBeep:
 107+ 6DCA 78               LD A, B
 108+ 6DCB 32 9C 6D         LD (BeepDurationFrames), A          ; activa el contador de cutoff
 109+ 6DCE F3               DI
 110+ 6DCF 0E FD            LD C, $FD
 111+ 6DD1                  ; R2 = L (period B lo)
 112+ 6DD1 3E 02            LD A, 2
 113+ 6DD3 06 FF            LD B, $FF
 114+ 6DD5 ED 79            OUT (C), A
 115+ 6DD7 7D               LD A, L
 116+ 6DD8 06 BF            LD B, $BF
 117+ 6DDA ED 79            OUT (C), A
 118+ 6DDC                  ; R3 = H (period B hi)
 119+ 6DDC 3E 03            LD A, 3
 120+ 6DDE 06 FF            LD B, $FF
 121+ 6DE0 ED 79            OUT (C), A
 122+ 6DE2 7C               LD A, H
 123+ 6DE3 06 BF            LD B, $BF
 124+ 6DE5 ED 79            OUT (C), A
 125+ 6DE7                  ; R9 = $0F (vol max fija, SIN envelope). R7 mixer ya esta en $38 (set por
 126+ 6DE7                  ; AY_Init) — no tocar para no apagar las voces A/C de la musica poly2.
 127+ 6DE7 21 ED 6D         LD HL, .beepRegs
 128+ 6DEA C3 20 6E         JP _AY_WriteRegPairs                ; tail call: EI + RET
 129+ 6DED
 130+ 6DED              .beepRegs:
 131+ 6DED 09 0F            DEFB  9, $0F          ; vol B = max fija (bit 4 = 0 → sin envelope)
 132+ 6DEF                                        ; (R7 mixer permanece en $38 desde AY_Init — no tocar
 133+ 6DEF                                        ; aqui para no cortar las voces A/C de la musica poly2)
 134+ 6DEF FF               DEFB $FF              ; sentinel
 135+ 6DF0
 136+ 6DF0              ; ==============================================================================
 137+ 6DF0              ; AY_PlayKnockSoft / AY_PlayKnockLoud - Knock percusivo en canal B
 138+ 6DF0              ; ==============================================================================
 139+ 6DF0              ; Dos variantes de knock que comparten cutoff mechanism (BeepDurationFrames):
 140+ 6DF0              ;
 141+ 6DF0              ; Soft (grupos de 3 toques): noise B solo (tone B off), envelope $0200 (~1.2s
 142+ 6DF0              ;   decay). Knock seco, mas discreto. R7 = $2A.
 143+ 6DF0              ;
 144+ 6DF0              ; Loud (grupo de 6 toques): noise B + tone B mix (~217 Hz), envelope $0400
 145+ 6DF0              ;   (~2.4s decay). Knock con "body" del tone, vol perceptual ~3 dB mayor.
 146+ 6DF0              ;   R7 = $28.
 147+ 6DF0              ;
 148+ 6DF0              ; Ambos:
 149+ 6DF0              ;   - R6 = $05 (noise period, chasquido seco/agudo).
 150+ 6DF0              ;   - R9 = $10 (use envelope, bit 4 set).
 151+ 6DF0              ;   - R13 = $09 (decay shape, \___, retrigger en cada call). Va ULTIMO.
 152+ 6DF0              ;   - _uphMuteR9 restaura R7 = $38 al cutoff (cleanup tras knock).
 153+ 6DF0              ;
 154+ 6DF0              ; IN: B = duracion frames cutoff (recomendado 4 = ~160ms).
 155+ 6DF0              ; Destruye: A, BC, HL.
 156+ 6DF0              ; ==============================================================================
 157+ 6DF0              AY_PlayKnockSoft:
 158+ 6DF0 21 02 6E         LD HL, _knockSoftRegs
 159+ 6DF3 18 03            JR _ay_play_knock_seq
 160+ 6DF5
 161+ 6DF5              AY_PlayKnockLoud:
 162+ 6DF5 21 0F 6E         LD HL, _knockLoudRegs
 163+ 6DF8                  ; fall through
 164+ 6DF8
 165+ 6DF8              _ay_play_knock_seq:
 166+ 6DF8 78               LD A, B
 167+ 6DF9 32 9C 6D         LD (BeepDurationFrames), A          ; arma cutoff via ticker
 168+ 6DFC F3               DI
 169+ 6DFD 0E FD            LD C, $FD
 170+ 6DFF C3 20 6E         JP _AY_WriteRegPairs                ; tail-call: EI + RET
 171+ 6E02
 172+ 6E02              _knockSoftRegs:
 173+ 6E02 06 05            DEFB  6, $05          ; R6 noise period
 174+ 6E04 07 2A            DEFB  7, $2A          ; R7 mixer: noise B on, tone B off
 175+ 6E06 0B 00            DEFB 11, $00          ; R11 envelope period lo
 176+ 6E08 0C 02            DEFB 12, $02          ; R12 envelope period hi ($0200 ~1.2s decay)
 177+ 6E0A 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 178+ 6E0C 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 179+ 6E0E FF               DEFB $FF
 180+ 6E0F
 181+ 6E0F              _knockLoudRegs:
 182+ 6E0F 02 00            DEFB  2, $00          ; R2 tone B period lo
 183+ 6E11 03 02            DEFB  3, $02          ; R3 tone B period hi ($0200 ~217 Hz, body grave)
 184+ 6E13 06 05            DEFB  6, $05          ; R6 noise period
 185+ 6E15 07 28            DEFB  7, $28          ; R7 mixer: tone B + noise B both on
 186+ 6E17 0B 00            DEFB 11, $00          ; R11 envelope period lo
 187+ 6E19 0C 04            DEFB 12, $04          ; R12 envelope period hi ($0400 ~2.4s decay)
 188+ 6E1B 09 10            DEFB  9, $10          ; R9 vol B = use envelope
 189+ 6E1D 0D 09            DEFB 13, $09          ; R13 envelope shape \___ (retrigger)
 190+ 6E1F FF               DEFB $FF
 191+ 6E20
 192+ 6E20              ; ==============================================================================
 193+ 6E20              ; _AY_WriteRegPairs - Helper compartido (PlayerHit + Beep)
 194+ 6E20              ; ==============================================================================
 195+ 6E20              ; Escribe pares (reg, val) leidos de HL hasta sentinel $FF. Caller debe haber
 196+ 6E20              ; hecho DI y `LD C, $FD`. Hace EI + RET al final.
 197+ 6E20              ; ==============================================================================
 198+ 6E20              _AY_WriteRegPairs:
 199+ 6E20 7E               LD A, (HL)
 200+ 6E21 FE FF            CP $FF
 201+ 6E23 28 0D            JR Z, .awrpDone
 202+ 6E25 06 FF            LD B, $FF
 203+ 6E27 ED 79            OUT (C), A                          ; AY register select ($FFFD)
 204+ 6E29 23               INC HL
 205+ 6E2A 06 BF            LD B, $BF
 206+ 6E2C 7E               LD A, (HL)
 207+ 6E2D ED 79            OUT (C), A                          ; AY data ($BFFD)
 208+ 6E2F 23               INC HL
 209+ 6E30 18 EE            JR _AY_WriteRegPairs
 210+ 6E32              .awrpDone:
 211+ 6E32 FB               EI
 212+ 6E33 C9               RET
 213+ 6E34
 214+ 6E34              ; ==============================================================================
 215+ 6E34              ; AY_UpdatePlayerHit - Per-frame: sweep R2/R3 hacia grave + cutoff beep
 216+ 6E34              ; ==============================================================================
 217+ 6E34              ; LLAMADO DESDE EL IRQ HANDLER (music_irq.asm) cada 2 IRQs (= 25 Hz). El
 218+ 6E34              ; handler ya tiene interrupts deshabilitados al entrar — esta rutina NO hace
 219+ 6E34              ; DI/EI internos. Si se llamara desde MainLoop, una IRQ podria caer mid-OUT
 220+ 6E34              ; corrompiendo el AY register pointer; pero como solo se llama desde IRQ
 221+ 6E34              ; (con IFF=0), no hay race.
 222+ 6E34              ;
 223+ 6E34              ; Tickea: PlayerHitFrames (sweep hit/death) Y BeepDurationFrames (beep
 224+ 6E34              ; BASIC-style). No-op si ambos inactivos (RET Z).
 225+ 6E34              ; Destruye: A, BC, DE, HL.
 226+ 6E34              ; ==============================================================================
 227+ 6E34              AY_UpdatePlayerHit:
 228+ 6E34 3A 97 6D         LD A, (PlayerHitFrames)
 229+ 6E37 B7               OR A
 230+ 6E38 28 2A            JR Z, .uphCheckBeep
 231+ 6E3A 3D               DEC A
 232+ 6E3B 32 97 6D         LD (PlayerHitFrames), A
 233+ 6E3E 28 2E            JR Z, _uphMuteR9                    ; ultimo frame: cutoff abrupto beeper-style
 234+ 6E40
 235+ 6E40 2A 98 6D         LD HL, (PlayerHitPeriod)
 236+ 6E43 ED 5B 9A 6D      LD DE, (PlayerHitDelta)             ; delta variable (hit=32, death=40)
 237+ 6E47 19               ADD HL, DE
 238+ 6E48 22 98 6D         LD (PlayerHitPeriod), HL
 239+ 6E4B
 240+ 6E4B                  ; Escribir R2 = L, R3 = H (period B). Sin DI/EI: ya en contexto IRQ.
 241+ 6E4B 0E FD            LD C, $FD
 242+ 6E4D 3E 02            LD A, 2
 243+ 6E4F 06 FF            LD B, $FF
 244+ 6E51 ED 79            OUT (C), A
 245+ 6E53 7D               LD A, L
 246+ 6E54 06 BF            LD B, $BF
 247+ 6E56 ED 79            OUT (C), A
 248+ 6E58 3E 03            LD A, 3
 249+ 6E5A 06 FF            LD B, $FF
 250+ 6E5C ED 79            OUT (C), A
 251+ 6E5E 7C               LD A, H
 252+ 6E5F 06 BF            LD B, $BF
 253+ 6E61 ED 79            OUT (C), A
 254+ 6E63 C9               RET
 255+ 6E64
 256+ 6E64              ; --- Tick del beep BASIC-style: decrementa contador, mute al llegar a 0 ---
 257+ 6E64              .uphCheckBeep:
 258+ 6E64 3A 9C 6D         LD A, (BeepDurationFrames)
 259+ 6E67 B7               OR A
 260+ 6E68 C8               RET Z
 261+ 6E69 3D               DEC A
 262+ 6E6A 32 9C 6D         LD (BeepDurationFrames), A
 263+ 6E6D C0               RET NZ
 264+ 6E6E                  ; fall-through al cutoff compartido
 265+ 6E6E
 266+ 6E6E              ; --- Cutoff abrupto compartido: mute R9 (canal B vol = 0). Sin DI/EI. ---
 267+ 6E6E              ; Llamado al final del sweep (PlayerHit/Death), beep o knock.
 268+ 6E6E              ; Tras mute, restaura R7 mixer a $38 (default de AY_Init: tones A/B/C on,
 269+ 6E6E              ; noise A/B/C off). Solo importa para el knock (que cambio R7 a $2A);
 270+ 6E6E              ; para hit/beep es redundante pero idempotente. Coste fijo ~10 T extra.
 271+ 6E6E              _uphMuteR9:
 272+ 6E6E 01 FD FF         LD BC, $FFFD
 273+ 6E71 3E 09            LD A, 9
 274+ 6E73 ED 79            OUT (C), A
 275+ 6E75 01 FD BF         LD BC, $BFFD
 276+ 6E78 AF               XOR A
 277+ 6E79 ED 79            OUT (C), A
 278+ 6E7B                  ; Restaurar R7 mixer al default ($38 = tone ABC on, noise ABC off)
 279+ 6E7B 01 FD FF         LD BC, $FFFD
 280+ 6E7E 3E 07            LD A, 7
 281+ 6E80 ED 79            OUT (C), A
 282+ 6E82 01 FD BF         LD BC, $BFFD
 283+ 6E85 3E 38            LD A, $38
 284+ 6E87 ED 79            OUT (C), A
 285+ 6E89 C9               RET
 286+ 6E8A
