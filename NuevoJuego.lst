 341  E3D3                  INCLUDE "shift_tables.asm"
# file opened: shift_tables.asm
   1+ E3D3              ; ==============================================================================
   2+ E3D3              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
   3+ E3D3              ; ==============================================================================
   4+ E3D3              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
   5+ E3D3              ; Para cada shift S:
   6+ E3D3              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
   7+ E3D3              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
   8+ E3D3              ;
   9+ E3D3              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
  10+ E3D3              ;
  11+ E3D3              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
  12+ E3D3              ;   INC B → pagina overflow. DEC B → restaurar.
  13+ E3D3              ;
  14+ E3D3              ; Calculo de B desde X%8:
  15+ E3D3              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / ADD SHIFT_TABLE_BASE
  16+ E3D3              ; ==============================================================================
  17+ E3D3
  18+ E3D3 00 00 00...      ALIGN 256
  19+ E400              ShiftTables:
  20+ E400                  LUA ALLPASS
  21+ E400 ~                for shift = 1, 7 do
  22+ E400 ~                    -- High part: byte >> shift
  23+ E400 ~                    for i = 0, 255 do
  24+ E400 ~                        sj.add_byte(math.floor(i / (2^shift)))
  25+ E400 ~                    end
  26+ E400 ~                    -- Overflow: byte << (8-shift), modulo 256
  27+ E400 ~                    for i = 0, 255 do
  28+ E400 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
  29+ E400 ~                    end
  30+ E400 ~                end
  31+ E400 00 00 01 01      ENDLUA
