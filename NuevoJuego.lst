   1+ 9CC9              ; ==============================================================================
   2+ 9CC9              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
   3+ 9CC9              ; ==============================================================================
   4+ 9CC9              ; Sistema fiel a Sabre Wulf:
   5+ 9CC9              ; - Sprites de tamanyo variable (width+height en cabecera)
   6+ 9CC9              ; - XOR para draw/erase (dibujar dos veces = borrar)
   7+ 9CC9              ; - NextPixelLine para cruzar character rows y tercios
   8+ 9CC9              ; - Atributos dinamicos segun tamanyo del sprite
   9+ 9CC9              ; ==============================================================================
  10+ 9CC9
  11+ 9CC9              ClearScreen:
  12+ 9CC9 CD AF 0D         CALL ROM_CLS
  13+ 9CCC C9               RET
  14+ 9CCD
  15+ 9CCD              ; ==============================================================================
  16+ 9CCD              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
  17+ 9CCD              ; ==============================================================================
  18+ 9CCD              ; Entrada:
  19+ 9CCD              ;   D = Y pixel (cualquier valor, no requiere alineacion)
  20+ 9CCD              ;   E = X pixel (cualquier valor, no requiere alineacion)
  21+ 9CCD              ;   IX = puntero a datos del sprite (con cabecera width, height)
  22+ 9CCD              ;
  23+ 9CCD              ; Formato del sprite:
  24+ 9CCD              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
  25+ 9CCD              ;   DEFB height_pixels
  26+ 9CCD              ;   DEFB pixel_data... (width * height bytes)
  27+ 9CCD              ;
  28+ 9CCD              ; Dos paths:
  29+ 9CCD              ;   - Alineado (X%8==0): XOR directo, sin tablas
  30+ 9CCD              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
  31+ 9CCD              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
  32+ 9CCD              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
  33+ 9CCD              ;
  34+ 9CCD              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
  35+ 9CCD              ;
  36+ 9CCD              ; Wrapper: sprite_data vive en bank 6 — paginar antes, restaurar despues.
  37+ 9CCD              ; El impl interno (_DrawSpriteImpl) tiene multiples early-exits (RET Z/C);
  38+ 9CCD              ; por eso envuelvo con CALL en vez de inline los early-exits pasarian por
  39+ 9CCD              ; alto la restauracion del bank.
  40+ 9CCD              ; ==============================================================================
  41+ 9CCD              DrawSprite:
  42+ 9CCD                  ; Paging INLINE: no podemos hacer CALL PageBankSlot3 porque su RET
  43+ 9CCD                  ; leeria del stack tras cambiar de banco (el stack vive en slot 3
  44+ 9CCD                  ; que cambia de banco al paginar). Inline evita cruzar el switch.
  45+ 9CCD 3A 82 90         LD A, (CurrentPaging)
  46+ 9CD0 E6 F8            AND $F8
  47+ 9CD2 F6 06            OR 6
  48+ 9CD4 32 82 90         LD (CurrentPaging), A
  49+ 9CD7 01 FD 7F         LD BC, $7FFD
  50+ 9CDA ED 79            OUT (C), A                  ; bank 6 paginado
  51+ 9CDC CD ED 9C         CALL _DrawSpriteImpl
  52+ 9CDF                  ; Restaurar bank 0 (estado normal). Si algun caller tiene otro bank
  53+ 9CDF                  ; paginado (p. ej. monster_ai durante BFS), no nos llama aqui.
  54+ 9CDF 3A 82 90         LD A, (CurrentPaging)
  55+ 9CE2 E6 F8            AND $F8
  56+ 9CE4 32 82 90         LD (CurrentPaging), A
  57+ 9CE7 01 FD 7F         LD BC, $7FFD
  58+ 9CEA ED 79            OUT (C), A
  59+ 9CEC C9               RET
  60+ 9CED
  61+ 9CED              _DrawSpriteImpl:
  62+ 9CED                  ; Guardar posicion
  63+ 9CED 7A               LD A, D
  64+ 9CEE 32 A7 9D         LD (.posY), A
  65+ 9CF1 7B               LD A, E
  66+ 9CF2 32 A6 9D         LD (.posX), A
  67+ 9CF5
  68+ 9CF5                  ; Leer cabecera sprite
  69+ 9CF5 DD 7E 00         LD A, (IX+0)                ; width_bytes
  70+ 9CF8 32 A8 9D         LD (.widthSave), A
  71+ 9CFB DD 7E 01         LD A, (IX+1)                ; height_pixels
  72+ 9CFE 32 A9 9D         LD (.heightSave), A
  73+ 9D01 DD 23            INC IX
  74+ 9D03 DD 23            INC IX                      ; IX → pixel data
  75+ 9D05
  76+ 9D05                  ; === Y CLIPPING ===
  77+ 9D05                  ; Clip superior: si Y < SCREEN_MIN_Y, saltar filas superiores
  78+ 9D05 3A A7 9D         LD A, (.posY)
  79+ 9D08 FE 10            CP SCREEN_MIN_Y
  80+ 9D0A 30 20            JR NC, .clipTopDone
  81+ 9D0C                  ; Filas a saltar = SCREEN_MIN_Y - Y
  82+ 9D0C 47               LD B, A                     ; B = Y
  83+ 9D0D 3E 10            LD A, SCREEN_MIN_Y
  84+ 9D0F 90               SUB B                       ; A = filas a saltar
  85+ 9D10 47               LD B, A                     ; B = skip rows
  86+ 9D11                  ; Reducir altura
  87+ 9D11 3A A9 9D         LD A, (.heightSave)
  88+ 9D14 90               SUB B
  89+ 9D15 C8               RET Z                       ; Sprite completamente fuera → no dibujar
  90+ 9D16 D8               RET C                       ; Idem
  91+ 9D17 32 A9 9D         LD (.heightSave), A
  92+ 9D1A                  ; Avanzar IX: skip_rows * width_bytes
  93+ 9D1A 3A A8 9D         LD A, (.widthSave)
  94+ 9D1D 4F               LD C, A
  95+ 9D1E              .clipSkipRow:
  96+ 9D1E 79               LD A, C
  97+ 9D1F              .clipSkipByte:
  98+ 9D1F DD 23            INC IX
  99+ 9D21 3D               DEC A
 100+ 9D22 20 FB            JR NZ, .clipSkipByte
 101+ 9D24 10 F8            DJNZ .clipSkipRow
 102+ 9D26                  ; Ajustar Y al borde
 103+ 9D26 3E 10            LD A, SCREEN_MIN_Y
 104+ 9D28 32 A7 9D         LD (.posY), A
 105+ 9D2B 57               LD D, A
 106+ 9D2C              .clipTopDone:
 107+ 9D2C                  ; Clip inferior: si Y + height > 192, reducir altura
 108+ 9D2C 3A A7 9D         LD A, (.posY)
 109+ 9D2F 47               LD B, A
 110+ 9D30 3A A9 9D         LD A, (.heightSave)
 111+ 9D33 80               ADD A, B                    ; A = Y + height
 112+ 9D34 38 04            JR C, .clipBot              ; Overflow → fuera por abajo
 113+ 9D36 FE C0            CP 192
 114+ 9D38 38 08            JR C, .clipBotDone          ; Dentro de pantalla
 115+ 9D3A              .clipBot:
 116+ 9D3A                  ; Reducir altura: new_height = 192 - Y
 117+ 9D3A 3E C0            LD A, 192
 118+ 9D3C 90               SUB B                       ; A = 192 - Y
 119+ 9D3D C8               RET Z
 120+ 9D3E D8               RET C
 121+ 9D3F 32 A9 9D         LD (.heightSave), A
 122+ 9D42              .clipBotDone:
 123+ 9D42
 124+ 9D42                  ; Comprobar alineacion
 125+ 9D42 7B               LD A, E
 126+ 9D43 E6 07            AND 7
 127+ 9D45 20 1E            JR NZ, .shifted
 128+ 9D47
 129+ 9D47                  ; ==================================================================
 130+ 9D47                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 131+ 9D47                  ; Optimizado: DE para sprite data (7T/byte vs 19T con IX+0)
 132+ 9D47                  ; ==================================================================
 133+ 9D47 CD 40 A0         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 134+ 9D4A DD E5            PUSH IX
 135+ 9D4C D1               POP DE                      ; DE = puntero a pixel data
 136+ 9D4D 3A A9 9D         LD A, (.heightSave)
