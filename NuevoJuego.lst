 636+ C3FF                  ; ===================== PATH RLE =====================
 637+ C3FF                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 638+ C3FF                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 639+ C3FF                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 640+ C3FF                  ; El estado .rlePending conserva el chunk entre filas:
 641+ C3FF                  ;   0 = necesita nuevo token
 642+ C3FF                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 643+ C3FF                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 644+ C3FF              .rlePixRow:
 645+ C3FF 3A AA C4         LD A, (.widthVal)
 646+ C402 47               LD B, A
 647+ C403 E5               PUSH HL                     ; guardar inicio de fila VRAM
 648+ C404
 649+ C404              .rlePixCol:
 650+ C404 3A AE C4         LD A, (.rlePending)
 651+ C407 B7               OR A
 652+ C408 CA 1F C4         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 653+ C40B FA 2D C4         JP M, .rleLitEmit           ; <0 = literal group en curso
 654+ C40E                  ; >0 = run en curso, emitir valor
 655+ C40E              .rleRunEmit:
 656+ C40E 3A AF C4         LD A, (.rleValue)
 657+ C411 2F               CPL
 658+ C412 77               LD (HL), A
 659+ C413 23               INC HL
 660+ C414 3A AE C4         LD A, (.rlePending)
 661+ C417 3D               DEC A
 662+ C418 32 AE C4         LD (.rlePending), A
 663+ C41B 10 E7            DJNZ .rlePixCol
 664+ C41D 18 32            JR .rleRowDone
 665+ C41F
 666+ C41F              .rleNewToken:
 667+ C41F DD 7E 00         LD A, (IX+0)
 668+ C422 DD 23            INC IX
 669+ C424 CB 7F            BIT 7, A
 670+ C426 20 18            JR NZ, .rleNewRun
 671+ C428                  ; --- Literal group: A = count (1-127) ---
 672+ C428 ED 44            NEG                         ; A = -count (negativo)
 673+ C42A 32 AE C4         LD (.rlePending), A
 674+ C42D                  ; fall through: emitir primer byte literal
 675+ C42D
 676+ C42D              .rleLitEmit:
 677+ C42D DD 7E 00         LD A, (IX+0)
 678+ C430 DD 23            INC IX
 679+ C432 2F               CPL
 680+ C433 77               LD (HL), A
 681+ C434 23               INC HL
 682+ C435 3A AE C4         LD A, (.rlePending)
 683+ C438 3C               INC A                       ; hacia 0
 684+ C439 32 AE C4         LD (.rlePending), A
 685+ C43C 10 C6            DJNZ .rlePixCol
 686+ C43E 18 11            JR .rleRowDone
 687+ C440
 688+ C440                  ; --- Run: count = (A & $7F) + 2 ---
 689+ C440              .rleNewRun:
 690+ C440 E6 7F            AND $7F
 691+ C442 C6 02            ADD A, 2
 692+ C444 32 AE C4         LD (.rlePending), A
 693+ C447 DD 7E 00         LD A, (IX+0)
 694+ C44A DD 23            INC IX
 695+ C44C 32 AF C4         LD (.rleValue), A
 696+ C44F 18 BD            JR .rleRunEmit
 697+ C451
