4102+ B966              ; CheckEnemyCollision - Colision enemigo contra fondo (2 puntos, simplificado)
4103+ B966              ; ==============================================================================
4104+ B966              ; IX = entidad. Salida: Z=libre, NZ=colision.
4105+ B966              ; ==============================================================================
4106+ B966              CheckEnemyCollision:
4107+ B966                  ; Testea TODAS las celdas del bbox del enemigo en CollisionMap
4108+ B966                  ; (no solo las 4 esquinas: podian dejar pasar obstaculos pequenyos
4109+ B966                  ; como el pozo o el bench cuando el enemigo cae desalineado).
4110+ B966 DD 7E 00         LD A, (IX+ENT_SPRITEID)
4111+ B969 CD 22 A8         CALL GetSpriteDims              ; B=W_px, C=H_px
4112+ B96C                  ; --- Char X range ---
4113+ B96C DD 7E 03         LD A, (IX+ENT_POSX)
4114+ B96F 57               LD D, A                         ; D = posX
4115+ B970 0F               RRCA
4116+ B971 0F               RRCA
4117+ B972 0F               RRCA
4118+ B973 E6 1F            AND $1F
4119+ B975 32 E6 B9         LD (.ecXlo), A                  ; charXlo
4120+ B978 7A               LD A, D
4121+ B979 80               ADD A, B
4122+ B97A 3D               DEC A                           ; posX + W - 1
4123+ B97B 0F               RRCA
4124+ B97C 0F               RRCA
4125+ B97D 0F               RRCA
4126+ B97E E6 1F            AND $1F
4127+ B980 5F               LD E, A                         ; E = charXhi
4128+ B981 3A E6 B9         LD A, (.ecXlo)
4129+ B984 57               LD D, A
4130+ B985 7B               LD A, E
4131+ B986 92               SUB D
4132+ B987 3C               INC A                           ; width_chars
4133+ B988 32 E8 B9         LD (.ecWc), A
