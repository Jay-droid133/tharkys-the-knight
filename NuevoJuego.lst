 853+ D44A DD 23            INC IX
 854+ D44C CB 7F            BIT 7, A
 855+ D44E 20 18            JR NZ, .rleNewRun
 856+ D450                  ; --- Literal group: A = count (1-127) ---
 857+ D450 ED 44            NEG                         ; A = -count (negativo)
 858+ D452 32 D6 D4         LD (.rlePending), A
 859+ D455                  ; fall through: emitir primer byte literal
 860+ D455
