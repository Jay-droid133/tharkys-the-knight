 301+ E4F1              ; ==============================================================================
 302+ E4F1              ; ApplyDayCycleRemap - Transforma un byte de atributo segun momento del dia
 303+ E4F1              ; ==============================================================================
 304+ E4F1              ; Entrada: A = attr original
 305+ E4F1              ; Salida:  A = attr transformado
 306+ E4F1              ; Preserva: HL, DE, BC, IX
 307+ E4F1              ; ==============================================================================
 308+ E4F1              ApplyDayCycleRemap:
 309+ E4F1 E5               PUSH HL
 310+ E4F2 67               LD H, A                     ; H = attr (temp save)
 311+ E4F3                  ; Skip remap si flag activa (random pickups: preservar brillo siempre).
 312+ E4F3 3A 8C E3         LD A, (BgSpriteSkipRemap)
 313+ E4F6 B7               OR A
 314+ E4F7 20 06            JR NZ, .skipRemap
 315+ E4F9 3A 86 E3         LD A, (CurrentTimeOfDay)
 316+ E4FC B7               OR A
 317+ E4FD 20 03            JR NZ, .doRemap
 318+ E4FF              .skipRemap:
 319+ E4FF 7C               LD A, H                     ; Dia o flag: devolver sin cambio
 320+ E500 E1               POP HL
 321+ E501 C9               RET
 322+ E502
 323+ E502              .doRemap:
 324+ E502 D5               PUSH DE
 325+ E503 C5               PUSH BC
 326+ E504
 327+ E504 7C               LD A, H                     ; A = attr original
 328+ E505 4F               LD C, A                     ; C = attr original
 329+ E506
 330+ E506                  ; Guardar flash + ink (bits 7, 2-0)
 331+ E506 E6 87            AND $87                     ; A = F000_0III
 332+ E508 47               LD B, A                     ; B = flash | ink
 333+ E509
 334+ E509                  ; Extraer paper+bright como indice 0-15
 335+ E509 79               LD A, C
 336+ E50A E6 78            AND $78                     ; A = 0BPPP000
 337+ E50C 0F               RRCA
 338+ E50D 0F               RRCA
 339+ E50E 0F               RRCA                        ; A = 0000BPPP = indice
 340+ E50F
 341+ E50F                  ; Elegir tabla segun tipo de sprite
 342+ E50F 5F               LD E, A
 343+ E510 16 00            LD D, 0
 344+ E512 3A 8B E3         LD A, (BgSpriteIsHouse)
 345+ E515 B7               OR A
 346+ E516 28 05            JR Z, .useStdTable
 347+ E518 2A 89 E3         LD HL, (CurrentHouseRemapTable)
 348+ E51B 18 03            JR .doLookup
 349+ E51D              .useStdTable:
 350+ E51D 2A 87 E3         LD HL, (CurrentRemapTable)
 351+ E520              .doLookup:
 352+ E520 19               ADD HL, DE
 353+ E521 7E               LD A, (HL)                  ; A = nuevo paper+bright (0-15)
 354+ E522
 355+ E522                  ; Reconstruir atributo
 356+ E522 07               RLCA
 357+ E523 07               RLCA
 358+ E524 07               RLCA                        ; A = 0BPPP000
 359+ E525 B0               OR B                        ; A = FBPPPIII
 360+ E526
 361+ E526 C1               POP BC
 362+ E527 D1               POP DE
 363+ E528 E1               POP HL
 364+ E529 C9               RET
 365+ E52A
 366+ E52A              ; ==============================================================================
 367+ E52A              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E52A              ; ==============================================================================
 369+ E52A              ; Entrada: A = sprite ID
 370+ E52A              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E52A              ; Preserva: A, DE, IX
 372+ E52A              ;
 373+ E52A              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E52A              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E52A              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E52A              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E52A              ; ==============================================================================
 378+ E52A              CheckIfHouseSprite:
 379+ E52A F5               PUSH AF
 380+ E52B E5               PUSH HL
 381+ E52C C5               PUSH BC
 382+ E52D
 383+ E52D 47               LD B, A                     ; B = id buscado
 384+ E52E
 385+ E52E AF               XOR A
 386+ E52F 32 8B E3         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E532
 388+ E532 21 43 E0         LD HL, HouseIdList
 389+ E535              .checkLoop:
 390+ E535 7E               LD A, (HL)
 391+ E536 FE FF            CP $FF
 392+ E538 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E53A B8               CP B
 394+ E53B 28 03            JR Z, .checkFound
 395+ E53D 23               INC HL
 396+ E53E 18 F5            JR .checkLoop
 397+ E540
 398+ E540              .checkFound:
 399+ E540 3E 01            LD A, 1
 400+ E542 32 8B E3         LD (BgSpriteIsHouse), A
 401+ E545
 402+ E545              .checkDone:
 403+ E545 C1               POP BC
 404+ E546 E1               POP HL
 405+ E547 F1               POP AF
 406+ E548 C9               RET
 407+ E549
 408+ E549              ; HouseIdList: auto-generada por el level editor en screen_data.asm
 409+ E549              ; (vive en bank 0 para acceso sin paginar). Lista DEFB id terminada en $FF.
 410+ E549              ; Incluye automaticamente cualquier sprite cuyo nombre contenga "house".
 411+ E549
 412+ E549              ; ==============================================================================
 413+ E549              ; DrawRoomInfo - Muestra coordenadas, indice y nombre del room en HUD fila 23
 414+ E549              ; ==============================================================================
 415+ E549              ; Formato: XX,YY:NN nombre_room     DY
 416+ E549              ;          cols 0-7  cols 9-29       cols 30-31 (DrawTimeIndicator)
 417+ E549              ; ==============================================================================
 418+ E549              DrawRoomInfo:
 419+ E549                  ; --- Limpiar cols 0-12 con espacios (13-18 = reloj HUD, 19-29 = vacío) ---
 420+ E549 1E 00            LD E, 0
 421+ E54B 06 0D            LD B, 13
 422+ E54D              .clearLoop:
 423+ E54D C5               PUSH BC
 424+ E54E D5               PUSH DE
 425+ E54F 3E 20            LD A, ' '
 426+ E551 CD 04 E7         CALL DrawHudChar
 427+ E554 D1               POP DE
 428+ E555 C1               POP BC
 429+ E556 1C               INC E
 430+ E557 10 F4            DJNZ .clearLoop
 431+ E559
 432+ E559                  ; --- CurrentScreenX como 2 digitos decimales en cols 0-1 ---
 433+ E559 3A 0A 83         LD A, (CurrentScreenX)
 434+ E55C 1E 00            LD E, 0
 435+ E55E CD BC E5         CALL .drawDec2
 436+ E561
 437+ E561                  ; --- ',' en col 2 ---
 438+ E561 3E 2C            LD A, ','
 439+ E563 1E 02            LD E, 2
 440+ E565 CD 04 E7         CALL DrawHudChar
 441+ E568
 442+ E568                  ; --- CurrentScreenY como 2 digitos decimales en cols 3-4 ---
 443+ E568 3A 0B 83         LD A, (CurrentScreenY)
 444+ E56B 1E 03            LD E, 3
 445+ E56D CD BC E5         CALL .drawDec2
 446+ E570
 447+ E570                  ; --- ':' en col 5 ---
 448+ E570 3E 3A            LD A, ':'
 449+ E572 1E 05            LD E, 5
 450+ E574 CD 04 E7         CALL DrawHudChar
 451+ E577
 452+ E577                  ; --- Obtener room index de MapTable[Y*16+X] ---
 453+ E577 3A 0B 83         LD A, (CurrentScreenY)
 454+ E57A 6F               LD L, A
 455+ E57B 26 00            LD H, 0
 456+ E57D 29               ADD HL, HL
 457+ E57E 29               ADD HL, HL
 458+ E57F 29               ADD HL, HL
 459+ E580 29               ADD HL, HL                  ; HL = Y * 16
 460+ E581 3A 0A 83         LD A, (CurrentScreenX)
 461+ E584 5F               LD E, A
 462+ E585 16 00            LD D, 0
 463+ E587 19               ADD HL, DE                  ; HL = Y*16 + X
 464+ E588 11 14 DE         LD DE, MapTable
 465+ E58B 19               ADD HL, DE
 466+ E58C 7E               LD A, (HL)                  ; A = room index (0-47)
 467+ E58D F5               PUSH AF                     ; guardar room index
 468+ E58E
 469+ E58E                  ; --- Room index como 2 hex en cols 6-7 ---
 470+ E58E F5               PUSH AF
 471+ E58F 0F               RRCA
 472+ E590 0F               RRCA
 473+ E591 0F               RRCA
 474+ E592 0F               RRCA
 475+ E593 E6 0F            AND $0F
 476+ E595 CD DA E5         CALL .hexToAscii
 477+ E598 1E 06            LD E, 6
 478+ E59A CD 04 E7         CALL DrawHudChar
 479+ E59D F1               POP AF
 480+ E59E E6 0F            AND $0F
 481+ E5A0 CD DA E5         CALL .hexToAscii
 482+ E5A3 1E 07            LD E, 7
 483+ E5A5 CD 04 E7         CALL DrawHudChar
 484+ E5A8
 485+ E5A8                  ; --- Espacio en col 8 ---
 486+ E5A8 3E 20            LD A, ' '
 487+ E5AA 1E 08            LD E, 8
 488+ E5AC CD 04 E7         CALL DrawHudChar
 489+ E5AF
 490+ E5AF                  ; --- Nombre del room: comentado (cols 9-29 libres para HUD) ---
 491+ E5AF F1               POP AF                      ; A = room index (descartar)
 492+ E5B0
 493+ E5B0                  ; --- Atributos fila 1 cols 0-12 (13-18 = reloj HUD gestiona los suyos) ---
 494+ E5B0 21 20 58         LD HL, ATTR_BASE + 1 * 32
 495+ E5B3 3E 47            LD A, $47                   ; bright white on black
 496+ E5B5 06 0D            LD B, 13
 497+ E5B7              .attrLoop:
 498+ E5B7 77               LD (HL), A
 499+ E5B8 23               INC HL
 500+ E5B9 10 FC            DJNZ .attrLoop
 501+ E5BB C9               RET
 502+ E5BC
 503+ E5BC              ; --- Helpers ---
 504+ E5BC              ; Dibuja valor de A (0-99) como 2 digitos decimales en cols E, E+1
 505+ E5BC              .drawDec2:
 506+ E5BC 4B               LD C, E                     ; guardar columna inicial
 507+ E5BD 06 00            LD B, 0                     ; decenas
 508+ E5BF              .divLoop:
 509+ E5BF FE 0A            CP 10
 510+ E5C1 38 05            JR C, .divDone
 511+ E5C3 D6 0A            SUB 10
 512+ E5C5 04               INC B
 513+ E5C6 18 F7            JR .divLoop
 514+ E5C8              .divDone:
 515+ E5C8                  ; B = decenas, A = unidades
 516+ E5C8 F5               PUSH AF                     ; guardar unidades
 517+ E5C9 78               LD A, B
 518+ E5CA C6 30            ADD A, '0'
 519+ E5CC 59               LD E, C
 520+ E5CD C5               PUSH BC                     ; guardar C (columna) - DrawHudChar destruye BC
 521+ E5CE CD 04 E7         CALL DrawHudChar
 522+ E5D1 C1               POP BC                      ; restaurar C
 523+ E5D2 F1               POP AF
 524+ E5D3 C6 30            ADD A, '0'
 525+ E5D5 59               LD E, C
 526+ E5D6 1C               INC E
 527+ E5D7 C3 04 E7         JP DrawHudChar              ; tail call
 528+ E5DA
 529+ E5DA              .hexToAscii:
 530+ E5DA FE 0A            CP 10
 531+ E5DC 38 03            JR C, .isDigit
 532+ E5DE C6 37            ADD A, 'A' - 10
 533+ E5E0 C9               RET
 534+ E5E1              .isDigit:
 535+ E5E1 C6 30            ADD A, '0'
 536+ E5E3 C9               RET
 537+ E5E4
 538+ E5E4              ; ==============================================================================
 539+ E5E4              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E5E4              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E5E4              ; ==============================================================================
 542+ E5E4              DrawDayCycleHUD:
 543+ E5E4                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E5E4 21 A2 E8         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E5E7 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E5EA CD 59 E6         CALL .drawChar
 547+ E5ED 21 AA E8         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E5F0 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E5F3 CD 59 E6         CALL .drawChar
 550+ E5F6 21 B2 E8         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E5F9 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E5FC CD 59 E6         CALL .drawChar
 553+ E5FF                  ; Col 7 = espacio (limpiar)
 554+ E5FF 11 07 40         LD DE, $4007
 555+ E602 CD 62 E6         CALL .clearChar
 556+ E605
 557+ E605                  ; --- Digito decenas (col 8) ---
 558+ E605 3A 0D BD         LD A, (DayCycleCount)
 559+ E608 FE 0A            CP 10
 560+ E60A 38 20            JR C, .singleDigit
 561+ E60C                  ; Dos digitos: dividir A / 10
 562+ E60C 06 00            LD B, 0
 563+ E60E              .divLoop:
 564+ E60E D6 0A            SUB 10
 565+ E610 04               INC B
 566+ E611 FE 0A            CP 10
 567+ E613 30 F9            JR NC, .divLoop
 568+ E615                  ; B = decenas, A = unidades
 569+ E615 F5               PUSH AF                             ; Guardar unidades
 570+ E616 78               LD A, B
 571+ E617 CD 4C E6         CALL .getDigitFont
 572+ E61A 11 08 40         LD DE, $4008                        ; Col 8
 573+ E61D CD 59 E6         CALL .drawChar
 574+ E620 F1               POP AF                              ; Recuperar unidades
 575+ E621 CD 4C E6         CALL .getDigitFont
 576+ E624 11 09 40         LD DE, $4009                        ; Col 9
 577+ E627 CD 59 E6         CALL .drawChar
 578+ E62A 18 14            JR .setAttrs
 579+ E62C
 580+ E62C              .singleDigit:
 581+ E62C                  ; Una cifra: decena = 0, unidad = A
 582+ E62C F5               PUSH AF
 583+ E62D 21 BA E8         LD HL, DayHudFont + 3 * 8          ; '0'
 584+ E630 11 08 40         LD DE, $4008                        ; Col 8
 585+ E633 CD 59 E6         CALL .drawChar
 586+ E636 F1               POP AF
 587+ E637 CD 4C E6         CALL .getDigitFont
 588+ E63A 11 09 40         LD DE, $4009                        ; Col 9
 589+ E63D CD 59 E6         CALL .drawChar
 590+ E640
 591+ E640              .setAttrs:
 592+ E640                  ; Atributos: bright white en cols 4-9
 593+ E640 3E 47            LD A, $47
 594+ E642 21 04 58         LD HL, ATTR_BASE + 4
 595+ E645 06 06            LD B, 6
 596+ E647              .attrLoop:
 597+ E647 77               LD (HL), A
 598+ E648 23               INC HL
 599+ E649 10 FC            DJNZ .attrLoop
 600+ E64B C9               RET
 601+ E64C
 602+ E64C              ; Devuelve HL = puntero a font data del digito en A (0-9)
 603+ E64C              ; A se destruye
 604+ E64C              .getDigitFont:
 605+ E64C C6 03            ADD A, 3                            ; Digitos empiezan en indice 3 de la font
 606+ E64E 6F               LD L, A
 607+ E64F 26 00            LD H, 0
 608+ E651 29               ADD HL, HL
 609+ E652 29               ADD HL, HL
 610+ E653 29               ADD HL, HL                          ; HL = indice * 8
 611+ E654 01 A2 E8         LD BC, DayHudFont
 612+ E657 09               ADD HL, BC
 613+ E658 C9               RET
 614+ E659
 615+ E659              ; Dibuja 8 bytes de font desde (HL) en VRAM (DE)
 616+ E659              ; DE = direccion VRAM base (fila 0), se incrementa D por scan line
 617+ E659              .drawChar:
 618+ E659 06 08            LD B, 8
 619+ E65B              .charLoop:
 620+ E65B 7E               LD A, (HL)
 621+ E65C 12               LD (DE), A
 622+ E65D 23               INC HL
 623+ E65E 14               INC D
 624+ E65F 10 FA            DJNZ .charLoop
 625+ E661 C9               RET
 626+ E662
 627+ E662              ; Limpia 8 scan lines en VRAM (DE)
 628+ E662              .clearChar:
 629+ E662 06 08            LD B, 8
 630+ E664 AF               XOR A
 631+ E665              .clearLoop:
 632+ E665 12               LD (DE), A
 633+ E666 14               INC D
 634+ E667 10 FC            DJNZ .clearLoop
 635+ E669 C9               RET
 636+ E66A
 637+ E66A              ; ==============================================================================
 638+ E66A              ; DrawPlayerSpeedHUD - Muestra velocidad player en HUD (fila 0, col 2)
 639+ E66A              ; ==============================================================================
 640+ E66A              DrawPlayerSpeedHUD:
 641+ E66A 3A 88 8D         LD A, (PlayerCurrentSpeed)
 642+ E66D C6 30            ADD A, '0'
 643+ E66F 1E 02            LD E, 2
 644+ E671 CD CA E6         CALL DrawHudCharRow0
 645+ E674                  ; Atributo (bright white)
 646+ E674 3E 47            LD A, $47
 647+ E676 32 02 58         LD (ATTR_BASE + 2), A
 648+ E679 C9               RET
 649+ E67A
 650+ E67A              ; ==============================================================================
 651+ E67A              ; DrawZoneCountHUD - DEBUG: muestra ZoneCellCount en HUD col 11-12 (hex)
 652+ E67A              ; ==============================================================================
 653+ E67A              DrawZoneCountHUD:
 654+ E67A 3A 00 5D         LD A, (ZoneCellCount)
 655+ E67D                  ; Hi nibble
 656+ E67D 47               LD B, A
 657+ E67E CB 3F            SRL A
 658+ E680 CB 3F            SRL A
 659+ E682 CB 3F            SRL A
 660+ E684 CB 3F            SRL A
 661+ E686 FE 0A            CP 10
 662+ E688 38 04            JR C, .dzcHiDigit
 663+ E68A C6 37            ADD A, 'A' - 10
 664+ E68C 18 02            JR .dzcHiOut
 665+ E68E              .dzcHiDigit:
 666+ E68E C6 30            ADD A, '0'
 667+ E690              .dzcHiOut:
 668+ E690 1E 0B            LD E, 11
 669+ E692 CD CA E6         CALL DrawHudCharRow0
 670+ E695                  ; Lo nibble
 671+ E695 78               LD A, B
 672+ E696 E6 0F            AND $0F
 673+ E698 FE 0A            CP 10
 674+ E69A 38 04            JR C, .dzcLoDigit
 675+ E69C C6 37            ADD A, 'A' - 10
 676+ E69E 18 02            JR .dzcLoOut
 677+ E6A0              .dzcLoDigit:
 678+ E6A0 C6 30            ADD A, '0'
 679+ E6A2              .dzcLoOut:
 680+ E6A2 1E 0C            LD E, 12
 681+ E6A4 CD CA E6         CALL DrawHudCharRow0
 682+ E6A7 3E 47            LD A, $47
 683+ E6A9 32 0B 58         LD (ATTR_BASE + 11), A
 684+ E6AC 32 0C 58         LD (ATTR_BASE + 12), A
 685+ E6AF C9               RET
 686+ E6B0
 687+ E6B0              ; ==============================================================================
 688+ E6B0              ; DrawEnemySpeedHUD - Muestra velocidad nasties en HUD (fila 0, col 30-31)
 689+ E6B0              ; ==============================================================================
 690+ E6B0              DrawEnemySpeedHUD:
 691+ E6B0                  ; "V" en columna 30
 692+ E6B0 3E 56            LD A, 'V'
 693+ E6B2 1E 1E            LD E, 30
 694+ E6B4 CD CA E6         CALL DrawHudCharRow0
 695+ E6B7                  ; Numero de velocidad en columna 31
 696+ E6B7 3A 57 8D         LD A, (CurrentEnemySpeed)
 697+ E6BA C6 30            ADD A, '0'
 698+ E6BC 1E 1F            LD E, 31
 699+ E6BE CD CA E6         CALL DrawHudCharRow0
 700+ E6C1                  ; Atributos (bright white)
 701+ E6C1 3E 47            LD A, $47
 702+ E6C3 32 1E 58         LD (ATTR_BASE + 30), A
 703+ E6C6 32 1F 58         LD (ATTR_BASE + 31), A
 704+ E6C9 C9               RET
