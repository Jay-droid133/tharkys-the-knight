 361+ A2C1                  ; Pintar attr
 362+ A2C1 3A DC 82         LD A, (PlayerDrawY)
 363+ A2C4 57               LD D, A
 364+ A2C5 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 365+ A2C8 5F               LD E, A
 366+ A2C9 DD E5            PUSH IX
 367+ A2CB DD 2A D8 A7      LD IX, (SpriteAddrTemp)
 368+ A2CF CD EA 9D         CALL CalcEntityAttrSize
 369+ A2D2 DD E1            POP IX
 370+ A2D4 3A DC 82         LD A, (PlayerDrawY)
 371+ A2D7 57               LD D, A
 372+ A2D8 DD 7E 0F         LD A, (IX+ENT_DRAWX)
 373+ A2DB 5F               LD E, A
 374+ A2DC DD 7E 05         LD A, (IX+ENT_ATTR)
 375+ A2DF CD BD 9D         CALL SetEntityAttr
 376+ A2E2
 377+ A2E2                  ; Guardar old = actual (con offset visual +1 para que el próximo erase coincida)
