7290+ C778 3C               INC A
7291+ C779 4F               LD C, A
7292+ C77A 3A 74 5F         LD A, (DBfsCurCx)
7293+ C77D 47               LD B, A
7294+ C77E 3E 01            LD A, MAI_DIR_S
7295+ C780 CD 13 C8         CALL .bfsTryNbr
7296+ C783              .bfsTryW:
