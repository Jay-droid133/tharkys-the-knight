 602+ EE1E              ; ==============================================================================
 603+ EE1E              ; RELOJ DE PLAZA - Esfera decorativa en el mapa que muestra la hora
 604+ EE1E              ; ==============================================================================
 605+ EE1E
 606+ EE1E              ; ==============================================================================
 607+ EE1E              ; BuildPlazaScanAddrs - Precalcula tabla de 16 dirs VRAM (1 por scan line)
 608+ EE1E              ; ==============================================================================
 609+ EE1E              ; Llamar al detectar BgGfx_reloj_plaza en DrawScreen.
 610+ EE1E              ; Lee PlazaClockCharX/Y (ya con BG_Y_OFFSET).
 611+ EE1E              ; ==============================================================================
 612+ EE1E              BuildPlazaScanAddrs:
 613+ EE1E                  ; Calcular pixel coords del top-left de la esfera
 614+ EE1E 3A 5A 8D         LD A, (PlazaClockCharY)
 615+ EE21 07               RLCA
 616+ EE22 07               RLCA
 617+ EE23 07               RLCA
 618+ EE24 57               LD D, A                     ; D = pixelY = charY * 8
 619+ EE25 3A 59 8D         LD A, (PlazaClockCharX)
 620+ EE28 07               RLCA
 621+ EE29 07               RLCA
 622+ EE2A 07               RLCA
 623+ EE2B 5F               LD E, A                     ; E = pixelX = charX * 8
 624+ EE2C CD 53 9D         CALL CalcPixelAddr          ; HL = dir VRAM scan line 0
 625+ EE2F
 626+ EE2F DD 21 5B 8D      LD IX, PlazaScanAddrs
 627+ EE33 06 10            LD B, 16
 628+ EE35              .buildLoop:
 629+ EE35 DD 75 00         LD (IX+0), L
 630+ EE38 DD 74 01         LD (IX+1), H
 631+ EE3B DD 23            INC IX
 632+ EE3D DD 23            INC IX
 633+ EE3F 05               DEC B
 634+ EE40 C8               RET Z
 635+ EE41 CD BF 9A         CALL NextPixelLine
 636+ EE44 18 EF            JR .buildLoop
 637+ EE46
 638+ EE46              ; ==============================================================================
 639+ EE46              ; DrawPlazaClock - Dibuja cara + agujas del reloj de plaza
 640+ EE46              ; ==============================================================================
 641+ EE46              ; Llamar cada frame desde el main loop.
 642+ EE46              ; Solo redibuja cuando las agujas cambian de posicion (evita corrupcion XOR).
 643+ EE46              ; ==============================================================================
 644+ EE46              DrawPlazaClock:
 645+ EE46 3A 58 8D         LD A, (PlazaClockActive)
 646+ EE49 B7               OR A
 647+ EE4A C8               RET Z
 648+ EE4B
 649+ EE4B                  ; --- Calcular posicion actual de las agujas ---
 650+ EE4B 3A BD E9         LD A, (GameHours)
 651+ EE4E FE 0C            CP 12
 652+ EE50 38 02            JR C, .pCalcHourOk
 653+ EE52 D6 0C            SUB 12
 654+ EE54              .pCalcHourOk:
 655+ EE54 57               LD D, A                     ; D = display hour (0-11)
 656+ EE55 3A BC E9         LD A, (GameMinutes)
 657+ EE58 1E 00            LD E, 0
 658+ EE5A              .pCalcDiv5:
 659+ EE5A FE 05            CP 5
 660+ EE5C 38 05            JR C, .pCalcMinOk
 661+ EE5E D6 05            SUB 5
 662+ EE60 1C               INC E
 663+ EE61 18 F7            JR .pCalcDiv5
 664+ EE63              .pCalcMinOk:
 665+ EE63                  ; D = hour pos (0-11), E = minute pos (0-11)
 666+ EE63
 667+ EE63                  ; --- Comprobar si cambiaron desde el ultimo dibujo ---
 668+ EE63 3A B7 EE         LD A, (PlazaLastHour)
 669+ EE66 BA               CP D
 670+ EE67 20 05            JR NZ, .pNeedsRedraw
 671+ EE69 3A B8 EE         LD A, (PlazaLastMin)
 672+ EE6C BB               CP E
 673+ EE6D C8               RET Z                       ; sin cambio → no redibujar
 674+ EE6E
 675+ EE6E              .pNeedsRedraw:
 676+ EE6E 7A               LD A, D
 677+ EE6F 32 B7 EE         LD (PlazaLastHour), A
 678+ EE72 7B               LD A, E
 679+ EE73 32 B8 EE         LD (PlazaLastMin), A
 680+ EE76
 681+ EE76                  ; --- Restaurar pixels de la esfera desde buffer en RAM fija ---
 682+ EE76                  ; BgGfx_reloj_plaza esta en bank 3; PlazaClockPixels es el cache.
 683+ EE76 DD 21 2E 8A      LD IX, PlazaClockPixels
 684+ EE7A FD 21 5B 8D      LD IY, PlazaScanAddrs
 685+ EE7E 06 10            LD B, 16
 686+ EE80              .faceRow:
 687+ EE80 FD 6E 00         LD L, (IY+0)
 688+ EE83 FD 66 01         LD H, (IY+1)               ; HL = dir VRAM de esta scan line
 689+ EE86 DD 7E 00         LD A, (IX+0)
 690+ EE89 2F               CPL                         ; des-invertir (dato CPL'd)
 691+ EE8A 77               LD (HL), A                  ; byte izquierdo
 692+ EE8B 23               INC HL
 693+ EE8C DD 7E 01         LD A, (IX+1)
 694+ EE8F 2F               CPL
 695+ EE90 77               LD (HL), A                  ; byte derecho
 696+ EE91 DD 23            INC IX
 697+ EE93 DD 23            INC IX
 698+ EE95 FD 23            INC IY
 699+ EE97 FD 23            INC IY
 700+ EE99 10 E5            DJNZ .faceRow
 701+ EE9B
 702+ EE9B                  ; --- Aguja de horas ---
 703+ EE9B 3A B7 EE         LD A, (PlazaLastHour)
 704+ EE9E 21 B9 EA         LD HL, HourHandPtrs
 705+ EEA1 CD B9 EE         CALL DrawPlazaHandLine
 706+ EEA4
 707+ EEA4                  ; --- Aguja de minutos ---
 708+ EEA4 3A B8 EE         LD A, (PlazaLastMin)
 709+ EEA7 21 D5 E9         LD HL, MinHandPtrs
 710+ EEAA CD B9 EE         CALL DrawPlazaHandLine
 711+ EEAD
 712+ EEAD                  ; --- Punto central (scan 7, col izquierda, bit 0) ---
 713+ EEAD 21 69 8D         LD HL, PlazaScanAddrs + 14  ; scan line 7 = word index 7 = byte offset 14
 714+ EEB0 7E               LD A, (HL)
 715+ EEB1 23               INC HL
 716+ EEB2 66               LD H, (HL)
 717+ EEB3 6F               LD L, A                     ; HL = dir VRAM scan line 7
 718+ EEB4 CB 86            RES 0, (HL)                 ; borrar bit = marca negra
 719+ EEB6 C9               RET
 720+ EEB7
 721+ EEB7              ; Variables locales reloj plaza
 722+ EEB7 FF           PlazaLastHour:  DEFB $FF        ; ultimo hour pos dibujado ($FF = forzar primer dibujo)
 723+ EEB8 FF           PlazaLastMin:   DEFB $FF        ; ultimo minute pos dibujado
 724+ EEB9
 725+ EEB9              ; ==============================================================================
 726+ EEB9              ; DrawPlazaHandLine - Dibuja aguja traduciendo coords HUD a plaza
 727+ EEB9              ; ==============================================================================
 728+ EEB9              ; Entrada: A = posicion (0-11), HL = tabla HUD (HourHandPtrs/MinHandPtrs)
 729+ EEB9              ; Reutiliza los datos de aguja del HUD, traduce las dirs VRAM absolutas
 730+ EEB9              ; a posiciones relativas y las busca en PlazaScanAddrs.
 731+ EEB9              ; ==============================================================================
 732+ EEB9              DrawPlazaHandLine:
 733+ EEB9                  ; Indexar en tabla de punteros
 734+ EEB9 87               ADD A, A
 735+ EEBA 4F               LD C, A
 736+ EEBB 06 00            LD B, 0
 737+ EEBD 09               ADD HL, BC
 738+ EEBE 7E               LD A, (HL)
 739+ EEBF 23               INC HL
 740+ EEC0 66               LD H, (HL)
 741+ EEC1 6F               LD L, A                     ; HL = puntero a datos de linea HUD
 742+ EEC2
 743+ EEC2              .pxLoop:
 744+ EEC2 7E               LD A, (HL)                  ; H byte de dir VRAM HUD ($00 = fin)
 745+ EEC3 B7               OR A
 746+ EEC4 C8               RET Z
 747+ EEC5
 748+ EEC5                  ; Leer tripleta completa: Hbyte, Lbyte, mask
 749+ EEC5 47               LD B, A                     ; B = H byte (contiene scan en bits 2-0)
 750+ EEC6 23               INC HL
 751+ EEC7 4E               LD C, (HL)                  ; C = L byte (contiene row y col)
 752+ EEC8 23               INC HL
 753+ EEC9 56               LD D, (HL)                  ; D = mask
 754+ EECA 23               INC HL
 755+ EECB E5               PUSH HL                     ; guardar puntero a siguiente entrada
 756+ EECC
 757+ EECC                  ; --- Calcular scanLine (0-15) ---
 758+ EECC 78               LD A, B
 759+ EECD E6 07            AND $07                     ; scan dentro del char row (0-7)
 760+ EECF CB 69            BIT 5, C                    ; ¿char row inferior? (HUD row_in_third=1)
 761+ EED1 28 02            JR Z, .pxIsTop
 762+ EED3 C6 08            ADD A, 8                    ; bottom: scanLine = scan + 8
 763+ EED5              .pxIsTop:
 764+ EED5                  ; A = scanLine (0-15)
 765+ EED5
 766+ EED5                  ; --- Calcular colOffset (0 o 1) ---
 767+ EED5 5F               LD E, A                     ; E = scanLine (guardar)
 768+ EED6 79               LD A, C
 769+ EED7 E6 1F            AND $1F                     ; extraer columna
 770+ EED9 D6 0F            SUB 15                      ; HUD col 15 → 0, col 16 → 1
 771+ EEDB 4F               LD C, A                     ; C = colOffset
 772+ EEDC
 773+ EEDC                  ; --- Buscar dir VRAM en PlazaScanAddrs[scanLine] ---
 774+ EEDC 7B               LD A, E                     ; A = scanLine
 775+ EEDD 87               ADD A, A                    ; *2 (word index)
 776+ EEDE 21 5B 8D         LD HL, PlazaScanAddrs
 777+ EEE1 85               ADD A, L
 778+ EEE2 6F               LD L, A
 779+ EEE3 30 01            JR NC, .pxNC
 780+ EEE5 24               INC H
 781+ EEE6              .pxNC:
 782+ EEE6 7E               LD A, (HL)
 783+ EEE7 23               INC HL
 784+ EEE8 66               LD H, (HL)
 785+ EEE9 81               ADD A, C                    ; sumar colOffset
 786+ EEEA 6F               LD L, A                     ; HL = dir VRAM destino
 787+ EEEB
 788+ EEEB                  ; --- Aplicar mask: borrar bits (AND ~mask) ---
 789+ EEEB 7A               LD A, D
 790+ EEEC 2F               CPL
 791+ EEED A6               AND (HL)
 792+ EEEE 77               LD (HL), A
 793+ EEEF
 794+ EEEF E1               POP HL                      ; restaurar puntero datos
 795+ EEF0 18 D0            JR .pxLoop
 796+ EEF2
