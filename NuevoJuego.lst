 671+ F3D0              ; ==============================================================================
 672+ F3D0              ; DrawCompassSprite - Vuelca 32 bytes (16x16 px) de DE a la posicion de la brujula
 673+ F3D0              ; ==============================================================================
 674+ F3D0              ; IN: DE = ptr a 16 filas x 2 bytes
 675+ F3D0              ; Asume top third (H=$40). Char rows COMPASS_CHARROW y COMPASS_CHARROW+1.
 676+ F3D0              ; Destruye: AF, B, HL.
 677+ F3D0              ; ==============================================================================
 678+ F3D0              DrawCompassSprite:
 679+ F3D0                  ; Char row 0 (rows 0-7 del sprite)
 680+ F3D0 26 40            LD H, $40
 681+ F3D2 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 682+ F3D4 06 08            LD B, 8
 683+ F3D6              .dcsRow0:
 684+ F3D6 1A               LD A, (DE)
 685+ F3D7 77               LD (HL), A
 686+ F3D8 13               INC DE
 687+ F3D9 23               INC HL
 688+ F3DA 1A               LD A, (DE)
 689+ F3DB 77               LD (HL), A
 690+ F3DC 13               INC DE
 691+ F3DD 2B               DEC HL
 692+ F3DE 24               INC H
 693+ F3DF 10 F5            DJNZ .dcsRow0
 694+ F3E1                  ; Char row 1 (rows 8-15 del sprite)
 695+ F3E1 26 40            LD H, $40
 696+ F3E3 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 697+ F3E5 06 08            LD B, 8
 698+ F3E7              .dcsRow1:
 699+ F3E7 1A               LD A, (DE)
 700+ F3E8 77               LD (HL), A
 701+ F3E9 13               INC DE
 702+ F3EA 23               INC HL
 703+ F3EB 1A               LD A, (DE)
 704+ F3EC 77               LD (HL), A
 705+ F3ED 13               INC DE
 706+ F3EE 2B               DEC HL
 707+ F3EF 24               INC H
 708+ F3F0 10 F5            DJNZ .dcsRow1
 709+ F3F2 C9               RET
 710+ F3F3
 711+ F3F3              ; ==============================================================================
 712+ F3F3              ; SetCompassAttrs - Pinta las 4 celdas (2x2) con el byte de atributo en A
