7647+ C9BB              ; ==============================================================================
7648+ C9BB              ; OnPlayerHealthDepleted - PlayerHealth llego a 0
7649+ C9BB              ; ==============================================================================
7650+ C9BB              ; -1 vida (clamp a 0); refill HP + stamina al maximo. Sin animaciones, sin
7651+ C9BB              ; respawn position, sin game over (de momento). El HUD se actualiza solo via
7652+ C9BB              ; DrawLivesHUD (caché .dlhLast detecta el cambio).
7653+ C9BB              ; ==============================================================================
7654+ C9BB              ; ==============================================================================
7655+ C9BB              ; InitGameState - Reset explicito de variables de gameplay a "partida nueva"
7656+ C9BB              ; ==============================================================================
7657+ C9BB              ; Llamado desde Inicio (boot fresco) y desde el reset por SPACE en game over.
7658+ C9BB              ; Variables.asm tiene DEFB initializers que solo se aplican al cargar el .tap;
7659+ C9BB              ; tras un reset por software los valores actuales persisten en RAM. Esta rutina
7660+ C9BB              ; los pone a su default.
7661+ C9BB              ; ==============================================================================
7662+ C9BB              InitGameState:
7663+ C9BB 3E 03            LD A, PLAYER_LIVES_INIT
7664+ C9BD 32 E6 82         LD (PlayerLives), A
7665+ C9C0 3E 10            LD A, HEALTH_MAX
7666+ C9C2 32 C8 B3         LD (PlayerHealth), A
7667+ C9C5 3E 10            LD A, STAMINA_MAX
7668+ C9C7 32 C9 B3         LD (PlayerStamina), A
