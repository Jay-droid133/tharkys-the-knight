 845+ D1C3                  ; ===================== PATH RLE =====================
 846+ D1C3                  ; Stream RLE con chunks explícitos (sin ambigüedad token/dato):
 847+ D1C3                  ;   Control $01-$7F: literal group, siguen (control) bytes raw
 848+ D1C3                  ;   Control $80-$FF: run, count = (control & $7F)+2, sigue 1 byte valor
 849+ D1C3                  ; El estado .rlePending conserva el chunk entre filas:
 850+ D1C3                  ;   0 = necesita nuevo token
 851+ D1C3                  ;   >0 = en run, quedan .rlePending bytes de .rleValue
 852+ D1C3                  ;   <0 = en literal group, quedan -(.rlePending) bytes por leer de IX
 853+ D1C3              .rlePixRow:
 854+ D1C3 3A 6E D2         LD A, (.widthVal)
 855+ D1C6 47               LD B, A
 856+ D1C7 E5               PUSH HL                     ; guardar inicio de fila VRAM
 857+ D1C8
 858+ D1C8              .rlePixCol:
 859+ D1C8 3A 72 D2         LD A, (.rlePending)
 860+ D1CB B7               OR A
 861+ D1CC CA E3 D1         JP Z, .rleNewToken          ; 0 = necesita nuevo chunk
 862+ D1CF FA F1 D1         JP M, .rleLitEmit           ; <0 = literal group en curso
 863+ D1D2                  ; >0 = run en curso, emitir valor
 864+ D1D2              .rleRunEmit:
 865+ D1D2 3A 73 D2         LD A, (.rleValue)
 866+ D1D5 2F               CPL
 867+ D1D6 77               LD (HL), A
 868+ D1D7 23               INC HL
 869+ D1D8 3A 72 D2         LD A, (.rlePending)
 870+ D1DB 3D               DEC A
 871+ D1DC 32 72 D2         LD (.rlePending), A
 872+ D1DF 10 E7            DJNZ .rlePixCol
 873+ D1E1 18 32            JR .rleRowDone
 874+ D1E3
 875+ D1E3              .rleNewToken:
 876+ D1E3 DD 7E 00         LD A, (IX+0)
 877+ D1E6 DD 23            INC IX
 878+ D1E8 CB 7F            BIT 7, A
 879+ D1EA 20 18            JR NZ, .rleNewRun
 880+ D1EC                  ; --- Literal group: A = count (1-127) ---
 881+ D1EC ED 44            NEG                         ; A = -count (negativo)
 882+ D1EE 32 72 D2         LD (.rlePending), A
 883+ D1F1                  ; fall through: emitir primer byte literal
 884+ D1F1
 885+ D1F1              .rleLitEmit:
 886+ D1F1 DD 7E 00         LD A, (IX+0)
 887+ D1F4 DD 23            INC IX
 888+ D1F6 2F               CPL
 889+ D1F7 77               LD (HL), A
 890+ D1F8 23               INC HL
 891+ D1F9 3A 72 D2         LD A, (.rlePending)
 892+ D1FC 3C               INC A                       ; hacia 0
 893+ D1FD 32 72 D2         LD (.rlePending), A
 894+ D200 10 C6            DJNZ .rlePixCol
 895+ D202 18 11            JR .rleRowDone
 896+ D204
 897+ D204                  ; --- Run: count = (A & $7F) + 2 ---
 898+ D204              .rleNewRun:
 899+ D204 E6 7F            AND $7F
 900+ D206 C6 02            ADD A, 2
 901+ D208 32 72 D2         LD (.rlePending), A
 902+ D20B DD 7E 00         LD A, (IX+0)
 903+ D20E DD 23            INC IX
 904+ D210 32 73 D2         LD (.rleValue), A
 905+ D213 18 BD            JR .rleRunEmit
 906+ D215
