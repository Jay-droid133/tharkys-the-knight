2442+ D974 23               INC HL
2442+ D975 23             INC HL                 ; skip ptr
2443+ D976 7E               LD A, (HL)                      ; charX
2444+ D977 87               ADD A, A
2444+ D978 87             ADD A, A
2444+ D979 87             ADD A, A  ; *8 = px_left
2445+ D97A 32 97 DA         LD (.cbtSpX), A
2446+ D97D 23               INC HL
2447+ D97E 7E               LD A, (HL)                      ; charY
2448+ D97F C6 02            ADD A, BG_Y_OFFSET
2449+ D981 87               ADD A, A
2449+ D982 87             ADD A, A
2449+ D983 87             ADD A, A  ; *8 = px_top
2450+ D984 32 98 DA         LD (.cbtSpY), A
2451+ D987                  ; AABB overlap test con extensión +SPEED_RUN pixels en cada lado.
2452+ D987                  ; Motivo: el motor revierte el movimiento al chocar, dejando al player
2453+ D987                  ; hasta 4 px del wall. Sin esta tolerancia, el bump nunca dispararía.
2454+ D987                  ; Horizontal: ext_left = max(0, sprite_left - 4), ext_right = min(255, sprite_right + 4).
2455+ D987 3A A6 81         LD A, (EntityTable + ENT_POSX)
2456+ D98A 4F               LD C, A                         ; C = player_left
2457+ D98B C6 10            ADD A, 16                       ; A = player_right
2458+ D98D 57               LD D, A
