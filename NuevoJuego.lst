1831+ F8E7
1832+ F8E7              ; ==============================================================================
1833+ F8E7              ; DrawCompassGapHint - Pinta sprite-flecha 24x24 en el gap por donde el player
1834+ F8E7              ;                     debe salir (magic compass activa).
1835+ F8E7              ; ==============================================================================
1836+ F8E7              ; PathDir mapea a sprite id: 0(N)=78, 1(S)=79, 2(W)=76, 3(E)=77.
1837+ F8E7              ; PathCoord: char col (N/S) o char row (W/E) del gap concreto elegido por la BFS.
1838+ F8E7              ; Render: XOR sobre BG (DrawBgSpriteXOR). Cachea ultimo dibujo en HintLast*
1839+ F8E7              ; para re-dibujar solo cuando cambia (path, sala). En sala distinta no borra
1840+ F8E7              ; el viejo porque DrawScreen ya repinta BG limpio.
1841+ F8E7              ;
1842+ F8E7              ; Llamada cada frame desde MainLoop tras DrawCompass.
1843+ F8E7              ; Vive en bank 2 (slot fijo, sin paging). Coste: ~100 B asm + 4 B RAM.
1844+ F8E7              ; ==============================================================================
1845+ F8E7              DrawCompassGapHint:
1846+ F8E7                  ; Magic compass activa + path resuelto + tick visible? Si falta cualquiera,
1847+ F8E7                  ; ocultar el sprite. El cache HintLastDir=$FF que deja .dcghHide hace que
1848+ F8E7                  ; cuando TickActiveFrames vuelva a >0 el path mismatch dispare .dcghDraw,
1849+ F8E7                  ; produciendo el parpadeo sincronizado con el tic AY.
1850+ F8E7 2A BF 5F         LD HL, (MagicCompassTimer)
1851+ F8EA 7C               LD A, H
1852+ F8EB B5               OR L
1853+ F8EC 28 7B            JR Z, .dcghHide
1854+ F8EE 3A C1 5F         LD A, (MagicCompassPathDir)
1855+ F8F1 3C               INC A                               ; A=0 si era $FF
1856+ F8F2 28 75            JR Z, .dcghHide
1857+ F8F4 3A C4 5F         LD A, (MagicCompassTickActiveFrames)
1858+ F8F7 B7               OR A
1859+ F8F8 28 6F            JR Z, .dcghHide
1860+ F8FA
1861+ F8FA                  ; --- Cache check: dibujar solo si (dir, coord, sx, sy) cambio ---
1862+ F8FA 21 1D FA         LD HL, HintLastDir
1863+ F8FD 7E               LD A, (HL)
1864+ F8FE 47               LD B, A
1865+ F8FF 3A C1 5F         LD A, (MagicCompassPathDir)
1866+ F902 B8               CP B
1867+ F903 20 1A            JR NZ, .dcghDraw
1868+ F905 23               INC HL
1869+ F906 7E               LD A, (HL)
1870+ F907 47               LD B, A
1871+ F908 3A C2 5F         LD A, (MagicCompassPathCoord)
1872+ F90B B8               CP B
1873+ F90C 20 11            JR NZ, .dcghDraw
1874+ F90E 23               INC HL
1875+ F90F 7E               LD A, (HL)
1876+ F910 47               LD B, A
1877+ F911 3A 10 83         LD A, (CurrentScreenX)
1878+ F914 B8               CP B
1879+ F915 20 08            JR NZ, .dcghDraw
1880+ F917 23               INC HL
1881+ F918 7E               LD A, (HL)
1882+ F919 47               LD B, A
1883+ F91A 3A 11 83         LD A, (CurrentScreenY)
1884+ F91D B8               CP B
1885+ F91E C8               RET Z                               ; sin cambio -> nada que hacer
1886+ F91F
1887+ F91F              .dcghDraw:
1888+ F91F                  ; Erase old si misma sala (para no dejar arrows huerfanos al cambiar path
1889+ F91F                  ; dentro de una sala, p.ej. tras un avance de hito mid-room).
1890+ F91F 3A 1D FA         LD A, (HintLastDir)
1891+ F922 FE FF            CP $FF
1892+ F924 28 1F            JR Z, .dcghDrawNew
1893+ F926 3A 1F FA         LD A, (HintLastScreenX)
1894+ F929 47               LD B, A
1895+ F92A 3A 10 83         LD A, (CurrentScreenX)
1896+ F92D B8               CP B
1897+ F92E 20 15            JR NZ, .dcghDrawNew                 ; diferente sala -> BG ya limpio
1898+ F930 3A 20 FA         LD A, (HintLastScreenY)
1899+ F933 47               LD B, A
1900+ F934 3A 11 83         LD A, (CurrentScreenY)
1901+ F937 B8               CP B
1902+ F938 20 0B            JR NZ, .dcghDrawNew
1903+ F93A 3A 1D FA         LD A, (HintLastDir)
1904+ F93D 47               LD B, A
1905+ F93E 3A 1E FA         LD A, (HintLastCoord)
1906+ F941 4F               LD C, A
1907+ F942 CD C0 F9         CALL EraseHintAtPos                 ; XOR + restore attrs (B=dir, C=coord)
1908+ F945              .dcghDrawNew:
1909+ F945 3A C1 5F         LD A, (MagicCompassPathDir)
1910+ F948 47               LD B, A
1911+ F949 3A C2 5F         LD A, (MagicCompassPathCoord)
1912+ F94C 4F               LD C, A
1913+ F94D CD B3 F9         CALL DrawHintAtPos
1914+ F950                  ; Update cache
1915+ F950 3A C1 5F         LD A, (MagicCompassPathDir)
1916+ F953 32 1D FA         LD (HintLastDir), A
1917+ F956 3A C2 5F         LD A, (MagicCompassPathCoord)
1918+ F959 32 1E FA         LD (HintLastCoord), A
1919+ F95C 3A 10 83         LD A, (CurrentScreenX)
1920+ F95F 32 1F FA         LD (HintLastScreenX), A
1921+ F962 3A 11 83         LD A, (CurrentScreenY)
1922+ F965 32 20 FA         LD (HintLastScreenY), A
1923+ F968 C9               RET
1924+ F969
1925+ F969              .dcghHide:
1926+ F969                  ; Compass inactiva: borrar hint si estaba dibujado en esta sala
1927+ F969 3A 1D FA         LD A, (HintLastDir)
1928+ F96C FE FF            CP $FF
1929+ F96E C8               RET Z
1930+ F96F 3A 1F FA         LD A, (HintLastScreenX)
1931+ F972 47               LD B, A
1932+ F973 3A 10 83         LD A, (CurrentScreenX)
1933+ F976 B8               CP B
1934+ F977 20 15            JR NZ, .dcghHideInvalidate
1935+ F979 3A 20 FA         LD A, (HintLastScreenY)
1936+ F97C 47               LD B, A
1937+ F97D 3A 11 83         LD A, (CurrentScreenY)
1938+ F980 B8               CP B
1939+ F981 20 0B            JR NZ, .dcghHideInvalidate
1940+ F983 3A 1D FA         LD A, (HintLastDir)
1941+ F986 47               LD B, A
1942+ F987 3A 1E FA         LD A, (HintLastCoord)
1943+ F98A 4F               LD C, A
1944+ F98B CD C0 F9         CALL EraseHintAtPos                 ; XOR + restore attrs
1945+ F98E              .dcghHideInvalidate:
1946+ F98E 3E FF            LD A, $FF
1947+ F990 32 1D FA         LD (HintLastDir), A
1948+ F993 C9               RET
1949+ F994
1950+ F994              ; ==============================================================================
1951+ F994              ; ComputeHintPos - (B=dir, C=coord) -> (B=charX, C=charY)
1952+ F994              ; ==============================================================================
1953+ F994              ; Sprite 16x16 = 2x2 chars. Gaps N/S = 4 chars wide -> sprite centrado:
1954+ F994              ; start col = coord + 1 (1 char margen cada lado). Gaps W/E = 3 o 5 chars
1955+ F994              ; tall -> sprite (2 char) cabe con 0.5 o 1.5 margin; usamos coord+0.
1956+ F994              ;
1957+ F994              ; charY se devuelve en BG-coords (0-21) porque DrawBgSpriteXOR y
1958+ F994              ; RestorePickupAttrs anaden BG_Y_OFFSET=2 internamente. Pasar VRAM-coords
1959+ F994              ; (e.g. 22 para fila inferior) provoca off-screen write -> corrupcion de
1960+ F994              ; la zona de atributos ($5800+).
1961+ F994              ; Destruye: A.
1962+ F994              ; ==============================================================================
1963+ F994              ComputeHintPos:
1964+ F994 78               LD A, B
1965+ F995 B7               OR A
1966+ F996 28 0A            JR Z, .chpNorth                     ; 0 = N
1967+ F998 3D               DEC A
1968+ F999 28 0B            JR Z, .chpSouth                     ; 1 = S
1969+ F99B 3D               DEC A
1970+ F99C 28 0C            JR Z, .chpWest                      ; 2 = W
1971+ F99E                  ; Fall-through: 3 = E
1972+ F99E 06 1D            LD B, 29                            ; charX = 29 (1 col separacion del wall E)
1973+ F9A0 18 0A            JR .chpVertShift                    ; ajustar charY si gap inferior
1974+ F9A2              .chpNorth:
1975+ F9A2 41               LD B, C                             ; charX = coord
1976+ F9A3 0E 01            LD C, 1                             ; charY BG = 1 -> VRAM row 3 (1 char bajo top)
1977+ F9A5 C9               RET
1978+ F9A6              .chpSouth:
1979+ F9A6 41               LD B, C
1980+ F9A7 0E 13            LD C, 19                            ; charY BG = 19 -> VRAM rows 21-22 (1 char sobre bottom)
1981+ F9A9 C9               RET
1982+ F9AA              .chpWest:
1983+ F9AA 06 01            LD B, 1                             ; charX = 1 (1 col separacion del wall W)
1984+ F9AC                  ; fall-through a .chpVertShift
1985+ F9AC              .chpVertShift:
1986+ F9AC                  ; Para W/E inferior (coord >= 7) bajar 1 char (queda mas centrado en
1987+ F9AC                  ; el gap de 5 chars de alto). W/E superior (coord < 7) usa sprite 2x3
1988+ F9AC                  ; que rellena gap de 3 chars exacto -> charY = coord directo.
1989+ F9AC 79               LD A, C
1990+ F9AD FE 07            CP 7
1991+ F9AF D8               RET C                               ; coord < 7: gap superior, charY = coord
1992+ F9B0 3C               INC A                               ; gap inferior: charY = coord + 1
1993+ F9B1 4F               LD C, A
1994+ F9B2 C9               RET
1995+ F9B3
1996+ F9B3              ; ==============================================================================
1997+ F9B3              ; DrawHintAtPos - Load sprite + XOR-draw flecha en (B=dir, C=coord)
1998+ F9B3              ; ==============================================================================
1999+ F9B3              ; IN:  B = PathDir (0=N, 1=S, 2=W, 3=E)
2000+ F9B3              ;      C = PathCoord (char col para N/S, char row para W/E)
2001+ F9B3              ; Destruye: AF, BC, DE, HL, IX.
2002+ F9B3              ; ==============================================================================
2003+ F9B3              DrawHintAtPos:
2004+ F9B3 CD DD F9         CALL LoadHintSprite                 ; HL = ptr cargado a BgSpriteBuffer; preserva BC
2005+ F9B6 CD 94 F9         CALL ComputeHintPos                 ; B=charX, C=charY
2006+ F9B9 DD 21 FD 86      LD IX, BgSpriteBuffer
2007+ F9BD C3 73 DC         JP DrawBgSpriteXOR                  ; tail call
2008+ F9C0
2009+ F9C0              ; ==============================================================================
2010+ F9C0              ; EraseHintAtPos - XOR-erase + restore attrs en (B=dir, C=coord)
2011+ F9C0              ; ==============================================================================
2012+ F9C0              ; Llamado al cambiar de path/sala/cancel. Mismo XOR-draw que erase los pixels,
2013+ F9C0              ; mas RestorePickupAttrs para limpiar las attrs (de lo contrario quedan
2014+ F9C0              ; cuadrados verdes huerfanos en pantalla).
2015+ F9C0              ; ==============================================================================
2016+ F9C0              EraseHintAtPos:
2017+ F9C0 CD DD F9         CALL LoadHintSprite                 ; HL=ptr; BgSpriteBuffer poblado
2018+ F9C3 CD 94 F9         CALL ComputeHintPos                 ; B=charX, C=charY
2019+ F9C6 C5               PUSH BC                             ; save charX, charY for RestorePickupAttrs
2020+ F9C7 DD 21 FD 86      LD IX, BgSpriteBuffer
2021+ F9CB CD 73 DC         CALL DrawBgSpriteXOR                ; XOR-erase pixels
2022+ F9CE C1               POP BC
2023+ F9CF                  ; height_chars depende del sprite (2 para 16x16, 3 para 16x24).
2024+ F9CF                  ; Leer del header: BgSpriteBuffer[0] = height_px; /8 = char rows.
2025+ F9CF 3A FD 86         LD A, (BgSpriteBuffer)
2026+ F9D2 0F               RRCA
2026+ F9D3 0F             RRCA
2026+ F9D4 0F             RRCA                  ; /8
2027+ F9D5 E6 1F            AND $1F
2028+ F9D7 57               LD D, A                             ; height_chars
2029+ F9D8 1E 02            LD E, 2                             ; width_chars (siempre 2 para flechas)
2030+ F9DA C3 09 DD         JP RestorePickupAttrs               ; tail call: restaura attrs desde CleanAttrMap
2031+ F9DD
2032+ F9DD              ; ==============================================================================
2033+ F9DD              ; LoadHintSprite - HL=ptr cargado a BgSpriteBuffer segun (dir B, coord C)
2034+ F9DD              ; ==============================================================================
2035+ F9DD              ; IN:  B = PathDir, C = PathCoord
2036+ F9DD              ; OUT: BgSpriteBuffer poblado con sprite
2037+ F9DD              ; Destruye: AF, DE, HL. Preserva BC.
2038+ F9DD              ;
2039+ F9DD              ; Para N/S y W/E inferior usa los 2x2 (id 42/49/80/82). Para W/E SUPERIOR
2040+ F9DD              ; (gap de 3 chars de alto en config dual) usa los 2x3 (id 81/83), que
2041+ F9DD              ; rellenan el gap mejor. Heuristica: coord < 7 = superior.
2042+ F9DD              ; ==============================================================================
2043+ F9DD              LoadHintSprite:
2044+ F9DD 78               LD A, B
2045+ F9DE FE 02            CP 2                                ; W?
2046+ F9E0 28 12            JR Z, .lhsW
2047+ F9E2 FE 03            CP 3                                ; E?
2048+ F9E4 28 1D            JR Z, .lhsE
2049+ F9E6                  ; N o S -> tabla base
2050+ F9E6 87               ADD A, A                            ; *2
2051+ F9E7 5F               LD E, A
2052+ F9E8 16 00            LD D, 0
2053+ F9EA 21 15 FA         LD HL, HintArrowPtrs
2054+ F9ED 19               ADD HL, DE
2055+ F9EE 5E               LD E, (HL)
2056+ F9EF 23               INC HL
2057+ F9F0 56               LD D, (HL)
2058+ F9F1 EB               EX DE, HL                           ; HL = sprite ptr
2059+ F9F2 18 1C            JR .lhsLoad
2060+ F9F4              .lhsW:
2061+ F9F4 79               LD A, C
2062+ F9F5 FE 07            CP 7
2063+ F9F7 30 05            JR NC, .lhsWBase                    ; coord >= 7: gap inferior, usa 2x2
2064+ F9F9 21 76 F2         LD HL, BgGfx_arrow_2x3_west         ; gap superior: 2x3
2065+ F9FC 18 12            JR .lhsLoad
2066+ F9FE              .lhsWBase:
2067+ F9FE 21 4D F2         LD HL, BgGfx_arrow_2x2_west
2068+ FA01 18 0D            JR .lhsLoad
2069+ FA03              .lhsE:
2070+ FA03 79               LD A, C
2071+ FA04 FE 07            CP 7
2072+ FA06 30 05            JR NC, .lhsEBase
2073+ FA08 21 2C F3         LD HL, BgGfx_arrow_2x3_east
2074+ FA0B 18 03            JR .lhsLoad
2075+ FA0D              .lhsEBase:
2076+ FA0D 21 03 F3         LD HL, BgGfx_arrow_2x2_east
2077+ FA10              .lhsLoad:
2078+ FA10 3E 03            LD A, 3                             ; bank 3 (bg_gfx.asm)
2079+ FA12 C3 D0 67         JP LoadBgSpriteToBuffer             ; tail call (preserva BC)
2080+ FA15
2081+ FA15              ; Sprite ptrs ordenados por PathDir: 0=N, 1=S, 2=W, 3=E. 16x16 = 2x2 chars.
2082+ FA15              ; Los labels los crea inject_pickup_sprites.py si no estan placed.
2083+ FA15              HintArrowPtrs:
2084+ FA15 B1 F2            DEFW BgGfx_arrow_2x2_north          ; 0 = N (id 42)
2085+ FA17 DA F2            DEFW BgGfx_arrow_2x2_south          ; 1 = S (id 49)
2086+ FA19 4D F2            DEFW BgGfx_arrow_2x2_west           ; 2 = W (id 80)
2087+ FA1B 03 F3            DEFW BgGfx_arrow_2x2_east           ; 3 = E (id 82)
2088+ FA1D
2089+ FA1D              ; Cache: ultima posicion dibujada (para erase + skip-no-op). 4 B en bank 0.
2090+ FA1D FF           HintLastDir:        DEFB $FF            ; $FF = nada dibujado
2091+ FA1E 00           HintLastCoord:      DEFB 0
2092+ FA1F FF           HintLastScreenX:    DEFB $FF
2093+ FA20 FF           HintLastScreenY:    DEFB $FF
2094+ FA21
# file closed: milestones.asm
 515  FA21                  ; town_gate_cutscene.asm: incluido arriba en $6000+ (slot 1).
 516  FA21                  INCLUDE "sound.asm"
# file opened: sound.asm
   1+ FA21              ; ==============================================================================
   2+ FA21              ; SOUND ENGINE - Beeper SFX para ZX Spectrum 48K
   3+ FA21              ; ==============================================================================
   4+ FA21              ; Motor de efectos de sonido usando el beeper (puerto $FE, bit 4).
   5+ FA21              ; Soporta tonos con sweep de pitch, ruido percusivo y silencios.
   6+ FA21              ;
   7+ FA21              ; Formato de datos de efecto (4 bytes por paso, terminado con duration=0):
   8+ FA21              ;   DEFB duration      ; iteraciones del bucle externo (0 = fin)
   9+ FA21              ;   DEFB pitch         ; semi-periodo del bucle interno (menor = mas agudo)
  10+ FA21              ;   DEFB pitchDelta    ; sumado al pitch cada iteracion (signed, para sweeps)
  11+ FA21              ;   DEFB flags         ; bit 0 = modo ruido (pitch XOR R para periodos random)
  12+ FA21              ; ==============================================================================
  13+ FA21
  14+ FA21              ; ==============================================================================
  15+ FA21              ; PlaySFX - Reproduce un efecto de sonido
  16+ FA21              ; ==============================================================================
  17+ FA21              ; Entrada: HL = puntero a datos del efecto
  18+ FA21              ; Modifica: AF, BC, DE, HL
  19+ FA21              ; ==============================================================================
  20+ FA21              PlaySFX:
  21+ FA21 F3               DI                          ; Sin interrupciones para audio limpio
  22+ FA22 3A 8B 8D         LD A, (CurrentBorderColor)
  23+ FA25 E6 07            AND $07                     ; Solo bits de color del borde
  24+ FA27 5F               LD E, A                     ; E = color del borde (preservado durante output)
  25+ FA28
  26+ FA28              .nextStep:
  27+ FA28 7E               LD A, (HL)                  ; Leer duration
  28+ FA29 B7               OR A
  29+ FA2A 28 5C            JR Z, .done                 ; duration=0 → fin del efecto
  30+ FA2C
  31+ FA2C 47               LD B, A                     ; B = duration (bucle externo)
  32+ FA2D 23               INC HL
  33+ FA2E 4E               LD C, (HL)                  ; C = pitch (semi-periodo)
  34+ FA2F 23               INC HL
  35+ FA30 56               LD D, (HL)                  ; D = pitchDelta (signed)
  36+ FA31 23               INC HL
  37+ FA32 7E               LD A, (HL)                  ; A = flags
  38+ FA33 23               INC HL
  39+ FA34 E5               PUSH HL                     ; Guardar puntero al siguiente paso
  40+ FA35 CB 47            BIT 0, A
  41+ FA37 20 20            JR NZ, .noiseLoop           ; bit 0 set → modo ruido
  42+ FA39
  43+ FA39              ; --- Bucle de tono normal ---
  44+ FA39              .toneLoop:
  45+ FA39                  ; Semi-periodo HIGH
  46+ FA39 7B               LD A, E
  47+ FA3A F6 10            OR $10                      ; bit 4 = speaker ON
  48+ FA3C D3 FE            OUT ($FE), A
  49+ FA3E 79               LD A, C                     ; A = pitch actual
  50+ FA3F              .toneDelayHi:
  51+ FA3F 3D               DEC A
  52+ FA40 20 FD            JR NZ, .toneDelayHi     ; delay proporcional al pitch
  53+ FA42
  54+ FA42                  ; Semi-periodo LOW
  55+ FA42 7B               LD A, E                     ; speaker OFF (solo borde)
  56+ FA43 D3 FE            OUT ($FE), A
  57+ FA45 79               LD A, C
  58+ FA46              .toneDelayLo:
  59+ FA46 3D               DEC A
  60+ FA47 20 FD            JR NZ, .toneDelayLo
  61+ FA49
  62+ FA49                  ; Aplicar pitch sweep
  63+ FA49 79               LD A, C
  64+ FA4A 82               ADD A, D                    ; pitch += pitchDelta
  65+ FA4B 28 08            JR Z, .toneClamp           ; evitar pitch=0 (bucle infinito)
  66+ FA4D FA 55 FA         JP M, .toneClamp            ; evitar pitch negativo
  67+ FA50 4F               LD C, A
  68+ FA51              .toneAfterClamp:
  69+ FA51 10 E6            DJNZ .toneLoop
  70+ FA53 18 30            JR .stepDone
  71+ FA55
  72+ FA55              .toneClamp:
  73+ FA55 0E 01            LD C, 1                     ; pitch minimo = 1
  74+ FA57 18 F8            JR .toneAfterClamp
  75+ FA59
  76+ FA59              ; --- Bucle de ruido (periodos pseudo-aleatorios) ---
  77+ FA59              .noiseLoop:
  78+ FA59                  ; Semi-periodo HIGH con ruido
  79+ FA59 7B               LD A, E
  80+ FA5A F6 10            OR $10
  81+ FA5C D3 FE            OUT ($FE), A
  82+ FA5E ED 5F            LD A, R                     ; R register como PRNG
  83+ FA60 A9               XOR C                       ; mezclar con pitch base
  84+ FA61 E6 1F            AND $1F                     ; limitar rango (0-31)
  85+ FA63 F6 01            OR $01                      ; minimo 1
  86+ FA65              .noiseDelayHi:
  87+ FA65 3D               DEC A
  88+ FA66 20 FD            JR NZ, .noiseDelayHi
  89+ FA68
  90+ FA68                  ; Semi-periodo LOW
  91+ FA68 7B               LD A, E
  92+ FA69 D3 FE            OUT ($FE), A
  93+ FA6B ED 5F            LD A, R
  94+ FA6D A9               XOR C
  95+ FA6E E6 1F            AND $1F
  96+ FA70 F6 01            OR $01
  97+ FA72              .noiseDelayLo:
  98+ FA72 3D               DEC A
  99+ FA73 20 FD            JR NZ, .noiseDelayLo
 100+ FA75
 101+ FA75                  ; Aplicar pitch sweep (afecta base del ruido)
 102+ FA75 79               LD A, C
 103+ FA76 82               ADD A, D
 104+ FA77 28 08            JR Z, .noiseClamp
 105+ FA79 FA 81 FA         JP M, .noiseClamp
 106+ FA7C 4F               LD C, A
 107+ FA7D              .noiseAfterClamp:
 108+ FA7D 10 DA            DJNZ .noiseLoop
 109+ FA7F 18 04            JR .stepDone
