 367+ E474              ; CheckIfHouseSprite - Determina si un sprite es tipo "house"
 368+ E474              ; ==============================================================================
 369+ E474              ; Entrada: A = sprite ID
 370+ E474              ; Setea BgSpriteIsHouse (0 o 1)
 371+ E474              ; Preserva: A, DE, IX
 372+ E474              ;
 373+ E474              ; Stage B.2: antes comparaba DE contra punteros en HouseSpriteList. Con
 374+ E474              ; sprites repartidos en varios banks, dos sprites en banks distintos pueden
 375+ E474              ; compartir direccion $Cxxx y dar falso positivo. Ahora comparamos por ID
 376+ E474              ; (unico globalmente) contra HouseIdList (formato DEFB id, terminador $FF).
 377+ E474              ; ==============================================================================
 378+ E474              CheckIfHouseSprite:
 379+ E474 F5               PUSH AF
 380+ E475 E5               PUSH HL
 381+ E476 C5               PUSH BC
 382+ E477
 383+ E477 47               LD B, A                     ; B = id buscado
 384+ E478
 385+ E478 AF               XOR A
 386+ E479 32 D5 E2         LD (BgSpriteIsHouse), A     ; Default: no es house
 387+ E47C
 388+ E47C 21 8D DF         LD HL, HouseIdList
 389+ E47F              .checkLoop:
 390+ E47F 7E               LD A, (HL)
 391+ E480 FE FF            CP $FF
 392+ E482 28 0B            JR Z, .checkDone            ; Terminador: no encontrado
 393+ E484 B8               CP B
 394+ E485 28 03            JR Z, .checkFound
 395+ E487 23               INC HL
 396+ E488 18 F5            JR .checkLoop
 397+ E48A
 398+ E48A              .checkFound:
 399+ E48A 3E 01            LD A, 1
 400+ E48C 32 D5 E2         LD (BgSpriteIsHouse), A
 401+ E48F
 402+ E48F              .checkDone:
 403+ E48F C1               POP BC
 404+ E490 E1               POP HL
 405+ E491 F1               POP AF
 406+ E492 C9               RET
