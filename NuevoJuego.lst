4397+ B73A              ; CountActiveNasties / CountActiveMonsters
4398+ B73A              ; ==============================================================================
4399+ B73A              ; Cuentan enemigos vivos por tipo (excluyen DYING, SPAWNING y SCARED).
4400+ B73A              ; Ambas usan _CountSlots internamente.
4401+ B73A              ; Salida: A = numero de enemigos activos. Machaca: B, C, DE, HL. Preserva: IX
4402+ B73A              ; ==============================================================================
4403+ B73A              CountActiveNasties:
4404+ B73A 21 05 82         LD HL, EntityTable + (SLOT_NASTY0 * ENT_SIZE) + ENT_TYPE
4405+ B73D 06 03            LD B, NUM_NASTIES
4406+ B73F 18 05            JR _CountSlots
4407+ B741
4408+ B741              CountActiveMonsters:
4409+ B741 21 A5 81         LD HL, EntityTable + (SLOT_MONSTER0 * ENT_SIZE) + ENT_TYPE
4410+ B744 06 06            LD B, NUM_MONSTERS
4411+ B746
4412+ B746              _CountSlots:
4413+ B746 0E 00            LD C, 0                         ; Contador
4414+ B748              .countLoop:
4415+ B748 7E               LD A, (HL)
4416+ B749 B7               OR A
4417+ B74A 28 16            JR Z, .countNext                ; Slot vacio: no contar
4418+ B74C                  ; Comprobar estado: excluir DYING, SPAWNING y SCARED
4419+ B74C D5               PUSH DE
4420+ B74D 11 01 00         LD DE, ENT_STATE - ENT_TYPE     ; Offset de TYPE a STATE = 1
4421+ B750 19               ADD HL, DE
4422+ B751 7E               LD A, (HL)
4423+ B752 ED 52            SBC HL, DE                      ; Restaurar HL a ENT_TYPE
4424+ B754 D1               POP DE
4425+ B755 FE 03            CP STATE_DYING
4426+ B757 28 09            JR Z, .countNext
4427+ B759 FE 04            CP STATE_SPAWNING
4428+ B75B 28 05            JR Z, .countNext
4429+ B75D FE 05            CP STATE_SCARED
4430+ B75F 28 01            JR Z, .countNext
4431+ B761 0C               INC C
4432+ B762              .countNext:
4433+ B762 11 10 00         LD DE, ENT_SIZE
4434+ B765 19               ADD HL, DE
4435+ B766 10 E0            DJNZ .countLoop
4436+ B768 79               LD A, C
4437+ B769 C9               RET
