7241+ C723 3E FF            LD A, MAI_DIR_NONE
7242+ C725 32 6F 5F         LD (DBfsBestDir), A
7243+ C728 AF               XOR A
7244+ C729 32 70 5F         LD (DBfsBestDepth), A
7245+ C72C 3E FF            LD A, $FF
7246+ C72E 32 71 5F         LD (DBfsBestManh), A
