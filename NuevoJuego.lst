1069+ F009              ; ==============================================================================
1070+ F009              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
1071+ F009              ; ==============================================================================
1072+ F009              ; Se llama desde:
1073+ F009              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
1074+ F009              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
1075+ F009              ;     por encima y los borro.
1076+ F009              ;
1077+ F009              ; Bypass total del day/night remap → respeta exactamente el patrón per-celda
1078+ F009              ; que el BG editor exporta (ej: col1 bright + col2 dim). Lee los 4 attrs
1079+ F009              ; ya extraídos por LoadSynthSpriteAndExtractAttr (RandomSynthAttr=TL,
1080+ F009              ; RandomSynthAttrTR, RandomSynthAttrBL, RandomSynthAttrBR) y los pinta
1081+ F009              ; 1:1 en VRAM.
1082+ F009              ;
1083+ F009              ; Pickup es 16x16 = 2x2 char attrs.
1084+ F009              ; Early-out si RandomSynthMapX = $FE (no activo).
1085+ F009              ; Destruye AF, BC, DE, HL.
1086+ F009              ; ==============================================================================
1087+ F009              PaintSynthPickupAttrsBody:
1088+ F009 3A B4 5F         LD A, (RandomSynthMapX)
1089+ F00C FE FE            CP $FE
1090+ F00E C8               RET Z                               ; no activo
1091+ F00F                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
1092+ F00F 3A B9 5F         LD A, (RandomSynthCharY)
1093+ F012 C6 02            ADD A, BG_Y_OFFSET
1094+ F014 26 00            LD H, 0
1095+ F016 6F               LD L, A
1096+ F017 29               ADD HL, HL
1097+ F018 29               ADD HL, HL
1098+ F019 29               ADD HL, HL
1099+ F01A 29               ADD HL, HL
1100+ F01B 29               ADD HL, HL                          ; *32
1101+ F01C 3A B8 5F         LD A, (RandomSynthCharX)
1102+ F01F 85               ADD A, L
1103+ F020 6F               LD L, A
1104+ F021 30 01            JR NC, .pspaNoCarry
1105+ F023 24               INC H
1106+ F024              .pspaNoCarry:
1107+ F024 11 00 58         LD DE, ATTR_BASE
1108+ F027 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
1109+ F028                  ; --- Fila 0: TL, TR ---
1110+ F028 3A BB 5F         LD A, (RandomSynthAttr)             ; TL
1111+ F02B 77               LD (HL), A
1112+ F02C 23               INC HL
1113+ F02D 3A E1 5F         LD A, (RandomSynthAttrTR)
1114+ F030 77               LD (HL), A
1115+ F031                  ; --- Avanzar a fila 1 col 0: +32 desde col 1 → +31 ---
1116+ F031 7D               LD A, L
1117+ F032 C6 1F            ADD A, 31
1118+ F034 6F               LD L, A
1119+ F035 30 01            JR NC, .pspaNoCarry2
1120+ F037 24               INC H
1121+ F038              .pspaNoCarry2:
1122+ F038                  ; --- Fila 1: BL, BR ---
1123+ F038 3A E2 5F         LD A, (RandomSynthAttrBL)
1124+ F03B 77               LD (HL), A
1125+ F03C 23               INC HL
1126+ F03D 3A E3 5F         LD A, (RandomSynthAttrBR)
1127+ F040 77               LD (HL), A
1128+ F041 C9               RET
1129+ F042
1130+ F042              ; ==============================================================================
1131+ F042              ; CheckRandomSyntheticPickup - colision + collect del pickup sintetico
1132+ F042              ; ==============================================================================
1133+ F042              ; Llamada por CheckPickupCollect tras procesar PickupTable. Si la entry
1134+ F042              ; sintetica esta activa, hace AABB contra el player. Si hay hit:
1135+ F042              ;   - SFX_Pickup
1136+ F042              ;   - Erase XOR + restore attrs
1137+ F042              ;   - Mark inactiva ($FE)
1138+ F042              ;   - Dispatch GiveLife/GiveHealth/GiveStamina segun RandomSynthPtr
1139+ F042              ; ==============================================================================
1140+ F042              CheckRandomSyntheticPickupBody:
1141+ F042 3A B4 5F         LD A, (RandomSynthMapX)
1142+ F045 FE FE            CP $FE
1143+ F047 C8               RET Z                               ; inactiva
1144+ F048                  ; Sanity: solo procesar si estamos en su sala (deberia ser asi tras hook).
1145+ F048 47               LD B, A
1146+ F049 3A 10 83         LD A, (CurrentScreenX)
1147+ F04C B8               CP B
1148+ F04D C0               RET NZ
1149+ F04E 3A B5 5F         LD A, (RandomSynthMapY)
1150+ F051 47               LD B, A
1151+ F052 3A 11 83         LD A, (CurrentScreenY)
1152+ F055 B8               CP B
1153+ F056 C0               RET NZ
1154+ F057
1155+ F057                  ; --- Cargar sprite a BgSpriteBuffer (header + pixels + attrs) ---
1156+ F057 2A B6 5F         LD HL, (RandomSynthPtr)
1157+ F05A 3E 03            LD A, 3                             ; bank 3
1158+ F05C CD DE 6E         CALL LoadBgSpriteToBuffer_B7
1159+ F05F
1160+ F05F                  ; --- Calcular pk_left, pk_top, pk_width_px, pk_height_px ---
1161+ F05F 21 FD 86         LD HL, BgSpriteBuffer
1162+ F062 7E               LD A, (HL)                          ; height_px
1163+ F063 32 AC F0         LD (.crsPkH+1), A
1164+ F066 23               INC HL
1165+ F067 7E               LD A, (HL)
1166+ F068 E6 7F            AND $7F                             ; width_bytes (sin flag RLE)
1167+ F06A 87               ADD A, A
1168+ F06B 87               ADD A, A
1169+ F06C 87               ADD A, A                            ; width_px = bytes*8
1170+ F06D 32 94 F0         LD (.crsPkW+1), A
1171+ F070 3A B8 5F         LD A, (RandomSynthCharX)
1172+ F073 87               ADD A, A
1173+ F074 87               ADD A, A
1174+ F075 87               ADD A, A                            ; pk_left = charX*8
1175+ F076 32 8F F0         LD (.crsPkLeft+1), A
1176+ F079 3A B9 5F         LD A, (RandomSynthCharY)
1177+ F07C C6 02            ADD A, BG_Y_OFFSET
1178+ F07E 87               ADD A, A
1179+ F07F 87               ADD A, A
1180+ F080 87               ADD A, A                            ; pk_top = (charY+BG_Y_OFFSET)*8
1181+ F081 32 A7 F0         LD (.crsPkTop+1), A
1182+ F084
1183+ F084                  ; --- AABB: player_right > pk_left AND player_left < pk_right
1184+ F084                  ;          AND player_bottom > pk_top AND player_top < pk_bottom ---
1185+ F084 3A A6 81         LD A, (EntityTable + ENT_POSX)
1186+ F087 32 8B F0         LD (.crsPlX+1), A
1187+ F08A              .crsPlX:
1188+ F08A 3E 00            LD A, 0                             ; player_left (self-mod)
1189+ F08C C6 10            ADD A, 16                           ; player_right
1190+ F08E              .crsPkLeft:
1191+ F08E 06 00            LD B, 0
1192+ F090 B8               CP B
1193+ F091 D8               RET C                               ; player_right <= pk_left -> miss
1194+ F092 C8               RET Z
1195+ F093              .crsPkW:
1196+ F093 3E 00            LD A, 0                             ; pk_width
1197+ F095 80               ADD A, B                            ; pk_right
1198+ F096 47               LD B, A
1199+ F097 3A 8B F0         LD A, (.crsPlX+1)
1200+ F09A B8               CP B
1201+ F09B D0               RET NC                              ; player_left >= pk_right -> miss
1202+ F09C
1203+ F09C 3A A7 81         LD A, (EntityTable + ENT_POSY)
1204+ F09F 32 A3 F0         LD (.crsPlY+1), A
1205+ F0A2              .crsPlY:
1206+ F0A2 3E 00            LD A, 0                             ; player_top
1207+ F0A4 C6 15            ADD A, 21                           ; player_bottom (player es 21 alto)
1208+ F0A6              .crsPkTop:
1209+ F0A6 06 00            LD B, 0
1210+ F0A8 B8               CP B
1211+ F0A9 D8               RET C
1212+ F0AA C8               RET Z
1213+ F0AB              .crsPkH:
1214+ F0AB 3E 00            LD A, 0                             ; pk_height
1215+ F0AD 80               ADD A, B                            ; pk_bottom
1216+ F0AE 47               LD B, A
1217+ F0AF 3A A3 F0         LD A, (.crsPlY+1)
1218+ F0B2 B8               CP B
1219+ F0B3 D0               RET NC                              ; miss
1220+ F0B4
1221+ F0B4                  ; --- HIT detectado, pero saltar si player ya esta al maximo del recurso ---
1222+ F0B4                  ; Identificar tipo via RP_CurRolled (semantico, no por ptr) y comparar
1223+ F0B4                  ; contra cap. Si A >= cap, RET (sin SFX ni erase): el pickup queda
1224+ F0B4                  ; visible para cuando el jugador haya gastado el recurso.
1225+ F0B4                  ; Rayo/caracol/mushroom/compass no son cap-able: siempre aplican.
1226+ F0B4                  ;
1227+ F0B4                  ; Antes esto se hacia comparando RandomSynthPtr contra BgGfx_health_pickup
1228+ F0B4                  ; / BgGfx_stamina_pickup. Ahora hay variantes (ids 72/74/254 health,
1229+ F0B4                  ; 73/255 stamina) elegidas al azar por .urpDoHealth/.urpDoStamina; el
1230+ F0B4                  ; ptr varia pero RP_CurRolled mantiene la semantica.
1231+ F0B4 3A D0 5F         LD A, (RP_CurRolled)
1232+ F0B7 FE 01            CP ROLLED_LIFE
1233+ F0B9 28 0A            JR Z, .crsCheckLife
1234+ F0BB FE 02            CP ROLLED_HEALTH
1235+ F0BD 28 0E            JR Z, .crsCheckHealth
1236+ F0BF FE 03            CP ROLLED_STAMINA
1237+ F0C1 28 12            JR Z, .crsCheckStamina
1238+ F0C3 18 16            JR .crsApplyHit                     ; rayo/caracol/mushroom/compass: siempre apply
1239+ F0C5              .crsCheckLife:
1240+ F0C5 3A E6 82         LD A, (PlayerLives)
1241+ F0C8 FE 05            CP PLAYER_LIVES_MAX
1242+ F0CA D0               RET NC
1243+ F0CB 18 0E            JR .crsApplyHit
1244+ F0CD              .crsCheckHealth:
1245+ F0CD 3A C8 B3         LD A, (PlayerHealth)
1246+ F0D0 FE 10            CP HEALTH_MAX
1247+ F0D2 D0               RET NC
1248+ F0D3 18 06            JR .crsApplyHit
1249+ F0D5              .crsCheckStamina:
1250+ F0D5 3A C9 B3         LD A, (PlayerStamina)
1251+ F0D8 FE 10            CP STAMINA_MAX
1252+ F0DA D0               RET NC
1253+ F0DB              .crsApplyHit:
1254+ F0DB                  ; --- HIT confirmado: SFX por categoria + erase + attrs + apply + inactive ---
1255+ F0DB                  ; SFX tier:
1256+ F0DB                  ;   Especiales (LIFE/COMPASS/ESCUDO_RAYO) -> AY sweep agudo (compass pickup)
1257+ F0DB                  ;   Debuffs    (SETA/CARACOL/REVERSE)     -> SFX_BadPickup (ding descendente)
1258+ F0DB                  ;   Resto                                 -> SFX_Pickup (ding ascendente)
1259+ F0DB 3A D0 5F         LD A, (RP_CurRolled)
1260+ F0DE FE 06            CP ROLLED_ROULETTE
1261+ F0E0 28 1A            JR Z, .crsCheckRouletteSfx
1262+ F0E2                  ; --- Dispatch directo via ROLLED_* ---
1263+ F0E2                  ; Debuffs: SETA + CARACOL + REVERSE
1264+ F0E2 FE 07            CP ROLLED_MUSHROOM
1264+ F0E4 28 3E          JR Z, .crsBadSfx
1265+ F0E6 FE 05            CP ROLLED_CARACOL
1265+ F0E8 28 3A          JR Z, .crsBadSfx
1266+ F0EA FE 0C            CP ROLLED_REVERSE
1266+ F0EC 28 36          JR Z, .crsBadSfx
1267+ F0EE                  ; Especiales: LIFE + COMPASS + ESCUDO_RAYO
1268+ F0EE FE 01            CP ROLLED_LIFE
1268+ F0F0 28 2D          JR Z, .crsSpecialSfx
1269+ F0F2 FE 08            CP ROLLED_COMPASS
1269+ F0F4 28 29          JR Z, .crsSpecialSfx
1270+ F0F6 FE 0B            CP ROLLED_ESCUDO_RAYO
1270+ F0F8 28 25          JR Z, .crsSpecialSfx
1271+ F0FA 18 1B            JR .crsGoodSfx
1272+ F0FC              .crsCheckRouletteSfx:
1273+ F0FC                  ; --- Dispatch via tipo actualmente mostrado por la ruleta (ROUL_*) ---
1274+ F0FC 3A E0 5F         LD A, (RouletteDisplayedType)
1275+ F0FF FE 06            CP ROUL_MUSHROOM
1275+ F101 28 21          JR Z, .crsBadSfx
1276+ F103 FE 05            CP ROUL_CARACOL
1276+ F105 28 1D          JR Z, .crsBadSfx
1277+ F107 FE 0B            CP ROUL_REVERSE
1277+ F109 28 19          JR Z, .crsBadSfx
1278+ F10B FE 01            CP ROUL_LIFE
1278+ F10D 28 10          JR Z, .crsSpecialSfx
1279+ F10F FE 07            CP ROUL_COMPASS
1279+ F111 28 0C          JR Z, .crsSpecialSfx
1280+ F113 FE 0A            CP ROUL_ESCUDO_RAYO
1280+ F115 28 08          JR Z, .crsSpecialSfx
1281+ F117              .crsGoodSfx:
1282+ F117 21 E8 FA         LD HL, SFX_Pickup
1283+ F11A CD C3 6E         CALL PlaySFX_B7
1284+ F11D 18 0B            JR .crsAfterSfx
1285+ F11F              .crsSpecialSfx:
1286+ F11F                  ; AY_PlayCompassPickup vive en slot 1 (always-visible). CALL directo desde
1287+ F11F                  ; bank 7 body — la rutina toca solo AY hw + state slot 1, no requiere paging.
1288+ F11F                  ; Esta es la unica call al SFX desde el random pickup. ApplyMagicCompassBuff
1289+ F11F                  ; (que se dispatcha despues via ROLLED_COMPASS) ya NO dispara AY_Play* —
1290+ F11F                  ; un segundo AY_PlaySFX back-to-back enmudecia el canal silenciosamente.
1291+ F11F CD AF 6A         CALL AY_PlayCompassPickup
1292+ F122 18 06            JR .crsAfterSfx
1293+ F124              .crsBadSfx:
1294+ F124 21 FD FA         LD HL, SFX_BadPickup
1295+ F127 CD C3 6E         CALL PlaySFX_B7
1296+ F12A              .crsAfterSfx:
1297+ F12A
1298+ F12A                  ; Erase: XOR redraw (sprite ya esta en BgSpriteBuffer)
1299+ F12A 3A B8 5F         LD A, (RandomSynthCharX)
1300+ F12D 47               LD B, A
1301+ F12E 3A B9 5F         LD A, (RandomSynthCharY)
1302+ F131 4F               LD C, A
1303+ F132 C5               PUSH BC
1304+ F133 DD 21 FD 86      LD IX, BgSpriteBuffer
1305+ F137 CD 9F 6E         CALL DrawBgSpriteXOR_B7
1306+ F13A C1               POP BC                              ; B=charX, C=charY
1307+ F13B
1308+ F13B                  ; Restore attrs: D=height_chars, E=width_chars
1309+ F13B 21 FD 86         LD HL, BgSpriteBuffer
1310+ F13E 7E               LD A, (HL)                          ; height_px
1311+ F13F 0F               RRCA
1311+ F140 0F             RRCA
1311+ F141 0F             RRCA
1312+ F142 E6 1F            AND $1F
1313+ F144 57               LD D, A
1314+ F145 23               INC HL
1315+ F146 7E               LD A, (HL)
1316+ F147 E6 7F            AND $7F
1317+ F149 5F               LD E, A
1318+ F14A CD DC 6D         CALL RestorePickupAttrs_B7
1319+ F14D
1320+ F14D                  ; Mark inactive
1321+ F14D 3E FE            LD A, $FE
1322+ F14F 32 B4 5F         LD (RandomSynthMapX), A
1323+ F152
1324+ F152                  ; Dispatch semantico via RP_CurRolled. Guardamos su valor ANTES de
1325+ F152                  ; resetear (la lista de variantes de health/stamina hace que el ptr
1326+ F152                  ; ya no sea univoco para identificar el tipo).
1327+ F152 3A D0 5F         LD A, (RP_CurRolled)
1328+ F155 47               LD B, A                             ; B = rolled type saved
1329+ F156                  ; Invalidar memoria cache: pickup consumido en esta sala. Al volver
1330+ F156                  ; (cache hit en prev) restauraremos rolled=NONE → no respawnea.
1331+ F156 AF               XOR A
1332+ F157 32 D0 5F         LD (RP_CurRolled), A                ; ROLLED_NONE
1333+ F15A
1334+ F15A                  ; Dispatch effect via saved rolled type
