 146+ 910A              ; LoadBgSpriteToBuffer - Copia 256 B desde un BgGfx_* a BgSpriteBuffer
 147+ 910A              ; ==============================================================================
 148+ 910A              ; IN:  HL = puntero al sprite BG (direccion en $C000-$FFFF)
 149+ 910A              ;      A  = bank (0-7) donde vive el sprite
 150+ 910A              ; OUT: BgSpriteBuffer relleno con 256 B copiados. Paginacion restaurada.
 151+ 910A              ;      HL destruido (no lo necesitamos tras la copia, el caller usa el buffer).
 152+ 910A              ; Destruye: A, BC, DE, HL. Preserva IX, IY.
 153+ 910A              ;
 154+ 910A              ; Mismo patron que LoadRoomToBuffer: inline page switch (CALL corromperia el
 155+ 910A              ; stack que vive en slot 3), DI durante la ventana, IFF2 preservado para no
 156+ 910A              ; forzar EI prematuro en startup.
 157+ 910A              ;
 158+ 910A              ; Stage B.1: antes era hardcoded bank 3. Ahora el caller decide el bank
 159+ 910A              ; leyendolo de BgGfxPtrById. Stage C dividira sprites entre bank 3 y 4.
 160+ 910A              ; ==============================================================================
 161+ 910A              LoadBgSpriteToBuffer:
 162+ 910A                  ; Preservar bank en variable (no podemos usar BC porque los callers lo
 163+ 910A                  ; necesitan intacto, y los registros alternos se usan abajo).
 164+ 910A 32 99 91         LD (.lbsBankSave), A
 165+ 910D                  ; Preservar BC: los callers (DrawScreen) usan B=x_char, C=y_char y
 166+ 910D                  ; esperan que siga intacto tras la carga. Lo salvamos al principio.
 167+ 910D C5               PUSH BC
 168+ 910E                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
 169+ 910E F3               DI
 170+ 910F                  ; Page bank deseado inline
 171+ 910F 3A 8F 90         LD A, (CurrentPaging)
 172+ 9112 E6 F8            AND $F8
 173+ 9114 47               LD B, A                         ; B = paging limpio sin bank
 174+ 9115 3A 99 91         LD A, (.lbsBankSave)
 175+ 9118 E6 07            AND $07                         ; safety: solo bits 0-2
 176+ 911A B0               OR B                            ; merge bank en paging
 177+ 911B 32 8F 90         LD (CurrentPaging), A
 178+ 911E 01 FD 7F         LD BC, $7FFD
 179+ 9121 ED 79            OUT (C), A
 180+ 9123                  ; --- Copia inteligente: parsea la cabecera y copia solo lo necesario ---
 181+ 9123                  ; Formato sprite: H, W|RLE, pixeles, tint, AH, AW, attrs
 182+ 9123                  ; Si bit 7 de W esta set → RLE, fallback a copia de 1024 B.
 183+ 9123                  ; Si no → calcular bytes exactos y copiar byte a byte.
 184+ 9123 11 42 89         LD DE, BgSpriteBuffer
 185+ 9126                  ; Copiar H (header byte 0)
 186+ 9126 7E               LD A, (HL)
 187+ 9127 12               LD (DE), A
 188+ 9128 32 97 91         LD (.lbsHsave), A
