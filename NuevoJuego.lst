 447+ E788              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 448+ E788              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 449+ E788              ; IX = puntero al primer byte de la decoracion en sprite data
 450+ E788              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 451+ E788              ; las (16-C) superiores con $00 (vacio/negro)
 452+ E788              .drawBar:
 453+ E788 7D               LD A, L
 454+ E789 32 D4 E7         LD (.dbCol), A                      ; Guardar columna base row 0
 455+ E78C 7B               LD A, E
 456+ E78D 32 D5 E7         LD (.dbCol1), A                     ; Guardar columna base row 1
 457+ E790 06 10            LD B, 16                            ; 16 scanlines totales
 458+ E792 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 459+ E794                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 460+ E794 3E 10            LD A, 16
 461+ E796 91               SUB C
 462+ E797 5F               LD E, A                             ; E = primera scanline llena
 463+ E798              .dbLoop:
 464+ E798                  ; Calcular direccion VRAM
 465+ E798 7A               LD A, D
 466+ E799 FE 08            CP 8
 467+ E79B 30 09            JR NC, .dbCalcR1
 468+ E79D                  ; Char row 0
 469+ E79D 67               LD H, A
 470+ E79E CB F4            SET 6, H
 471+ E7A0 3A D4 E7         LD A, (.dbCol)
 472+ E7A3 6F               LD L, A
 473+ E7A4 18 09            JR .dbWrite
 474+ E7A6              .dbCalcR1:
 475+ E7A6                  ; Char row 1
 476+ E7A6 D6 08            SUB 8
 477+ E7A8 67               LD H, A
 478+ E7A9 CB F4            SET 6, H
 479+ E7AB 3A D5 E7         LD A, (.dbCol1)
 480+ E7AE 6F               LD L, A
 481+ E7AF              .dbWrite:
 482+ E7AF                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 483+ E7AF 7A               LD A, D
 484+ E7B0 BB               CP E
 485+ E7B1 30 0B            JR NC, .dbFull
 486+ E7B3                  ; Marchito: copiar sprite decayed
 487+ E7B3 FD 7E 00         LD A, (IY+0)
 488+ E7B6 77               LD (HL), A
 489+ E7B7 23               INC HL
 490+ E7B8 FD 7E 01         LD A, (IY+1)
 491+ E7BB 77               LD (HL), A
 492+ E7BC 18 09            JR .dbAdvanceSpr
 493+ E7BE              .dbFull:
 494+ E7BE                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 495+ E7BE DD 7E 00         LD A, (IX+0)
 496+ E7C1 77               LD (HL), A
 497+ E7C2 23               INC HL
 498+ E7C3 DD 7E 01         LD A, (IX+1)
 499+ E7C6 77               LD (HL), A
 500+ E7C7              .dbAdvanceSpr:
 501+ E7C7                  ; Avanzar ambos punteros sprite (siempre, 6 bytes por scanline)
 502+ E7C7 D5               PUSH DE
 503+ E7C8 11 06 00         LD DE, 6
 504+ E7CB DD 19            ADD IX, DE
 505+ E7CD FD 19            ADD IY, DE
 506+ E7CF D1               POP DE
 507+ E7D0 14               INC D
 508+ E7D1 10 C5            DJNZ .dbLoop
 509+ E7D3 C9               RET
 510+ E7D4
 511+ E7D4 00           .dbCol:  DEFB 0
 512+ E7D5 00           .dbCol1: DEFB 0
 513+ E7D6
 514+ E7D6              ; --- Subrutina: nivel (A) → color attr (ink=color, paper=negro, bright) ---
 515+ E7D6              .levelToColor:
 516+ E7D6 FE 0C            CP 12
 517+ E7D8 30 11            JR NC, .lcGreen
 518+ E7DA FE 07            CP 7
 519+ E7DC 30 0A            JR NC, .lcCyan
 520+ E7DE FE 03            CP 3
 521+ E7E0 30 03            JR NC, .lcYellow
 522+ E7E2 3E 42            LD A, RED | $40                     ; 0-2: rojo
 523+ E7E4 C9               RET
 524+ E7E5              .lcYellow:
 525+ E7E5 3E 46            LD A, YELLOW | $40                  ; 3-6: amarillo
 526+ E7E7 C9               RET
 527+ E7E8              .lcCyan:
 528+ E7E8 3E 45            LD A, CYAN | $40                    ; 7-11: cyan
 529+ E7EA C9               RET
 530+ E7EB              .lcGreen:
 531+ E7EB 3E 44            LD A, GREEN | $40                   ; 12-16: verde
 532+ E7ED C9               RET
