 219+ 9AC5              ; Variables locales de DrawSprite
 220+ 9AC5 00           .posX:       DEFB 0
 221+ 9AC6 00           .posY:       DEFB 0
 222+ 9AC7 00           .widthSave:  DEFB 0
 223+ 9AC8 00           .heightSave: DEFB 0
 224+ 9AC9 00           .tablePage:  DEFB 0
 225+ 9ACA 00           .widthCount: DEFB 0
 226+ 9ACB
 227+ 9ACB              ; ==============================================================================
 228+ 9ACB              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9ACB              ; ==============================================================================
 230+ 9ACB              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9ACB              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9ACB              ;
 233+ 9ACB              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9ACB              ; ==============================================================================
 235+ 9ACB              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9ACB              NextPixelLine:
 237+ 9ACB 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9ACC 7C               LD A, H
 239+ 9ACD E6 07            AND 7
 240+ 9ACF C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9AD0
 242+ 9AD0                  ; --- Cruce de character row ---
 243+ 9AD0 7D               LD A, L
 244+ 9AD1 C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9AD3 6F               LD L, A
 246+ 9AD4 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9AD6 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9AD7
 249+ 9AD7                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9AD7 7C               LD A, H
 251+ 9AD8 D6 08            SUB 8
 252+ 9ADA 67               LD H, A
 253+ 9ADB C9               RET
 254+ 9ADC
 255+ 9ADC              ; ==============================================================================
 256+ 9ADC              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
 257+ 9ADC              ; ==============================================================================
 258+ 9ADC              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
 259+ 9ADC              ; Entrada:
 260+ 9ADC              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 261+ 9ADC              ;   A = atributo a pintar
 262+ 9ADC              ; ==============================================================================
 263+ 9ADC              SetEntityAttr:
 264+ 9ADC F5               PUSH AF                     ; Guardar atributo
 265+ 9ADD CD 44 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 266+ 9AE0 F1               POP AF
 267+ 9AE1
 268+ 9AE1 47               LD B, A                     ; B = atributo (preservar)
 269+ 9AE2 3A DB 9B         LD A, (EntityAttrH)
 270+ 9AE5 4F               LD C, A                     ; C = filas
 271+ 9AE6              .rowLoop:
 272+ 9AE6                  ; Clipping: no pintar en filas del HUD (ATTR_BASE..ATTR_BASE+63)
 273+ 9AE6 E5               PUSH HL
 274+ 9AE7 7C               LD A, H
 275+ 9AE8 FE 58            CP (ATTR_BASE + 64) >> 8   ; Comprobar si estamos en las 2 primeras filas
 276+ 9AEA 20 08            JR NZ, .rowNotHud
 277+ 9AEC 7D               LD A, L
 278+ 9AED FE 40            CP (ATTR_BASE + 64) & $FF
 279+ 9AEF 30 03            JR NC, .rowNotHud
 280+ 9AF1                  ; Fila en HUD → saltar sin pintar
 281+ 9AF1 E1               POP HL
 282+ 9AF2 18 0B            JR .rowSkip
 283+ 9AF4              .rowNotHud:
 284+ 9AF4 E1               POP HL
 285+ 9AF5 3A DA 9B         LD A, (EntityAttrW)
 286+ 9AF8 E5               PUSH HL                     ; Guardar inicio de fila
 287+ 9AF9                  ; Pintar una fila
 288+ 9AF9              .colLoop:
 289+ 9AF9 70               LD (HL), B
 290+ 9AFA 23               INC HL
 291+ 9AFB 3D               DEC A
 292+ 9AFC 20 FB            JR NZ, .colLoop
 293+ 9AFE E1               POP HL
 294+ 9AFF              .rowSkip:
 295+ 9AFF                  ; Siguiente fila: HL += 32
 296+ 9AFF D5               PUSH DE
 297+ 9B00 11 20 00         LD DE, 32
 298+ 9B03 19               ADD HL, DE
 299+ 9B04 D1               POP DE
 300+ 9B05 0D               DEC C
 301+ 9B06 20 DE            JR NZ, .rowLoop
 302+ 9B08 C9               RET
 303+ 9B09
 304+ 9B09              ; ==============================================================================
 305+ 9B09              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
 306+ 9B09              ; ==============================================================================
 307+ 9B09              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
 308+ 9B09              ; Se llama ANTES de pintar el sprite.
 309+ 9B09              ;
 310+ 9B09              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 311+ 9B09              ;          IX = puntero al sprite (para leer width/height)
 312+ 9B09              ; ==============================================================================
 313+ 9B09              ; CalcEntityAttrSize - Calcula EntityAttrW/H sin guardar attrs (para enemigos)
 314+ 9B09              ; ==============================================================================
 315+ 9B09              ; Entrada: D = Y pixel, E = X pixel, IX = puntero al sprite (width/height)
 316+ 9B09              ; Solo calcula las dimensiones en chars para que SetEntityAttr funcione.
 317+ 9B09              ; ==============================================================================
 318+ 9B09              CalcEntityAttrSize:
 319+ 9B09                  ; Paging inline (ver nota en DrawSprite)
 320+ 9B09 3A 87 8D         LD A, (CurrentPaging)
 321+ 9B0C E6 F8            AND $F8
 322+ 9B0E F6 06            OR 6
 323+ 9B10 32 87 8D         LD (CurrentPaging), A
 324+ 9B13 01 FD 7F         LD BC, $7FFD
 325+ 9B16 ED 79            OUT (C), A
 326+ 9B18 CD 29 9B         CALL _CalcEntityAttrSizeImpl
 327+ 9B1B 3A 87 8D         LD A, (CurrentPaging)
 328+ 9B1E E6 F8            AND $F8
 329+ 9B20 32 87 8D         LD (CurrentPaging), A
 330+ 9B23 01 FD 7F         LD BC, $7FFD
 331+ 9B26 ED 79            OUT (C), A
 332+ 9B28 C9               RET
 333+ 9B29
 334+ 9B29              _CalcEntityAttrSizeImpl:
 335+ 9B29 DD 7E 00         LD A, (IX+0)                ; width_bytes
 336+ 9B2C 47               LD B, A
 337+ 9B2D 7B               LD A, E
 338+ 9B2E E6 07            AND 7
 339+ 9B30 28 01            JR Z, .ceNoExtra
 340+ 9B32 04               INC B
 341+ 9B33              .ceNoExtra:
 342+ 9B33 78               LD A, B
 343+ 9B34 32 DA 9B         LD (EntityAttrW), A
 344+ 9B37 7A               LD A, D
 345+ 9B38 E6 07            AND 7
 346+ 9B3A 4F               LD C, A
 347+ 9B3B DD 7E 01         LD A, (IX+1)                ; height_pixels
 348+ 9B3E 81               ADD A, C
 349+ 9B3F C6 07            ADD A, 7
 350+ 9B41 0F               RRCA
 351+ 9B42 0F               RRCA
 352+ 9B43 0F               RRCA
 353+ 9B44 E6 1F            AND $1F
 354+ 9B46 32 DB 9B         LD (EntityAttrH), A
 355+ 9B49 C9               RET
 356+ 9B4A
 357+ 9B4A              ; ==============================================================================
 358+ 9B4A              SaveEntityAttr:
 359+ 9B4A                  ; Paging inline (ver nota en DrawSprite)
 360+ 9B4A 3A 87 8D         LD A, (CurrentPaging)
 361+ 9B4D E6 F8            AND $F8
 362+ 9B4F F6 06            OR 6
 363+ 9B51 32 87 8D         LD (CurrentPaging), A
 364+ 9B54 01 FD 7F         LD BC, $7FFD
 365+ 9B57 ED 79            OUT (C), A
 366+ 9B59 CD 6A 9B         CALL _SaveEntityAttrImpl
 367+ 9B5C 3A 87 8D         LD A, (CurrentPaging)
 368+ 9B5F E6 F8            AND $F8
 369+ 9B61 32 87 8D         LD (CurrentPaging), A
 370+ 9B64 01 FD 7F         LD BC, $7FFD
 371+ 9B67 ED 79            OUT (C), A
 372+ 9B69 C9               RET
 373+ 9B6A
 374+ 9B6A              _SaveEntityAttrImpl:
 375+ 9B6A                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
 376+ 9B6A DD 7E 00         LD A, (IX+0)                ; width_bytes
 377+ 9B6D 47               LD B, A
 378+ 9B6E 7B               LD A, E                     ; X pixel (raw)
 379+ 9B6F E6 07            AND 7
 380+ 9B71 28 01            JR Z, .noExtraW
 381+ 9B73 04               INC B                       ; +1 columna si no alineado
 382+ 9B74              .noExtraW:
 383+ 9B74 78               LD A, B
 384+ 9B75 32 DA 9B         LD (EntityAttrW), A
 385+ 9B78
 386+ 9B78                  ; Calcular height_chars = (Y%8 + height + 7) / 8
 387+ 9B78 7A               LD A, D                     ; Y pixel (raw)
 388+ 9B79 E6 07            AND 7                       ; Y offset dentro del char
 389+ 9B7B 4F               LD C, A
 390+ 9B7C DD 7E 01         LD A, (IX+1)                ; height_pixels
 391+ 9B7F 81               ADD A, C                    ; + Y offset
 392+ 9B80 C6 07            ADD A, 7
 393+ 9B82 0F               RRCA
 394+ 9B83 0F               RRCA
 395+ 9B84 0F               RRCA
 396+ 9B85 E6 1F            AND $1F                     ; / 8 = height_chars
 397+ 9B87 32 DB 9B         LD (EntityAttrH), A
 398+ 9B8A
 399+ 9B8A CD 44 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 400+ 9B8D 11 CA 9B         LD DE, EntitySavedAttr      ; DE = buffer destino
 401+ 9B90
 402+ 9B90 3A DB 9B         LD A, (EntityAttrH)
 403+ 9B93 4F               LD C, A                     ; C = filas
 404+ 9B94              .saveRow:
 405+ 9B94 3A DA 9B         LD A, (EntityAttrW)
 406+ 9B97 47               LD B, A                     ; B = columnas
 407+ 9B98 E5               PUSH HL                     ; Guardar inicio de fila
 408+ 9B99              .saveCol:
 409+ 9B99 7E               LD A, (HL)
 410+ 9B9A 12               LD (DE), A
 411+ 9B9B 23               INC HL
 412+ 9B9C 13               INC DE
 413+ 9B9D 10 FA            DJNZ .saveCol
 414+ 9B9F E1               POP HL
 415+ 9BA0                  ; Siguiente fila attr: HL += 32
 416+ 9BA0 D5               PUSH DE
 417+ 9BA1 11 20 00         LD DE, 32
 418+ 9BA4 19               ADD HL, DE
 419+ 9BA5 D1               POP DE
 420+ 9BA6 0D               DEC C
 421+ 9BA7 20 EB            JR NZ, .saveRow
 422+ 9BA9 C9               RET
 423+ 9BAA
 424+ 9BAA              ; ==============================================================================
 425+ 9BAA              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
 426+ 9BAA              ; ==============================================================================
 427+ 9BAA              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
 428+ 9BAA              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
 429+ 9BAA              ;
 430+ 9BAA              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 431+ 9BAA              ; ==============================================================================
 432+ 9BAA              RestoreEntityAttr:
 433+ 9BAA CD 44 9D         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
 434+ 9BAD 11 CA 9B         LD DE, EntitySavedAttr      ; DE = buffer fuente
 435+ 9BB0
 436+ 9BB0 3A DB 9B         LD A, (EntityAttrH)
 437+ 9BB3 4F               LD C, A
 438+ 9BB4              .restRow:
 439+ 9BB4 3A DA 9B         LD A, (EntityAttrW)
 440+ 9BB7 47               LD B, A
 441+ 9BB8 E5               PUSH HL
 442+ 9BB9              .restCol:
 443+ 9BB9 1A               LD A, (DE)
 444+ 9BBA 77               LD (HL), A
 445+ 9BBB 23               INC HL
 446+ 9BBC 13               INC DE
 447+ 9BBD 10 FA            DJNZ .restCol
 448+ 9BBF E1               POP HL
 449+ 9BC0 D5               PUSH DE
 450+ 9BC1 11 20 00         LD DE, 32
 451+ 9BC4 19               ADD HL, DE
 452+ 9BC5 D1               POP DE
 453+ 9BC6 0D               DEC C
 454+ 9BC7 20 EB            JR NZ, .restRow
 455+ 9BC9 C9               RET
 456+ 9BCA
 457+ 9BCA              ; --- Buffer de atributos guardados POR ENTIDAD ---
 458+ 9BCA              ; Cada entidad activa necesita su propio buffer (max 4x4=16 bytes + 2 de W/H).
 459+ 9BCA              ; SavedAttrTable: NUM_ENTITIES * 18 bytes. Seleccionar con SetAttrSlot antes de Save/Restore.
 460+ 9BCA              ; ---
 461+ 9BCA 00 00 00...  EntitySavedAttr:    DEFS 16     ; Buffer activo (copia del slot actual)
 462+ 9BDA 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
 463+ 9BDB 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
 464+ 9BDC 00 00 00...  SavedAttrTable:     DEFS NUM_ENTITIES * 18  ; 17 slots * 18 bytes = 306 bytes
 465+ 9D0E 00           CurrentAttrSlot:    DEFB 0      ; Indice del slot activo (0-16)
 466+ 9D0F
 467+ 9D0F              ; ==============================================================================
 468+ 9D0F              ; SetAttrSlot - Selecciona slot de atributos para una entidad
 469+ 9D0F              ; ==============================================================================
 470+ 9D0F              ; Entrada: A = indice de entidad (0-16)
 471+ 9D0F              ; Carga el buffer de ese slot en EntitySavedAttr/W/H para usar Save/Restore.
 472+ 9D0F              ; ==============================================================================
 473+ 9D0F              SetAttrSlot:
 474+ 9D0F 32 0E 9D         LD (CurrentAttrSlot), A
 475+ 9D12                  ; Calcular offset: A * 18
 476+ 9D12 6F               LD L, A
 477+ 9D13 26 00            LD H, 0
 478+ 9D15 29               ADD HL, HL                  ; x2
 479+ 9D16 54               LD D, H
 480+ 9D17 5D               LD E, L                     ; DE = x2
 481+ 9D18 29               ADD HL, HL                  ; x4
 482+ 9D19 29               ADD HL, HL                  ; x8
 483+ 9D1A 29               ADD HL, HL                  ; x16
 484+ 9D1B 19               ADD HL, DE                  ; x18
 485+ 9D1C 11 DC 9B         LD DE, SavedAttrTable
 486+ 9D1F 19               ADD HL, DE                  ; HL = &SavedAttrTable[slot*18]
 487+ 9D20                  ; Copiar 18 bytes a EntitySavedAttr
 488+ 9D20 11 CA 9B         LD DE, EntitySavedAttr
 489+ 9D23 01 12 00         LD BC, 18
 490+ 9D26 ED B0            LDIR
 491+ 9D28 C9               RET
 492+ 9D29
 493+ 9D29              ; ==============================================================================
 494+ 9D29              ; FlushAttrSlot - Guarda el buffer activo de vuelta al slot
 495+ 9D29              ; ==============================================================================
 496+ 9D29              FlushAttrSlot:
 497+ 9D29 3A 0E 9D         LD A, (CurrentAttrSlot)
 498+ 9D2C 6F               LD L, A
 499+ 9D2D 26 00            LD H, 0
 500+ 9D2F 29               ADD HL, HL                  ; x2
 501+ 9D30 54               LD D, H
 502+ 9D31 5D               LD E, L
 503+ 9D32 29               ADD HL, HL                  ; x4
 504+ 9D33 29               ADD HL, HL                  ; x8
 505+ 9D34 29               ADD HL, HL                  ; x16
 506+ 9D35 19               ADD HL, DE                  ; x18
 507+ 9D36 11 DC 9B         LD DE, SavedAttrTable
 508+ 9D39 19               ADD HL, DE                  ; HL = destino en tabla
 509+ 9D3A EB               EX DE, HL                   ; DE = destino
 510+ 9D3B 21 CA 9B         LD HL, EntitySavedAttr      ; HL = fuente
 511+ 9D3E 01 12 00         LD BC, 18
 512+ 9D41 ED B0            LDIR
 513+ 9D43 C9               RET
 514+ 9D44
 515+ 9D44              ; ==============================================================================
 516+ 9D44              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
 517+ 9D44              ; ==============================================================================
 518+ 9D44              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
 519+ 9D44              ; Salida: HL = direccion en zona de atributos ($5800+)
 520+ 9D44              ; ==============================================================================
 521+ 9D44              CalcAttrAddr:
 522+ 9D44 7A               LD A, D
 523+ 9D45 0F               RRCA
 524+ 9D46 0F               RRCA
 525+ 9D47 0F               RRCA
 526+ 9D48 E6 1F            AND $1F                     ; Y / 8 = fila de atributo
 527+ 9D4A 6F               LD L, A
 528+ 9D4B 26 00            LD H, 0
 529+ 9D4D 29               ADD HL, HL
 530+ 9D4E 29               ADD HL, HL
 531+ 9D4F 29               ADD HL, HL
 532+ 9D50 29               ADD HL, HL
 533+ 9D51 29               ADD HL, HL                  ; HL = fila * 32
 534+ 9D52 7B               LD A, E
 535+ 9D53 0F               RRCA
 536+ 9D54 0F               RRCA
 537+ 9D55 0F               RRCA
 538+ 9D56 E6 1F            AND $1F                     ; X / 8 = columna
 539+ 9D58 B5               OR L
 540+ 9D59 6F               LD L, A
 541+ 9D5A 01 00 58         LD BC, ATTR_BASE
 542+ 9D5D 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
 543+ 9D5E C9               RET
 544+ 9D5F
 545+ 9D5F              ; ==============================================================================
 546+ 9D5F              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
 547+ 9D5F              ; ==============================================================================
 548+ 9D5F              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
 549+ 9D5F              ; Salida: HL=direccion en VRAM
 550+ 9D5F              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
 551+ 9D5F              ; ==============================================================================
 552+ 9D5F              CalcPixelAddr:
 553+ 9D5F 7A               LD A, D
 554+ 9D60 E6 C0            AND $C0                     ; Y7 Y6
 555+ 9D62 1F               RRA
 556+ 9D63 1F               RRA
 557+ 9D64 1F               RRA                         ; >> 3
 558+ 9D65 F6 40            OR $40                      ; + SCREEN_BASE ($4000)
 559+ 9D67 67               LD H, A
 560+ 9D68
 561+ 9D68 7A               LD A, D
 562+ 9D69 E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
 563+ 9D6B B4               OR H
 564+ 9D6C 67               LD H, A
 565+ 9D6D
 566+ 9D6D 7A               LD A, D
 567+ 9D6E E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
 568+ 9D70 87               ADD A, A
 569+ 9D71 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
 570+ 9D72 6F               LD L, A
 571+ 9D73
 572+ 9D73 7B               LD A, E
 573+ 9D74 1F               RRA
 574+ 9D75 1F               RRA
 575+ 9D76 1F               RRA
 576+ 9D77 E6 1F            AND $1F                     ; X / 8 = columna
 577+ 9D79 B5               OR L
 578+ 9D7A 6F               LD L, A
 579+ 9D7B C9               RET
 580+ 9D7C
 581+ 9D7C              ; ==============================================================================
 582+ 9D7C              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
 583+ 9D7C              ; ==============================================================================
 584+ 9D7C              DrawDebugInfo:
 585+ 9D7C 3A 0D 83         LD A, (CurrentScreenX)
 586+ 9D7F 1E 00            LD E, 0
 587+ 9D81 CD 9E 9D         CALL .drawHexDigit
 588+ 9D84
 589+ 9D84 3E 2C            LD A, ','
 590+ 9D86 1E 01            LD E, 1
 591+ 9D88 CD AA 9D         CALL .drawChar
 592+ 9D8B
 593+ 9D8B 3A 0E 83         LD A, (CurrentScreenY)
 594+ 9D8E 1E 02            LD E, 2
 595+ 9D90 CD 9E 9D         CALL .drawHexDigit
 596+ 9D93
 597+ 9D93 21 00 58         LD HL, ATTR_BASE
 598+ 9D96 3E 47            LD A, WHITE | $40
 599+ 9D98 77               LD (HL), A
 600+ 9D99 23               INC HL
 601+ 9D9A 77               LD (HL), A
 602+ 9D9B 23               INC HL
 603+ 9D9C 77               LD (HL), A
 604+ 9D9D C9               RET
 605+ 9D9E
 606+ 9D9E              .drawHexDigit:
 607+ 9D9E E6 0F            AND $0F
 608+ 9DA0 FE 0A            CP 10
 609+ 9DA2 38 04            JR C, .isNum
 610+ 9DA4 C6 37            ADD A, 'A' - 10
 611+ 9DA6 18 02            JR .drawChar
 612+ 9DA8              .isNum:
 613+ 9DA8 C6 30            ADD A, '0'
 614+ 9DAA              .drawChar:
 615+ 9DAA 6F               LD L, A
 616+ 9DAB 26 00            LD H, 0
 617+ 9DAD 29               ADD HL, HL
 618+ 9DAE 29               ADD HL, HL
 619+ 9DAF 29               ADD HL, HL
 620+ 9DB0 01 00 3C         LD BC, $3C00
 621+ 9DB3 09               ADD HL, BC
 622+ 9DB4
 623+ 9DB4 16 40            LD D, $40
 624+ 9DB6 06 08            LD B, 8
 625+ 9DB8              .charLoop:
 626+ 9DB8 7E               LD A, (HL)
 627+ 9DB9 12               LD (DE), A
 628+ 9DBA 23               INC HL
 629+ 9DBB 14               INC D
 630+ 9DBC 10 FA            DJNZ .charLoop
 631+ 9DBE C9               RET
 632+ 9DBF
