 378+ EDE3              ; ==============================================================================
 379+ EDE3              ; DrawHealthStaminaHUD - Barra de salud (izq) y stamina (der) en decoraciones
 380+ EDE3              ; ==============================================================================
 381+ EDE3              ; Borra scanlines de arriba hacia abajo segun nivel (0-16).
 382+ EDE3              ; Decoraciones: 2 cols × 16 scanlines (8 en row 22 + 8 en row 23).
 383+ EDE3              ; Datos del sprite estan CPL'd → borrar = poner $FF en VRAM.
 384+ EDE3              ; ==============================================================================
 385+ EDE3              DrawHealthStaminaHUD:
 386+ EDE3                  ; --- Salud (izquierda: cols 13-14, sprite bytes 0-1 por scanline) ---
 387+ EDE3 3A C8 B3         LD A, (PlayerHealth)
 388+ EDE6 4F               LD C, A                             ; C = nivel (0-16)
 389+ EDE7 21 0D 40         LD HL, $400D                        ; Col 13, row 0, scan 0
 390+ EDEA 11 2D 40         LD DE, $402D                        ; Col 13, row 1, scan 0
 391+ EDED DD 21 C9 E9      LD IX, BgGfx_hud_clock + 2          ; Sprite sano (skip header), offset 0
 392+ EDF1 FD 21 3A EA      LD IY, BgGfx_hud_clock_decayed + 2  ; Sprite marchito, offset 0
 393+ EDF5 CD 5B EE         CALL .drawBar
 394+ EDF8
 395+ EDF8                  ; --- Stamina (derecha: cols 17-18, sprite bytes 4-5 por scanline) ---
 396+ EDF8 3A C9 B3         LD A, (PlayerStamina)
 397+ EDFB 4F               LD C, A
 398+ EDFC 21 11 40         LD HL, $4011                        ; Col 17, row 0, scan 0
 399+ EDFF 11 31 40         LD DE, $4031                        ; Col 17, row 1, scan 0
 400+ EE02 DD 21 CD E9      LD IX, BgGfx_hud_clock + 2 + 4      ; Sprite sano, offset 4 (cols 4-5)
 401+ EE06 FD 21 3E EA      LD IY, BgGfx_hud_clock_decayed + 2 + 4  ; Sprite marchito, offset 4
 402+ EE0A CD 5B EE         CALL .drawBar
 403+ EE0D
 404+ EE0D                  ; --- Flash de recuperacion del pozo ---
 405+ EE0D 3A 62 8D         LD A, (WellFlashTimer)
 406+ EE10 B7               OR A
 407+ EE11 28 23            JR Z, .noFlash
 408+ EE13 3D               DEC A
 409+ EE14 32 62 8D         LD (WellFlashTimer), A
 410+ EE17                  ; Flash: alternar blanco/normal cada 4 frames
 411+ EE17 E6 04            AND $04
 412+ EE19 28 1B            JR Z, .noFlash
 413+ EE1B                  ; Flash blanco brillante en ambas barras (player attr no se toca:
 414+ EE1B                  ; reservado para buffs de pickup rayo/caracol que cambian su color).
 415+ EE1B 3E 47            LD A, WHITE | $40
 416+ EE1D 32 0D 58         LD ($580D), A
 417+ EE20 32 0E 58         LD ($580E), A
 418+ EE23 32 2D 58         LD ($582D), A
 419+ EE26 32 2E 58         LD ($582E), A
 420+ EE29 32 11 58         LD ($5811), A
 421+ EE2C 32 12 58         LD ($5812), A
 422+ EE2F 32 31 58         LD ($5831), A
 423+ EE32 32 32 58         LD ($5832), A
 424+ EE35 C9               RET
 425+ EE36              .noFlash:
 426+ EE36                  ; --- Attrs segun nivel (normal) ---
 427+ EE36                  ; Salud
 428+ EE36 3A C8 B3         LD A, (PlayerHealth)
 429+ EE39 CD A9 EE         CALL .levelToColor
 430+ EE3C 32 0D 58         LD ($580D), A
 431+ EE3F 32 0E 58         LD ($580E), A
 432+ EE42 32 2D 58         LD ($582D), A
 433+ EE45 32 2E 58         LD ($582E), A
 434+ EE48                  ; Stamina
 435+ EE48 3A C9 B3         LD A, (PlayerStamina)
 436+ EE4B CD A9 EE         CALL .levelToColor
 437+ EE4E 32 11 58         LD ($5811), A
 438+ EE51 32 12 58         LD ($5812), A
 439+ EE54 32 31 58         LD ($5831), A
 440+ EE57 32 32 58         LD ($5832), A
 441+ EE5A C9               RET
 442+ EE5B
 443+ EE5B              ; --- Subrutina: redibujar decoracion completa y blanquear parte vacia ---
 444+ EE5B              ; C = nivel (0-16), HL = base col row 0, DE = base col row 1
 445+ EE5B              ; IX = puntero al primer byte de la decoracion en sprite data
 446+ EE5B              ; Redibuja 16 scanlines: las C inferiores con datos del sprite,
 447+ EE5B              ; las (16-C) superiores con $00 (vacio/negro)
 448+ EE5B              .drawBar:
 449+ EE5B 7D               LD A, L
 450+ EE5C 32 A7 EE         LD (.dbCol), A                      ; Guardar columna base row 0
 451+ EE5F 7B               LD A, E
 452+ EE60 32 A8 EE         LD (.dbCol1), A                     ; Guardar columna base row 1
 453+ EE63 06 10            LD B, 16                            ; 16 scanlines totales
 454+ EE65 16 00            LD D, 0                             ; D = scanline index (0 = arriba)
 455+ EE67                  ; Calcular umbral: scanlines 0..(15-C) = vacio, (16-C)..15 = lleno
 456+ EE67 3E 10            LD A, 16
 457+ EE69 91               SUB C
 458+ EE6A 5F               LD E, A                             ; E = primera scanline llena
 459+ EE6B              .dbLoop:
 460+ EE6B                  ; Calcular direccion VRAM
 461+ EE6B 7A               LD A, D
 462+ EE6C FE 08            CP 8
 463+ EE6E 30 09            JR NC, .dbCalcR1
 464+ EE70                  ; Char row 0
 465+ EE70 67               LD H, A
 466+ EE71 CB F4            SET 6, H
 467+ EE73 3A A7 EE         LD A, (.dbCol)
 468+ EE76 6F               LD L, A
 469+ EE77 18 09            JR .dbWrite
 470+ EE79              .dbCalcR1:
 471+ EE79                  ; Char row 1
 472+ EE79 D6 08            SUB 8
 473+ EE7B 67               LD H, A
 474+ EE7C CB F4            SET 6, H
 475+ EE7E 3A A8 EE         LD A, (.dbCol1)
 476+ EE81 6F               LD L, A
 477+ EE82              .dbWrite:
 478+ EE82                  ; D < E → marchito (decayed), D >= E → sano (healthy sprite data)
 479+ EE82 7A               LD A, D
 480+ EE83 BB               CP E
 481+ EE84 30 0B            JR NC, .dbFull
 482+ EE86                  ; Marchito: copiar sprite decayed
 483+ EE86 FD 7E 00         LD A, (IY+0)
 484+ EE89 77               LD (HL), A
 485+ EE8A 23               INC HL
 486+ EE8B FD 7E 01         LD A, (IY+1)
 487+ EE8E 77               LD (HL), A
 488+ EE8F 18 09            JR .dbAdvanceSpr
 489+ EE91              .dbFull:
 490+ EE91                  ; Sano: copiar sprite data (ya almacenado CPL'd)
 491+ EE91 DD 7E 00         LD A, (IX+0)
 492+ EE94 77               LD (HL), A
 493+ EE95 23               INC HL
 494+ EE96 DD 7E 01         LD A, (IX+1)
 495+ EE99 77               LD (HL), A
