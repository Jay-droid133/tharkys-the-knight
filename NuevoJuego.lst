7447+ C89F              ; --- bfsTryNbr: probar vecino (B=nx, C=ny, A=step_dir). Si valido, encolar
7448+ C89F              ; y actualizar best. ---
7449+ C89F              .bfsTryNbr:
7450+ C89F 32 7A 5F         LD (DBfsTryDir), A
7451+ C8A2 78               LD A, B
7452+ C8A3 32 78 5F         LD (DBfsTryCx), A
7453+ C8A6 79               LD A, C
7454+ C8A7 32 79 5F         LD (DBfsTryCy), A
