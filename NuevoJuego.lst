 599+ 718A              ; ==============================================================================
 600+ 718A              ; PaintSynthPickupAttrs - Pinta attrs hardcoded del random pickup en VRAM
 601+ 718A              ; ==============================================================================
 602+ 718A              ; Se llama desde:
 603+ 718A              ;   - .pkDrawDone (DrawScreen): tras dibujar pixels del synth.
 604+ 718A              ;   - MainLoop tras RefreshPickupAttrs: para repintar attrs si un enemigo paso
 605+ 718A              ;     por encima y los borro.
 606+ 718A              ;
 607+ 718A              ; Bypass total de tint swap + day/night remap → siempre brillan:
 608+ 718A              ;   life          = $47 (white bright, paper black)
 609+ 718A              ;   health_pickup = $42 (red bright,   paper black)
 610+ 718A              ;   stamina_pickup= $45 (cyan bright,  paper black)
 611+ 718A              ;
 612+ 718A              ; Pickup es 16x16 = 2x2 char attrs.
 613+ 718A              ; Early-out si RandomSynthMapX = $FE (no activo).
 614+ 718A              ; Destruye AF, BC, DE, HL.
 615+ 718A              ; ==============================================================================
 616+ 718A              PaintSynthPickupAttrs:
 617+ 718A 3A B4 5F         LD A, (RandomSynthMapX)
 618+ 718D FE FE            CP $FE
 619+ 718F C8               RET Z                               ; no activo
 620+ 7190                  ; --- Attr byte: leido del sprite al activar (RandomSynthAttr en RAM) ---
 621+ 7190                  ; Respeta el color que el usuario puso en el BG editor. Bypass del remap
 622+ 7190                  ; dia/noche garantizado al escribir directo a VRAM (sin DrawBgAttrOnly).
 623+ 7190 3A BB 5F         LD A, (RandomSynthAttr)
 624+ 7193 4F               LD C, A                             ; C = attr byte
 625+ 7194                  ; --- Calcular VRAM addr fila 0 = ATTR_BASE + (charY+BG_Y_OFFSET)*32 + charX ---
 626+ 7194 3A B9 5F         LD A, (RandomSynthCharY)
 627+ 7197 C6 02            ADD A, BG_Y_OFFSET
 628+ 7199 26 00            LD H, 0
 629+ 719B 6F               LD L, A
 630+ 719C 29               ADD HL, HL
 631+ 719D 29               ADD HL, HL
 632+ 719E 29               ADD HL, HL
 633+ 719F 29               ADD HL, HL
 634+ 71A0 29               ADD HL, HL                          ; *32
 635+ 71A1 3A B8 5F         LD A, (RandomSynthCharX)
 636+ 71A4 85               ADD A, L
 637+ 71A5 6F               LD L, A
 638+ 71A6 30 01            JR NC, .pspaNoCarry
 639+ 71A8 24               INC H
 640+ 71A9              .pspaNoCarry:
 641+ 71A9 11 00 58         LD DE, ATTR_BASE
 642+ 71AC 19               ADD HL, DE                          ; HL = VRAM addr fila 0, col 0
 643+ 71AD                  ; --- Escribir 4 attrs (2x2) ---
 644+ 71AD 71               LD (HL), C
 645+ 71AE 23               INC HL
 646+ 71AF 71               LD (HL), C                          ; fila 0
 647+ 71B0 7D               LD A, L
 648+ 71B1 C6 1F            ADD A, 31                           ; +32 a fila siguiente, -1 (al col 0)
 649+ 71B3 6F               LD L, A
 650+ 71B4 30 01            JR NC, .pspaNoCarry2
 651+ 71B6 24               INC H
 652+ 71B7              .pspaNoCarry2:
 653+ 71B7 71               LD (HL), C
 654+ 71B8 23               INC HL
 655+ 71B9 71               LD (HL), C                          ; fila 1
 656+ 71BA C9               RET
