 246+ E468              ; --- DrawSwordModeHUD: pinta letra B/C/A en fila 23, col 0 ---
 247+ E468              DrawSwordModeHUD:
 248+ E468 3A 4A B3         LD A, (SwordMode)
 249+ E46B 21 9B E4         LD HL, .modeChars
 250+ E46E 5F               LD E, A
 251+ E46F 16 00            LD D, 0
 252+ E471 19               ADD HL, DE
 253+ E472 7E               LD A, (HL)                          ; A = ASCII del modo
 254+ E473                  ; Calcular direccion en VRAM: fila 0, col 0 = $4000 (scan 0)
 255+ E473 21 00 40         LD HL, $4000
 256+ E476                  ; Buscar glyph en ROM charset ($3C00 + char*8)
 257+ E476 5F               LD E, A
 258+ E477 16 00            LD D, 0
 259+ E479 42               LD B, D                             ; B = 0
 260+ E47A CB 23            SLA E
 260+ E47C CB 12          RL D                        ; *2
 261+ E47E CB 23            SLA E
 261+ E480 CB 12          RL D                        ; *4
 262+ E482 CB 23            SLA E
 262+ E484 CB 12          RL D                        ; *8
 263+ E486 E5               PUSH HL
 264+ E487 21 00 3C         LD HL, $3C00
 265+ E48A 19               ADD HL, DE                          ; HL = direccion del glyph
 266+ E48B EB               EX DE, HL                           ; DE = glyph
 267+ E48C E1               POP HL                              ; HL = VRAM
 268+ E48D 06 08            LD B, 8
 269+ E48F              .drawChar:
 270+ E48F 1A               LD A, (DE)
 271+ E490 77               LD (HL), A
 272+ E491 13               INC DE
