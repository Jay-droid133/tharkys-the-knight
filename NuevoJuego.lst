 524+ F143
 525+ F143              .dcRedraw:
 526+ F143                  ; --- dx = ObjectiveScreenX - CurrentScreenX (signed) ---
 527+ F143 3A BA 82         LD A, (ObjectiveScreenX)
 528+ F146 47               LD B, A
 529+ F147 3A 0A 83         LD A, (CurrentScreenX)
 530+ F14A 4F               LD C, A
 531+ F14B 78               LD A, B
 532+ F14C 91               SUB C                               ; A = dx (signed)
 533+ F14D                  ; abs(dx) -> H, sign(dx)+1 -> L
 534+ F14D F2 57 F1         JP P, .dcDxNonNeg
 535+ F150 ED 44            NEG
 536+ F152 67               LD H, A                             ; abs(dx)
 537+ F153 2E 00            LD L, 0                             ; sign+1 = 0 (negativo)
 538+ F155 18 0A            JR .dcDxDone
 539+ F157              .dcDxNonNeg:
 540+ F157 67               LD H, A
 541+ F158 B7               OR A
 542+ F159 20 04            JR NZ, .dcDxPositive
 543+ F15B 2E 01            LD L, 1                             ; dx == 0
 544+ F15D 18 02            JR .dcDxDone
 545+ F15F              .dcDxPositive:
 546+ F15F 2E 02            LD L, 2
 547+ F161              .dcDxDone:
 548+ F161 E5               PUSH HL                             ; stack: [H=abs_dx, L=signdx+1]
