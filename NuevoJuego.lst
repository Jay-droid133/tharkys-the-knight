1203+ EE5A              ; ==============================================================================
1204+ EE5A              ; ChurchCutsceneInitStatueShake - prepara state para fase SHAKE_STATUE
1205+ EE5A              ; ==============================================================================
1206+ EE5A              ; Busca la estatua del tipo atrapado en CurrentScreenBuffer, computa su pixel
1207+ EE5A              ; original y lo guarda en Orig/Last X/Y. La estatua ya esta dibujada en su
1208+ EE5A              ; posicion char-aligned (la pinto DrawScreen al entrar a la pantalla).
1209+ EE5A              ; ==============================================================================
1210+ EE5A              ChurchCutsceneInitStatueShake:
1211+ EE5A 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1212+ EE5D 21 34 67         LD HL, StatueIdTable
1213+ EE60 5F               LD E, A
1214+ EE61 16 00            LD D, 0
1215+ EE63 19               ADD HL, DE
1216+ EE64 7E               LD A, (HL)                              ; A = statue id
1217+ EE65 B7               OR A
1218+ EE66 C8               RET Z                                   ; sin estatua
1219+ EE67 32 97 EE         LD (.cisTargetId), A
1220+ EE6A                  ; Buscar en CurrentScreenBuffer
1221+ EE6A 2A 1F 82         LD HL, (CurrentScreenAddr)
1222+ EE6D              .cisLoop:
1223+ EE6D 7E               LD A, (HL)
1224+ EE6E FE FF            CP $FF
1225+ EE70 C8               RET Z                                   ; no encontrada (no se hace shake)
1226+ EE71 47               LD B, A
1227+ EE72 3A 97 EE         LD A, (.cisTargetId)
1228+ EE75 B8               CP B
1229+ EE76 28 06            JR Z, .cisFound
1230+ EE78 11 04 00         LD DE, 4
1231+ EE7B 19               ADD HL, DE
1232+ EE7C 18 EF            JR .cisLoop
1233+ EE7E              .cisFound:
1234+ EE7E 23               INC HL
1235+ EE7F 7E               LD A, (HL)                              ; charX
1236+ EE80                  ; Pixel X = charX * 8
1237+ EE80 87               ADD A, A
1238+ EE81 87               ADD A, A
1239+ EE82 87               ADD A, A
1240+ EE83 32 A0 5F         LD (ChurchCutsceneStatueOrigX), A
1241+ EE86 32 A2 5F         LD (ChurchCutsceneStatueLastX), A
1242+ EE89 23               INC HL
1243+ EE8A 7E               LD A, (HL)                              ; charY
1244+ EE8B                  ; Pixel Y = (charY + BG_Y_OFFSET) * 8
1245+ EE8B C6 02            ADD A, BG_Y_OFFSET
1246+ EE8D 87               ADD A, A
1247+ EE8E 87               ADD A, A
1248+ EE8F 87               ADD A, A
1249+ EE90 32 A1 5F         LD (ChurchCutsceneStatueOrigY), A
1250+ EE93 32 A3 5F         LD (ChurchCutsceneStatueLastY), A
1251+ EE96 C9               RET
1252+ EE97 00           .cisTargetId: DEFB 0
