2896+ DB58 5E               LD E, (HL)
2897+ DB59 23               INC HL
2898+ DB5A 56               LD D, (HL)                  ; DE = BgGfx ptr
2899+ DB5B EB               EX DE, HL                   ; HL = BgGfx ptr
2900+ DB5C 3E 03            LD A, 3                     ; KeyLockTable ptrs viven en bank 3
2901+ DB5E CD C2 6C         CALL LoadBgSpriteToBuffer
2902+ DB61 DD 21 F8 86      LD IX, BgSpriteBuffer
2903+ DB65 06 14            LD B, 20                    ; charX (col 20)
