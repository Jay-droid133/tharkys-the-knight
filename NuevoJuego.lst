 685+ 90A1
 686+ 90A1 7E               LD A, (HL)
 687+ 90A2 B7               OR A
 688+ 90A3 CA EF 90         JP Z, .mosNoGaps
 689+ 90A6 47               LD B, A                         ; B = total count
 690+ 90A7 23               INC HL                          ; HL = first entry
 691+ 90A8
 692+ 90A8                  ; --- Pass 1: count entries matching wantSide ---
 693+ 90A8 E5               PUSH HL                         ; save entries ptr
 694+ 90A9 C5               PUSH BC                         ; save B (total)
 695+ 90AA 0E 00            LD C, 0                         ; C = match count
 696+ 90AC              .mosCountLoop:
 697+ 90AC 7E               LD A, (HL)                      ; side
 698+ 90AD 23               INC HL
 699+ 90AE 23               INC HL                          ; skip coord byte → next entry
 700+ 90AF 5F               LD E, A                         ; E = entry side
 701+ 90B0 3A B7 97         LD A, (MaiGapWantSide)
