 875+ CE9E              ; ==============================================================================
 876+ CE9E              ; ApplyTintSwap - Reemplaza paper si coincide con tintPaper del sprite
 877+ CE9E              ; ==============================================================================
 878+ CE9E              ; Entrada: A = attr byte
 879+ CE9E              ; Salida:  A = attr con paper reemplazado (o sin cambio)
 880+ CE9E              ; Preserva: HL, DE, BC, IX
 881+ CE9E              ; ==============================================================================
 882+ CE9E              ApplyTintSwap:
 883+ CE9E C5               PUSH BC
 884+ CE9F 47               LD B, A                     ; B = attr original
 885+ CEA0 3A 9A CE         LD A, (CurrentTintVar)
 886+ CEA3 FE FF            CP $FF
 887+ CEA5 28 24            JR Z, .tintNoChange
 888+ CEA7 4F               LD C, A                     ; C = tint variant (new paper 0-7)
 889+ CEA8 3A 9B CE         LD A, (CurrentTintPaper)
 890+ CEAB FE FF            CP $FF
 891+ CEAD 28 1C            JR Z, .tintNoChange
 892+ CEAF                  ; A = tintPaper (0-7), C = tintVar (0-7), B = attr
 893+ CEAF                  ; Extraer paper del attr: bits 5-3
 894+ CEAF 78               LD A, B
 895+ CEB0 E6 38            AND $38                     ; A = 00PPP000
 896+ CEB2 0F               RRCA
 897+ CEB3 0F               RRCA
 898+ CEB4 0F               RRCA                        ; A = 00000PPP = paper actual
 899+ CEB5 D5               PUSH DE
 900+ CEB6 57               LD D, A                     ; D = paper actual
 901+ CEB7 3A 9B CE         LD A, (CurrentTintPaper)
 902+ CEBA BA               CP D                        ; paper actual == tintPaper?
 903+ CEBB D1               POP DE
 904+ CEBC 20 0D            JR NZ, .tintNoChange
 905+ CEBE                  ; Match: reemplazar paper bits con tintVar
 906+ CEBE 78               LD A, B
 907+ CEBF E6 C7            AND $C7                     ; A = FB000III (limpiar paper)
 908+ CEC1 D5               PUSH DE
 909+ CEC2 57               LD D, A
 910+ CEC3 79               LD A, C                     ; A = tintVar (0-7)
 911+ CEC4 07               RLCA
 912+ CEC5 07               RLCA
 913+ CEC6 07               RLCA                        ; A = 00PPP000
 914+ CEC7 B2               OR D                        ; A = FBPPPIII
 915+ CEC8 D1               POP DE
 916+ CEC9 C1               POP BC
 917+ CECA C9               RET
 918+ CECB              .tintNoChange:
 919+ CECB 78               LD A, B                     ; devolver sin cambio
 920+ CECC C1               POP BC
 921+ CECD C9               RET
