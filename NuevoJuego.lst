 727+ 9508                  ; A = target idx 0..matches-1. Descartar stack ANTES de moverlo a C,
 728+ 9508                  ; porque POP BC machaca C (bug anterior: target se perdia, siempre idx 0).
 729+ 9508 C1               POP BC                          ; discard saved total count
 730+ 9509 E1               POP HL                          ; HL = first entry ptr again
 731+ 950A 4F               LD C, A                         ; C = target match index
 732+ 950B 06 00            LD B, 0                         ; B = matches seen so far
