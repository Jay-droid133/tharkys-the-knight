 121+ E575              ; UpdateGameClock
 122+ E575              ; ==============================================================================
 123+ E575              UpdateGameClock:
 124+ E575 3A F4 81         LD A, (TimeFrozen)
 125+ E578 B7               OR A
 126+ E579 C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 127+ E57A 21 DB E3         LD HL, GameSubMinute
 128+ E57D 34               INC (HL)
 129+ E57E 3A DE E3         LD A, (SubMinuteMax)
 130+ E581 BE               CP (HL)
 131+ E582 C0               RET NZ
 132+ E583
 133+ E583 AF               XOR A
 134+ E584 32 DB E3         LD (GameSubMinute), A
 135+ E587 21 DC E3         LD HL, GameMinutes
 136+ E58A 34               INC (HL)
 137+ E58B                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 138+ E58B                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 139+ E58B 3A DC E3         LD A, (GameMinutes)
 140+ E58E FE 3C            CP 60
 141+ E590 C0               RET NZ
 142+ E591
 143+ E591 AF               XOR A
 144+ E592 32 DC E3         LD (GameMinutes), A
 145+ E595 21 DD E3         LD HL, GameHours
 146+ E598 34               INC (HL)
 147+ E599 7E               LD A, (HL)
 148+ E59A FE 18            CP 24
 149+ E59C 20 04            JR NZ, .checkPhase
 150+ E59E AF               XOR A
 151+ E59F 32 DD E3         LD (GameHours), A
 152+ E5A2
 153+ E5A2              .checkPhase:
 154+ E5A2 3A DD E3         LD A, (GameHours)
 155+ E5A5 21 E7 E3         LD HL, PhaseTable
 156+ E5A8 06 07            LD B, 7
 157+ E5AA              .phaseLoop:
 158+ E5AA BE               CP (HL)
 159+ E5AB 28 05            JR Z, .phaseFound
 160+ E5AD 23               INC HL
 161+ E5AE 23               INC HL
 162+ E5AF 10 F9            DJNZ .phaseLoop
 163+ E5B1 C9               RET
 164+ E5B2              .phaseFound:
 165+ E5B2 23               INC HL
 166+ E5B3 7E               LD A, (HL)
 167+ E5B4 F5               PUSH AF
 168+ E5B5 CD 8B DD         CALL SetTimeOfDay
 169+ E5B8 F1               POP AF
 170+ E5B9 FE 04            CP 4                                ; Fase 4 = N2 (medianoche 00:00)?
 171+ E5BB C0               RET NZ
 172+ E5BC                  ; Nuevo dia: incrementar ciclo
 173+ E5BC 21 7D BD         LD HL, DayCycleCount
 174+ E5BF 34               INC (HL)
 175+ E5C0 C9               RET
