 142+ E419 3A 9A E3         LD A, (CurrentTimeOfDay)
 143+ E41C 21 18 E8         LD HL, RemapHouseTablePtrs
 144+ E41F 5F               LD E, A
 145+ E420 16 00            LD D, 0
 146+ E422 19               ADD HL, DE
 147+ E423 19               ADD HL, DE
 148+ E424 5E               LD E, (HL)
 149+ E425 23               INC HL
 150+ E426 56               LD D, (HL)
 151+ E427 ED 53 9D E3      LD (CurrentHouseRemapTable), DE
 152+ E42B C9               RET
 153+ E42C
 154+ E42C              ; ==============================================================================
 155+ E42C              ; CheckDebugKeys - Lee tecla T para ciclar momento del dia
 156+ E42C              ; ==============================================================================
 157+ E42C              CheckDebugKeys:
 158+ E42C 3E FB            LD A, $FB
 159+ E42E DB FE            IN A, ($FE)
 160+ E430 CB 67            BIT 4, A                ; T key: bit 4 de semi-fila $FBFE (0=pulsada)
 161+ E432 20 1C            JR NZ, .notPressed
 162+ E434
 163+ E434                  ; Tecla pulsada: comprobar debounce
 164+ E434 3A A1 E3         LD A, (DebugKeyDebounce)
 165+ E437 B7               OR A
 166+ E438 C0               RET NZ                  ; Ya estaba pulsada, ignorar
 167+ E439
 168+ E439                  ; Primera pulsacion: ciclar
 169+ E439 3E 01            LD A, 1
 170+ E43B 32 A1 E3         LD (DebugKeyDebounce), A
 171+ E43E
 172+ E43E 3A 9A E3         LD A, (CurrentTimeOfDay)
 173+ E441 3C               INC A
 174+ E442 FE 07            CP NUM_TIME_MOMENTS
 175+ E444 38 01            JR C, .noWrap
 176+ E446 AF               XOR A                   ; Volver a 0 (Dia)
 177+ E447              .noWrap:
 178+ E447 F5               PUSH AF
 179+ E448 CD A2 E3         CALL SetTimeOfDay
 180+ E44B F1               POP AF
 181+ E44C CD E6 EB         CALL SetClockToPhaseHour
 182+ E44F C9               RET
 183+ E450
 184+ E450              .notPressed:
 185+ E450 AF               XOR A
 186+ E451 32 A1 E3         LD (DebugKeyDebounce), A
 187+ E454
 188+ E454                  ; --- Tecla S: incrementar DayCycleCount (sube velocidad nasties) ---
 189+ E454 3E FD            LD A, $FD
 190+ E456 DB FE            IN A, ($FE)
 191+ E458 4F               LD C, A                 ; C = estado semi-fila $FDFE
 192+ E459 CB 49            BIT 1, C                ; S key: bit 1 (0=pulsada)
 193+ E45B 20 13            JR NZ, .sNotPressed
 194+ E45D 3A AB E4         LD A, (SpeedKeyDebounce)
 195+ E460 B7               OR A
 196+ E461 C0               RET NZ
 197+ E462 3E 01            LD A, 1
 198+ E464 32 AB E4         LD (SpeedKeyDebounce), A
 199+ E467 21 21 BD         LD HL, DayCycleCount
 200+ E46A 7E               LD A, (HL)
 201+ E46B FE 0A            CP 10
 202+ E46D D0               RET NC                  ; Ya en maximo
 203+ E46E 34               INC (HL)
 204+ E46F C9               RET
 205+ E470              .sNotPressed:
 206+ E470                  ; --- Tecla D: decrementar DayCycleCount (baja velocidad nasties) ---
 207+ E470 CB 51            BIT 2, C                ; D key: bit 2 (0=pulsada)
 208+ E472 20 13            JR NZ, .dNotPressed
 209+ E474 3A AB E4         LD A, (SpeedKeyDebounce)
 210+ E477 B7               OR A
 211+ E478 C0               RET NZ
 212+ E479 3E 01            LD A, 1
 213+ E47B 32 AB E4         LD (SpeedKeyDebounce), A
 214+ E47E 21 21 BD         LD HL, DayCycleCount
 215+ E481 7E               LD A, (HL)
 216+ E482 FE 01            CP 1
 217+ E484 C8               RET Z                   ; Ya en minimo
 218+ E485 35               DEC (HL)
 219+ E486 C9               RET
 220+ E487              .dNotPressed:
 221+ E487 AF               XOR A
 222+ E488 32 AB E4         LD (SpeedKeyDebounce), A
 223+ E48B
 224+ E48B                  ; --- Tecla N: togglea NoclipMode (debug) ---
 225+ E48B 3E 7F            LD A, $7F
 226+ E48D DB FE            IN A, ($FE)                 ; fila SPACE-SS-M-N-B
 227+ E48F CB 5F            BIT 3, A                    ; N = bit 3 (0 = pulsada)
 228+ E491 20 13            JR NZ, .nNotPressed
 229+ E493 3A AC E4         LD A, (NoclipKeyDebounce)
 230+ E496 B7               OR A
 231+ E497 C0               RET NZ
 232+ E498 3E 01            LD A, 1
 233+ E49A 32 AC E4         LD (NoclipKeyDebounce), A
