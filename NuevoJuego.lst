1686+ F5F4              ; church-cutscene block (lines 1489-2181 originales) movido a code/church_cutscene.asm
1687+ F5F4              ; e incluido en $6000+ desde main.asm (slot 1, siempre visible).
1688+ F5F4
1689+ F5F4              ; ==============================================================================
1690+ F5F4              ; SPRITES PLACEHOLDER (16x16 px = 16 filas x 2 bytes = 32 bytes c/u)
1691+ F5F4              ; ==============================================================================
1692+ F5F4              ; Indice (CompassSprites[idx]):
1693+ F5F4              ;   0 = NW    1 = N    2 = NE
1694+ F5F4              ;   3 = W     4 = X    5 = E
1695+ F5F4              ;   6 = SW    7 = S    8 = SE
1696+ F5F4              ; ==============================================================================
1697+ F5F4              CompassSprites:
1698+ F5F4 13 F7            DEFW Sprite_Compass_NW
1699+ F5F6 33 F6            DEFW Sprite_Compass_N
1700+ F5F8 53 F6            DEFW Sprite_Compass_NE
1701+ F5FA F3 F6            DEFW Sprite_Compass_W
1702+ F5FC 33 F7            DEFW Sprite_Compass_X
1703+ F5FE 73 F6            DEFW Sprite_Compass_E
1704+ F600 D3 F6            DEFW Sprite_Compass_SW
1705+ F602 B3 F6            DEFW Sprite_Compass_S
1706+ F604 93 F6            DEFW Sprite_Compass_SE
1707+ F606
1708+ F606              ; ==============================================================================
1709+ F606              ; CompassWobbleTable - Indexada por idx target (0..8). 4 bytes por entry:
1710+ F606              ;   {prev2_idx, prev_idx, next_idx, next2_idx} en sentido horario (clockwise).
1711+ F606              ; Mapping clockwise: N(1) -> NE(2) -> E(5) -> SE(8) -> S(7) -> SW(6) -> W(3) -> NW(0) -> N(1)
1712+ F606              ; prev2/next2 son dos posiciones counter-/clockwise respectivamente.
1713+ F606              ; idx 4 (X) no vibra; entry rellena con 4,4,4,4 como fallback inocuo.
1714+ F606              ; ==============================================================================
1715+ F606              CompassWobbleTable:
1716+ F606 06 03 01 02      DEFB 6, 3, 1, 2                     ; 0 NW: prev2=SW, prev=W,  next=N,  next2=NE
1717+ F60A 03 00 02 05      DEFB 3, 0, 2, 5                     ; 1 N : prev2=W,  prev=NW, next=NE, next2=E
1718+ F60E 00 01 05 08      DEFB 0, 1, 5, 8                     ; 2 NE: prev2=NW, prev=N,  next=E,  next2=SE
1719+ F612 07 06 00 01      DEFB 7, 6, 0, 1                     ; 3 W : prev2=S,  prev=SW, next=NW, next2=N
1720+ F616 04 04 04 04      DEFB 4, 4, 4, 4                     ; 4 X : (no wobble)
1721+ F61A 01 02 08 07      DEFB 1, 2, 8, 7                     ; 5 E : prev2=N,  prev=NE, next=SE, next2=S
1722+ F61E 08 07 03 00      DEFB 8, 7, 3, 0                     ; 6 SW: prev2=SE, prev=S,  next=W,  next2=NW
1723+ F622 05 08 06 03      DEFB 5, 8, 6, 3                     ; 7 S : prev2=E,  prev=SE, next=SW, next2=W
1724+ F626 02 05 07 06      DEFB 2, 5, 7, 6                     ; 8 SE: prev2=NE, prev=E,  next=S,  next2=SW
1725+ F62A
1726+ F62A              ; ==============================================================================
1727+ F62A              ; WobblePhaseTable - 9 fases del wobble (1 frame cada una, 9 frames total).
1728+ F62A              ; Indexada por (counter-1) -> 0..8. Valor:
1729+ F62A              ;   0 = prev2, 1 = prev, 2 = target, 3 = next, 4 = next2.
1730+ F62A              ; Con counter inicial 9 y decremento por frame:
1731+ F62A              ;   counter 9 -> phase 8 -> prev2  (primer estado al entrar a la sala)
1732+ F62A              ;   counter 8 -> phase 7 -> prev
1733+ F62A              ;   counter 7 -> phase 6 -> target
1734+ F62A              ;   counter 6 -> phase 5 -> next
1735+ F62A              ;   counter 5 -> phase 4 -> next2
1736+ F62A              ;   counter 4 -> phase 3 -> prev
1737+ F62A              ;   counter 3 -> phase 2 -> target
1738+ F62A              ;   counter 2 -> phase 1 -> prev
1739+ F62A              ;   counter 1 -> phase 0 -> target (estado final, settle)
1740+ F62A              ; ==============================================================================
1741+ F62A              WobblePhaseTable:
1742+ F62A 02 01 02 01      DEFB 2, 1, 2, 1, 4, 3, 2, 1, 0
1742+ F62E 04 03 02 01
1742+ F632 00
