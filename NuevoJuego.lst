2772+ DAAB FE 08            CP MAX_PICKUPS_CACHED
2773+ DAAD 30 47            JR NC, .bprcSkipFromCharX
2774+ DAAF                  ; Cargar header del sprite (necesario para H, W).
2775+ DAAF E5               PUSH HL                     ; save HL @ charX
2776+ DAB0 EB               EX DE, HL                   ; HL = BgGfx ptr
2777+ DAB1 3E 03            LD A, 3
2778+ DAB3 CD CA 67         CALL LoadBgSpriteToBuffer   ; preserva BC
2779+ DAB6 E1               POP HL                      ; HL @ charX
2780+ DAB7                  ; Append a cache: IX = PickupRectCache + idx*4
2781+ DAB7 E5               PUSH HL                     ; save HL @ charX
2782+ DAB8 3A 0D 83         LD A, (NumPickupsCached)
2783+ DABB 3C               INC A
2784+ DABC 32 0D 83         LD (NumPickupsCached), A
2785+ DABF 3D               DEC A
2786+ DAC0 87               ADD A, A
2787+ DAC1 87               ADD A, A                    ; A = idx*4
2788+ DAC2 5F               LD E, A
2789+ DAC3 16 00            LD D, 0
2790+ DAC5 21 0E 83         LD HL, PickupRectCache
2791+ DAC8 19               ADD HL, DE                  ; HL = slot
2792+ DAC9 E5               PUSH HL
2793+ DACA DD E1            POP IX                      ; IX = slot
2794+ DACC E1               POP HL                      ; HL @ charX
2795+ DACD                  ; Escribir [0]=charX, [2]=charXEnd
2796+ DACD 7E               LD A, (HL)                  ; charX
2797+ DACE DD 77 00         LD (IX+0), A
2798+ DAD1 47               LD B, A                     ; B = charX
2799+ DAD2 3A EF 86         LD A, (BgSpriteBuffer + 1)
2800+ DAD5 E6 7F            AND $7F                     ; charW (bit 7 = RLE flag, ignorar)
2801+ DAD7 80               ADD A, B
2802+ DAD8 3D               DEC A                       ; charXEnd = charX + W - 1
2803+ DAD9 DD 77 02         LD (IX+2), A
2804+ DADC 23               INC HL                      ; HL @ charY
2805+ DADD                  ; Escribir [1]=charY (con BG_Y_OFFSET para alinear con ATTR_BASE), [3]=charYEnd
2806+ DADD 7E               LD A, (HL)
2807+ DADE C6 02            ADD A, BG_Y_OFFSET
