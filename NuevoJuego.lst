2539+ B0AB              ; ==============================================================================
2540+ B0AB              ; ==============================================================================
2541+ B0AB              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2542+ B0AB              ; ==============================================================================
2543+ B0AB              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2544+ B0AB              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2545+ B0AB              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2546+ B0AB              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2547+ B0AB              ; ==============================================================================
2548+ B0AB              UpdateMonster:
2549+ B0AB                  ; --- Stun: knockback + pausa tras golpe del player ---
2550+ B0AB DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2551+ B0AE B7               OR A
2552+ B0AF CA E4 B2         JP Z, .moNormal
2553+ B0B2 DD 35 0A         DEC (IX+ENT_DIR)
2554+ B0B5 20 0B            JR NZ, .moStunActive
2555+ B0B7                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2556+ B0B7 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2557+ B0BB DD 36 07 00      LD (IX+ENT_DELTAY), 0
2558+ B0BF C3 E4 B2         JP .moNormal
2559+ B0C2
2560+ B0C2              .moStunActive:
2561+ B0C2                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2562+ B0C2 FE 06            CP MONSTER_STUN_PAUSE
2563+ B0C4 DA 6E B4         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2564+ B0C7                  ; Knockback: aplicar movimiento con collision check
2565+ B0C7 DD 56 06         LD D, (IX+ENT_DELTAX)
2566+ B0CA DD 5E 07         LD E, (IX+ENT_DELTAY)
2567+ B0CD 7A               LD A, D
2568+ B0CE B3               OR E
2569+ B0CF CA 6E B4         JP Z, .moAnimate
2570+ B0D2                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2571+ B0D2 D5               PUSH DE
2572+ B0D3 DD 7E 03         LD A, (IX+ENT_POSX)
2573+ B0D6 32 FF B5         LD (.moSvX), A
2574+ B0D9 DD 7E 04         LD A, (IX+ENT_POSY)
2575+ B0DC 32 00 B6         LD (.moSvY), A
2576+ B0DF                  ; Calcular nueva posicion
2577+ B0DF DD 7E 03         LD A, (IX+ENT_POSX)
2578+ B0E2 82               ADD A, D
2579+ B0E3 DD 77 03         LD (IX+ENT_POSX), A
2580+ B0E6 DD 7E 04         LD A, (IX+ENT_POSY)
2581+ B0E9 83               ADD A, E
2582+ B0EA DD 77 04         LD (IX+ENT_POSY), A
2583+ B0ED                  ; Comprobar bordes ANTES de colision con paredes
2584+ B0ED DD 7E 03         LD A, (IX+ENT_POSX)
2585+ B0F0 FE E8            CP SCREEN_MAX_X
2586+ B0F2 30 30            JR NC, .moKbPreOffscreen
2587+ B0F4 FE 04            CP MONSTER_KB_SPEED
2588+ B0F6 38 20            JR C, .moKbPreOffscreenMaybeX
2589+ B0F8              .moKbPreBorderXOk:
2590+ B0F8 DD 7E 04         LD A, (IX+ENT_POSY)
2591+ B0FB FE A8            CP SCREEN_MAX_Y
2592+ B0FD 30 25            JR NC, .moKbPreOffscreen
2593+ B0FF FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2594+ B101 38 1B            JR C, .moKbPreOffscreenMaybeY
2595+ B103              .moKbPreBorderOk:
2596+ B103                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2597+ B103                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2598+ B103                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2599+ B103                  ; CheckEnemyCollision.
2600+ B103                  ; CheckChurchTrap retorna:
2601+ B103                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2602+ B103                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2603+ B103                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2604+ B103 CD 01 EC         CALL CheckChurchTrap
2605+ B106 B7               OR A
2606+ B107 28 07            JR Z, .moKbCollCheck
2607+ B109 FE 02            CP 2
2608+ B10B CA BC B1         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2609+ B10E D1               POP DE                              ; limpiar PUSH DE previo
2610+ B10F C9               RET                                 ; cutscene activa, salir
2611+ B110              .moKbCollCheck:
