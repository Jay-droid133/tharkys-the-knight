 539+ E6A1              ; DrawDayCycleHUD - Muestra "DAY 01" en HUD (fila 0, col 4-9)
 540+ E6A1              ; Usa font custom (DayHudFont) en vez de ROM font
 541+ E6A1              ; ==============================================================================
 542+ E6A1              DrawDayCycleHUD:
 543+ E6A1                  ; --- Dibujar "DAY " (chars fijos: indices 0,1,2 + espacio) ---
 544+ E6A1 21 5F E9         LD HL, DayHudFont + 0 * 8          ; 'D'
 545+ E6A4 11 04 40         LD DE, $4004                        ; Fila 0, col 4
 546+ E6A7 CD 16 E7         CALL .drawChar
 547+ E6AA 21 67 E9         LD HL, DayHudFont + 1 * 8          ; 'A'
 548+ E6AD 11 05 40         LD DE, $4005                        ; Fila 0, col 5
 549+ E6B0 CD 16 E7         CALL .drawChar
 550+ E6B3 21 6F E9         LD HL, DayHudFont + 2 * 8          ; 'Y'
 551+ E6B6 11 06 40         LD DE, $4006                        ; Fila 0, col 6
 552+ E6B9 CD 16 E7         CALL .drawChar
 553+ E6BC                  ; Col 7 = espacio (limpiar)
 554+ E6BC 11 07 40         LD DE, $4007
 555+ E6BF CD 1F E7         CALL .clearChar
 556+ E6C2
 557+ E6C2                  ; --- Digito decenas (col 8) ---
 558+ E6C2 3A 63 BD         LD A, (DayCycleCount)
 559+ E6C5 FE 0A            CP 10
 560+ E6C7 38 20            JR C, .singleDigit
 561+ E6C9                  ; Dos digitos: dividir A / 10
 562+ E6C9 06 00            LD B, 0
 563+ E6CB              .divLoop:
 564+ E6CB D6 0A            SUB 10
 565+ E6CD 04               INC B
 566+ E6CE FE 0A            CP 10
 567+ E6D0 30 F9            JR NC, .divLoop
 568+ E6D2                  ; B = decenas, A = unidades
 569+ E6D2 F5               PUSH AF                             ; Guardar unidades
 570+ E6D3 78               LD A, B
 571+ E6D4 CD 09 E7         CALL .getDigitFont
 572+ E6D7 11 08 40         LD DE, $4008                        ; Col 8
 573+ E6DA CD 16 E7         CALL .drawChar
 574+ E6DD F1               POP AF                              ; Recuperar unidades
 575+ E6DE CD 09 E7         CALL .getDigitFont
 576+ E6E1 11 09 40         LD DE, $4009                        ; Col 9
 577+ E6E4 CD 16 E7         CALL .drawChar
 578+ E6E7 18 14            JR .setAttrs
 579+ E6E9
 580+ E6E9              .singleDigit:
 581+ E6E9                  ; Una cifra: decena = 0, unidad = A
 582+ E6E9 F5               PUSH AF
 583+ E6EA 21 77 E9         LD HL, DayHudFont + 3 * 8          ; '0'
 584+ E6ED 11 08 40         LD DE, $4008                        ; Col 8
 585+ E6F0 CD 16 E7         CALL .drawChar
 586+ E6F3 F1               POP AF
 587+ E6F4 CD 09 E7         CALL .getDigitFont
 588+ E6F7 11 09 40         LD DE, $4009                        ; Col 9
 589+ E6FA CD 16 E7         CALL .drawChar
