 358+ 6A7E CB 3F            SRL A
 359+ 6A80 CB 3F            SRL A                               ; x_char = posX / 8
 360+ 6A82 47               LD B, A
 361+ 6A83 3A FA 82         LD A, (CorpseY)
 362+ 6A86 C6 05            ADD A, 5                            ; tomb 16px alineada a base del player 21px
 363+ 6A88 CB 3F            SRL A
 364+ 6A8A CB 3F            SRL A
 365+ 6A8C CB 3F            SRL A                               ; abs_char_y = (posY+5) / 8
 366+ 6A8E D6 02            SUB BG_Y_OFFSET                     ; DrawBgGfxSprite re-suma BG_Y_OFFSET
 367+ 6A90 4F               LD C, A
 368+ 6A91 DD 21 FD 86      LD IX, BgSpriteBuffer
 369+ 6A95 CD E6 D1         CALL DrawBgGfxSprite
