 217+ E58B              ; ==============================================================================
 218+ E58B              ; AY_UpdateBell - Decay manual del volumen de los 3 canales
 219+ E58B              ; ==============================================================================
 220+ E58B              ; Llamar cada frame desde el main loop.
 221+ E58B              ; ==============================================================================
 222+ E58B              ; AY_UpdateBellImpl: catchup wall-clock — avanza N game frames de decay donde
 223+ E58B              ; N = FramesElapsed (calculado en MainLoop top). Identico a tickear N veces
 224+ E58B              ; per-frame (preserva la fase del BellDecayTimer modulo BELL_DECAY_RATE).
 225+ E58B              AY_UpdateBellImpl:
 226+ E58B 3A E1 99         LD A, (FramesElapsed)
 227+ E58E B7               OR A
 228+ E58F C8               RET Z
 229+ E590 47               LD B, A
 230+ E591              .aubLoop:
 231+ E591 C5               PUSH BC
 232+ E592 CD 99 E5         CALL .aubTickOnce
 233+ E595 C1               POP BC
 234+ E596 10 F9            DJNZ .aubLoop
 235+ E598 C9               RET
 236+ E599
 237+ E599              .aubTickOnce:
 238+ E599                  ; ¿alguno de los 3 canales aún suena?
 239+ E599 3A DC E4         LD A, (BellVolL)
 240+ E59C 47               LD B, A
 241+ E59D 3A DD E4         LD A, (BellVolC)
 242+ E5A0 B0               OR B
 243+ E5A1 47               LD B, A
 244+ E5A2 3A DE E4         LD A, (BellVolR)
 245+ E5A5 B0               OR B
 246+ E5A6 C8               RET Z                       ; los 3 a 0 → silenciado
 247+ E5A7
 248+ E5A7 21 DF E4         LD HL, BellDecayTimer
 249+ E5AA 35               DEC (HL)
 250+ E5AB C0               RET NZ                      ; aun no toca decrementar
 251+ E5AC
 252+ E5AC 3E 02            LD A, BELL_DECAY_RATE
 253+ E5AE 32 DF E4         LD (BellDecayTimer), A
 254+ E5B1
 255+ E5B1                  ; Decrementar canal A (si > 0)
 256+ E5B1 3A DC E4         LD A, (BellVolL)
 257+ E5B4 B7               OR A
 258+ E5B5 28 0A            JR Z, .skipA
 259+ E5B7 3D               DEC A
 260+ E5B8 32 DC E4         LD (BellVolL), A
 261+ E5BB 5F               LD E, A
 262+ E5BC 3E 08            LD A, 8
 263+ E5BE CD 9E E4         CALL AY_WriteReg
 264+ E5C1              .skipA:
 265+ E5C1
 266+ E5C1                  ; Decrementar canal B (si > 0)
 267+ E5C1 3A DD E4         LD A, (BellVolC)
 268+ E5C4 B7               OR A
 269+ E5C5 28 0A            JR Z, .skipB
 270+ E5C7 3D               DEC A
 271+ E5C8 32 DD E4         LD (BellVolC), A
 272+ E5CB 5F               LD E, A
 273+ E5CC 3E 09            LD A, 9
 274+ E5CE CD 9E E4         CALL AY_WriteReg
 275+ E5D1              .skipB:
 276+ E5D1
 277+ E5D1                  ; Decrementar canal C (si > 0)
 278+ E5D1 3A DE E4         LD A, (BellVolR)
 279+ E5D4 B7               OR A
 280+ E5D5 C8               RET Z
 281+ E5D6 3D               DEC A
 282+ E5D7 32 DE E4         LD (BellVolR), A
 283+ E5DA 5F               LD E, A
 284+ E5DB 3E 0A            LD A, 10
 285+ E5DD C3 9E E4         JP AY_WriteReg              ; tail call
