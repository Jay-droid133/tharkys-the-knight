4006+ B902 CD 08 A8         CALL GetOldSpriteAddr               ; DE = sprite ptr (HL trashed)
4007+ B905 E1               POP HL
4008+ B906 73               LD (HL), E
4009+ B907 23               INC HL
4010+ B908 72               LD (HL), D
4011+ B909                  ; Incrementar counter
4012+ B909 3A 7B 5F         LD A, (PendingEraseCount)
4013+ B90C 3C               INC A
4014+ B90D 32 7B 5F         LD (PendingEraseCount), A
4015+ B910 C9               RET
