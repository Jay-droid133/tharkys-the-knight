1325+ D3DA                  ; Recorrer tokens RLE hasta consumir HL pixeles
1326+ D3DA              .spRleLoop:
1327+ D3DA 7C               LD A, H
1328+ D3DB B5               OR L
1329+ D3DC C8               RET Z                       ; 0 pixeles restantes → IX en posicion correcta
1330+ D3DD DD 7E 00         LD A, (IX+0)
1331+ D3E0 DD 23            INC IX
1332+ D3E2 CB 7F            BIT 7, A
1333+ D3E4 20 0C            JR NZ, .spRleRun
1334+ D3E6                  ; Literal group: consume A bytes de datos (A = count 1-127)
1335+ D3E6 5F               LD E, A
1336+ D3E7 16 00            LD D, 0
1337+ D3E9 ED 52            SBC HL, DE                  ; HL -= count
1338+ D3EB                  ; Saltar los bytes literales
1339+ D3EB 43               LD B, E
