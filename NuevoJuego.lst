 701+ F3A3              ; ==============================================================================
 702+ F3A3              ; ClearCompass - Borra el bloque 2x2 de la brujula (cuando no hay objetivo)
 703+ F3A3              ; ==============================================================================
 704+ F3A3              ClearCompass:
 705+ F3A3 26 40            LD H, $40
 706+ F3A5 2E 18            LD L, COMPASS_CHARROW * $20 + COMPASS_COL
 707+ F3A7 06 08            LD B, 8
 708+ F3A9 AF               XOR A
 709+ F3AA              .ccRow0:
 710+ F3AA 77               LD (HL), A
 711+ F3AB 23               INC HL
 712+ F3AC 77               LD (HL), A
 713+ F3AD 2B               DEC HL
 714+ F3AE 24               INC H
 715+ F3AF 10 F9            DJNZ .ccRow0
 716+ F3B1 26 40            LD H, $40
 717+ F3B3 2E 38            LD L, (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 718+ F3B5 06 08            LD B, 8
 719+ F3B7 AF               XOR A
 720+ F3B8              .ccRow1:
 721+ F3B8 77               LD (HL), A
 722+ F3B9 23               INC HL
 723+ F3BA 77               LD (HL), A
 724+ F3BB 2B               DEC HL
 725+ F3BC 24               INC H
 726+ F3BD 10 F9            DJNZ .ccRow1
 727+ F3BF AF               XOR A                               ; attr 0 (negro/negro, invisible)
 728+ F3C0 21 18 58         LD HL, $5800 + COMPASS_CHARROW * $20 + COMPASS_COL
 729+ F3C3 77               LD (HL), A
 730+ F3C4 23               INC HL
 731+ F3C5 77               LD (HL), A
 732+ F3C6 21 38 58         LD HL, $5800 + (COMPASS_CHARROW + 1) * $20 + COMPASS_COL
 733+ F3C9 77               LD (HL), A
 734+ F3CA 23               INC HL
 735+ F3CB 77               LD (HL), A
 736+ F3CC C9               RET
 737+ F3CD
 738+ F3CD              ; ==============================================================================
 739+ F3CD              ; CHURCH TRAP (paso 7 - encerrar a los 3 monsters en la iglesia)
 740+ F3CD              ; ==============================================================================
 741+ F3CD              ; Mecanica: la puerta de la iglesia, una vez abierta (ChurchDoorOpen=1), se
 742+ F3CD              ; convierte en una trampa de un solo sentido. El player ataca a los monstruos
 743+ F3CD              ; haciendo que el knockback les empuje hacia las celdas trampa (CHURCH_TRAP_
 744+ F3CD              ; CELL_LO_X/HI_X, CHURCH_TRAP_CELL_Y) en la pantalla de la iglesia. Cuando un
 745+ F3CD              ; monstruo cae alli con la puerta abierta:
 746+ F3CD              ;   - Bit slot en MonsterTrappedFlags
 747+ F3CD              ;   - Despawn del monstruo (puff)
 748+ F3CD              ;   - Puerta se re-cierra (sprite + flag)
 749+ F3CD              ;   - Si quedan monstruos: respawn de la church_key en AltKeyN
 750+ F3CD              ;   - Si los 3 atrapados: spawn de la town_gate_key + avance hito 7 -> 8
 751+ F3CD              ;
 752+ F3CD              ; Las constantes CHURCH_TRAP_* y CHURCH_KEY_ALT*_* viven en screen_data.asm,
 753+ F3CD              ; auto-generadas por el level editor segun la posicion de la puerta y los
 754+ F3CD              ; markers AltKey1/AltKey2.
 755+ F3CD              ; ==============================================================================
 756+ F3CD
 757+ F3CD              ; ==============================================================================
 758+ F3CD              ; CheckChurchTrap - llamada tras .moKbYOk en UpdateMonster
 759+ F3CD              ; ==============================================================================
 760+ F3CD              ; IN:  IX = entity ptr del monster (tras knockback aplicado)
 761+ F3CD              ; OUT: A = 0 si no trampa, NZ si trampa disparada (caller debe abortar update).
 762+ F3CD              ; Destruye: AF, BC.
 763+ F3CD              ; ==============================================================================
 764+ F3CD              CheckChurchTrap:
 765+ F3CD                  ; --- Solo en pantalla de la iglesia ---
 766+ F3CD 3A AD 82         LD A, (CurrentScreenX)
 767+ F3D0 FE 0F            CP CHURCH_TRAP_SCREEN_X
 768+ F3D2 20 5D            JR NZ, .cctNoTrap
 769+ F3D4 3A AE 82         LD A, (CurrentScreenY)
 770+ F3D7 FE 06            CP CHURCH_TRAP_SCREEN_Y
 771+ F3D9 20 56            JR NZ, .cctNoTrap
 772+ F3DB                  ; --- Solo con la puerta abierta ---
 773+ F3DB 3A 61 82         LD A, (ChurchDoorOpen)
 774+ F3DE B7               OR A
 775+ F3DF 28 50            JR Z, .cctNoTrap
 776+ F3E1                  ; --- Solo si el knockback es DIRECTO del player ---
 777+ F3E1                  ; Un kb heredado via billar (monstruo empuja a monstruo) no debe servir
 778+ F3E1                  ; para encerrar al receptor: el bit ENTF_KB_DIRECT se set al golpear con
 779+ F3E1                  ; espada y se clear cuando se hereda kb por colision.
 780+ F3E1 DD CB 0B 66      BIT ENTF_KB_DIRECT, (IX+ENT_FLAGS)
 781+ F3E5 28 4A            JR Z, .cctNoTrap
 782+ F3E7                  ; --- Y de la celda trampa: charY del monstruo en [trap-2..trap] ---
 783+ F3E7                  ; (acepta sprites de 16, 21 o 24 px de alto)
 784+ F3E7 DD 7E 04         LD A, (IX+ENT_POSY)
 785+ F3EA CB 3F            SRL A
 786+ F3EC CB 3F            SRL A
 787+ F3EE CB 3F            SRL A                                   ; A = top charY del monster
 788+ F3F0 47               LD B, A
 789+ F3F1 3E 0E            LD A, CHURCH_TRAP_CELL_Y + BG_Y_OFFSET
 790+ F3F3 90               SUB B                                   ; A = trap_charY - mon_charY
 791+ F3F4 FE 03            CP 3
 792+ F3F6 30 39            JR NC, .cctNoTrap                       ; fuera de rango Y
 793+ F3F8                  ; --- X de la celda trampa: charX del monstruo en [LO_X-1..LO_X+1] ---
 794+ F3F8 DD 7E 03         LD A, (IX+ENT_POSX)
 795+ F3FB CB 3F            SRL A
 796+ F3FD CB 3F            SRL A
 797+ F3FF CB 3F            SRL A
 798+ F401 47               LD B, A                                 ; B = left charX del monster
 799+ F402 3E 0F            LD A, CHURCH_TRAP_CELL_LO_X
 800+ F404 3C               INC A                                   ; A = LO_X + 1
 801+ F405 90               SUB B                                   ; A = LO_X+1 - charX
 802+ F406 FE 03            CP 3
 803+ F408 30 27            JR NC, .cctNoTrap                       ; fuera de rango X
 804+ F40A                  ; --- En zona de trampa: comprobar si este monstruo es el esperado ---
 805+ F40A                  ; Type idx del monstruo = (ANIMBASE - SPRID_MONSTER_0) / 8.
 806+ F40A DD 7E 08         LD A, (IX+ENT_ANIMBASE)
 807+ F40D D6 4C            SUB SPRID_MONSTER_0
 808+ F40F CB 3F            SRL A
 809+ F411 CB 3F            SRL A
 810+ F413 CB 3F            SRL A                                   ; A = type idx 0..2
 811+ F415 47               LD B, A
 812+ F416                  ; Type esperado = ChurchTrapOrderTable[NextChurchTrapStep].
 813+ F416 3A 6E 82         LD A, (NextChurchTrapStep)
 814+ F419 FE 03            CP 3
 815+ F41B 30 11            JR NC, .cctBlockAsWall                  ; ya capturados los 3 -> bloquear
 816+ F41D 21 33 F4         LD HL, ChurchTrapOrderTable
 817+ F420 5F               LD E, A
 818+ F421 16 00            LD D, 0
 819+ F423 19               ADD HL, DE
 820+ F424 7E               LD A, (HL)                              ; A = type esperado
 821+ F425 B8               CP B
 822+ F426 20 06            JR NZ, .cctBlockAsWall                  ; tipo no esperado -> wall
 823+ F428                  ; --- TRAMPA: tipo correcto, disparar TriggerChurchTrap ---
 824+ F428 CD CB F4         CALL TriggerChurchTrap
 825+ F42B 3E 01            LD A, 1
 826+ F42D C9               RET
 827+ F42E              .cctBlockAsWall:
 828+ F42E                  ; Tipo no esperado en zona de trampa: bloquear como si fuera pared.
 829+ F42E                  ; Caller (.moKbPreBorderOk) salta a .moKbWallBlock con A=2.
 830+ F42E 3E 02            LD A, 2
 831+ F430 C9               RET
 832+ F431              .cctNoTrap:
 833+ F431 AF               XOR A
 834+ F432 C9               RET
 835+ F433
 836+ F433              ; Orden de captura: step idx -> type idx. Zombi=0, Ghost=2, Skeleton=1.
 837+ F433              ChurchTrapOrderTable:
 838+ F433 00 02 01         DEFB 0, 2, 1
 839+ F436
 840+ F436              ; ==============================================================================
 841+ F436              ; HighlightExpectedStatue - pinta la estatua del monstruo "esperado" en
 842+ F436              ; blanco brillante sobre paper negro ($47).
 843+ F436              ; ==============================================================================
 844+ F436              ; Llamada desde DrawScreen tras pintar BG y antes de SaveCleanAttrs.
 845+ F436              ; - No-op fuera de la sala de la iglesia.
 846+ F436              ; - No-op si todos los monstruos atrapados (NextChurchTrapStep >= 3).
 847+ F436              ; - Localiza la estatua del type esperado en CurrentScreenBuffer y
 848+ F436              ;   sobreescribe sus 2x3 chars con $47. Las otras dos estatuas (las que
 849+ F436              ;   aun no toca) conservan sus attrs originales del sprite.
 850+ F436              ; Destruye: AF, BC, DE, HL.
 851+ F436              ; ==============================================================================
 852+ F436              ; HighlightExpectedStatue: pinta la estatua del esperado en blanco brillante
 853+ F436              ; ($47). Wrapper sobre PaintExpectedStatueAttr.
 854+ F436              HighlightExpectedStatue:
 855+ F436 3E 47            LD A, $47
 856+ F438 18 00            JR PaintExpectedStatueAttr
 857+ F43A
 858+ F43A              ; PaintExpectedStatueAttr: pinta la estatua del esperado con el attr en A.
 859+ F43A              ; Usado por HighlightExpectedStatue ($47, ON) y por UpdateStatueBlink que
 860+ F43A              ; alterna entre $47 (ON) y $00 (OFF, statue invisible) durante el blink.
 861+ F43A              PaintExpectedStatueAttr:
 862+ F43A 32 A4 F4         LD (.hesAttr), A
 863+ F43D                  ; --- Solo en la sala de la iglesia ---
 864+ F43D 3A AD 82         LD A, (CurrentScreenX)
 865+ F440 FE 0F            CP CHURCH_TRAP_SCREEN_X
 866+ F442 C0               RET NZ
 867+ F443 3A AE 82         LD A, (CurrentScreenY)
 868+ F446 FE 06            CP CHURCH_TRAP_SCREEN_Y
 869+ F448 C0               RET NZ
 870+ F449                  ; --- Solo tras abrir la iglesia 1a vez ---
 871+ F449                  ; Antes de abrir la puerta todas las estatuas mantienen sus attrs
 872+ F449                  ; originales del sprite. Usamos ChurchEverOpened (sticky) en lugar de
 873+ F449                  ; ChurchDoorOpen porque durante la cutscene de captura la puerta se
 874+ F449                  ; cierra y queremos que el highlight de la siguiente estatua se aplique
 875+ F449                  ; al terminar el humo, NO esperar a que el jugador re-abra la puerta.
 876+ F449 3A 62 82         LD A, (ChurchEverOpened)
 877+ F44C B7               OR A
 878+ F44D C8               RET Z
 879+ F44E                  ; --- Solo si quedan monstruos por atrapar ---
 880+ F44E 3A 6E 82         LD A, (NextChurchTrapStep)
 881+ F451 FE 03            CP 3
 882+ F453 D0               RET NC
 883+ F454                  ; --- Type esperado -> statue id ---
 884+ F454 21 33 F4         LD HL, ChurchTrapOrderTable
 885+ F457 5F               LD E, A
 886+ F458 16 00            LD D, 0
 887+ F45A 19               ADD HL, DE
 888+ F45B 7E               LD A, (HL)                              ; type idx esperado
 889+ F45C 21 67 67         LD HL, StatueIdTable
 890+ F45F 5F               LD E, A
 891+ F460 16 00            LD D, 0
 892+ F462 19               ADD HL, DE
 893+ F463 7E               LD A, (HL)                              ; A = statue id
 894+ F464 B7               OR A
 895+ F465 C8               RET Z
 896+ F466 32 A5 F4         LD (.hesTargetId), A
 897+ F469                  ; --- Buscar la estatua en CurrentScreenBuffer (4B per entry) ---
 898+ F469 2A AF 82         LD HL, (CurrentScreenAddr)
 899+ F46C              .hesLoop:
 900+ F46C 7E               LD A, (HL)
 901+ F46D FE FF            CP $FF
 902+ F46F C8               RET Z                                   ; estatua no en esta sala
 903+ F470 47               LD B, A
 904+ F471 3A A5 F4         LD A, (.hesTargetId)
 905+ F474 B8               CP B
 906+ F475 28 06            JR Z, .hesFound
 907+ F477 11 04 00         LD DE, 4
 908+ F47A 19               ADD HL, DE
 909+ F47B 18 EF            JR .hesLoop
 910+ F47D              .hesFound:
 911+ F47D 23               INC HL
 912+ F47E 7E               LD A, (HL)                              ; charX
 913+ F47F 47               LD B, A
 914+ F480 23               INC HL
 915+ F481 7E               LD A, (HL)                              ; charY (sin BG_Y_OFFSET)
 916+ F482 C6 02            ADD A, BG_Y_OFFSET                      ; con offset HUD
 917+ F484 4F               LD C, A                                 ; C = charY (post-HUD)
 918+ F485                  ; --- Calcular addr en ATTR_BASE: $5800 + charY*32 + charX ---
 919+ F485 26 00            LD H, 0
 920+ F487 69               LD L, C
 921+ F488 29               ADD HL, HL
 922+ F489 29               ADD HL, HL
 923+ F48A 29               ADD HL, HL
 924+ F48B 29               ADD HL, HL
 925+ F48C 29               ADD HL, HL                              ; HL = charY * 32
 926+ F48D 58               LD E, B
 927+ F48E 16 00            LD D, 0
 928+ F490 19               ADD HL, DE                              ; + charX
 929+ F491 11 00 58         LD DE, $5800
 930+ F494 19               ADD HL, DE                              ; HL = attr addr top-left
 931+ F495                  ; --- Pintar 2 chars de ancho x 3 de alto = 6 cells con el attr ---
 932+ F495                  ; Por diseno nada del juego pasa por encima de las estatuas, asi que
 933+ F495                  ; no hace falta sincronizar CleanAttrMap.
 934+ F495 3A A4 F4         LD A, (.hesAttr)
 935+ F498 06 03            LD B, 3                                 ; 3 filas de chars
 936+ F49A              .hesRow:
 937+ F49A 77               LD (HL), A
 938+ F49B 23               INC HL
 939+ F49C 77               LD (HL), A                              ; (charX+1)
 940+ F49D 11 1F 00         LD DE, 31
 941+ F4A0 19               ADD HL, DE                              ; siguiente fila col 0
 942+ F4A1 10 F7            DJNZ .hesRow
 943+ F4A3 C9               RET
 944+ F4A4 00           .hesAttr:     DEFB 0
 945+ F4A5 00           .hesTargetId: DEFB 0
 946+ F4A6
 947+ F4A6              ; ==============================================================================
 948+ F4A6              ; Statue blink: parpadeo ON/OFF al activarse el highlight de una estatua.
 949+ F4A6              ; ==============================================================================
 950+ F4A6              ; StatueBlinkCounter cuenta atras desde STATUE_BLINK_FRAMES. Cada N ticks
 951+ F4A6              ; alterna entre ON ($47) y OFF ($00 = invisible). Al llegar a 0, settle ON.
 952+ F4A6              ; Patron (32 frames de blink, 2 ticks por fase, 16 fases ON-OFF-...-ON-OFF
 953+ F4A6              ; + ON final settle): 8 ciclos de ON-OFF en total.
 954+ F4A6              ; ==============================================================================
 955+ F4A6              STATUE_BLINK_FRAMES   EQU 32
 956+ F4A6
 957+ F4A6              StartStatueBlink:
 958+ F4A6                  ; Arranca el blink y pinta inmediatamente la primera frame ON. Debe
 959+ F4A6                  ; llamarse en lugar de HighlightExpectedStatue en los puntos donde
 960+ F4A6                  ; queremos efecto "se enciende": ApplyChurchTrapDone, UpdateBellsDoneTimer
 961+ F4A6                  ; (caso A), .cbtActChurchDoor (caso B).
 962+ F4A6 3E 20            LD A, STATUE_BLINK_FRAMES
 963+ F4A8 32 6F 82         LD (StatueBlinkCounter), A
 964+ F4AB C3 36 F4         JP HighlightExpectedStatue              ; initial ON paint
 965+ F4AE
 966+ F4AE              UpdateStatueBlink:
 967+ F4AE                  ; Llamada cada frame desde MainLoop. No-op si counter == 0.
 968+ F4AE 3A 6F 82         LD A, (StatueBlinkCounter)
 969+ F4B1 B7               OR A
 970+ F4B2 C8               RET Z
 971+ F4B3 3D               DEC A
 972+ F4B4 32 6F 82         LD (StatueBlinkCounter), A
 973+ F4B7 20 03            JR NZ, .usbInProgress
 974+ F4B9                  ; Counter recien llego a 0: settle ON
 975+ F4B9 C3 36 F4         JP HighlightExpectedStatue
 976+ F4BC              .usbInProgress:
 977+ F4BC                  ; counter actual en A (1..31). Phase = (counter / 2) bit 0:
 978+ F4BC                  ;   bit 0 = 1 -> ON, bit 0 = 0 -> OFF. Cambio de fase cada 2 ticks.
 979+ F4BC CB 3F            SRL A
 980+ F4BE E6 01            AND $01
 981+ F4C0 28 05            JR Z, .usbOff
 982+ F4C2 3E 47            LD A, $47
 983+ F4C4 C3 3A F4         JP PaintExpectedStatueAttr
 984+ F4C7              .usbOff:
 985+ F4C7 AF               XOR A
 986+ F4C8 C3 3A F4         JP PaintExpectedStatueAttr
 987+ F4CB
 988+ F4CB              ; ==============================================================================
 989+ F4CB              ; CUTSCENE - parametros ajustables
 990+ F4CB              ; ==============================================================================
 991+ F4CB              ; Fase LOOK_MONSTER: el monster mira de un lado a otro alternando sprite.
 992+ F4CB              ; POSX/POSY fijos (sin jitter) -> cero contaminacion de attrs con la puerta.
 993+ F4CB              CHURCH_CUTSCENE_LOOK_FRAMES         EQU 25      ; ~1s total
 994+ F4CB              CHURCH_CUTSCENE_LOOK_PERIOD         EQU 6       ; frames entre cambios de sprite
 995+ F4CB
 996+ F4CB              ; Fase SHAKE_STATUE: la estatua tiembla con jitter pixel-preciso.
 997+ F4CB              CHURCH_CUTSCENE_SHAKE_FRAMES        EQU 28      ; ~1.1s total
 998+ F4CB              CHURCH_CUTSCENE_SHAKE_AMP           EQU 2       ; jitter +/- AMP px en X e Y
 999+ F4CB
1000+ F4CB              ; Fase SMOKE: 3 frames de humo XOR-dibujados encima de los restos.
1001+ F4CB              ;   tick 0  -> dibujar restos (1 vez) + dibujar smoke[0]
1002+ F4CB              ;   tick 4  -> erase smoke[0], dibujar smoke[1]
1003+ F4CB              ;   tick 8  -> erase smoke[1], dibujar smoke[2]
1004+ F4CB              ;   tick 12 -> erase smoke[2], pasar a DONE
1005+ F4CB              CHURCH_CUTSCENE_SMOKE_PER_FRAME     EQU 2       ; ticks por sub-frame
1006+ F4CB              CHURCH_CUTSCENE_SMOKE_TOTAL         EQU 12      ; 3 sub-frames * 4 = 12 ticks
1007+ F4CB
1008+ F4CB              ; Posicion del monster atrapado durante la cutscene. CELL_Y es la fila
1009+ F4CB              ; base del vano (auto-derivada por el editor). El monster (3 chars de
1010+ F4CB              ; alto) se coloca con su top 3 chars arriba de CELL_Y para que quede
1011+ F4CB              ; centrado dentro del vano de la puerta.
1012+ F4CB              ;   POSX = LO_X * 8                            (charX absoluto = LO_X)
1013+ F4CB              ;   POSY = (CELL_Y - 3 + BG_Y_OFFSET) * 8      (charY absoluto = CELL_Y - 1)
1014+ F4CB              CHURCH_TRAP_AREA_POSX   EQU CHURCH_TRAP_CELL_LO_X * 8
1015+ F4CB              CHURCH_TRAP_AREA_POSY   EQU (CHURCH_TRAP_CELL_Y - 3 + BG_Y_OFFSET) * 8
1016+ F4CB
1017+ F4CB              ; ==============================================================================
1018+ F4CB              ; TriggerChurchTrap - arranca la cutscene de la iglesia
1019+ F4CB              ; ==============================================================================
1020+ F4CB              ; IN: IX = monster atrapado.
1021+ F4CB              ; Mueve al monster al centro del vano y activa la cutscene. Los efectos
1022+ F4CB              ; reales (despawn, cierre puerta, respawn key, advance hito) se aplican
1023+ F4CB              ; en ApplyChurchTrapEffects al final del cutscene.
1024+ F4CB              ; ==============================================================================
1025+ F4CB              TriggerChurchTrap:
1026+ F4CB                  ; --- 1. Calcular slot 0..2 ---
1027+ F4CB DD E5            PUSH IX
1028+ F4CD E1               POP HL
1029+ F4CE 11 5B 81         LD DE, EntityTable + (SLOT_MONSTER0 * ENT_SIZE)
1030+ F4D1 B7               OR A
1031+ F4D2 ED 52            SBC HL, DE
1032+ F4D4 CB 3D            SRL L
1033+ F4D6 CB 3D            SRL L
1034+ F4D8 CB 3D            SRL L
1035+ F4DA CB 3D            SRL L                                   ; L = slot 0..2
1036+ F4DC 7D               LD A, L
1037+ F4DD 32 9E 5F         LD (ChurchCutsceneSlot), A
1038+ F4E0                  ; --- 1b. Calcular type idx (0=zombi, 1=skel, 2=ghost) y guardarlo ---
1039+ F4E0 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
1040+ F4E3 D6 4C            SUB SPRID_MONSTER_0
1041+ F4E5 CB 3F            SRL A
1042+ F4E7 CB 3F            SRL A
1043+ F4E9 CB 3F            SRL A                                   ; A = type idx
1044+ F4EB 32 9F 5F         LD (ChurchCutsceneTypeIdx), A
1045+ F4EE                  ; --- 2. Mover monster al centro del vano ---
1046+ F4EE 3E 78            LD A, CHURCH_TRAP_AREA_POSX
1047+ F4F0 DD 77 03         LD (IX+ENT_POSX), A
1048+ F4F3 3E 58            LD A, CHURCH_TRAP_AREA_POSY
1049+ F4F5 DD 77 04         LD (IX+ENT_POSY), A
1050+ F4F8 DD 36 06 00      LD (IX+ENT_DELTAX), 0
1051+ F4FC DD 36 07 00      LD (IX+ENT_DELTAY), 0
1052+ F500 DD 36 0A 00      LD (IX+ENT_DIR), 0                      ; clear stun timer
1053+ F504                  ; --- 3. Parar blink y forzar estatua en ON ($47) ---
1054+ F504                  ; Si la cutscene arrancase con un blink mid-frame OFF ($00), los pixels
1055+ F504                  ; del shake y del humo se renderizarian invisibles (ink black sobre
1056+ F504                  ; paper black). Forzando ON aqui garantizamos que la animacion de
1057+ F504                  ; temblor se vea con ink blanco brillante sobre paper negro.
1058+ F504 AF               XOR A
1059+ F505 32 6F 82         LD (StatueBlinkCounter), A              ; parar blink
1060+ F508 DD E5            PUSH IX
1061+ F50A CD 36 F4         CALL HighlightExpectedStatue            ; pintar $47
1062+ F50D                  ; --- 3.5. Despawn Death + stop musica si estaba activa ---
1063+ F50D                  ; Si el player tardo mas de 6s en entrar al cutscene, Death pudo haber
1064+ F50D                  ; spawneado en la iglesia. MainLoop salta la AI durante el cutscene, asi
1065+ F50D                  ; que su sprite quedaria congelado en pantalla. La quitamos aqui.
1066+ F50D CD 15 BE         CALL SilentKillDeath                    ; erase sprite + clear flag + reset timer
1067+ F510 3E FF            LD A, $FF
1068+ F512 CD 05 9D         CALL StartMusic                         ; sentinel STOP (idempotente si no sonaba)
1069+ F515 DD E1            POP IX
1070+ F517                  ; --- 4. Activar cutscene (phase 1 LOOK, frame 0) ---
1071+ F517 3E 01            LD A, 1
1072+ F519 32 72 82         LD (ChurchCutscenePhase), A
1073+ F51C AF               XOR A
1074+ F51D 32 9D 5F         LD (ChurchCutsceneFrame), A
1075+ F520 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1076+ F522 32 A4 5F         LD (ChurchCutsceneLookCount), A
1077+ F525 C9               RET
1078+ F526
1079+ F526              ; ==============================================================================
1080+ F526              ; UpdateChurchCutscene - llamada cada frame desde MainLoop
1081+ F526              ; ==============================================================================
1082+ F526              ; Si phase = 0 → no-op. Si activa: incrementa frame counter y, al llegar
1083+ F526              ; a CHURCH_CUTSCENE_TOTAL_FRAMES, dispara ApplyChurchTrapEffects + termina.
1084+ F526              ; (MVP1: solo freeze + reposicion; sin shake. MVP2 anadira jitter visible.)
1085+ F526              ; ==============================================================================
1086+ F526              UpdateChurchCutscene:
1087+ F526 3A 72 82         LD A, (ChurchCutscenePhase)
1088+ F529 B7               OR A
1089+ F52A C8               RET Z
1090+ F52B 3D               DEC A
1091+ F52C 28 12            JR Z, .ucsLookPhase
1092+ F52E 3D               DEC A
1093+ F52F 28 38            JR Z, .ucsShakeStatuePhase
1094+ F531 3D               DEC A
1095+ F532 CA BB F5         JP Z, .ucsSmokePhase
1096+ F535                  ; Phase 4 (DONE): aplicar efectos finales y terminar cutscene.
1097+ F535 CD D2 66         CALL ApplyChurchTrapDone
1098+ F538 AF               XOR A
1099+ F539 32 72 82         LD (ChurchCutscenePhase), A
1100+ F53C 32 9D 5F         LD (ChurchCutsceneFrame), A
1101+ F53F C9               RET
1102+ F540
1103+ F540              ; ---- Phase 1: monster mira de un lado a otro (no jitter de posicion) ----
1104+ F540              .ucsLookPhase:
1105+ F540                  ; Frame counter (para detectar fin de fase)
1106+ F540 21 9D 5F         LD HL, ChurchCutsceneFrame
1107+ F543 34               INC (HL)
1108+ F544                  ; Toggle countdown (cualquier valor, no necesita ser potencia de 2)
1109+ F544 21 A4 5F         LD HL, ChurchCutsceneLookCount
1110+ F547 35               DEC (HL)
1111+ F548 20 06            JR NZ, .ucsLookCheckEnd
1112+ F54A 3E 06            LD A, CHURCH_CUTSCENE_LOOK_PERIOD
1113+ F54C 77               LD (HL), A
1114+ F54D CD 09 F6         CALL ChurchCutsceneToggleMonsterDir
1115+ F550              .ucsLookCheckEnd:
1116+ F550 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1117+ F553 FE 19            CP CHURCH_CUTSCENE_LOOK_FRAMES
1118+ F555 D8               RET C                                   ; sigue mirando
1119+ F556                  ; Fin del look: BORRAR monster ANTES de cerrar la puerta. Si no, los
1120+ F556                  ; pixels del monster que asoman bajo el vano (chars no cubiertos por
1121+ F556                  ; la puerta cerrada) quedan visibles durante toda la fase SHAKE.
1122+ F556 CD AE 66         CALL EraseChurchTrappedMonster
1123+ F559 CD 5D 69         CALL CloseChurchDoor
1124+ F55C CD 2E F6         CALL ChurchCutsceneInitStatueShake
1125+ F55F 3E 02            LD A, 2
1126+ F561 32 72 82         LD (ChurchCutscenePhase), A
1127+ F564 AF               XOR A
1128+ F565 32 9D 5F         LD (ChurchCutsceneFrame), A
1129+ F568 C9               RET
1130+ F569
1131+ F569              ; ---- Phase 2: la estatua tiembla con jitter pixel-preciso ----
1132+ F569              .ucsShakeStatuePhase:
1133+ F569 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1134+ F56C FE 1C            CP CHURCH_CUTSCENE_SHAKE_FRAMES
1135+ F56E 30 35            JR NC, .ucsShakeStatueDone
1136+ F570                  ; Shake "horizontal" via byte-shift del sprite (no XOR, no jitter de
1137+ F570                  ; posicion). Se queda dentro del rectangulo de chars de la estatua y
1138+ F570                  ; respeta los attrs originales -- evita el "cuadrado" que dejaba el
1139+ F570                  ; XOR shift sub-char al destapar la zona donde el wall ya no existe.
1140+ F570                  ;
1141+ F570                  ; Jitter -1 / 0 / +1 bits, pseudo-random via R + frame counter.
1142+ F570                  ; Distribucion 50% sin shift, 25% left, 25% right (lookup table).
1143+ F570 ED 5F            LD A, R
1144+ F572 E6 03            AND $03
1145+ F574 21 A1 F5         LD HL, .ucsShakeJitterTable
1146+ F577 5F               LD E, A
1147+ F578 16 00            LD D, 0
1148+ F57A 19               ADD HL, DE
1149+ F57B 7E               LD A, (HL)
1150+ F57C 47               LD B, A                                 ; B = jitter (preservar sobre el pick de tabla)
1151+ F57D                  ; Pick statue table: primer mitad = entera, segunda mitad = rota.
1152+ F57D 3A 9D 5F         LD A, (ChurchCutsceneFrame)
1153+ F580 FE 0E            CP CHURCH_CUTSCENE_SHAKE_FRAMES / 2
1154+ F582 21 67 67         LD HL, StatueIdTable
1155+ F585 38 03            JR C, .ucsShakeTablePicked
1156+ F587 21 6A 67         LD HL, StatueBrokenIdTable
1157+ F58A              .ucsShakeTablePicked:
1158+ F58A 78               LD A, B                                 ; restore jitter para la llamada
1159+ F58B CD 98 F6         CALL ChurchCutsceneShakeStatueByteShift
1160+ F58E                  ; Border flicker blanco/negro cada frame (efecto "alarma"). No tocamos
1161+ F58E                  ; CurrentBorderColor: si suena un SFX se restaura a negro al terminar,
1162+ F58E                  ; y al salir de la fase forzamos borde a negro explicitamente.
1163+ F58E 3A 9D 5F         LD A, (ChurchCutsceneFrame)
