 606+ 9DA1              .drawHexDigit:
 607+ 9DA1 E6 0F            AND $0F
 608+ 9DA3 FE 0A            CP 10
 609+ 9DA5 38 04            JR C, .isNum
 610+ 9DA7 C6 37            ADD A, 'A' - 10
 611+ 9DA9 18 02            JR .drawChar
 612+ 9DAB              .isNum:
 613+ 9DAB C6 30            ADD A, '0'
 614+ 9DAD              .drawChar:
 615+ 9DAD 6F               LD L, A
 616+ 9DAE 26 00            LD H, 0
 617+ 9DB0 29               ADD HL, HL
 618+ 9DB1 29               ADD HL, HL
 619+ 9DB2 29               ADD HL, HL
 620+ 9DB3 01 00 3C         LD BC, $3C00
 621+ 9DB6 09               ADD HL, BC
 622+ 9DB7
 623+ 9DB7 16 40            LD D, $40
 624+ 9DB9 06 08            LD B, 8
 625+ 9DBB              .charLoop:
 626+ 9DBB 7E               LD A, (HL)
 627+ 9DBC 12               LD (DE), A
 628+ 9DBD 23               INC HL
 629+ 9DBE 14               INC D
 630+ 9DBF 10 FA            DJNZ .charLoop
 631+ 9DC1 C9               RET
