2717+ ADDF              ; ==============================================================================
2718+ ADDF              ; ==============================================================================
2719+ ADDF              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2720+ ADDF              ; ==============================================================================
2721+ ADDF              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2722+ ADDF              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2723+ ADDF              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2724+ ADDF              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2725+ ADDF              ; ==============================================================================
2726+ ADDF              UpdateMonster:
2727+ ADDF                  ; --- Stun: knockback + pausa tras golpe del player ---
2728+ ADDF DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2729+ ADE2 B7               OR A
2730+ ADE3 CA 18 B0         JP Z, .moNormal
2731+ ADE6 DD 35 0A         DEC (IX+ENT_DIR)
2732+ ADE9 20 0B            JR NZ, .moStunActive
2733+ ADEB                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2734+ ADEB DD 36 06 00      LD (IX+ENT_DELTAX), 0
2735+ ADEF DD 36 07 00      LD (IX+ENT_DELTAY), 0
2736+ ADF3 C3 18 B0         JP .moNormal
2737+ ADF6
2738+ ADF6              .moStunActive:
2739+ ADF6                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2740+ ADF6 FE 06            CP MONSTER_STUN_PAUSE
2741+ ADF8 DA A9 B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2742+ ADFB                  ; Knockback: aplicar movimiento con collision check
2743+ ADFB DD 56 06         LD D, (IX+ENT_DELTAX)
2744+ ADFE DD 5E 07         LD E, (IX+ENT_DELTAY)
2745+ AE01 7A               LD A, D
2746+ AE02 B3               OR E
2747+ AE03 CA A9 B1         JP Z, .moAnimate
2748+ AE06                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2749+ AE06 D5               PUSH DE
2750+ AE07 DD 7E 03         LD A, (IX+ENT_POSX)
2751+ AE0A 32 41 B3         LD (.moSvX), A
2752+ AE0D DD 7E 04         LD A, (IX+ENT_POSY)
2753+ AE10 32 42 B3         LD (.moSvY), A
2754+ AE13                  ; Calcular nueva posicion
2755+ AE13 DD 7E 03         LD A, (IX+ENT_POSX)
2756+ AE16 82               ADD A, D
2757+ AE17 DD 77 03         LD (IX+ENT_POSX), A
2758+ AE1A DD 7E 04         LD A, (IX+ENT_POSY)
2759+ AE1D 83               ADD A, E
2760+ AE1E DD 77 04         LD (IX+ENT_POSY), A
