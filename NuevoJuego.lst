1372+ F3BC              ; ==============================================================================
1373+ F3BC              ; ChurchCutsceneEraseStatueAtLast / DrawStatueAtLast - XOR redraw a (Last X/Y)
1374+ F3BC              ; ==============================================================================
1375+ F3BC              ; Igual que el monster shake, XOR redraw es reversible: la primera llamada
1376+ F3BC              ; borra, la segunda redibuja. Cargamos sprite por TypeIdx.
1377+ F3BC              ; ==============================================================================
1378+ F3BC              ChurchCutsceneEraseStatueAtLast:
1379+ F3BC              ChurchCutsceneDrawStatueAtLast:
1380+ F3BC 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1381+ F3BF 21 A9 67         LD HL, StatueIdTable
1382+ F3C2 5F               LD E, A
1383+ F3C3 16 00            LD D, 0
1384+ F3C5 19               ADD HL, DE
1385+ F3C6 7E               LD A, (HL)                              ; A = statue id
1386+ F3C7 B7               OR A
1387+ F3C8 C8               RET Z
1388+ F3C9                  ; Lookup ptr+bank en BgGfxPtrById (id*3)
1389+ F3C9 6F               LD L, A
1390+ F3CA 26 00            LD H, 0
1391+ F3CC 54               LD D, H
1392+ F3CD 5D               LD E, L
1393+ F3CE 29               ADD HL, HL
1394+ F3CF 19               ADD HL, DE                              ; HL = id*3
1395+ F3D0 11 26 DF         LD DE, BgGfxPtrById
1396+ F3D3 19               ADD HL, DE
1397+ F3D4 5E               LD E, (HL)
1398+ F3D5 23               INC HL
1399+ F3D6 56               LD D, (HL)                              ; DE = sprite ptr
1400+ F3D7 23               INC HL
1401+ F3D8 7E               LD A, (HL)                              ; A = bank
1402+ F3D9 EB               EX DE, HL                               ; HL = sprite ptr
1403+ F3DA CD C2 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1404+ F3DD                  ; Cargar pixel X/Y desde state y dibujar pixel-preciso
1405+ F3DD 3A A3 5F         LD A, (ChurchCutsceneStatueLastY)
1406+ F3E0 57               LD D, A
1407+ F3E1 3A A2 5F         LD A, (ChurchCutsceneStatueLastX)
1408+ F3E4 5F               LD E, A
1409+ F3E5 C3 31 69         JP DrawBgSprite16XorAtPixel
1410+ F3E8
1411+ F3E8              ; ==============================================================================
1412+ F3E8              ; ChurchCutsceneShakeStatueByteShift - shake "horizontal" sin tocar attrs
1413+ F3E8              ; IN: HL = ptr a tabla de IDs de estatua (StatueIdTable o StatueBrokenIdTable),
1414+ F3E8              ;     A  = jitter signed (-1, 0, +1) en bits.
1415+ F3E8              ; ==============================================================================
1416+ F3E8              ; IN: A = jitter signed (-1, 0, +1) en bits.
1417+ F3E8              ; Carga el sprite de la estatua, shiftea sus 16-bit rows en memoria (por
1418+ F3E8              ; reg D/E) y vuelca los bytes resultantes a VRAM en (StatueOrigX,
1419+ F3E8              ; StatueOrigY). DIRECT WRITE -- sobreescribe pixels en su sitio sin tocar
1420+ F3E8              ; los chars adyacentes ni los attrs. Cada frame reemplaza pixels con la
1421+ F3E8              ; version shifted, sin XOR.
1422+ F3E8              ;
1423+ F3E8              ; Por que esto evita el "cuadrado" del XOR: el sprite jamas sale de su
1424+ F3E8              ; rectangulo de 2x3 chars, asi que sus attrs originales (set al pintar la
1425+ F3E8              ; sala) siguen siendo visualmente correctos. El wall que tapaba la
1426+ F3E8              ; estatua se perdio cuando la estatua se pinto la primera vez con
1427+ F3E8              ; DrawBgGfxSprite (direct write), pero como nunca destapamos el rectangulo
1428+ F3E8              ; de la estatua, el wall perdido no se ve.
1429+ F3E8              ;
1430+ F3E8              ; Pixels que caen "fuera" al shiftear (LSB en shift left, MSB en shift right)
1431+ F3E8              ; se descartan. La estatua tipicamente tiene padding lateral asi que un
1432+ F3E8              ; shift de 1 bit no pierde pixels visibles.
1433+ F3E8              ; Destruye: AF, BC, DE, HL, IX.
1434+ F3E8              ; ==============================================================================
1435+ F3E8              ChurchCutsceneShakeStatueByteShift:
1436+ F3E8 32 52 F4         LD (.csbsJitter), A
1437+ F3EB                  ; HL = tabla de IDs (entera o rota) elegida por el caller. Indexar por TypeIdx.
1438+ F3EB 3A 9F 5F         LD A, (ChurchCutsceneTypeIdx)
1439+ F3EE 5F               LD E, A
1440+ F3EF 16 00            LD D, 0
1441+ F3F1 19               ADD HL, DE
1442+ F3F2 7E               LD A, (HL)
1443+ F3F3 B7               OR A
1444+ F3F4 C8               RET Z                                   ; sin estatua
1445+ F3F5 6F               LD L, A
1446+ F3F6 26 00            LD H, 0
1447+ F3F8 54               LD D, H
1448+ F3F9 5D               LD E, L
1449+ F3FA 29               ADD HL, HL
1450+ F3FB 19               ADD HL, DE                              ; HL = id*3
1451+ F3FC 11 26 DF         LD DE, BgGfxPtrById
1452+ F3FF 19               ADD HL, DE
1453+ F400 5E               LD E, (HL)
1454+ F401 23               INC HL
1455+ F402 56               LD D, (HL)                              ; DE = sprite ptr
1456+ F403 23               INC HL
1457+ F404 7E               LD A, (HL)                              ; A = bank
1458+ F405 EB               EX DE, HL                               ; HL = sprite ptr
1459+ F406 CD C2 6A         CALL LoadBgSpriteToBuffer               ; preserva BC
1460+ F409                  ; BgSpriteBuffer ahora tiene [height=24, width=2, pixel_CPL × 48 bytes, ...]
1461+ F409 DD 21 F8 86      LD IX, BgSpriteBuffer
1462+ F40D DD 7E 00         LD A, (IX+0)                            ; height (24 para statues 16x24)
1463+ F410 B7               OR A
1464+ F411 C8               RET Z
1465+ F412 47               LD B, A                                 ; B = row counter
1466+ F413 DD 23            INC IX
1467+ F415 DD 23            INC IX                                  ; IX -> pixel data
1468+ F417                  ; Calcular addr VRAM en (origX, origY)
1469+ F417 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1470+ F41A 57               LD D, A
1471+ F41B 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1472+ F41E 5F               LD E, A
1473+ F41F CD 5D 9D         CALL CalcPixelAddr                      ; HL = VRAM addr
1474+ F422              .csbsRow:
1475+ F422 C5               PUSH BC
1476+ F423 E5               PUSH HL                                 ; save inicio fila VRAM
1477+ F424                  ; Leer 2 pixel bytes del buffer (CPL'd) -> un-CPL en D/E
1478+ F424 DD 7E 00         LD A, (IX+0)
1479+ F427 2F               CPL
1480+ F428 57               LD D, A                                 ; D = byte0 (8 cols izquierda, original)
1481+ F429 DD 7E 01         LD A, (IX+1)
1482+ F42C 2F               CPL
1483+ F42D 5F               LD E, A                                 ; E = byte1 (8 cols derecha, original)
1484+ F42E                  ; Aplicar jitter (D|E como entero 16-bit, MSB izquierda)
1485+ F42E 3A 52 F4         LD A, (.csbsJitter)
1486+ F431 B7               OR A
1487+ F432 28 0D            JR Z, .csbsWrite                        ; sin shift
1488+ F434 FA 3D F4         JP M, .csbsLeft                         ; A < 0 -> shift left
1489+ F437                  ; A > 0 -> shift right by 1 (pixels visualmente a la derecha)
1490+ F437 CB 3A            SRL D
1491+ F439 CB 1B            RR E
1492+ F43B 18 04            JR .csbsWrite
1493+ F43D              .csbsLeft:
1494+ F43D CB 23            SLA E
1495+ F43F CB 12            RL D
1496+ F441              .csbsWrite:
1497+ F441 7A               LD A, D
1498+ F442 77               LD (HL), A
1499+ F443 23               INC HL
1500+ F444 7B               LD A, E
1501+ F445 77               LD (HL), A
1502+ F446 E1               POP HL
1503+ F447 CD C9 9A         CALL NextPixelLine                      ; HL = siguiente pixel row
1504+ F44A DD 23            INC IX
1505+ F44C DD 23            INC IX                                  ; siguiente row del buffer (2 bytes)
1506+ F44E C1               POP BC
1507+ F44F 10 D1            DJNZ .csbsRow
1508+ F451 C9               RET
1509+ F452 00           .csbsJitter: DEFB 0
1510+ F453
1511+ F453              ; ==============================================================================
1512+ F453              ; ChurchCutsceneEraseStatueDirect - escribe 0s sobre los 24 rows x 2 bytes
1513+ F453              ; donde estaba la estatua. Usa direct write (no XOR), lo que da un erase
1514+ F453              ; final limpio independientemente de lo que dibujara el ultimo shake frame.
1515+ F453              ; Llamada al final de la fase SHAKE en sustitucion del XOR-erase antiguo.
1516+ F453              ; Destruye: AF, BC, HL.
1517+ F453              ; ==============================================================================
1518+ F453              ChurchCutsceneEraseStatueDirect:
1519+ F453 3A A1 5F         LD A, (ChurchCutsceneStatueOrigY)
1520+ F456 57               LD D, A
1521+ F457 3A A0 5F         LD A, (ChurchCutsceneStatueOrigX)
1522+ F45A 5F               LD E, A
1523+ F45B CD 5D 9D         CALL CalcPixelAddr
1524+ F45E 06 18            LD B, 24                                ; statues son 24 px de alto
1525+ F460              .csedRow:
1526+ F460 AF               XOR A                                   ; A=0 cada iter (NextPixelLine corrompe A)
1527+ F461 77               LD (HL), A
1528+ F462 23               INC HL
1529+ F463 77               LD (HL), A
1530+ F464 2B               DEC HL                                  ; volver a inicio fila
1531+ F465 C5               PUSH BC
1532+ F466 CD C9 9A         CALL NextPixelLine
1533+ F469 C1               POP BC
1534+ F46A 10 F4            DJNZ .csedRow
1535+ F46C C9               RET
