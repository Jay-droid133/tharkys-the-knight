  49+ 91E4                  ; --- Swap a stack temporal (bank 2) ---
  50+ 91E4 ED 73 A3 9C      LD (MaiFlowSavedSP), SP
  51+ 91E8 31 43 9D         LD SP, MaiTempStackTop
  52+ 91EB
  53+ 91EB                  ; --- Ventana de paginacion ---
  54+ 91EB                  ; IFF tracking via StartupComplete (RAM) - evita race del LD A,I
  55+ 91EB F3               DI
  56+ 91EC 3A 8F 90         LD A, (CurrentPaging)
  57+ 91EF E6 F8            AND $F8
  58+ 91F1 F6 06            OR 6
  59+ 91F3 32 8F 90         LD (CurrentPaging), A
  60+ 91F6 01 FD 7F         LD BC, $7FFD
  61+ 91F9 ED 79            OUT (C), A
  62+ 91FB
  63+ 91FB                  ; --- Ejecutar BFS (usa temp stack para CALLs internos) ---
  64+ 91FB CD 17 92         CALL MaiFlowBfs
  65+ 91FE
  66+ 91FE                  ; --- Cerrar ventana: repaginar bank 0 ---
  67+ 91FE 3A 8F 90         LD A, (CurrentPaging)
  68+ 9201 E6 F8            AND $F8
  69+ 9203 32 8F 90         LD (CurrentPaging), A
  70+ 9206 01 FD 7F         LD BC, $7FFD
  71+ 9209 ED 79            OUT (C), A
  72+ 920B
