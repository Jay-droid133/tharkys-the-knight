 189+ DA89                  ; --- High nibble doubled ---
 190+ DA89 E6 F0            AND $F0
 191+ DA8B 0F               RRCA
 191+ DA8C 0F             RRCA
 191+ DA8D 0F             RRCA
 191+ DA8E 0F             RRCA       ; high nibble en posición baja
 192+ DA8F 5F               LD E, A
 193+ DA90 16 00            LD D, 0
 194+ DA92 21 1D DB         LD HL, NibbleDoubleLUT
 195+ DA95 19               ADD HL, DE
