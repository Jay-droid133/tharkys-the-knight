2192+ AE61              ; ==============================================================================
2193+ AE61              ; StartWellCooldown - al usar el pozo: captura originals, pinta blanco, arranca timer
2194+ AE61              ; ==============================================================================
2195+ AE61              ; Lee los 2 attrs actuales de CleanAttrMap (cian "limpio", ignora overlays
2196+ AE61              ; de player/enemigos), los guarda en WellOrigAttrN para restaurar al final
2197+ AE61              ; del cooldown. Luego pinta blanco en VRAM y CleanAttrMap.
2198+ AE61              ; ==============================================================================
2199+ AE61              StartWellCooldown:
2200+ AE61 CD 8E AE         CALL GetWellBottomOffset            ; HL = offset fila inferior en attr map
2201+ AE64 E5               PUSH HL
2202+ AE65 11 BB 8D         LD DE, CleanAttrMap
2203+ AE68 19               ADD HL, DE
2204+ AE69 7E               LD A, (HL)
2205+ AE6A 32 C3 90         LD (WellOrigAttr0), A
2206+ AE6D 23               INC HL
2207+ AE6E 7E               LD A, (HL)
2208+ AE6F 32 C4 90         LD (WellOrigAttr1), A
2209+ AE72 E1               POP HL
2210+ AE73 CD A8 AE         CALL PaintWellWhiteAt               ; pinta blanco VRAM + CleanAttrMap
2211+ AE76 21 7D 00         LD HL, WELL_COOLDOWN_FRAMES
2212+ AE79 22 C1 90         LD (WellCooldownTimer), HL
2213+ AE7C C9               RET
