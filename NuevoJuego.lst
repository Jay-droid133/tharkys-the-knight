  68+ 989A 3A 82 8D         LD A, (CurrentPaging)
  69+ 989D E6 F8            AND $F8
  70+ 989F 32 82 8D         LD (CurrentPaging), A
  71+ 98A2 01 FD 7F         LD BC, $7FFD
  72+ 98A5 ED 79            OUT (C), A                      ; slot 3 = bank 0 (sin DI; SP alterno)
  73+ 98A7 ED 7B AC 98      LD SP, (.aubSavedSP)
  74+ 98AB C9               RET
  75+ 98AC 00 00        .aubSavedSP: DEFW 0
