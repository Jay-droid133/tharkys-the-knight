 124+ EC43              ; UpdateGameClock
 125+ EC43              ; ==============================================================================
 126+ EC43              UpdateGameClock:
 127+ EC43 3A BB 82         LD A, (TimeFrozen)
 128+ EC46 B7               OR A
 129+ EC47 C0               RET NZ                          ; tiempo congelado mientras encierras monstruos
 130+ EC48 21 A9 EA         LD HL, GameSubMinute
 131+ EC4B 34               INC (HL)
 132+ EC4C 3A AC EA         LD A, (SubMinuteMax)
 133+ EC4F BE               CP (HL)
 134+ EC50 C0               RET NZ
 135+ EC51
 136+ EC51 AF               XOR A
 137+ EC52 32 A9 EA         LD (GameSubMinute), A
 138+ EC55 21 AA EA         LD HL, GameMinutes
 139+ EC58 34               INC (HL)
 140+ EC59                  ; NOTA: el spawn de monsters ahora se dispara tras las campanadas
 141+ EC59                  ; (cadena diferida en UpdateBellsDoneTimer), no a las 00:30.
 142+ EC59 3A AA EA         LD A, (GameMinutes)
 143+ EC5C FE 3C            CP 60
 144+ EC5E C0               RET NZ
 145+ EC5F
 146+ EC5F AF               XOR A
 147+ EC60 32 AA EA         LD (GameMinutes), A
