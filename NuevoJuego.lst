2759+ AE16              ; ==============================================================================
2760+ AE16              ; ==============================================================================
2761+ AE16              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2762+ AE16              ; ==============================================================================
2763+ AE16              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2764+ AE16              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2765+ AE16              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2766+ AE16              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2767+ AE16              ; ==============================================================================
2768+ AE16              UpdateMonster:
2769+ AE16                  ; --- Stun: knockback + pausa tras golpe del player ---
2770+ AE16 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2771+ AE19 B7               OR A
2772+ AE1A CA 4F B0         JP Z, .moNormal
2773+ AE1D DD 35 0A         DEC (IX+ENT_DIR)
2774+ AE20 20 0B            JR NZ, .moStunActive
2775+ AE22                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2776+ AE22 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2777+ AE26 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2778+ AE2A C3 4F B0         JP .moNormal
2779+ AE2D
2780+ AE2D              .moStunActive:
2781+ AE2D                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2782+ AE2D FE 06            CP MONSTER_STUN_PAUSE
2783+ AE2F DA E0 B1         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2784+ AE32                  ; Knockback: aplicar movimiento con collision check
2785+ AE32 DD 56 06         LD D, (IX+ENT_DELTAX)
2786+ AE35 DD 5E 07         LD E, (IX+ENT_DELTAY)
2787+ AE38 7A               LD A, D
2788+ AE39 B3               OR E
2789+ AE3A CA E0 B1         JP Z, .moAnimate
2790+ AE3D                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2791+ AE3D D5               PUSH DE
2792+ AE3E DD 7E 03         LD A, (IX+ENT_POSX)
2793+ AE41 32 78 B3         LD (.moSvX), A
2794+ AE44 DD 7E 04         LD A, (IX+ENT_POSY)
2795+ AE47 32 79 B3         LD (.moSvY), A
2796+ AE4A                  ; Calcular nueva posicion
2797+ AE4A DD 7E 03         LD A, (IX+ENT_POSX)
2798+ AE4D 82               ADD A, D
2799+ AE4E DD 77 03         LD (IX+ENT_POSX), A
2800+ AE51 DD 7E 04         LD A, (IX+ENT_POSY)
2801+ AE54 83               ADD A, E
2802+ AE55 DD 77 04         LD (IX+ENT_POSY), A
2803+ AE58                  ; Comprobar bordes ANTES de colision con paredes
2804+ AE58 DD 7E 03         LD A, (IX+ENT_POSX)
2805+ AE5B FE E8            CP SCREEN_MAX_X
2806+ AE5D 30 30            JR NC, .moKbPreOffscreen
2807+ AE5F FE 04            CP MONSTER_KB_SPEED
2808+ AE61 38 20            JR C, .moKbPreOffscreenMaybeX
2809+ AE63              .moKbPreBorderXOk:
2810+ AE63 DD 7E 04         LD A, (IX+ENT_POSY)
2811+ AE66 FE A8            CP SCREEN_MAX_Y
2812+ AE68 30 25            JR NC, .moKbPreOffscreen
2813+ AE6A FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2814+ AE6C 38 1B            JR C, .moKbPreOffscreenMaybeY
2815+ AE6E              .moKbPreBorderOk:
2816+ AE6E                  ; Trampa de la iglesia (paso 7): detectar el INTENTO de cruzar la
2817+ AE6E                  ; puerta. POSX/POSY ya tienen la would-be posicion; la puerta abierta
2818+ AE6E                  ; es wall en CollisionMap, asi que el check debe ocurrir antes de
2819+ AE6E                  ; CheckEnemyCollision.
2820+ AE6E                  ; CheckChurchTrap retorna:
2821+ AE6E                  ;   A=0 -> no es trampa, seguir flujo normal (collision check).
2822+ AE6E                  ;   A=1 -> trampa disparada, cutscene activa: salir.
2823+ AE6E                  ;   A=2 -> tipo no esperado en zona de trampa: tratar como wall.
2824+ AE6E CD 52 F3         CALL CheckChurchTrap
2825+ AE71 B7               OR A
2826+ AE72 28 07            JR Z, .moKbCollCheck
2827+ AE74 FE 02            CP 2
2828+ AE76 CA 27 AF         JP Z, .moKbWallBlock                ; tipo no esperado -> rebotar
2829+ AE79 D1               POP DE                              ; limpiar PUSH DE previo
2830+ AE7A C9               RET                                 ; cutscene activa, salir
2831+ AE7B              .moKbCollCheck:
2832+ AE7B                  ; Dentro de pantalla: comprobar colision con paredes
2833+ AE7B CD F4 B6         CALL CheckEnemyCollision
2834+ AE7E C2 27 AF         JP NZ, .moKbWallBlock               ; Bloqueado por pared
2835+ AE81 18 1C            JR .moKbNotBlocked
2836+ AE83              .moKbPreOffscreenMaybeX:
2837+ AE83 CB 7A            BIT 7, D
2838+ AE85 20 08            JR NZ, .moKbPreOffscreen
2839+ AE87 18 DA            JR .moKbPreBorderXOk
2840+ AE89              .moKbPreOffscreenMaybeY:
2841+ AE89 CB 7B            BIT 7, E
2842+ AE8B 20 02            JR NZ, .moKbPreOffscreen
2843+ AE8D 18 DF            JR .moKbPreBorderOk
2844+ AE8F              .moKbPreOffscreen:
2845+ AE8F                  ; Sale de pantalla: restaurar pos y saltar directo a offscreen handler
2846+ AE8F 3A 78 B3         LD A, (.moSvX)
2847+ AE92 DD 77 03         LD (IX+ENT_POSX), A
2848+ AE95 3A 79 B3         LD A, (.moSvY)
2849+ AE98 DD 77 04         LD (IX+ENT_POSY), A
2850+ AE9B D1               POP DE
2851+ AE9C C3 8C AF         JP .moKbOffscreen
2852+ AE9F              .moKbNotBlocked:
2853+ AE9F                  ; Pared libre: comprobar impacto con otro monster (billar)
2854+ AE9F CD 79 B2         CALL .moCheckOverlap
2855+ AEA2 20 10            JR NZ, .moKbBilliard                ; Impacto! → transferir fuerza
2856+ AEA4                  ; Libre: restaurar pos y aplicar movimiento
2857+ AEA4 3A 78 B3         LD A, (.moSvX)
2858+ AEA7 DD 77 03         LD (IX+ENT_POSX), A
2859+ AEAA 3A 79 B3         LD A, (.moSvY)
2860+ AEAD DD 77 04         LD (IX+ENT_POSY), A
2861+ AEB0 D1               POP DE
2862+ AEB1 C3 63 AF         JP .moKbApply
2863+ AEB4              .moKbBilliard:
2864+ AEB4                  ; Billar: A para en su sitio, B hereda la fuerza
2865+ AEB4 3A 78 B3         LD A, (.moSvX)
2866+ AEB7 DD 77 03         LD (IX+ENT_POSX), A
2867+ AEBA 3A 79 B3         LD A, (.moSvY)
2868+ AEBD DD 77 04         LD (IX+ENT_POSY), A
2869+ AEC0 D1               POP DE
2870+ AEC1                  ; Transferir knockback al monster impactado
2871+ AEC1 DD E5            PUSH IX
2872+ AEC3 DD 2A 82 B3      LD IX, (.moHitMonster)
2873+ AEC7                  ; Solo transferir si no esta ya en stun
2874+ AEC7 DD 7E 0A         LD A, (IX+ENT_DIR)
2875+ AECA B7               OR A
2876+ AECB 20 2A            JR NZ, .moKbBilliardDone
2877+ AECD                  ; B hereda misma direccion pero fuerza reducida (billar secundario)
2878+ AECD 7A               LD A, D
2879+ AECE B7               OR A
2880+ AECF 28 0D            JR Z, .moBillNoX
2881+ AED1 CB 7A            BIT 7, D
2882+ AED3 20 04            JR NZ, .moBillXNeg
2883+ AED5 3E 03            LD A, MONSTER_KB_SPEED - 1           ; 3px (entre 2 y 4)
2884+ AED7 18 02            JR .moBillSetX
2885+ AED9              .moBillXNeg:
2886+ AED9 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2887+ AEDB              .moBillSetX:
2888+ AEDB DD 77 06         LD (IX+ENT_DELTAX), A
2889+ AEDE              .moBillNoX:
2890+ AEDE 7B               LD A, E
2891+ AEDF B7               OR A
2892+ AEE0 28 0D            JR Z, .moBillNoY
2893+ AEE2 CB 7B            BIT 7, E
2894+ AEE4 20 04            JR NZ, .moBillYNeg
2895+ AEE6 3E 03            LD A, MONSTER_KB_SPEED - 1
2896+ AEE8 18 02            JR .moBillSetY
2897+ AEEA              .moBillYNeg:
2898+ AEEA 3E FD            LD A, -(MONSTER_KB_SPEED - 1)
2899+ AEEC              .moBillSetY:
2900+ AEEC DD 77 07         LD (IX+ENT_DELTAY), A
2901+ AEEF              .moBillNoY:
2902+ AEEF DD 36 0A 0C      LD (IX+ENT_DIR), MONSTER_STUN_PAUSE + 6  ; 18 frames: 6 de knockback + 12 de pausa
2903+ AEF3                  ; Kb heredado por billar: NO es directo del player.
2904+ AEF3                  ; Limpia el bit -> CheckChurchTrap no disparara la trampa para este kb.
2905+ AEF3 DD CB 0B A6      RES ENTF_KB_DIRECT, (IX+ENT_FLAGS)
2906+ AEF7              .moKbBilliardDone:
2907+ AEF7 DD E1            POP IX
2908+ AEF9                  ; A continua con fuerza reducida (no para del todo)
2909+ AEF9                  ; Reducir velocidad de A a la mitad
2910+ AEF9 DD 7E 06         LD A, (IX+ENT_DELTAX)
2911+ AEFC CB 2F            SRA A                               ; /2 con signo
2912+ AEFE DD 77 06         LD (IX+ENT_DELTAX), A
2913+ AF01 57               LD D, A
2914+ AF02 DD 7E 07         LD A, (IX+ENT_DELTAY)
2915+ AF05 CB 2F            SRA A
2916+ AF07 DD 77 07         LD (IX+ENT_DELTAY), A
2917+ AF0A 5F               LD E, A
2918+ AF0B                  ; Reducir stun restante de A
2919+ AF0B DD 7E 0A         LD A, (IX+ENT_DIR)
2920+ AF0E FE 08            CP MONSTER_STUN_PAUSE + 2
2921+ AF10 DA 44 B0         JP C, .moStunStop                   ; Casi sin stun → parar
2922+ AF13 D6 04            SUB 4                               ; Quitar 4 frames de knockback
2923+ AF15 DD 77 0A         LD (IX+ENT_DIR), A
2924+ AF18                  ; Aplicar movimiento reducido de A
2925+ AF18 3A 78 B3         LD A, (.moSvX)
2926+ AF1B DD 77 03         LD (IX+ENT_POSX), A
2927+ AF1E 3A 79 B3         LD A, (.moSvY)
2928+ AF21 DD 77 04         LD (IX+ENT_POSY), A
2929+ AF24 C3 63 AF         JP .moKbApply
2930+ AF27              .moKbWallBlock:
2931+ AF27                  ; Bloqueado por pared: restaurar pos, intentar slide por eje individual
2932+ AF27 3A 78 B3         LD A, (.moSvX)
2933+ AF2A DD 77 03         LD (IX+ENT_POSX), A
2934+ AF2D 3A 79 B3         LD A, (.moSvY)
2935+ AF30 DD 77 04         LD (IX+ENT_POSY), A
2936+ AF33 D1               POP DE
2937+ AF34                  ; Intentar solo eje X (mantener direccion del golpe)
2938+ AF34 7A               LD A, D
2939+ AF35 B7               OR A
2940+ AF36 28 12            JR Z, .moKbSlideY                   ; Sin deltaX → probar Y directamente
2941+ AF38 D5               PUSH DE
2942+ AF39 1E 00            LD E, 0
2943+ AF3B CD 3A B2         CALL .moTryPassable
2944+ AF3E D1               POP DE
2945+ AF3F 20 09            JR NZ, .moKbSlideY
2946+ AF41                  ; Slide en X funciona
2947+ AF41 1E 00            LD E, 0
2948+ AF43 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2949+ AF47 C3 63 AF         JP .moKbApply
2950+ AF4A              .moKbSlideY:
2951+ AF4A                  ; Intentar solo eje Y (mantener direccion del golpe)
2952+ AF4A 7B               LD A, E
2953+ AF4B B7               OR A
2954+ AF4C 28 12            JR Z, .moKbSlideStop                ; Sin deltaY → todo bloqueado
2955+ AF4E D5               PUSH DE
2956+ AF4F 16 00            LD D, 0
2957+ AF51 CD 3A B2         CALL .moTryPassable
2958+ AF54 D1               POP DE
2959+ AF55 20 09            JR NZ, .moKbSlideStop
2960+ AF57                  ; Slide en Y funciona
2961+ AF57 16 00            LD D, 0
2962+ AF59 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2963+ AF5D C3 63 AF         JP .moKbApply
2964+ AF60              .moKbSlideStop:
2965+ AF60 C3 44 B0         JP .moStunStop
2966+ AF63                  ; (moKbMonsterHit eliminado - reemplazado por moKbBilliard arriba)
2967+ AF63              .moKbApply:
2968+ AF63 DD 7E 03         LD A, (IX+ENT_POSX)
2969+ AF66 82               ADD A, D
2970+ AF67 DD 77 03         LD (IX+ENT_POSX), A
2971+ AF6A                  ; Comprobar bordes X
2972+ AF6A FE E8            CP SCREEN_MAX_X
2973+ AF6C 30 1E            JR NC, .moKbOffscreen               ; Derecha o underflow pasado izquierda
2974+ AF6E                  ; Borde izquierdo: si X < KB_SPEED y empujando a la izquierda
2975+ AF6E FE 04            CP MONSTER_KB_SPEED
2976+ AF70 30 04            JR NC, .moKbXOk
2977+ AF72 CB 7A            BIT 7, D                            ; Delta X negativo?
2978+ AF74 20 16            JR NZ, .moKbOffscreen               ; Si, empujando izquierda → offscreen
2979+ AF76              .moKbXOk:
2980+ AF76 DD 7E 04         LD A, (IX+ENT_POSY)
2981+ AF79 83               ADD A, E
2982+ AF7A DD 77 04         LD (IX+ENT_POSY), A
2983+ AF7D                  ; Comprobar bordes Y
