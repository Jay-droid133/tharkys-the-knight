1430+ D4D5              ; BuildCollisionMap - Construye mapa de colision desde los sprites del room
1431+ D4D5              ; ==============================================================================
1432+ D4D5              ; Llamado una vez al cargar cada pantalla (desde DrawScreen).
1433+ D4D5              ; Itera la lista de BG sprites y marca su footprint en CollisionMap.
1434+ D4D5              ; Todos los BG sprites se tratan como solidos.
1435+ D4D5              ; ==============================================================================
1436+ D4D5              BuildCollisionMap:
1437+ D4D5                  ; Limpiar mapa a 0 (todo libre)
1438+ D4D5 21 3D 83         LD HL, CollisionMap
1439+ D4D8 11 3E 83         LD DE, CollisionMap + 1
1440+ D4DB 01 BF 02         LD BC, 32 * 22 - 1
1441+ D4DE AF               XOR A
1442+ D4DF 77               LD (HL), A
1443+ D4E0 ED B0            LDIR
1444+ D4E2
1445+ D4E2                  ; Iterar sprites del room (formato Stage A: DEFB id, x, y, v; $FF = end)
1446+ D4E2 2A 12 83         LD HL, (CurrentScreenAddr)
1447+ D4E5              .bcmLoop:
1448+ D4E5 7E               LD A, (HL)                  ; A = id
1449+ D4E6 23               INC HL
1450+ D4E7 FE FF            CP $FF
1451+ D4E9 28 45            JR Z, .bcmRoomDone          ; Terminador → pasar a ObjectTable
1452+ D4EB FE D2            CP RANDOM_SLOT_MARKER       ; id 210: ghost (no es solido). Skip x, y, v.
1453+ D4ED 20 05            JR NZ, .bcmNotMarker
1454+ D4EF 23               INC HL
1455+ D4F0 23               INC HL
1456+ D4F1 23               INC HL
1457+ D4F2 18 F1            JR .bcmLoop
1458+ D4F4              .bcmNotMarker:
1459+ D4F4
1460+ D4F4                  ; Resolver id -> (ptr, bank) via BgGfxPtrById (formato 3B: ptr + bank)
1461+ D4F4 E5               PUSH HL
1462+ D4F5 6F               LD L, A
1463+ D4F6 26 00            LD H, 0
1464+ D4F8 54               LD D, H
1465+ D4F9 5D               LD E, L                     ; DE = id
