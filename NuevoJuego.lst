 771+ D1A8              ; DrawBgGfxSprite - Dibuja un BG sprite con pixeles y atributos
 772+ D1A8              ; ==============================================================================
 773+ D1A8              ; Entrada: IX = datos del sprite, B = x_char, C = y_char
 774+ D1A8              ; Formato: DEFB height_px, width_bytes, pixel_data(CPL),
 775+ D1A8              ;          DEFB tintPaper, attr_h, attr_w, attr_data
 776+ D1A8              ; ==============================================================================
 777+ D1A8              DrawBgGfxSprite:
 778+ D1A8 DD 7E 00         LD A, (IX+0)                ; height_px
