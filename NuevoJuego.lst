2837+ DB14              ; ==============================================================================
2838+ DB14              ; DrawKeyHUD - Muestra la llave actual en el HUD (cols 20-22, rows 0-1)
2839+ DB14              ; ==============================================================================
2840+ DB14              ; Slot 3×2 chars en la fila HUD superior, justo a la derecha del reloj-decor.
2841+ DB14              ; Las 6 keys son todas 24×16 (3×2 chars).
2842+ DB14              ; Si CurrentKey == 0: limpia el área. Si > 0: dibuja el sprite de la key.
2843+ DB14              ; Se llama cada frame desde MainLoop.
2844+ DB14              ; ==============================================================================
2845+ DB14              DrawKeyHUD:
2846+ DB14 3A B1 82         LD A, (CurrentKey)
2847+ DB17 B7               OR A
2848+ DB18 20 35            JR NZ, .dkhDraw
2849+ DB1A
2850+ DB1A                  ; Limpiar pixeles fila 0 (third 0, scans 0-7 = H $40..$47)
2851+ DB1A 21 14 40         LD HL, $4014                ; row 0 col 20 scan 0
2852+ DB1D 06 08            LD B, 8
2853+ DB1F              .dkhClr0:
2854+ DB1F AF               XOR A
2855+ DB20 77               LD (HL), A
2856+ DB21 23               INC HL
2857+ DB22 77               LD (HL), A
2858+ DB23 23               INC HL
2859+ DB24 77               LD (HL), A
2860+ DB25 2B               DEC HL
2861+ DB26 2B               DEC HL
2862+ DB27 24               INC H
2863+ DB28 10 F5            DJNZ .dkhClr0
2864+ DB2A                  ; Limpiar pixeles fila 1
2865+ DB2A 21 34 40         LD HL, $4034                ; row 1 col 20 scan 0
2866+ DB2D 06 08            LD B, 8
2867+ DB2F              .dkhClr1:
2868+ DB2F AF               XOR A
2869+ DB30 77               LD (HL), A
2870+ DB31 23               INC HL
2871+ DB32 77               LD (HL), A
2872+ DB33 23               INC HL
2873+ DB34 77               LD (HL), A
2874+ DB35 2B               DEC HL
2875+ DB36 2B               DEC HL
2876+ DB37 24               INC H
2877+ DB38 10 F5            DJNZ .dkhClr1
2878+ DB3A                  ; Limpiar attrs (row 0-1, cols 20-22)
2879+ DB3A 3E 47            LD A, $47                   ; bright white on black
2880+ DB3C 32 14 58         LD ($5814), A
2881+ DB3F 32 15 58         LD ($5815), A
2882+ DB42 32 16 58         LD ($5816), A
2883+ DB45 32 34 58         LD ($5834), A
2884+ DB48 32 35 58         LD ($5835), A
2885+ DB4B 32 36 58         LD ($5836), A
2886+ DB4E C9               RET
2887+ DB4F
2888+ DB4F              .dkhDraw:
2889+ DB4F                  ; A = 1..6: sacar el BgGfx ptr de KeyLockTable[A-1]
