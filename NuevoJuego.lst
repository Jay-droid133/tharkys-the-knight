 714+ E897 09               ADD HL, BC                  ; HL = font data
 715+ E898 16 40            LD D, $40                   ; Tercio 0, scan line 0
 716+ E89A 7B               LD A, E                     ; Columna directa (fila 0 offset = 0)
 717+ E89B 5F               LD E, A                     ; DE = dir VRAM
 718+ E89C 06 08            LD B, 8
