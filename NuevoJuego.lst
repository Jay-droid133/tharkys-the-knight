2756+ B18E 30 04            JR NC, .moKbXOk
2757+ B190 CB 7A            BIT 7, D                            ; Delta X negativo?
2758+ B192 20 16            JR NZ, .moKbOffscreen               ; Si, empujando izquierda → offscreen
2759+ B194              .moKbXOk:
2760+ B194 DD 7E 04         LD A, (IX+ENT_POSY)
2761+ B197 83               ADD A, E
2762+ B198 DD 77 04         LD (IX+ENT_POSY), A
2763+ B19B                  ; Comprobar bordes Y
2764+ B19B FE A8            CP SCREEN_MAX_Y
2765+ B19D 30 0B            JR NC, .moKbOffscreen               ; Pasado borde inferior
2766+ B19F                  ; Borde superior: si Y < MIN+KB_SPEED y empujando arriba
2767+ B19F FE 14            CP SCREEN_MIN_Y + MONSTER_KB_SPEED
2768+ B1A1 30 04            JR NC, .moKbYOk
2769+ B1A3 CB 7B            BIT 7, E                            ; Delta Y negativo?
2770+ B1A5 20 03            JR NZ, .moKbOffscreen               ; Si, empujando arriba → offscreen
2771+ B1A7              .moKbYOk:
2772+ B1A7 C3 F7 B3         JP .moAnimate
2773+ B1AA              .moKbOffscreen:
2774+ B1AA                  ; Elegir eje de salida por MAGNITUD DEL KNOCKBACK, no por el eje que
2775+ B1AA                  ; cruzo el borde primero. Asi el monster sale por el lado que el
2776+ B1AA                  ; player quiso empujar (eje primario) aunque llegue al borde del eje
2777+ B1AA                  ; secundario un frame antes por drift diagonal.
2778+ B1AA                  ;
2779+ B1AA                  ; |DX| vs |DY|: eje primario = mayor magnitud. En empate, horizontal.
2780+ B1AA DD 7E 06         LD A, (IX+ENT_DELTAX)
2781+ B1AD CB 7F            BIT 7, A
2782+ B1AF 28 02            JR Z, .moKbAbsDxOk
2783+ B1B1 ED 44            NEG
2784+ B1B3              .moKbAbsDxOk:
2785+ B1B3 47               LD B, A                             ; B = |dx|
2786+ B1B4 DD 7E 07         LD A, (IX+ENT_DELTAY)
2787+ B1B7 CB 7F            BIT 7, A
2788+ B1B9 28 02            JR Z, .moKbAbsDyOk
2789+ B1BB ED 44            NEG
2790+ B1BD              .moKbAbsDyOk:
2791+ B1BD                  ; A = |dy|, B = |dx|
2792+ B1BD B8               CP B
2793+ B1BE 30 30            JR NC, .moKbPrimY                   ; |dy| >= |dx| → Y primario
2794+ B1C0              .moKbPrimX:
2795+ B1C0                  ; Eje primario X → clamp X, mantener Y (clampeado al rango valido)
2796+ B1C0 DD 7E 06         LD A, (IX+ENT_DELTAX)
2797+ B1C3 CB 7F            BIT 7, A
2798+ B1C5 20 08            JR NZ, .moKbExitLeft
2799+ B1C7 DD 36 03 E7      LD (IX+ENT_POSX), SCREEN_MAX_X - 1
2800+ B1CB 3E 04            LD A, DIR_E
