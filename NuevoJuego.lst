 227+ 9AC9              ; ==============================================================================
 228+ 9AC9              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
 229+ 9AC9              ; ==============================================================================
 230+ 9AC9              ; Maneja correctamente los cruces de character row (cada 8 lineas)
 231+ 9AC9              ; y los cruces de tercio de pantalla (cada 64 lineas).
 232+ 9AC9              ;
 233+ 9AC9              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
 234+ 9AC9              ; ==============================================================================
 235+ 9AC9              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
 236+ 9AC9              NextPixelLine:
 237+ 9AC9 24               INC H                       ; Siguiente scanline dentro del char
 238+ 9ACA 7C               LD A, H
 239+ 9ACB E6 07            AND 7
 240+ 9ACD C0               RET NZ                      ; Sin cruce de char row → listo
 241+ 9ACE
 242+ 9ACE                  ; --- Cruce de character row ---
 243+ 9ACE 7D               LD A, L
 244+ 9ACF C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
 245+ 9AD1 6F               LD L, A
 246+ 9AD2 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
 247+ 9AD4 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
 248+ 9AD5
 249+ 9AD5                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
 250+ 9AD5 7C               LD A, H
 251+ 9AD6 D6 08            SUB 8
 252+ 9AD8 67               LD H, A
 253+ 9AD9 C9               RET
