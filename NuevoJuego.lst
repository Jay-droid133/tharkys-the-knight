7423+ C86B              .bfsAppMove:
7424+ C86B                  ; Intentar 1 paso con collision check
7425+ C86B DD 7E 03         LD A, (IX+ENT_POSX)
7426+ C86E 32 9A C8         LD (.bfsSvX), A
7427+ C871 DD 7E 04         LD A, (IX+ENT_POSY)
7428+ C874 32 9B C8         LD (.bfsSvY), A
7429+ C877 DD 7E 03         LD A, (IX+ENT_POSX)
7430+ C87A DD 86 06         ADD A, (IX+ENT_DELTAX)
7431+ C87D DD 77 03         LD (IX+ENT_POSX), A
7432+ C880 DD 7E 04         LD A, (IX+ENT_POSY)
