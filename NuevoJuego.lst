 181+ EB11                  ; --- Lookup sprite ptr ---
 182+ EB11 FE 02            CP ROUL_HEALTH
 183+ EB13 28 12            JR Z, .grpiHealth
 184+ EB15 FE 03            CP ROUL_STAMINA
 185+ EB17 28 14            JR Z, .grpiStamina
 186+ EB19                  ; Resto: canonical en RouletteTypePtrs[A-1]
 187+ EB19 3D               DEC A
 188+ EB1A 26 00            LD H, 0
 189+ EB1C 6F               LD L, A
 190+ EB1D 29               ADD HL, HL
 191+ EB1E 11 C1 EA         LD DE, RouletteTypePtrs
 192+ EB21 19               ADD HL, DE
 193+ EB22 7E               LD A, (HL)
 194+ EB23 23               INC HL
 195+ EB24 66               LD H, (HL)
 196+ EB25 6F               LD L, A                                 ; HL = sprite ptr
 197+ EB26 C9               RET
