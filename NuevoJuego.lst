2677+ B0F8              ; ==============================================================================
2678+ B0F8              ; UpdateMonster - AI de persecucion lenta, erratica, con evasion de obstaculos
2679+ B0F8              ; ==============================================================================
2680+ B0F8              ; IX = entidad TYPE_MONSTER en STATE_RUNNING.
2681+ B0F8              ; Persigue al player lenta e inexorablemente (MONSTER_SPEED=1).
2682+ B0F8              ; 25% de frames no se mueve (erraticidad). Rodea BG sprites.
2683+ B0F8              ; Persistencia: mantiene direccion mientras sea pasable y acerque al player.
2684+ B0F8              ; ==============================================================================
2685+ B0F8              UpdateMonster:
2686+ B0F8                  ; --- Stun: knockback + pausa tras golpe del player ---
2687+ B0F8 DD 7E 0A         LD A, (IX+ENT_DIR)              ; ENT_DIR = stun counter (0=normal)
2688+ B0FB B7               OR A
2689+ B0FC CA 31 B3         JP Z, .moNormal
2690+ B0FF DD 35 0A         DEC (IX+ENT_DIR)
2691+ B102 20 0B            JR NZ, .moStunActive
2692+ B104                  ; Stun terminado: sigue vivo, limpiar deltas para recalculo de persecucion
2693+ B104 DD 36 06 00      LD (IX+ENT_DELTAX), 0
2694+ B108 DD 36 07 00      LD (IX+ENT_DELTAY), 0
2695+ B10C C3 31 B3         JP .moNormal
2696+ B10F
2697+ B10F              .moStunActive:
2698+ B10F                  ; Fase knockback: timer >= PAUSE → moverse con deltas invertidos
2699+ B10F FE 06            CP MONSTER_STUN_PAUSE
2700+ B111 DA C2 B4         JP C, .moAnimate                ; Fase pausa: no moverse, solo animar
2701+ B114                  ; Knockback: aplicar movimiento con collision check
2702+ B114 DD 56 06         LD D, (IX+ENT_DELTAX)
2703+ B117 DD 5E 07         LD E, (IX+ENT_DELTAY)
2704+ B11A 7A               LD A, D
2705+ B11B B3               OR E
2706+ B11C CA C2 B4         JP Z, .moAnimate
2707+ B11F                  ; --- Comprobar si el knockback sale de pantalla (antes de colision) ---
2708+ B11F D5               PUSH DE
2709+ B120 DD 7E 03         LD A, (IX+ENT_POSX)
2710+ B123 32 5A B6         LD (.moSvX), A
2711+ B126 DD 7E 04         LD A, (IX+ENT_POSY)
2712+ B129 32 5B B6         LD (.moSvY), A
