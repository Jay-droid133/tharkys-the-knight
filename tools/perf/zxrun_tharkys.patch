+        B.worst = bad;
+        write_bmp_buf(B.shot, fr->disp, fr->dispat, true);
+        snprintf(fin, sizeof fin, "%s.fin.bmp", B.shot);
+        write_bmp_buf(fin, scr, scr + 6144, false);
+    }
