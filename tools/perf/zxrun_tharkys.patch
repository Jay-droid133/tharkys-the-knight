+static void beam_eval(const beamfr_t *fr, const uint8_t *scr) {
+    uint32_t bad = 0;
+    for (int off = 0; off < 6144; off++) {
+        const uint8_t d = fr->disp[off];
+        if (d == stable[off] || d == scr[off]) continue;
+        const int line = ((off >> 8) & 7) | ((off >> 2) & 0x38) | ((off >> 5) & 0xC0);
+        bad++; B.bad_px++; B.heat[(line >> 3) * 32 + (off & 31)]++; B.pcs[fr->dpc[off]]++;
+    }
+    for (int k = 0; k < 6144; k++) {
+        const int line = k >> 5, col = k & 31, aoff = 6144 + (line >> 3) * 32 + col;
+        const uint8_t d = fr->dispat[k];
+        if (d == stable[aoff] || d == scr[aoff]) continue;
+        bad++; B.bad_at++; B.heat[(line >> 3) * 32 + col]++; B.pcs[fr->dpcat[k]]++;
+    }
+    B.frames++;
+    if (bad) B.bad_frames++;
+    if (bad > B.worst && B.shot) {
+        char fin[300];
+        B.worst = bad;
+        write_bmp_buf(B.shot, fr->disp, fr->dispat, true);
+        snprintf(fin, sizeof fin, "%s.fin.bmp", B.shot);
+        write_bmp_buf(fin, scr, scr + 6144, false);
+    }
+}
