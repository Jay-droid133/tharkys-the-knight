+/* --beam: lo que el haz ha leido frente al ultimo estado estable y al final.
+ * Un juego a 25 fps (Tharkys) dibuja durante 2 frames: solo los frames que
+ * acaban en HALT tienen un estado estable. Los frames intermedios (el INT
+ * llega con la CPU trabajando) se guardan y se evaluan todos juntos cuando la
+ * vuelta acaba en HALT: cada byte visto debe ser el del estado estable
+ * anterior o el del final; si no, es un estado intermedio (parpadeo). */
+typedef struct { uint8_t disp[6144], dispat[6144]; uint16_t dpc[6144], dpcat[6144]; } beamfr_t;
+static beamfr_t *pend; static int npend, cappend; static bool group_skip;
+static uint8_t stable[6912]; static bool have_stable;
