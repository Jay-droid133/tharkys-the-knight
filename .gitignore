# Binarios compilados
code/juego.tap
code/juego.sna
code/juego.map
code/*.lst
code/*.sym
code/*.sld

# Backups locales
*.bak

# Backups auto-generados de bg_sprites.json (por build_and_*.bat antes del build)
# Locales y rotados (max 30 snapshots). Ver tools/backup_bg_sprites.py.
code/backups/

# Magic Watcher triggers (transient: creados por level editor, borrados por magic_watcher.ps1)
code/_magic_run.json
code/_magic_zesarux.json
code/_magic_zesarux_stop.json

# Player tracker output (escrito por track_player.py mientras corre)
code/_player_pos.json

# Estado runtime de ZEsarUX (puede aparecer en code/ o en raiz segun cwd)
zesarux_index_menu.idx
code/zesarux_index_menu.idx

# Worktrees de Claude
.claude/worktrees/

# Configuración local de Claude
.claude/settings.local.json

# Memory map: snapshot baseline local (efímero, puede regenerarse en cualquier momento)
tools/.memory_map_snapshot.json
tools/__pycache__/

# sjasmplus listing (regenerable, 46k lineas)
code/ml.txt

# Desktop wrapper binary stamped at repo root by port/CMakeLists.txt
# (build artifact, regenerable; canonical copy lives in port/build/bin/)
/tharkys.exe
/tharkys

# Desktop wrapper runtime log (overwritten on each launch)
/tharkys.log

# Listing files at repo root (sjasmplus side-effect of build_and_*.bat)
/*.lst

# Word lock files (creados mientras un .docx está abierto)
~$*.docx

# Emulator quick-save snapshots from manual testing
Saves emu testing/*.szx
