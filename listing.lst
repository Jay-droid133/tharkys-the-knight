 86+  832B              ; InitEntities - Inicializa la tabla de entidades
 87+  832B              ; ==============================================================================
 88+  832B              ; Limpia todos los slots y configura el slot 0 como player.
 89+  832B              ; ==============================================================================
 90+  832B              InitEntities:
 91+  832B                  ; Limpiar toda la tabla a ceros
 92+  832B 21 37 80         LD HL, EntityTable
 93+  832E 11 38 80         LD DE, EntityTable + 1
