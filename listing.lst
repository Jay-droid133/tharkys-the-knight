190+  83CA              ; DrawEntity - Guarda attrs, XOR-dibuja sprite, pinta attrs de entidad
191+  83CA              ; ==============================================================================
192+  83CA              ; IX = puntero a la entidad
193+  83CA              ; ==============================================================================
194+  83CA              DrawEntity:
195+  83CA                  ; Guardar attrs del fondo ANTES de pintar
196+  83CA CD FC 83         CALL GetSpriteAddr          ; Necesitamos width/height para SaveEntityAttr
197+  83CD DD 56 04         LD D, (IX+ENT_POSY)
198+  83D0 DD 5E 03         LD E, (IX+ENT_POSX)
199+  83D3 DD E5            PUSH IX
200+  83D5 DD 2A 0F 84      LD IX, (SpriteAddrTemp)
201+  83D9 CD C7 81         CALL SaveEntityAttr
202+  83DC DD E1            POP IX
203+  83DE
204+  83DE                  ; XOR draw del sprite
205+  83DE DD 56 04         LD D, (IX+ENT_POSY)
206+  83E1 DD 5E 03         LD E, (IX+ENT_POSX)
207+  83E4 DD E5            PUSH IX
208+  83E6 DD 2A 0F 84      LD IX, (SpriteAddrTemp)
209+  83EA CD 10 81         CALL DrawSprite
210+  83ED DD E1            POP IX
211+  83EF
212+  83EF                  ; Pintar atributo de la entidad
213+  83EF DD 56 04         LD D, (IX+ENT_POSY)
214+  83F2 DD 5E 03         LD E, (IX+ENT_POSX)
215+  83F5 DD 7E 05         LD A, (IX+ENT_ATTR)
216+  83F8 CD A9 81         CALL SetEntityAttr
217+  83FB C9               RET
218+  83FC
219+  83FC              ; ==============================================================================
220+  83FC              ; GetSpriteAddr - Obtiene puntero al sprite actual de la entidad
221+  83FC              ; ==============================================================================
222+  83FC              ; Lee SpriteID de la entidad, busca en SpriteFrameTable.
223+  83FC              ; Resultado guardado en SpriteAddrTemp (IX se preserva).
224+  83FC              ; ==============================================================================
225+  83FC              GetSpriteAddr:
226+  83FC DD 7E 00         LD A, (IX+ENT_SPRITEID)
227+  83FF 6F               LD L, A
228+  8400 26 00            LD H, 0
229+  8402 29               ADD HL, HL                  ; × 2 (cada entrada es DEFW)
230+  8403 11 C2 8B         LD DE, SpriteFrameTable
231+  8406 19               ADD HL, DE
232+  8407 5E               LD E, (HL)
233+  8408 23               INC HL
234+  8409 56               LD D, (HL)
235+  840A ED 53 0F 84      LD (SpriteAddrTemp), DE
236+  840E C9               RET
237+  840F
238+  840F 00 00        SpriteAddrTemp: DEFW 0
239+  8411
240+  8411              ; ==============================================================================
241+  8411              ; UpdatePlayer - Actualiza estado, movimiento y animacion del player
242+  8411              ; ==============================================================================
243+  8411              ; IX = puntero a la entidad del player (slot 0)
244+  8411              ; ==============================================================================
245+  8411              UpdatePlayer:
246+  8411 CD 1B 84         CALL UpdatePlayerState
247+  8414 CD 60 84         CALL UpdatePlayerMovement
248+  8417 CD 28 85         CALL UpdatePlayerAnimation
249+  841A C9               RET
