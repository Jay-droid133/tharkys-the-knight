  2+  810C              ; MOTOR GRAFICO - Sprites genericos y utilidades de pantalla
  3+  810C              ; ==============================================================================
  4+  810C              ; Sistema fiel a Sabre Wulf:
  5+  810C              ; - Sprites de tamanyo variable (width+height en cabecera)
  6+  810C              ; - XOR para draw/erase (dibujar dos veces = borrar)
  7+  810C              ; - NextPixelLine para cruzar character rows y tercios
  8+  810C              ; - Atributos dinamicos segun tamanyo del sprite
  9+  810C              ; ==============================================================================
 10+  810C
 11+  810C              ClearScreen:
 12+  810C CD AF 0D         CALL ROM_CLS
 13+  810F C9               RET
 14+  8110
 15+  8110              ; ==============================================================================
 16+  8110              ; DrawSprite - Dibuja un sprite con XOR, pixel-perfect (fiel a Sabre Wulf)
 17+  8110              ; ==============================================================================
 18+  8110              ; Entrada:
 19+  8110              ;   D = Y pixel (cualquier valor, no requiere alineacion)
 20+  8110              ;   E = X pixel (cualquier valor, no requiere alineacion)
 21+  8110              ;   IX = puntero a datos del sprite (con cabecera width, height)
 22+  8110              ;
 23+  8110              ; Formato del sprite:
 24+  8110              ;   DEFB width_bytes  (2 = 16px, 3 = 24px)
 25+  8110              ;   DEFB height_pixels
 26+  8110              ;   DEFB pixel_data... (width * height bytes)
 27+  8110              ;
 28+  8110              ; Dos paths:
 29+  8110              ;   - Alineado (X%8==0): XOR directo, sin tablas
 30+  8110              ;   - Shifted (X%8!=0): lookup tables pre-computadas (LD C,byte / LD A,(BC))
 31+  8110              ;     Cada byte de sprite produce high part + overflow en columna siguiente.
 32+  8110              ;     Un sprite de W bytes ocupa W+1 columnas VRAM cuando shifted.
 33+  8110              ;
 34+  8110              ; Usa XOR: dibujar dos veces en la misma posicion = borrar.
 35+  8110              ; ==============================================================================
 36+  8110              DrawSprite:
 37+  8110                  ; Guardar posicion
 38+  8110 7A               LD A, D
 39+  8111 32 93 81         LD (.posY), A
 40+  8114 7B               LD A, E
 41+  8115 32 92 81         LD (.posX), A
 42+  8118
 43+  8118                  ; Leer cabecera sprite
 44+  8118 DD 7E 00         LD A, (IX+0)                ; width_bytes
 45+  811B 32 94 81         LD (.widthSave), A
 46+  811E DD 7E 01         LD A, (IX+1)                ; height_pixels
 47+  8121 32 95 81         LD (.heightSave), A
 48+  8124 DD 23            INC IX
 49+  8126 DD 23            INC IX                      ; IX → pixel data
 50+  8128
 51+  8128                  ; Comprobar alineacion
 52+  8128 7B               LD A, E
 53+  8129 E6 07            AND 7
 54+  812B 20 1E            JR NZ, .shifted
 55+  812D
 56+  812D                  ; ==================================================================
 57+  812D                  ; PATH ALINEADO (X%8 == 0) — sin tablas, XOR directo
 58+  812D                  ; ==================================================================
 59+  812D CD 54 82         CALL CalcPixelAddr          ; D=Y, E=X → HL = dir VRAM
 60+  8130 3A 95 81         LD A, (.heightSave)
 61+  8133 4F               LD C, A                     ; C = height counter
 62+  8134
 63+  8134              .alignedLine:
 64+  8134 3A 94 81         LD A, (.widthSave)
 65+  8137 47               LD B, A                     ; B = ancho en bytes
 66+  8138 E5               PUSH HL                     ; Guardar inicio de linea en VRAM
 67+  8139
 68+  8139              .alignedByte:
 69+  8139 DD 7E 00         LD A, (IX+0)
 70+  813C AE               XOR (HL)
 71+  813D 77               LD (HL), A
 72+  813E 23               INC HL                      ; Siguiente columna VRAM
 73+  813F DD 23            INC IX                      ; Siguiente byte de sprite
 74+  8141 10 F6            DJNZ .alignedByte
 75+  8143
 76+  8143 E1               POP HL                      ; Restaurar inicio de linea
 77+  8144 0D               DEC C
 78+  8145 C8               RET Z                       ; Terminamos todas las lineas
 79+  8146 CD 98 81         CALL NextPixelLine          ; HL = siguiente linea (cruza chars/tercios)
 80+  8149 18 E9            JR .alignedLine
 81+  814B
 82+  814B                  ; ==================================================================
 83+  814B                  ; PATH SHIFTED (X%8 != 0) — tablas de lookup (fiel a Sabre Wulf)
 84+  814B                  ; ==================================================================
 85+  814B                  ; A = shift amount (1-7) al llegar aqui
 86+  814B              .shifted:
 87+  814B                  ; Calcular pagina de tabla (fiel a PrepDraw original)
 88+  814B 3D               DEC A                       ; 0-6
 89+  814C 07               RLCA                        ; ×2 (cada shift usa 2 paginas)
 90+  814D E6 0E            AND $0E
 91+  814F F6 90            OR SHIFT_TABLE_BASE         ; Base de tablas
 92+  8151 32 96 81         LD (.tablePage), A
 93+  8154
 94+  8154                  ; Convertir IX → DE (sprite data), necesitamos BC para tabla
 95+  8154 DD E5            PUSH IX
 96+  8156 D1               POP DE                      ; DE = puntero a pixel data
 97+  8157 D5               PUSH DE                     ; Guardar sprite data ptr en stack
 98+  8158
 99+  8158                  ; Recargar D=Y, E=X para CalcPixelAddr
100+  8158 3A 93 81         LD A, (.posY)
101+  815B 57               LD D, A
102+  815C 3A 92 81         LD A, (.posX)
103+  815F 5F               LD E, A
104+  8160 CD 54 82         CALL CalcPixelAddr          ; HL = dir VRAM
105+  8163
106+  8163 D1               POP DE                      ; DE = sprite data ptr restaurado
107+  8164 3A 96 81         LD A, (.tablePage)
108+  8167 47               LD B, A                     ; B = pagina high part
109+  8168
110+  8168              .shiftedLine:
111+  8168 E5               PUSH HL                     ; Guardar inicio de linea
112+  8169 3A 94 81         LD A, (.widthSave)
113+  816C 32 97 81         LD (.widthCount), A
