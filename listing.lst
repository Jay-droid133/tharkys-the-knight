151+  8198              ; ==============================================================================
152+  8198              ; NextPixelLine - Avanza HL a la siguiente linea de pixel en VRAM
153+  8198              ; ==============================================================================
154+  8198              ; Maneja correctamente los cruces de character row (cada 8 lineas)
155+  8198              ; y los cruces de tercio de pantalla (cada 64 lineas).
156+  8198              ;
157+  8198              ; Entrada/Salida: HL = direccion VRAM (modificada in-place)
158+  8198              ; ==============================================================================
159+  8198              ; Fiel a Sabre Wulf $B8CC: "Screen Address One Pixel Below"
160+  8198              NextPixelLine:
161+  8198 24               INC H                       ; Siguiente scanline dentro del char
162+  8199 7C               LD A, H
163+  819A E6 07            AND 7
164+  819C C0               RET NZ                      ; Sin cruce de char row → listo
165+  819D
166+  819D                  ; --- Cruce de character row ---
167+  819D 7D               LD A, L
168+  819E C6 20            ADD A, 32                   ; Avanzar fila de caracteres (Y5Y4Y3 += 1)
169+  81A0 6F               LD L, A
170+  81A1 E6 E0            AND $E0                     ; ¿Y5Y4Y3 volvio a 000?
171+  81A3 C8               RET Z                       ; Si → cruce de tercio, INC H ya dejo H correcto
172+  81A4
173+  81A4                  ; --- No cruce de tercio: deshacer carry espurio de INC H ---
174+  81A4 7C               LD A, H
175+  81A5 D6 08            SUB 8
176+  81A7 67               LD H, A
177+  81A8 C9               RET
178+  81A9
179+  81A9              ; ==============================================================================
180+  81A9              ; SetEntityAttr - Pone atributo en las celdas del sprite (tamanyo variable)
181+  81A9              ; ==============================================================================
182+  81A9              ; Usa EntityAttrW/H calculados previamente por SaveEntityAttr.
183+  81A9              ; Entrada:
184+  81A9              ;   D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
185+  81A9              ;   A = atributo a pintar
186+  81A9              ; ==============================================================================
187+  81A9              SetEntityAttr:
188+  81A9 F5               PUSH AF                     ; Guardar atributo
189+  81AA CD 39 82         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
190+  81AD F1               POP AF
191+  81AE
192+  81AE 47               LD B, A                     ; B = atributo (preservar)
193+  81AF 3A 38 82         LD A, (EntityAttrH)
194+  81B2 4F               LD C, A                     ; C = filas
195+  81B3              .rowLoop:
196+  81B3 3A 37 82         LD A, (EntityAttrW)
197+  81B6 E5               PUSH HL                     ; Guardar inicio de fila
198+  81B7                  ; Pintar una fila
199+  81B7              .colLoop:
200+  81B7 70               LD (HL), B
201+  81B8 23               INC HL
202+  81B9 3D               DEC A
203+  81BA 20 FB            JR NZ, .colLoop
204+  81BC E1               POP HL
205+  81BD                  ; Siguiente fila: HL += 32
206+  81BD D5               PUSH DE
207+  81BE 11 20 00         LD DE, 32
208+  81C1 19               ADD HL, DE
209+  81C2 D1               POP DE
210+  81C3 0D               DEC C
211+  81C4 20 ED            JR NZ, .rowLoop
212+  81C6 C9               RET
213+  81C7
214+  81C7              ; ==============================================================================
215+  81C7              ; SaveEntityAttr - Guarda atributos VRAM bajo un sprite de tamanyo variable
216+  81C7              ; ==============================================================================
217+  81C7              ; Lee width_chars × height_chars atributos y los guarda en EntitySavedAttr.
218+  81C7              ; Se llama ANTES de pintar el sprite.
219+  81C7              ;
220+  81C7              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
221+  81C7              ;          IX = puntero al sprite (para leer width/height)
222+  81C7              ; ==============================================================================
223+  81C7              SaveEntityAttr:
224+  81C7                  ; Calcular width_chars = sprite_width + (X%8 != 0 ? 1 : 0)
225+  81C7 DD 7E 00         LD A, (IX+0)                ; width_bytes
226+  81CA 47               LD B, A
227+  81CB 7B               LD A, E                     ; X pixel (raw)
228+  81CC E6 07            AND 7
229+  81CE 28 01            JR Z, .noExtraW
230+  81D0 04               INC B                       ; +1 columna si no alineado
231+  81D1              .noExtraW:
232+  81D1 78               LD A, B
233+  81D2 32 37 82         LD (EntityAttrW), A
234+  81D5
235+  81D5                  ; Calcular height_chars = (Y%8 + height + 7) / 8
236+  81D5 7A               LD A, D                     ; Y pixel (raw)
237+  81D6 E6 07            AND 7                       ; Y offset dentro del char
238+  81D8 4F               LD C, A
239+  81D9 DD 7E 01         LD A, (IX+1)                ; height_pixels
240+  81DC 81               ADD A, C                    ; + Y offset
241+  81DD C6 07            ADD A, 7
242+  81DF 0F               RRCA
243+  81E0 0F               RRCA
244+  81E1 0F               RRCA
245+  81E2 E6 1F            AND $1F                     ; / 8 = height_chars
246+  81E4 32 38 82         LD (EntityAttrH), A
247+  81E7
248+  81E7 CD 39 82         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
249+  81EA 11 27 82         LD DE, EntitySavedAttr      ; DE = buffer destino
250+  81ED
251+  81ED 3A 38 82         LD A, (EntityAttrH)
252+  81F0 4F               LD C, A                     ; C = filas
253+  81F1              .saveRow:
254+  81F1 3A 37 82         LD A, (EntityAttrW)
255+  81F4 47               LD B, A                     ; B = columnas
256+  81F5 E5               PUSH HL                     ; Guardar inicio de fila
257+  81F6              .saveCol:
258+  81F6 7E               LD A, (HL)
259+  81F7 12               LD (DE), A
260+  81F8 23               INC HL
261+  81F9 13               INC DE
262+  81FA 10 FA            DJNZ .saveCol
263+  81FC E1               POP HL
264+  81FD                  ; Siguiente fila attr: HL += 32
265+  81FD D5               PUSH DE
266+  81FE 11 20 00         LD DE, 32
267+  8201 19               ADD HL, DE
268+  8202 D1               POP DE
269+  8203 0D               DEC C
270+  8204 20 EB            JR NZ, .saveRow
271+  8206 C9               RET
272+  8207
273+  8207              ; ==============================================================================
274+  8207              ; RestoreEntityAttr - Restaura atributos guardados a VRAM
275+  8207              ; ==============================================================================
276+  8207              ; Escribe los valores de EntitySavedAttr de vuelta a VRAM.
277+  8207              ; Usa EntityAttrW/H guardados por SaveEntityAttr.
278+  8207              ;
279+  8207              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
280+  8207              ; ==============================================================================
281+  8207              RestoreEntityAttr:
282+  8207 CD 39 82         CALL CalcAttrAddr           ; HL = dir atributo celda (0,0)
283+  820A 11 27 82         LD DE, EntitySavedAttr      ; DE = buffer fuente
284+  820D
285+  820D 3A 38 82         LD A, (EntityAttrH)
286+  8210 4F               LD C, A
287+  8211              .restRow:
288+  8211 3A 37 82         LD A, (EntityAttrW)
289+  8214 47               LD B, A
290+  8215 E5               PUSH HL
291+  8216              .restCol:
292+  8216 1A               LD A, (DE)
293+  8217 77               LD (HL), A
294+  8218 23               INC HL
295+  8219 13               INC DE
296+  821A 10 FA            DJNZ .restCol
297+  821C E1               POP HL
298+  821D D5               PUSH DE
299+  821E 11 20 00         LD DE, 32
300+  8221 19               ADD HL, DE
301+  8222 D1               POP DE
302+  8223 0D               DEC C
303+  8224 20 EB            JR NZ, .restRow
304+  8226 C9               RET
305+  8227
306+  8227              ; --- Buffer de atributos guardados (max 4×4 = 16 bytes, shifted + Y offset) ---
307+  8227 00 00 00...  EntitySavedAttr:    DEFS 16
308+  8237 00           EntityAttrW:        DEFB 0      ; width_chars del sprite actual
309+  8238 00           EntityAttrH:        DEFB 0      ; height_chars del sprite actual
