179+  83B5                  ; XOR draw para borrar (mismo sprite, misma posicion = borra)
180+  83B5 CD FC 83         CALL GetSpriteAddr          ; IX_sprite en (SpriteAddrTemp)
181+  83B8 DD 56 04         LD D, (IX+ENT_POSY)
182+  83BB DD 5E 03         LD E, (IX+ENT_POSX)
