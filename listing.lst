  1+  859C              ; ==============================================================================
  2+  859C              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
  3+  859C              ; ==============================================================================
  4+  859C              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
  5+  859C              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
  6+  859C              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
  7+  859C              ; ==============================================================================
  8+  859C
  9+  859C              ; ==============================================================================
 10+  859C              ; InitScreenSystem - Inicializa el sistema de pantallas
 11+  859C              ; ==============================================================================
 12+  859C              InitScreenSystem:
 13+  859C 3E 08            LD A, START_SCREEN_X
 14+  859E 32 05 81         LD (CurrentScreenX), A
 15+  85A1 3E 08            LD A, START_SCREEN_Y
 16+  85A3 32 06 81         LD (CurrentScreenY), A
 17+  85A6 3E 01            LD A, 1
 18+  85A8 32 0A 81         LD (ScreenDirty), A         ; Forzar dibujado inicial
 19+  85AB AF               XOR A
 20+  85AC 32 09 81         LD (ScreenTransition), A
 21+  85AF CD B3 85         CALL CalcScreenAddress
 22+  85B2 C9               RET
 23+  85B3
 24+  85B3              ; ==============================================================================
 25+  85B3              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
 26+  85B3              ; ==============================================================================
 27+  85B3              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
 28+  85B3              ; ==============================================================================
 29+  85B3              CalcScreenAddress:
 30+  85B3 3A 06 81         LD A, (CurrentScreenY)
 31+  85B6 6F               LD L, A
 32+  85B7 26 00            LD H, 0
 33+  85B9 29               ADD HL, HL                  ; x2
 34+  85BA 29               ADD HL, HL                  ; x4
 35+  85BB 29               ADD HL, HL                  ; x8
 36+  85BC 29               ADD HL, HL                  ; x16
 37+  85BD 3A 05 81         LD A, (CurrentScreenX)
 38+  85C0 5F               LD E, A
 39+  85C1 16 00            LD D, 0
 40+  85C3 19               ADD HL, DE                  ; HL = Y*16 + X
 41+  85C4 11 5E 88         LD DE, MapTable
 42+  85C7 19               ADD HL, DE                  ; HL = &MapTable[index]
 43+  85C8 7E               LD A, (HL)                  ; A = room index (0-47)
 44+  85C9                  ; Lookup en RoomTable (tabla de DEFWs)
 45+  85C9 6F               LD L, A
 46+  85CA 26 00            LD H, 0
 47+  85CC 29               ADD HL, HL                  ; index * 2
 48+  85CD 11 FE 87         LD DE, RoomTable
 49+  85D0 19               ADD HL, DE
 50+  85D1 5E               LD E, (HL)
 51+  85D2 23               INC HL
 52+  85D3 56               LD D, (HL)                  ; DE = puntero a room data
 53+  85D4 ED 53 07 81      LD (CurrentScreenAddr), DE
 54+  85D8 C9               RET
 55+  85D9
 56+  85D9              ; ==============================================================================
 57+  85D9              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
 58+  85D9              ; ==============================================================================
 59+  85D9              CheckScreenTransition:
 60+  85D9 AF               XOR A
 61+  85DA 32 09 81         LD (ScreenTransition), A
 62+  85DD
 63+  85DD                  ; --- Comprobar borde OESTE (izquierdo) ---
 64+  85DD 3A 3A 80         LD A, (EntityTable + ENT_POSX)
 65+  85E0 FE 04            CP TRANSITION_ZONE
 66+  85E2 30 16            JR NC, .noWest
 67+  85E4 3A 05 81         LD A, (CurrentScreenX)
 68+  85E7 B7               OR A
 69+  85E8 28 10            JR Z, .noWest
 70+  85EA 3D               DEC A
 71+  85EB 32 05 81         LD (CurrentScreenX), A
 72+  85EE 3E 08            LD A, DIR_W
 73+  85F0 32 09 81         LD (ScreenTransition), A
 74+  85F3 3E E0            LD A, SCREEN_MAX_X - 8
 75+  85F5 32 3A 80         LD (EntityTable + ENT_POSX), A
 76+  85F8 18 57            JR .doTransition
 77+  85FA
 78+  85FA              .noWest:
 79+  85FA                  ; --- Comprobar borde ESTE (derecho) ---
 80+  85FA 3A 3A 80         LD A, (EntityTable + ENT_POSX)
 81+  85FD FE E8            CP SCREEN_MAX_X
 82+  85FF 38 17            JR C, .noEast
 83+  8601 3A 05 81         LD A, (CurrentScreenX)
 84+  8604 FE 0F            CP MAP_WIDTH - 1
 85+  8606 28 10            JR Z, .noEast
 86+  8608 3C               INC A
 87+  8609 32 05 81         LD (CurrentScreenX), A
 88+  860C 3E 04            LD A, DIR_E
 89+  860E 32 09 81         LD (ScreenTransition), A
 90+  8611 3E 05            LD A, TRANSITION_ZONE + 1
 91+  8613 32 3A 80         LD (EntityTable + ENT_POSX), A
 92+  8616 18 39            JR .doTransition
 93+  8618
 94+  8618              .noEast:
 95+  8618                  ; --- Comprobar borde NORTE (superior) ---
 96+  8618 3A 3B 80         LD A, (EntityTable + ENT_POSY)
 97+  861B FE 04            CP TRANSITION_ZONE
 98+  861D 30 16            JR NC, .noNorth
 99+  861F 3A 06 81         LD A, (CurrentScreenY)
100+  8622 B7               OR A
101+  8623 28 10            JR Z, .noNorth
102+  8625 3D               DEC A
103+  8626 32 06 81         LD (CurrentScreenY), A
104+  8629 3E 01            LD A, DIR_N
105+  862B 32 09 81         LD (ScreenTransition), A
106+  862E 3E 98            LD A, SCREEN_MAX_Y - 8
107+  8630 32 3B 80         LD (EntityTable + ENT_POSY), A
108+  8633 18 1C            JR .doTransition
109+  8635
110+  8635              .noNorth:
111+  8635                  ; --- Comprobar borde SUR (inferior) ---
112+  8635 3A 3B 80         LD A, (EntityTable + ENT_POSY)
113+  8638 FE A0            CP SCREEN_MAX_Y
114+  863A 38 20            JR C, .noSouth
115+  863C 3A 06 81         LD A, (CurrentScreenY)
116+  863F FE 0F            CP MAP_HEIGHT - 1
117+  8641 28 19            JR Z, .noSouth
118+  8643 3C               INC A
119+  8644 32 06 81         LD (CurrentScreenY), A
120+  8647 3E 02            LD A, DIR_S
121+  8649 32 09 81         LD (ScreenTransition), A
122+  864C 3E 05            LD A, TRANSITION_ZONE + 1
123+  864E 32 3B 80         LD (EntityTable + ENT_POSY), A
124+  8651
125+  8651              .doTransition:
126+  8651 CD B3 85         CALL CalcScreenAddress
127+  8654 3E 01            LD A, 1
128+  8656 32 0A 81         LD (ScreenDirty), A
129+  8659 32 0B 81         LD (ScreenJustRedrawn), A
130+  865C              .noSouth:
131+  865C C9               RET
132+  865D
133+  865D              ; ==============================================================================
134+  865D              ; DrawScreen - Dibuja la pantalla actual iterando sprites de fondo
135+  865D              ; ==============================================================================
136+  865D              ; Itera la lista de sprites del room y pinta rectangulos de atributos.
137+  865D              ; Solo se ejecuta cuando ScreenDirty=1 (cambio de pantalla).
138+  865D              ; ==============================================================================
139+  865D              DrawScreen:
140+  865D 3A 0A 81         LD A, (ScreenDirty)
141+  8660 B7               OR A
142+  8661 C8               RET Z
143+  8662
144+  8662                  ; --- Limpiar pixeles ---
145+  8662 21 00 40         LD HL, SCREEN_BASE
146+  8665 11 01 40         LD DE, SCREEN_BASE + 1
147+  8668 01 FF 17         LD BC, 6143
148+  866B AF               XOR A
149+  866C 77               LD (HL), A
150+  866D ED B0            LDIR
151+  866F
152+  866F                  ; --- Limpiar TODOS los atributos a negro ---
153+  866F 21 00 58         LD HL, ATTR_BASE
154+  8672 11 01 58         LD DE, ATTR_BASE + 1
155+  8675 01 FF 02         LD BC, ATTR_SIZE - 1
156+  8678 AF               XOR A
157+  8679 77               LD (HL), A
158+  867A ED B0            LDIR
159+  867C
160+  867C                  ; --- Iterar sprites del room y pintar atributos ---
161+  867C 2A 07 81         LD HL, (CurrentScreenAddr)
162+  867F              .sprLoop:
163+  867F                  ; Leer DEFW sprite_ptr
164+  867F 5E               LD E, (HL)
165+  8680 23               INC HL
166+  8681 56               LD D, (HL)
167+  8682 23               INC HL
168+  8683                  ; Terminador?
169+  8683 7A               LD A, D
170+  8684 B3               OR E
171+  8685 28 11            JR Z, .drawDone
172+  8687                  ; Leer posicion
173+  8687 46               LD B, (HL)                  ; B = x_char
174+  8688 23               INC HL
175+  8689 4E               LD C, (HL)                  ; C = y_char
176+  868A 23               INC HL
177+  868B E5               PUSH HL                     ; Guardar puntero a siguiente entrada
178+  868C                  ; Leer definicion del sprite desde DE
179+  868C EB               EX DE, HL                   ; HL = sprite def
180+  868D 56               LD D, (HL)                  ; D = width_chars
181+  868E 23               INC HL
182+  868F 5E               LD E, (HL)                  ; E = height_chars
183+  8690 23               INC HL
184+  8691 7E               LD A, (HL)                  ; A = attr
185+  8692                  ; Pintar rectangulo de atributos
186+  8692 CD A2 86         CALL DrawRoomSprite
187+  8695 E1               POP HL                      ; Restaurar puntero room data
188+  8696 18 E7            JR .sprLoop
189+  8698
190+  8698              .drawDone:
191+  8698 AF               XOR A
192+  8699 32 0A 81         LD (ScreenDirty), A
193+  869C 3E 01            LD A, 1
194+  869E 32 0B 81         LD (ScreenJustRedrawn), A   ; Entities deben saltar erase tras redibujar
195+  86A1 C9               RET
196+  86A2
197+  86A2              ; ==============================================================================
198+  86A2              ; DrawRoomSprite - Pinta un rectangulo de atributos en VRAM
199+  86A2              ; ==============================================================================
200+  86A2              ; Entrada: B=x_char, C=y_char, D=width, E=height, A=attr
201+  86A2              ; ==============================================================================
202+  86A2              DrawRoomSprite:
203+  86A2 F5               PUSH AF                     ; Guardar atributo
204+  86A3                  ; Calcular dir VRAM: ATTR_BASE + y*32 + x
205+  86A3 79               LD A, C
206+  86A4 6F               LD L, A
207+  86A5 26 00            LD H, 0
208+  86A7 29               ADD HL, HL
209+  86A8 29               ADD HL, HL
210+  86A9 29               ADD HL, HL
211+  86AA 29               ADD HL, HL
212+  86AB 29               ADD HL, HL                  ; HL = y * 32
213+  86AC 78               LD A, B
214+  86AD 85               ADD A, L
215+  86AE 6F               LD L, A
216+  86AF 30 01            JR NC, .noCarry
217+  86B1 24               INC H
218+  86B2              .noCarry:
219+  86B2 01 00 58         LD BC, ATTR_BASE
220+  86B5 09               ADD HL, BC                  ; HL = dir atributo VRAM
221+  86B6 F1               POP AF                      ; A = attr
222+  86B7                  ; Pintar E filas de D columnas
223+  86B7              .rowLoop:
224+  86B7 42               LD B, D                     ; B = ancho (contador columnas)
225+  86B8 E5               PUSH HL                     ; Guardar inicio de fila
226+  86B9              .colLoop:
227+  86B9 77               LD (HL), A
228+  86BA 23               INC HL
229+  86BB 10 FC            DJNZ .colLoop
230+  86BD E1               POP HL                      ; Restaurar inicio de fila
231+  86BE                  ; Siguiente fila: +32
232+  86BE D5               PUSH DE
233+  86BF 11 20 00         LD DE, 32
234+  86C2 19               ADD HL, DE
235+  86C3 D1               POP DE
236+  86C4 1D               DEC E
237+  86C5 20 F0            JR NZ, .rowLoop
238+  86C7 C9               RET
239+  86C8
240+  86C8              ; ==============================================================================
241+  86C8              ; IsPointBlocked - Comprueba si un punto pixel esta bloqueado por un sprite solido
242+  86C8              ; ==============================================================================
243+  86C8              ; Estilo Sabre Wulf (rutina B873): itera la lista de sprites del room,
244+  86C8              ; comprueba si el punto cae dentro del bounding box de algun sprite solido.
245+  86C8              ;
246+  86C8              ; Entrada: B = X pixel, C = Y pixel
247+  86C8              ; Salida: Z = libre, NZ = bloqueado
248+  86C8              ; Preserva: BC (punto), DE (para el caller)
249+  86C8              ; ==============================================================================
250+  86C8              IsPointBlocked:
251+  86C8 D5               PUSH DE
252+  86C9 2A 07 81         LD HL, (CurrentScreenAddr)
253+  86CC              .loop:
254+  86CC                  ; Leer DEFW sprite_ptr
255+  86CC 5E               LD E, (HL)
256+  86CD 23               INC HL
257+  86CE 56               LD D, (HL)
258+  86CF 23               INC HL
259+  86D0                  ; Terminador?
260+  86D0 7A               LD A, D
261+  86D1 B3               OR E
262+  86D2 28 55            JR Z, .free
263+  86D4                  ; Leer posicion
264+  86D4 7E               LD A, (HL)
265+  86D5 23               INC HL
266+  86D6 32 2C 87         LD (.sprX), A
267+  86D9 7E               LD A, (HL)
268+  86DA 23               INC HL
269+  86DB 32 2D 87         LD (.sprY), A
270+  86DE E5               PUSH HL                     ; Guardar puntero a siguiente entrada
271+  86DF                  ; Cargar definicion del sprite desde DE
272+  86DF EB               EX DE, HL
273+  86E0 7E               LD A, (HL)                  ; width_chars
274+  86E1 32 2E 87         LD (.sprW), A
275+  86E4 23               INC HL
276+  86E5 7E               LD A, (HL)                  ; height_chars
277+  86E6 32 2F 87         LD (.sprH), A
278+  86E9 23               INC HL
279+  86EA 23               INC HL                      ; saltar attr
280+  86EB 7E               LD A, (HL)                  ; flags
281+  86EC CB 47            BIT 0, A
282+  86EE 28 36            JR Z, .skip                 ; No es solido, siguiente
283+  86F0
284+  86F0                  ; === Comprobar X ===
285+  86F0                  ; charCol = B / 8, comprobar sprX <= charCol < sprX + sprW
286+  86F0 78               LD A, B
287+  86F1 0F               RRCA
288+  86F2 0F               RRCA
289+  86F3 0F               RRCA
290+  86F4 E6 1F            AND $1F                     ; A = charCol
291+  86F6 57               LD D, A                     ; D = charCol
292+  86F7 3A 2C 87         LD A, (.sprX)
293+  86FA 5F               LD E, A                     ; E = sprX
294+  86FB 7A               LD A, D                     ; A = charCol
295+  86FC 93               SUB E                       ; A = charCol - sprX (carry si charCol < sprX)
296+  86FD 38 27            JR C, .skip                 ; Fuera por la izquierda
297+  86FF                  ; A = offset horizontal dentro del sprite
298+  86FF 5F               LD E, A                     ; E = offset
299+  8700 3A 2E 87         LD A, (.sprW)
300+  8703 BB               CP E                        ; sprW - offset
301+  8704 28 20            JR Z, .skip                 ; En el borde derecho = fuera
302+  8706 38 1E            JR C, .skip                 ; offset > sprW = fuera
303+  8708
304+  8708                  ; === Comprobar Y ===
305+  8708                  ; charRow = C / 8, comprobar sprY <= charRow < sprY + sprH
306+  8708 79               LD A, C
307+  8709 0F               RRCA
308+  870A 0F               RRCA
309+  870B 0F               RRCA
310+  870C E6 1F            AND $1F                     ; A = charRow
311+  870E 57               LD D, A                     ; D = charRow
312+  870F 3A 2D 87         LD A, (.sprY)
313+  8712 5F               LD E, A
314+  8713 7A               LD A, D
315+  8714 93               SUB E                       ; A = charRow - sprY
316+  8715 38 0F            JR C, .skip                 ; Fuera por arriba
317+  8717 5F               LD E, A
318+  8718 3A 2F 87         LD A, (.sprH)
319+  871B BB               CP E
320+  871C 28 08            JR Z, .skip                 ; En el borde inferior = fuera
321+  871E 38 06            JR C, .skip                 ; offset > sprH = fuera
322+  8720
323+  8720                  ; Punto dentro de sprite solido!
324+  8720 E1               POP HL
325+  8721 3E 01            LD A, 1
326+  8723 B7               OR A                        ; NZ = bloqueado
327+  8724 D1               POP DE
328+  8725 C9               RET
329+  8726
330+  8726              .skip:
331+  8726 E1               POP HL
332+  8727 18 A3            JR .loop
333+  8729
334+  8729              .free:
335+  8729 AF               XOR A                       ; Z = libre
336+  872A D1               POP DE
337+  872B C9               RET
338+  872C
339+  872C              ; Variables temporales para IsPointBlocked
340+  872C 00           .sprX: DEFB 0
341+  872D 00           .sprY: DEFB 0
342+  872E 00           .sprW: DEFB 0
343+  872F 00           .sprH: DEFB 0
