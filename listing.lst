 99+  8338                  ; Configurar slot 0: Player
100+  8338 DD 21 37 80      LD IX, EntityTable
101+  833C DD 36 00 00      LD (IX+ENT_SPRITEID), SPRID_IDLE    ; Frame idle 0
102+  8340 DD 36 01 01      LD (IX+ENT_TYPE), TYPE_PLAYER
103+  8344 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
104+  8348 DD 36 03 78      LD (IX+ENT_POSX), START_PLAYER_X
105+  834C DD 36 04 58      LD (IX+ENT_POSY), START_PLAYER_Y
