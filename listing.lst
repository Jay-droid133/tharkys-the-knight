 62   8BE6                  INCLUDE "shift_tables.asm"
# file opened: c:/NUEVO_JUEGO/code/shift_tables.asm
  1+  8BE6              ; ==============================================================================
  2+  8BE6              ; TABLAS DE SHIFT PRE-COMPUTADAS (fiel a Sabre Wulf $F000-$FFFF)
  3+  8BE6              ; ==============================================================================
  4+  8BE6              ; 7 pares de 256 bytes = 3584 bytes (shifts 1-7).
  5+  8BE6              ; Para cada shift S:
  6+  8BE6              ;   Pagina par:  table[byte] = byte >> S  (high part, queda en columna actual)
  7+  8BE6              ;   Pagina impar: table[byte] = byte << (8-S) (overflow, pasa a siguiente columna)
  8+  8BE6              ;
  9+  8BE6              ; Shift 0 (alineado) no necesita tabla — se usa el path directo.
 10+  8BE6              ;
 11+  8BE6              ; Uso: B = pagina de tabla, C = byte de sprite, LD A,(BC) = resultado instantaneo.
 12+  8BE6              ;   INC B → pagina overflow. DEC B → restaurar.
 13+  8BE6              ;
 14+  8BE6              ; Calculo de B desde X%8:
 15+  8BE6              ;   LD A, X_pixel / AND 7 / DEC A / RLCA / AND $0E / OR SHIFT_TABLE_BASE
 16+  8BE6              ; ==============================================================================
 17+  8BE6
 18+  8BE6 00 00 00...      ALIGN 4096
 19+  9000              ShiftTables:
 20+  9000                  LUA ALLPASS
 21+  9000 ~                for shift = 1, 7 do
 22+  9000 ~                    -- High part: byte >> shift
 23+  9000 ~                    for i = 0, 255 do
 24+  9000 ~                        sj.add_byte(math.floor(i / (2^shift)))
 25+  9000 ~                    end
 26+  9000 ~                    -- Overflow: byte << (8-shift), modulo 256
 27+  9000 ~                    for i = 0, 255 do
 28+  9000 ~                        sj.add_byte(math.floor((i * (2^(8-shift))) % 256))
 29+  9000 ~                    end
 30+  9000 ~                end
 31+  9000 00 00 01 01      ENDLUA
 31+  9004 02 02 03 03
