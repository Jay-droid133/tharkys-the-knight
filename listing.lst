311+  8239              ; ==============================================================================
312+  8239              ; CalcAttrAddr - Calcula direccion de atributo para coordenadas alineadas a 8px
313+  8239              ; ==============================================================================
314+  8239              ; Entrada: D = Y pixel (alineado 8px), E = X pixel (alineado 8px)
315+  8239              ; Salida: HL = direccion en zona de atributos ($5800+)
316+  8239              ; ==============================================================================
317+  8239              CalcAttrAddr:
318+  8239 7A               LD A, D
319+  823A 0F               RRCA
320+  823B 0F               RRCA
321+  823C 0F               RRCA
322+  823D E6 1F            AND $1F                     ; Y / 8 = fila de atributo
323+  823F 6F               LD L, A
324+  8240 26 00            LD H, 0
325+  8242 29               ADD HL, HL
326+  8243 29               ADD HL, HL
327+  8244 29               ADD HL, HL
328+  8245 29               ADD HL, HL
329+  8246 29               ADD HL, HL                  ; HL = fila * 32
330+  8247 7B               LD A, E
331+  8248 0F               RRCA
332+  8249 0F               RRCA
333+  824A 0F               RRCA
334+  824B E6 1F            AND $1F                     ; X / 8 = columna
335+  824D B5               OR L
336+  824E 6F               LD L, A
337+  824F 01 00 58         LD BC, ATTR_BASE
338+  8252 09               ADD HL, BC                  ; HL = ATTR_BASE + fila*32 + col
339+  8253 C9               RET
340+  8254
341+  8254              ; ==============================================================================
342+  8254              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
343+  8254              ; ==============================================================================
344+  8254              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
345+  8254              ; Salida: HL=direccion en VRAM
346+  8254              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
347+  8254              ; ==============================================================================
348+  8254              CalcPixelAddr:
349+  8254 7A               LD A, D
350+  8255 E6 C0            AND $C0                     ; Y7 Y6
351+  8257 1F               RRA
352+  8258 1F               RRA
353+  8259 1F               RRA                         ; >> 3
354+  825A F6 40            OR $40                      ; + SCREEN_BASE ($4000)
355+  825C 67               LD H, A
356+  825D
357+  825D 7A               LD A, D
358+  825E E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
359+  8260 B4               OR H
360+  8261 67               LD H, A
361+  8262
362+  8262 7A               LD A, D
363+  8263 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
364+  8265 87               ADD A, A
365+  8266 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
366+  8267 6F               LD L, A
367+  8268
368+  8268 7B               LD A, E
369+  8269 1F               RRA
370+  826A 1F               RRA
371+  826B 1F               RRA
372+  826C E6 1F            AND $1F                     ; X / 8 = columna
373+  826E B5               OR L
374+  826F 6F               LD L, A
375+  8270 C9               RET
376+  8271
