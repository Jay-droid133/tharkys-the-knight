115+  816F              .shiftedByte:
116+  816F                  ; === Inner loop fiel al original ($BA0D) ===
117+  816F 1A               LD A, (DE)                  ; Leer byte de sprite
118+  8170 4F               LD C, A                     ; C = byte value (indice en tabla)
119+  8171 0A               LD A, (BC)                  ; A = byte >> shift (high part)
120+  8172 AE               XOR (HL)                    ; XOR con VRAM
121+  8173 77               LD (HL), A                  ; Escribir
122+  8174 2C               INC L                       ; Siguiente columna VRAM
123+  8175 04               INC B                       ; Pagina overflow
124+  8176 0A               LD A, (BC)                  ; A = byte << (8-shift) (overflow)
125+  8177 AE               XOR (HL)                    ; XOR con VRAM
126+  8178 77               LD (HL), A                  ; Escribir
127+  8179 05               DEC B                       ; Restaurar pagina high
128+  817A 13               INC DE                      ; Siguiente byte de sprite
129+  817B                  ; Siguiente byte de ancho
130+  817B 3A 97 81         LD A, (.widthCount)
131+  817E 3D               DEC A
132+  817F 32 97 81         LD (.widthCount), A
133+  8182 20 EB            JR NZ, .shiftedByte
134+  8184
135+  8184 E1               POP HL                      ; Restaurar inicio de linea
136+  8185 3A 95 81         LD A, (.heightSave)
137+  8188 3D               DEC A
138+  8189 32 95 81         LD (.heightSave), A
139+  818C C8               RET Z                       ; Terminamos todas las lineas
140+  818D CD 98 81         CALL NextPixelLine          ; HL = siguiente linea
141+  8190 18 D6            JR .shiftedLine
