111+  8364 DD 36 0A 40      LD (IX+ENT_DIR), DIR_E << 4         ; lastHDir=E, dir=none
112+  8368 DD 36 0B 01      LD (IX+ENT_FLAGS), 1 << ENTF_VISIBLE
113+  836C C9               RET
