143+  8192              ; Variables locales de DrawSprite
144+  8192 00           .posX:       DEFB 0
145+  8193 00           .posY:       DEFB 0
146+  8194 00           .widthSave:  DEFB 0
147+  8195 00           .heightSave: DEFB 0
148+  8196 00           .tablePage:  DEFB 0
149+  8197 00           .widthCount: DEFB 0
