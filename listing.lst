403+  84F8              ; ==============================================================================
404+  84F8              ; CheckEntityCollision - Colision de la entidad contra sprites de fondo
405+  84F8              ; ==============================================================================
406+  84F8              ; Comprueba 3 puntos del bounding box (como el original).
407+  84F8              ; IX = entidad. Salida: Z=libre, NZ=colision.
408+  84F8              ; ==============================================================================
409+  84F8              CheckEntityCollision:
410+  84F8                  ; Punto 1: centro-arriba (X+8, Y+2)
411+  84F8 DD 7E 03         LD A, (IX+ENT_POSX)
412+  84FB C6 08            ADD A, 8
413+  84FD 47               LD B, A
414+  84FE DD 7E 04         LD A, (IX+ENT_POSY)
415+  8501 C6 02            ADD A, 2
416+  8503 4F               LD C, A
417+  8504 CD C8 86         CALL IsPointBlocked
418+  8507 C0               RET NZ
419+  8508
420+  8508                  ; Punto 2: centro-abajo (X+8, Y+13)
421+  8508 DD 7E 03         LD A, (IX+ENT_POSX)
422+  850B C6 08            ADD A, 8
423+  850D 47               LD B, A
424+  850E DD 7E 04         LD A, (IX+ENT_POSY)
425+  8511 C6 0D            ADD A, 13
426+  8513 4F               LD C, A
427+  8514 CD C8 86         CALL IsPointBlocked
428+  8517 C0               RET NZ
429+  8518
430+  8518                  ; Punto 3: centro-centro (X+8, Y+8)
431+  8518 DD 7E 03         LD A, (IX+ENT_POSX)
432+  851B C6 08            ADD A, 8
433+  851D 47               LD B, A
434+  851E DD 7E 04         LD A, (IX+ENT_POSY)
435+  8521 C6 08            ADD A, 8
436+  8523 4F               LD C, A
437+  8524 CD C8 86         CALL IsPointBlocked
438+  8527 C9               RET                         ; Z/NZ del ultimo check
439+  8528
440+  8528              ; ==============================================================================
441+  8528              ; UpdatePlayerAnimation - Animacion por SpriteID
442+  8528              ; ==============================================================================
443+  8528              ; Determina el AnimBase segun estado+dir, avanza frame si timer expira.
444+  8528              ; ==============================================================================
445+  8528              UpdatePlayerAnimation:
446+  8528                  ; Determinar animacion segun estado y direccion
447+  8528 DD 7E 02         LD A, (IX+ENT_STATE)
448+  852B FE 02            CP STATE_FIGHTING
449+  852D 28 0C            JR Z, .animFight
450+  852F FE 01            CP STATE_RUNNING
451+  8531 28 21            JR Z, .animRun
452+  8533
453+  8533                  ; --- IDLE ---
454+  8533 16 00            LD D, SPRID_IDLE
455+  8535 1E 02            LD E, ANIM_FRAMES_IDLE
456+  8537 0E 08            LD C, ANIM_DELAY_IDLE
457+  8539 18 3C            JR .applyAnim
458+  853B
459+  853B              .animFight:
460+  853B                  ; Pelear usa lastHDir (bits 4-7 de ENT_DIR)
461+  853B DD 7E 0A         LD A, (IX+ENT_DIR)
462+  853E 0F               RRCA
463+  853F 0F               RRCA
464+  8540 0F               RRCA
465+  8541 0F               RRCA
466+  8542 E6 0F            AND $0F                     ; lastHDir
467+  8544 FE 08            CP DIR_W
468+  8546 28 04            JR Z, .fightW
469+  8548 16 0E            LD D, SPRID_FIGHT_E
470+  854A 18 02            JR .fightSet
471+  854C              .fightW:
472+  854C 16 10            LD D, SPRID_FIGHT_W
473+  854E              .fightSet:
474+  854E 1E 02            LD E, ANIM_FRAMES_FIGHT
475+  8550 0E 03            LD C, ANIM_DELAY_FIGHT
476+  8552 18 23            JR .applyAnim
477+  8554
478+  8554              .animRun:
479+  8554 DD 7E 0A         LD A, (IX+ENT_DIR)
480+  8557 E6 0F            AND $0F                     ; dir actual
481+  8559                  ; Prioridad: E/W sobre N/S
482+  8559 CB 57            BIT 2, A
483+  855B 20 0C            JR NZ, .runE
484+  855D CB 5F            BIT 3, A
485+  855F 20 0C            JR NZ, .runW
486+  8561 CB 47            BIT 0, A
487+  8563 20 0C            JR NZ, .runN
488+  8565 16 0B            LD D, SPRID_WALK_S
489+  8567 18 0A            JR .runSet
490+  8569              .runE:
491+  8569 16 02            LD D, SPRID_WALK_E
492+  856B 18 06            JR .runSet
493+  856D              .runW:
494+  856D 16 05            LD D, SPRID_WALK_W
495+  856F 18 02            JR .runSet
496+  8571              .runN:
497+  8571 16 08            LD D, SPRID_WALK_N
498+  8573              .runSet:
499+  8573 1E 03            LD E, ANIM_FRAMES_WALK
500+  8575 0E 04            LD C, ANIM_DELAY_RUN
501+  8577
502+  8577              .applyAnim:
503+  8577                  ; D = nuevo AnimBase, E = num frames, C = delay
504+  8577                  ; ¿Cambio de animacion?
505+  8577 DD 7E 08         LD A, (IX+ENT_ANIMBASE)
506+  857A BA               CP D
507+  857B 28 0A            JR Z, .sameAnim
508+  857D
509+  857D                  ; Nueva animacion → reiniciar
510+  857D DD 72 08         LD (IX+ENT_ANIMBASE), D
511+  8580 DD 72 00         LD (IX+ENT_SPRITEID), D     ; Reset al primer frame
512+  8583 DD 71 09         LD (IX+ENT_ANIMTIMER), C
513+  8586 C9               RET
514+  8587
515+  8587              .sameAnim:
516+  8587                  ; Decrementar timer
517+  8587 DD 35 09         DEC (IX+ENT_ANIMTIMER)
518+  858A C0               RET NZ
519+  858B
520+  858B                  ; Timer expirado → avanzar frame
521+  858B DD 71 09         LD (IX+ENT_ANIMTIMER), C    ; Reset timer
522+  858E
523+  858E DD 7E 00         LD A, (IX+ENT_SPRITEID)
524+  8591 3C               INC A
525+  8592                  ; ¿Fuera de rango?
526+  8592 47               LD B, A                     ; B = nuevo SpriteID
527+  8593 92               SUB D                       ; A = frame relativo (nuevo - animBase)
528+  8594 BB               CP E                        ; ¿>= num_frames?
529+  8595 38 01            JR C, .frameOk
530+  8597 42               LD B, D                     ; Reset al AnimBase
531+  8598              .frameOk:
532+  8598 DD 70 00         LD (IX+ENT_SPRITEID), B
533+  859B C9               RET
