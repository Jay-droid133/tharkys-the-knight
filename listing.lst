251+  841B              ; ==============================================================================
252+  841B              ; UpdatePlayerState - Determina estado y direccion desde input
253+  841B              ; ==============================================================================
254+  841B              UpdatePlayerState:
255+  841B 3A 03 81         LD A, (InputDirection)
256+  841E 47               LD B, A
257+  841F 3A 04 81         LD A, (InputFire)
258+  8422 4F               LD C, A
259+  8423
260+  8423                  ; Sin input → idle
261+  8423 78               LD A, B
262+  8424 B1               OR C
263+  8425 20 0D            JR NZ, .notIdle
264+  8427 DD 36 02 00      LD (IX+ENT_STATE), STATE_IDLE
265+  842B                  ; Dir actual = none (bits 0-3), mantener lastHDir (bits 4-7)
266+  842B DD 7E 0A         LD A, (IX+ENT_DIR)
267+  842E E6 F0            AND $F0                     ; Limpiar dir actual, mantener lastHDir
268+  8430 DD 77 0A         LD (IX+ENT_DIR), A
269+  8433 C9               RET
270+  8434
271+  8434              .notIdle:
272+  8434                  ; Guardar direccion actual en bits 0-3
273+  8434 DD 7E 0A         LD A, (IX+ENT_DIR)
274+  8437 E6 F0            AND $F0                     ; Mantener lastHDir
275+  8439 B0               OR B                        ; Añadir dir actual
276+  843A DD 77 0A         LD (IX+ENT_DIR), A
277+  843D
278+  843D                  ; Actualizar lastHDir si hay componente E/W
279+  843D 78               LD A, B
280+  843E E6 0C            AND DIR_E | DIR_W
281+  8440 28 0E            JR Z, .noHorizUpdate
282+  8442                  ; Guardar en bits 4-7
283+  8442 07               RLCA
284+  8443 07               RLCA
285+  8444 07               RLCA
286+  8445 07               RLCA                        ; Shift a bits 4-7
287+  8446 4F               LD C, A                     ; C = lastHDir en bits 4-7
288+  8447 DD 7E 0A         LD A, (IX+ENT_DIR)
289+  844A E6 0F            AND $0F                     ; Mantener dir actual
290+  844C B1               OR C                        ; Añadir lastHDir
291+  844D DD 77 0A         LD (IX+ENT_DIR), A
292+  8450              .noHorizUpdate:
293+  8450
294+  8450                  ; Fighting o running?
295+  8450 3A 04 81         LD A, (InputFire)
296+  8453 B7               OR A
297+  8454 28 05            JR Z, .running
298+  8456 DD 36 02 02      LD (IX+ENT_STATE), STATE_FIGHTING
299+  845A C9               RET
300+  845B
301+  845B              .running:
302+  845B DD 36 02 01      LD (IX+ENT_STATE), STATE_RUNNING
303+  845F C9               RET
304+  8460
305+  8460              ; ==============================================================================
306+  8460              ; UpdatePlayerMovement - Movimiento 8-bit con colision
307+  8460              ; ==============================================================================
308+  8460              UpdatePlayerMovement:
309+  8460 DD 7E 0A         LD A, (IX+ENT_DIR)
310+  8463 E6 0F            AND $0F                     ; Dir actual (bits 0-3)
311+  8465 C8               RET Z                       ; Sin movimiento
312+  8466
313+  8466                  ; Determinar velocidad segun estado
314+  8466 DD 7E 02         LD A, (IX+ENT_STATE)
315+  8469 FE 02            CP STATE_FIGHTING
316+  846B 3E 02            LD A, SPEED_RUN
317+  846D 20 02            JR NZ, .gotSpeed
318+  846F 3E 01            LD A, SPEED_FIGHT
319+  8471              .gotSpeed:
320+  8471 32 F5 84         LD (.speed), A
321+  8474
322+  8474                  ; --- Movimiento horizontal (con colision) ---
323+  8474 DD 7E 03         LD A, (IX+ENT_POSX)
324+  8477 32 F6 84         LD (.savedX), A             ; Guardar X antes de mover
325+  847A
326+  847A DD 7E 0A         LD A, (IX+ENT_DIR)
327+  847D CB 57            BIT 2, A                    ; DIR_E?
328+  847F 28 11            JR Z, .noE
329+  8481 3A F5 84         LD A, (.speed)
330+  8484 47               LD B, A
331+  8485 DD 7E 03         LD A, (IX+ENT_POSX)
332+  8488 80               ADD A, B
333+  8489 FE E8            CP SCREEN_MAX_X
334+  848B 38 02            JR C, .clampE
335+  848D 3E E8            LD A, SCREEN_MAX_X
336+  848F              .clampE:
337+  848F DD 77 03         LD (IX+ENT_POSX), A
338+  8492              .noE:
339+  8492 DD 7E 0A         LD A, (IX+ENT_DIR)
340+  8495 CB 5F            BIT 3, A                    ; DIR_W?
341+  8497 28 10            JR Z, .noW
342+  8499 DD 7E 03         LD A, (IX+ENT_POSX)
343+  849C 47               LD B, A
344+  849D 3A F5 84         LD A, (.speed)
345+  84A0 4F               LD C, A
346+  84A1 78               LD A, B
347+  84A2 91               SUB C
348+  84A3 30 01            JR NC, .clampW
349+  84A5 AF               XOR A                       ; Clamp a 0
350+  84A6              .clampW:
351+  84A6 DD 77 03         LD (IX+ENT_POSX), A
352+  84A9              .noW:
353+  84A9                  ; Check colision X
354+  84A9 CD F8 84         CALL CheckEntityCollision
355+  84AC 28 06            JR Z, .xOk
356+  84AE 3A F6 84         LD A, (.savedX)
357+  84B1 DD 77 03         LD (IX+ENT_POSX), A        ; Revertir X
358+  84B4              .xOk:
359+  84B4
360+  84B4                  ; --- Movimiento vertical (con colision) ---
361+  84B4 DD 7E 04         LD A, (IX+ENT_POSY)
362+  84B7 32 F7 84         LD (.savedY), A
363+  84BA
364+  84BA DD 7E 0A         LD A, (IX+ENT_DIR)
365+  84BD CB 4F            BIT 1, A                    ; DIR_S?
366+  84BF 28 11            JR Z, .noS
367+  84C1 3A F5 84         LD A, (.speed)
368+  84C4 47               LD B, A
369+  84C5 DD 7E 04         LD A, (IX+ENT_POSY)
370+  84C8 80               ADD A, B
371+  84C9 FE A0            CP SCREEN_MAX_Y
372+  84CB 38 02            JR C, .clampS
373+  84CD 3E A0            LD A, SCREEN_MAX_Y
374+  84CF              .clampS:
375+  84CF DD 77 04         LD (IX+ENT_POSY), A
376+  84D2              .noS:
377+  84D2 DD 7E 0A         LD A, (IX+ENT_DIR)
378+  84D5 CB 47            BIT 0, A                    ; DIR_N?
379+  84D7 28 10            JR Z, .noN
380+  84D9 DD 7E 04         LD A, (IX+ENT_POSY)
381+  84DC 47               LD B, A
382+  84DD 3A F5 84         LD A, (.speed)
383+  84E0 4F               LD C, A
384+  84E1 78               LD A, B
385+  84E2 91               SUB C
386+  84E3 30 01            JR NC, .clampN
387+  84E5 AF               XOR A
388+  84E6              .clampN:
389+  84E6 DD 77 04         LD (IX+ENT_POSY), A
390+  84E9              .noN:
391+  84E9                  ; Check colision Y
392+  84E9 CD F8 84         CALL CheckEntityCollision
393+  84EC 28 06            JR Z, .yOk
394+  84EE 3A F7 84         LD A, (.savedY)
395+  84F1 DD 77 04         LD (IX+ENT_POSY), A        ; Revertir Y
396+  84F4              .yOk:
397+  84F4 C9               RET
398+  84F5
399+  84F5 00           .speed:  DEFB 0
400+  84F6 00           .savedX: DEFB 0
401+  84F7 00           .savedY: DEFB 0
