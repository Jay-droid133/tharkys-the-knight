 11   0000
 12   0000                  ; Origen del programa en RAM
 13   0000                  ORG ORIGIN_ADDRESS
 14   8000
 15   8000              Inicio:
 16   8000 F3               DI                      ; Deshabilitar interrupciones
 17   8001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
 18   8004
 19   8004                  ; Configuración inicial (Borde negro, etc.)
 20   8004 AF               XOR A                   ; A = 0 (Negro)
 21   8005 D3 FE            OUT (254), A            ; Cambia el color del borde a negro
 22   8007
 23   8007                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
 24   8007                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
 25   8007 21 00 40         LD HL, SCREEN_BASE
 26   800A 11 01 40         LD DE, SCREEN_BASE + 1
 27   800D 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
 28   8010 77               LD (HL), A              ; A=0
 29   8011 ED B0            LDIR
 30   8013
 31   8013                  ; Inicializar sistema de pantallas
 32   8013 CD 9C 85         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
 33   8016 CD 2B 83         CALL InitEntities       ; Inicializar tabla de entidades (player en slot 0)
 34   8019
 35   8019 ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
 36   801B FB               EI                      ; Habilitar interrupciones
 37   801C
 38   801C              MainLoop:
 39   801C 76               HALT                    ; Esperar al barrido de pantalla (sincronizar a 50 FPS)
 40   801D
 41   801D                  ; Bucle principal estilo Sabre Wulf: Input -> Transicion -> Pantalla -> Entidades
 42   801D CD B4 82         CALL ReadInput              ; Leer teclado (QAOP + SPACE)
 43   8020 CD D9 85         CALL CheckScreenTransition  ; Detectar y ejecutar cambio de pantalla
 44   8023 CD 5D 86         CALL DrawScreen             ; Dibujar pantalla si es necesario (flick-screen)
 45   8026 CD 6D 83         CALL ProcessEntities        ; Per-entity: erase -> update -> draw
 46   8029 CD 71 82         CALL DrawDebugInfo          ; DEBUG: mostrar coordenadas de pantalla
 47   802C
 48   802C                  ; Incrementar contador de frames
 49   802C 3A 35 80         LD A, (GameFrameCounter)
 50   802F 3C               INC A
 51   8030 32 35 80         LD (GameFrameCounter), A
 52   8033
 53   8033 18 E7            JR MainLoop
 54   8035
 55   8035                  ; Inclusión de módulos
