 12+  82B4              ; ReadInput - Lee teclado y genera direccion + fuego
 13+  82B4              ; ==============================================================================
 14+  82B4              ReadInput:
 15+  82B4 AF               XOR A
 16+  82B5 32 03 81         LD (InputDirection), A
 17+  82B8 32 04 81         LD (InputFire), A
 18+  82BB
 19+  82BB                  ; --- Q (Arriba) ---
 20+  82BB 01 FE FB         LD BC, $FBFE
 21+  82BE ED 78            IN A, (C)
 22+  82C0 CB 47            BIT 0, A
 23+  82C2 20 08            JR NZ, .noUp
 24+  82C4 3A 03 81         LD A, (InputDirection)
 25+  82C7 F6 01            OR DIR_N
 26+  82C9 32 03 81         LD (InputDirection), A
 27+  82CC              .noUp:
 28+  82CC                  ; --- A (Abajo) ---
 29+  82CC 01 FE FD         LD BC, $FDFE
 30+  82CF ED 78            IN A, (C)
 31+  82D1 CB 47            BIT 0, A
 32+  82D3 20 08            JR NZ, .noDown
 33+  82D5 3A 03 81         LD A, (InputDirection)
 34+  82D8 F6 02            OR DIR_S
 35+  82DA 32 03 81         LD (InputDirection), A
 36+  82DD              .noDown:
 37+  82DD                  ; --- O (Izquierda) ---
 38+  82DD 01 FE DF         LD BC, $DFFE
 39+  82E0 ED 78            IN A, (C)
 40+  82E2 CB 4F            BIT 1, A
 41+  82E4 20 08            JR NZ, .noLeft
 42+  82E6 3A 03 81         LD A, (InputDirection)
 43+  82E9 F6 08            OR DIR_W
 44+  82EB 32 03 81         LD (InputDirection), A
 45+  82EE              .noLeft:
 46+  82EE                  ; --- P (Derecha) ---
 47+  82EE 01 FE DF         LD BC, $DFFE
 48+  82F1 ED 78            IN A, (C)
 49+  82F3 CB 47            BIT 0, A
 50+  82F5 20 08            JR NZ, .noRight
 51+  82F7 3A 03 81         LD A, (InputDirection)
 52+  82FA F6 04            OR DIR_E
 53+  82FC 32 03 81         LD (InputDirection), A
 54+  82FF              .noRight:
 55+  82FF                  ; --- SPACE (Fuego) ---
 56+  82FF 01 FE 7F         LD BC, $7FFE
 57+  8302 ED 78            IN A, (C)
 58+  8304 CB 47            BIT 0, A
 59+  8306 20 05            JR NZ, .noFire
 60+  8308 3E 01            LD A, 1
 61+  830A 32 04 81         LD (InputFire), A
 62+  830D              .noFire:
 63+  830D                  ; Cancelar opuestos
 64+  830D 3A 03 81         LD A, (InputDirection)
 65+  8310 47               LD B, A
 66+  8311 E6 03            AND DIR_N | DIR_S
 67+  8313 FE 03            CP DIR_N | DIR_S
 68+  8315 20 04            JR NZ, .noVC
 69+  8317 78               LD A, B
 70+  8318 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 71+  831A 47               LD B, A
 72+  831B              .noVC:
 73+  831B 78               LD A, B
 74+  831C E6 0C            AND DIR_E | DIR_W
 75+  831E FE 0C            CP DIR_E | DIR_W
 76+  8320 20 04            JR NZ, .noHC
 77+  8322 78               LD A, B
 78+  8323 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 79+  8325 47               LD B, A
 80+  8326              .noHC:
 81+  8326 78               LD A, B
 82+  8327 32 03 81         LD (InputDirection), A
