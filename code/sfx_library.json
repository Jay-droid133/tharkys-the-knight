  "_schema": {
    "id": "AYSFX_<UPPER_SNAKE>  — exported as EQU, indexes AySfxTable. Prefix evita colision con beeper SFX_* (sound.asm).",
    "name": "human-readable label (editor UI only)",
    "channels": "array of channels reserved while playing: A/B/C/N (noise). Music driver suppresses its own writes on these channels.",
    "preset": "editor metadata: which preset button generated this SFX (hit/blip/pickup/laser/explosion/jump/powerup/knock). Optional — only used by the editor to round-trip slider state.",
    "params": "editor metadata: slider values used by the preset to generate 'commands'. Optional. The COMPILED form is 'commands', not 'params'.",
    "commands": "the actual SFX program. Array of {op, ...args}. Ops: END, WAIT, TONE, VOL, MIXER, NOISE, ENV_SHAPE, ENV_PERIOD, SWEEP_TONE, SWEEP_VOL."
  }
