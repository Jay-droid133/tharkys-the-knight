        "decayFrames": 0,
        "noisePeriod": 0,
        "useNoise": false
      },
      "commands": [
        { "op": "VOL",        "ch": "B", "v": 15 },
        { "op": "SWEEP_TONE", "ch": "B", "from": 128, "to": 2128, "frames": 25 },
