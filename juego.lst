  1   0000              ; ==============================================================================
  2   0000              ; PROYECTO ZX SPECTRUM 48K
  3   0000              ; Archivo Principal - Punto de entrada
  4   0000              ; ==============================================================================
  5   0000
  6   0000                  DEVICE ZXSPECTRUM48
  7   0000
  8   0000                  ; Inclusión de definiciones
  9   0000                  INCLUDE "constants.asm"
# file opened: constants.asm
  1+  0000              ; ==============================================================================
  2+  0000              ; CONSTANTES DEL SISTEMA Y JUEGO
  3+  0000              ; ==============================================================================
  4+  0000
  5+  0000              ; --- Direcciones de Memoria ---
  6+  0000              ORIGIN_ADDRESS  EQU 32768           ; $8000 - Inicio de nuestro juego en RAM
  7+  0000              SP_ADDRESS      EQU 65368           ; $FF58 - Tope seguro para la pila (Stack)
  8+  0000
  9+  0000              ; --- Mapa de Video ---
 10+  0000              SCREEN_BASE     EQU 16384           ; $4000 - Inicio de los píxeles
 11+  0000              ATTR_BASE       EQU 22528           ; $5800 - Inicio de los atributos (colores)
 12+  0000              ATTR_SIZE       EQU 768             ; Tamaño de la zona de atributos
 13+  0000
 14+  0000              ; --- Colores Básicos (Tinta) ---
 15+  0000              BLACK           EQU 0
 16+  0000              BLUE            EQU 1
 17+  0000              RED             EQU 2
 18+  0000              MAGENTA         EQU 3
 19+  0000              GREEN           EQU 4
 20+  0000              CYAN            EQU 5
 21+  0000              YELLOW          EQU 6
 22+  0000              WHITE           EQU 7
 23+  0000
 24+  0000              ; --- Rutinas de la ROM ---
 25+  0000              ROM_CLS         EQU $0DAF           ; Limpiar pantalla
 26+  0000              ROM_CHAN_OPEN   EQU $1601           ; Abrir canal (pantalla principal)
 27+  0000              ROM_PRINT       EQU $203C           ; Imprimir carácter
 28+  0000
 29+  0000              ; --- Movimiento estilo Sabre Wulf (velocidades 16-bit) ---
 30+  0000              ; Byte alto = pixeles, Byte bajo = subpixel (fraccion)
 31+  0000              ; Sabre Wulf usa $02A0 en X y $0230 en Y para correr
 32+  0000              ; Y velocidades menores para pelear: $0230 X, $01C0 Y
 33+  0000              SPEED_RUN_X     EQU $02A0           ; Velocidad X corriendo (~2.625 px/frame)
 34+  0000              SPEED_RUN_Y     EQU $0230           ; Velocidad Y corriendo (~2.1875 px/frame)
 35+  0000              SPEED_FIGHT_X   EQU $0230           ; Velocidad X peleando
 36+  0000              SPEED_FIGHT_Y   EQU $01C0           ; Velocidad Y peleando
 37+  0000
 38+  0000              ; --- Limites de pantalla (en pixeles, considerando sprite 16x16) ---
 39+  0000              SCREEN_MIN_X    EQU 0               ; Limite izquierdo
 40+  0000              SCREEN_MAX_X    EQU 240             ; Limite derecho (256 - 16 sprite width)
 41+  0000              SCREEN_MIN_Y    EQU 0               ; Limite superior
 42+  0000              SCREEN_MAX_Y    EQU 160             ; Limite inferior (176 area juego - 16 sprite height)
 43+  0000
 44+  0000              ; --- Animacion (delays en frames de pantalla) ---
 45+  0000              ANIM_DELAY_RUN  EQU 4               ; Frames entre cambios de anim corriendo (12.5fps)
 46+  0000              ANIM_DELAY_IDLE EQU 8               ; Frames entre cambios de anim idle (6.25fps)
 47+  0000
 48+  0000              ; --- Numero de frames de animacion por estado ---
 49+  0000              ; Sabre Wulf real: Walk E/W=4, Walk N/S=4, Fight=6, Idle=2
 50+  0000              ANIM_FRAMES_WALK    EQU 3           ; Frames caminando (simplificado de 4)
 51+  0000              ANIM_FRAMES_FIGHT   EQU 2           ; Frames peleando (simplificado de 6)
 52+  0000              ANIM_FRAMES_IDLE    EQU 2           ; Frames idle
 53+  0000
 54+  0000              ; --- Direcciones del jugador ---
 55+  0000              DIR_NONE        EQU 0
 56+  0000              DIR_N           EQU 1
 57+  0000              DIR_S           EQU 2
 58+  0000              DIR_E           EQU 4
 59+  0000              DIR_W           EQU 8
 60+  0000              DIR_NE          EQU 5               ; DIR_N | DIR_E
 61+  0000              DIR_NW          EQU 9               ; DIR_N | DIR_W
 62+  0000              DIR_SE          EQU 6               ; DIR_S | DIR_E
 63+  0000              DIR_SW          EQU 10              ; DIR_S | DIR_W
 64+  0000
 65+  0000              ; --- Estados del jugador ---
 66+  0000              STATE_IDLE      EQU 0
 67+  0000              STATE_RUNNING   EQU 1
 68+  0000              STATE_FIGHTING  EQU 2
 69+  0000
 70+  0000              ; --- Puertos de teclado (semi-filas del ZX Spectrum) ---
 71+  0000              KEY_ROW_QAOP_P  EQU $DFFE           ; Fila P,O,I,U,Y  (bit0=P)
 72+  0000              KEY_ROW_QAOP_O  EQU $DFFE           ; Fila P,O,I,U,Y  (bit1=O)
 73+  0000              KEY_ROW_QAOP_Q  EQU $FBFE           ; Fila Q,W,E,R,T  (bit0=Q)
 74+  0000              KEY_ROW_QAOP_A  EQU $FDFE           ; Fila A,S,D,F,G  (bit0=A)
 75+  0000              KEY_ROW_SPACE   EQU $7FFE           ; Fila SPACE,SS,M,N,B (bit0=SPACE)
 76+  0000
 77+  0000              ; ==============================================================================
 78+  0000              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf)
 79+  0000              ; ==============================================================================
 80+  0000              ; Sabre Wulf: mapa de 256 pantallas en grid 16x16.
 81+  0000              ; Cada pantalla es una vista fija (flick-screen).
 82+  0000              ; Al tocar el borde, se transiciona a la pantalla adyacente.
 83+  0000              ;
 84+  0000              ; Cada pantalla se define como una rejilla de tiles de 8x8 pixeles.
 85+  0000              ; Area de juego: 256x176 pixeles = 32x22 caracteres.
 86+  0000              ; (Las 2 filas inferiores = HUD/panel de estado)
 87+  0000              ; ==============================================================================
 88+  0000
 89+  0000              ; --- Dimensiones del mapa ---
 90+  0000              MAP_WIDTH       EQU 16              ; Ancho del mapa en pantallas
 91+  0000              MAP_HEIGHT      EQU 16              ; Alto del mapa en pantallas
 92+  0000              MAP_TOTAL       EQU 256             ; Total de pantallas (16x16)
 93+  0000
 94+  0000              ; --- Dimensiones de cada pantalla (en tiles de 8x8) ---
 95+  0000              SCR_TILE_W      EQU 32              ; Tiles de ancho por pantalla
 96+  0000              SCR_TILE_H      EQU 22              ; Tiles de alto (22 filas = 176px area de juego)
 97+  0000              SCR_TILES_TOTAL EQU 704             ; 32 * 22 = tiles por pantalla
 98+  0000
 99+  0000              ; --- Dimensiones del area de juego (en pixeles) ---
100+  0000              PLAY_AREA_W     EQU 256             ; Ancho en pixeles
101+  0000              PLAY_AREA_H     EQU 176             ; Alto en pixeles (22 filas de 8px)
102+  0000              HUD_Y_START     EQU 176             ; Pixel Y donde empieza el HUD (filas 22-23)
103+  0000
104+  0000              ; --- Tipos de tile ---
105+  0000              ; Cada tile tiene un ID de 0-255 que referencia su grafico
106+  0000              TILE_EMPTY      EQU 0               ; Suelo transitable (vacio)
107+  0000              TILE_WALL       EQU 1               ; Muro solido (no transitable)
108+  0000              TILE_BUSH_TL    EQU 2               ; Arbusto esquina sup-izq
109+  0000              TILE_BUSH_TR    EQU 3               ; Arbusto esquina sup-der
110+  0000              TILE_BUSH_BL    EQU 4               ; Arbusto esquina inf-izq
111+  0000              TILE_BUSH_BR    EQU 5               ; Arbusto esquina inf-der
112+  0000              TILE_PLANT_1    EQU 6               ; Planta decorativa 1
113+  0000              TILE_PLANT_2    EQU 7               ; Planta decorativa 2
114+  0000              TILE_PATH_H     EQU 8               ; Camino horizontal
115+  0000              TILE_PATH_V     EQU 9               ; Camino vertical
116+  0000              TILE_DOOR       EQU 10              ; Puerta/pasaje entre pantallas
117+  0000              ; Tiles 11-255 reservados para mas vegetacion, objetos, etc.
118+  0000
119+  0000              ; --- Flags de tile (propiedades en la tabla de colision) ---
120+  0000              TFLAG_WALK      EQU 0               ; Se puede caminar (bit 0)
121+  0000              TFLAG_SOLID     EQU 1               ; Solido/bloqueante (bit 1)
122+  0000              TFLAG_DAMAGE    EQU 2               ; Hace danyo al contacto (bit 2)
123+  0000              TFLAG_COLLECT   EQU 4               ; Coleccionable (bit 3)
124+  0000
125+  0000              ; --- Posicion inicial del jugador en el mapa ---
126+  0000              START_SCREEN_X  EQU 8               ; Pantalla inicial X (centro del mapa)
127+  0000              START_SCREEN_Y  EQU 8               ; Pantalla inicial Y
128+  0000              START_PLAYER_X  EQU 120             ; Pixel X inicial dentro de la pantalla
129+  0000              START_PLAYER_Y  EQU 88              ; Pixel Y inicial dentro de la pantalla
130+  0000
131+  0000              ; --- Zona de transicion (pixeles desde el borde que activan cambio) ---
132+  0000              TRANSITION_ZONE EQU 4               ; Pixeles de margen para activar transicion
133+  0000
# file closed: constants.asm
 10   0000                  INCLUDE "macros.asm"
# file opened: macros.asm
  1+  0000              ; ==============================================================================
  2+  0000              ; MACROS ÚTILES PARA EL DESARROLLO
  3+  0000              ; ==============================================================================
  4+  0000
  5+  0000                  ; Marco para pintar un color rápidamente en la pantalla
  6+  0000                  MACRO SET_COLOR color, address
  7+  0000 ~                    LD A, color
  8+  0000 ~                    LD HL, address
  9+  0000 ~                    LD (HL), A
 10+  0000                  ENDM
 11+  0000
 12+  0000                  ; Macro estándar para sumar A a HL
 13+  0000                  MACRO ADD_HL_A
 14+  0000 ~                    ADD A, L
 15+  0000 ~                    LD L, A
 16+  0000 ~                    ADC A, H
 17+  0000 ~                    SUB L
 18+  0000 ~                    LD H, A
 19+  0000                  ENDM
 20+  0000
# file closed: macros.asm
 11   0000
 12   0000                  ; Origen del programa en RAM
 13   0000                  ORG ORIGIN_ADDRESS
 14   8000
 15   8000              Inicio:
 16   8000 F3               DI                      ; Deshabilitar interrupciones
 17   8001 31 58 FF         LD SP, SP_ADDRESS       ; Inicializar la pila (Stack Pointer)
 18   8004
 19   8004                  ; Configuración inicial (Borde negro, etc.)
 20   8004 AF               XOR A                   ; A = 0 (Negro)
 21   8005 D3 FE            OUT (254), A            ; Cambia el color del borde a negro
 22   8007
 23   8007                  ; Limpiar TODA la pantalla (pixeles + atributos) antes de nada
 24   8007                  ; Los pixeles del loader del .tap quedan en VRAM si no se borran
 25   8007 21 00 40         LD HL, SCREEN_BASE
 26   800A 11 01 40         LD DE, SCREEN_BASE + 1
 27   800D 01 FF 1A         LD BC, 6911             ; 6144 pixeles + 768 atributos - 1
 28   8010 77               LD (HL), A              ; A=0
 29   8011 ED B0            LDIR
 30   8013
 31   8013                  ; Inicializar sistema de pantallas
 32   8013 CD 81 84         CALL InitScreenSystem   ; Configura pantalla inicial y calcula puntero
 33   8016
 34   8016 ED 56            IM 1                    ; Modo de interrupciones 1 (por defecto en Spectrum 48k)
 35   8018 FB               EI                      ; Habilitar interrupciones
 36   8019
 37   8019              MainLoop:
 38   8019 76               HALT                    ; Esperar al barrido de pantalla (sincronizar a 50 FPS)
 39   801A
 40   801A                  ; Bucle principal estilo Sabre Wulf: Input -> Logica -> Pantalla -> Dibujo
 41   801A CD 94 81         CALL ReadInput          ; Leer teclado (QAOP + SPACE)
 42   801D CD 0B 82         CALL UpdateLogic        ; Actualizar estado, movimiento y animacion
 43   8020 CD BE 84         CALL CheckScreenTransition  ; Detectar y ejecutar cambio de pantalla
 44   8023 CD 55 85         CALL DrawScreen         ; Dibujar pantalla si es necesario (flick-screen)
 45   8026 CD 16 84         CALL DrawPlayer         ; Dibujar jugador sobre la pantalla
 46   8029 CD 51 81         CALL DrawDebugInfo      ; DEBUG: mostrar coordenadas de pantalla
 47   802C
 48   802C                  ; Incrementar contador de frames
 49   802C 3A 35 80         LD A, (GameFrameCounter)
 50   802F 3C               INC A
 51   8030 32 35 80         LD (GameFrameCounter), A
 52   8033
 53   8033 18 E4            JR MainLoop
 54   8035
 55   8035                  ; Inclusión de módulos
 56   8035                  INCLUDE "variables.asm"
# file opened: variables.asm
  1+  8035              ; ==============================================================================
  2+  8035              ; VARIABLES EN RAM MANTENIDAS POR EL JUEGO
  3+  8035              ; ==============================================================================
  4+  8035              ; Aquí definimos todos los datos mutables del juego.
  5+  8035              ; Usamos DEFB (Byte, 8 bits), DEFW (Word, 16 bits), DEFS (Espacio de bytes).
  6+  8035
  7+  8035 00           GameFrameCounter:   DEFB 0      ; Contador que incrementa cada frame (0-255)
  8+  8036 00           GameState:          DEFB 0      ; Estado: 0=Menu, 1=InGame, 2=GameOver
  9+  8037
 10+  8037              ; --- Posicion del jugador en 16-bit (estilo Sabre Wulf) ---
 11+  8037              ; Byte alto = posicion en pixeles, Byte bajo = fraccion subpixel
 12+  8037              ; Esto permite velocidades no enteras y movimiento suave
 13+  8037 00           PlayerXLo:          DEFB 0      ; Subpixel X (fraccion)
 14+  8038 78           PlayerXHi:          DEFB 120    ; Pixel X (posicion visible)
 15+  8039 00           PlayerYLo:          DEFB 0      ; Subpixel Y (fraccion)
 16+  803A 58           PlayerYHi:          DEFB 88     ; Pixel Y (posicion visible)
 17+  803B
 18+  803B              ; --- Estado de movimiento ---
 19+  803B 00           PlayerDir:          DEFB DIR_NONE   ; Direccion actual (bits: N=1,S=2,E=4,W=8)
 20+  803C 04           PlayerLastHDir:     DEFB DIR_E      ; Ultima direccion horizontal (para ataque retenido)
 21+  803D 00           PlayerState:        DEFB STATE_IDLE ; Estado: 0=idle, 1=running, 2=fighting
 22+  803E 00           PlayerFire:         DEFB 0          ; Boton de fuego presionado (0=no, 1=si)
 23+  803F
 24+  803F              ; --- Animacion ---
 25+  803F 00           PlayerAnimFrame:    DEFB 0      ; Frame actual de animacion (0..N-1)
 26+  8040 08           PlayerAnimDelay:    DEFB ANIM_DELAY_IDLE  ; Contador de delay (decrementa cada frame)
 27+  8041 02           PlayerAnimNumFrames: DEFB 2     ; Numero de frames en anim actual
 28+  8042 00 00        PlayerAnimBase:     DEFW ANIM_IDX_IDLE  ; Offset base en SpriteFrameTable
 29+  8044
 30+  8044              ; --- Input crudo ---
 31+  8044 00           InputDirection:     DEFB 0      ; Direccion leida del teclado este frame
 32+  8045 00           InputFire:          DEFB 0      ; Fuego leido del teclado este frame
 33+  8046
 34+  8046              ; ==============================================================================
 35+  8046              ; SISTEMA DE PANTALLAS
 36+  8046              ; ==============================================================================
 37+  8046
 38+  8046              ; --- Posicion actual en el mapa de pantallas (grid 16x16) ---
 39+  8046 08           CurrentScreenX:     DEFB START_SCREEN_X  ; Columna actual (0-15)
 40+  8047 08           CurrentScreenY:     DEFB START_SCREEN_Y  ; Fila actual (0-15)
 41+  8048
 42+  8048              ; --- Puntero a los datos de la pantalla actual ---
 43+  8048 00 00        CurrentScreenAddr:  DEFW 0      ; Direccion en memoria de los datos de la pantalla actual
 44+  804A
 45+  804A              ; --- Flag de transicion ---
 46+  804A 00           ScreenTransition:   DEFB 0      ; 0=sin transicion, 1=N, 2=S, 4=E, 8=W
 47+  804B
 48+  804B              ; --- Flag de redibujado ---
 49+  804B 01           ScreenDirty:        DEFB 1      ; 1=hay que redibujar la pantalla completa
 50+  804C
 51+  804C              ; --- Flag de transicion reciente (skip restore en DrawPlayer) ---
 52+  804C 00           ScreenJustRedrawn:  DEFB 0      ; 1=pantalla recien dibujada, no restaurar attrs
 53+  804D
# file closed: variables.asm
 57   804D                  INCLUDE "engine_graphics.asm"
# file opened: engine_graphics.asm
  1+  804D              ; ==============================================================================
  2+  804D              ; MOTOR GRAFICO - Sprites y utilidades de pantalla
  3+  804D              ; ==============================================================================
  4+  804D
  5+  804D              ClearScreen:
  6+  804D CD AF 0D         CALL ROM_CLS
  7+  8050 C9               RET
  8+  8051
  9+  8051              ; ==============================================================================
 10+  8051              ; DrawSprite - Dibuja un sprite de 16x16 con XOR en pantalla
 11+  8051              ; ==============================================================================
 12+  8051              ; Enfoque Sabre Wulf: sprites alineados a caracter (8px grid).
 13+  8051              ; XOR permite borrar redibujando el mismo sprite en la misma posicion.
 14+  8051              ;
 15+  8051              ; Entrada:
 16+  8051              ;   D = Y pixel (alineado a 8px por el caller)
 17+  8051              ;   E = X pixel (alineado a 8px por el caller)
 18+  8051              ;   IX = puntero a datos del sprite (SPRITE_W * SPRITE_H bytes)
 19+  8051              ;
 20+  8051              ; El sprite es de 2 bytes ancho (16px) x 16 lineas alto.
 21+  8051              ; Ocupa 2 columnas de caracter y 2 filas de caracter (2x2 celdas).
 22+  8051              ; ==============================================================================
 23+  8051              DrawSprite:
 24+  8051                  ; Calcular dir VRAM del bloque superior-izquierdo (celda 0,0)
 25+  8051 CD 34 81         CALL CalcPixelAddr          ; HL = dir VRAM para (D,E)
 26+  8054
 27+  8054                  ; --- Dibujar mitad superior (8 lineas, celda fila 0) ---
 28+  8054 06 08            LD B, 8
 29+  8056              .topHalf:
 30+  8056 DD 7E 00         LD A, (IX+0)                ; Byte izquierdo del sprite
 31+  8059 AE               XOR (HL)                    ; XOR con pantalla
 32+  805A 77               LD (HL), A
 33+  805B 2C               INC L                       ; Columna siguiente (byte derecho)
 34+  805C DD 7E 01         LD A, (IX+1)
 35+  805F AE               XOR (HL)
 36+  8060 77               LD (HL), A
 37+  8061 2D               DEC L                       ; Volver a columna izquierda
 38+  8062 24               INC H                       ; Siguiente linea de pixel (dentro del char)
 39+  8063 DD 23            INC IX
 40+  8065 DD 23            INC IX                      ; Avanzar 2 bytes en datos del sprite
 41+  8067 10 ED            DJNZ .topHalf
 42+  8069
 43+  8069                  ; --- Calcular dir VRAM de la celda inferior (Y+8) ---
 44+  8069 7A               LD A, D
 45+  806A C6 08            ADD A, 8                    ; Y + 8 = fila de caracter siguiente
 46+  806C 57               LD D, A
 47+  806D CD 34 81         CALL CalcPixelAddr          ; HL = dir VRAM para (D, E) en celda inferior
 48+  8070
 49+  8070                  ; --- Dibujar mitad inferior (8 lineas, celda fila 1) ---
 50+  8070 06 08            LD B, 8
 51+  8072              .bottomHalf:
 52+  8072 DD 7E 00         LD A, (IX+0)
 53+  8075 AE               XOR (HL)
 54+  8076 77               LD (HL), A
 55+  8077 2C               INC L
 56+  8078 DD 7E 01         LD A, (IX+1)
 57+  807B AE               XOR (HL)
 58+  807C 77               LD (HL), A
 59+  807D 2D               DEC L
 60+  807E 24               INC H
 61+  807F DD 23            INC IX
 62+  8081 DD 23            INC IX
 63+  8083 10 ED            DJNZ .bottomHalf
 64+  8085
 65+  8085 C9               RET
 66+  8086
 67+  8086              ; ==============================================================================
 68+  8086              ; EraseSprite - Borra un sprite de 16x16 (pone a 0, sin XOR)
 69+  8086              ; ==============================================================================
 70+  8086              ; Mas rapido que XOR para borrar cuando no nos importa el fondo.
 71+  8086              ; Entrada: D=Y (alineado 8px), E=X (alineado 8px)
 72+  8086              ; ==============================================================================
 73+  8086              EraseSprite:
 74+  8086 CD 34 81         CALL CalcPixelAddr
 75+  8089
 76+  8089                  ; Mitad superior (8 lineas)
 77+  8089 06 08            LD B, 8
 78+  808B              .eraseTop:
 79+  808B 36 00            LD (HL), 0
 80+  808D 2C               INC L
 81+  808E 36 00            LD (HL), 0
 82+  8090 2D               DEC L
 83+  8091 24               INC H
 84+  8092 10 F7            DJNZ .eraseTop
 85+  8094
 86+  8094                  ; Celda inferior
 87+  8094 7A               LD A, D
 88+  8095 C6 08            ADD A, 8
 89+  8097 57               LD D, A
 90+  8098 CD 34 81         CALL CalcPixelAddr
 91+  809B
 92+  809B                  ; Mitad inferior (8 lineas)
 93+  809B 06 08            LD B, 8
 94+  809D              .eraseBot:
 95+  809D 36 00            LD (HL), 0
 96+  809F 2C               INC L
 97+  80A0 36 00            LD (HL), 0
 98+  80A2 2D               DEC L
 99+  80A3 24               INC H
100+  80A4 10 F7            DJNZ .eraseBot
101+  80A6
102+  80A6 C9               RET
103+  80A7
104+  80A7              ; ==============================================================================
105+  80A7              ; SetSpriteAttr - Pone atributo de color en las 2x2 celdas del sprite
106+  80A7              ; ==============================================================================
107+  80A7              ; Entrada: D=Y pixel (alineado 8px), E=X pixel (alineado 8px), A=atributo
108+  80A7              ; ==============================================================================
109+  80A7              SetSpriteAttr:
110+  80A7 F5               PUSH AF                     ; Guardar atributo
111+  80A8                  ; Calcular posicion en tabla de atributos
112+  80A8 7A               LD A, D
113+  80A9 0F               RRCA
114+  80AA 0F               RRCA
115+  80AB 0F               RRCA
116+  80AC E6 1F            AND $1F                     ; Y / 8 = fila de atributo
117+  80AE 6F               LD L, A
118+  80AF 26 00            LD H, 0
119+  80B1 29               ADD HL, HL
120+  80B2 29               ADD HL, HL
121+  80B3 29               ADD HL, HL
122+  80B4 29               ADD HL, HL
123+  80B5 29               ADD HL, HL                  ; * 32
124+  80B6 7B               LD A, E
125+  80B7 0F               RRCA
126+  80B8 0F               RRCA
127+  80B9 0F               RRCA
128+  80BA E6 1F            AND $1F                     ; X / 8 = columna
129+  80BC B5               OR L
130+  80BD 6F               LD L, A
131+  80BE 01 00 58         LD BC, ATTR_BASE
132+  80C1 09               ADD HL, BC                  ; HL = dir atributo celda (0,0)
133+  80C2
134+  80C2 F1               POP AF                      ; Recuperar atributo
135+  80C3                  ; Celda (0,0) y (0,1) - fila superior
136+  80C3 77               LD (HL), A
137+  80C4 23               INC HL
138+  80C5 77               LD (HL), A
139+  80C6                  ; Celda (1,0) y (1,1) - fila inferior (+32 bytes)
140+  80C6 01 1F 00         LD BC, 31                   ; 32 - 1 (ya avanzamos 1)
141+  80C9 09               ADD HL, BC
142+  80CA 77               LD (HL), A
143+  80CB 23               INC HL
144+  80CC 77               LD (HL), A
145+  80CD C9               RET
146+  80CE
147+  80CE              ; ==============================================================================
148+  80CE              ; SaveSpriteAttr - Guarda los 4 atributos VRAM bajo un sprite 2x2
149+  80CE              ; ==============================================================================
150+  80CE              ; Lee los 4 bytes de atributos de VRAM en la posicion del sprite y los
151+  80CE              ; guarda en PlayerSavedAttr. Se llama ANTES de pintar el sprite.
152+  80CE              ;
153+  80CE              ; Entrada: D = Y pixel (alineado a 8), E = X pixel (alineado a 8)
154+  80CE              ; ==============================================================================
155+  80CE              SaveSpriteAttr:
156+  80CE 7A               LD A, D
157+  80CF 0F               RRCA
158+  80D0 0F               RRCA
159+  80D1 0F               RRCA
160+  80D2 E6 1F            AND $1F                     ; row = Y / 8
161+  80D4 6F               LD L, A
162+  80D5 26 00            LD H, 0
163+  80D7 29               ADD HL, HL
164+  80D8 29               ADD HL, HL
165+  80D9 29               ADD HL, HL
166+  80DA 29               ADD HL, HL
167+  80DB 29               ADD HL, HL                  ; HL = row * 32
168+  80DC 7B               LD A, E
169+  80DD 0F               RRCA
170+  80DE 0F               RRCA
171+  80DF 0F               RRCA
172+  80E0 E6 1F            AND $1F                     ; col = X / 8
173+  80E2 B5               OR L
174+  80E3 6F               LD L, A
175+  80E4 01 00 58         LD BC, ATTR_BASE
176+  80E7 09               ADD HL, BC                  ; HL = dir atributo celda (0,0)
177+  80E8                  ; Leer 4 atributos
178+  80E8 7E               LD A, (HL)
179+  80E9 32 30 81         LD (PlayerSavedAttr), A     ; sup-izq
180+  80EC 23               INC HL
181+  80ED 7E               LD A, (HL)
182+  80EE 32 31 81         LD (PlayerSavedAttr+1), A   ; sup-der
183+  80F1 01 1F 00         LD BC, 31
184+  80F4 09               ADD HL, BC                  ; siguiente fila
185+  80F5 7E               LD A, (HL)
186+  80F6 32 32 81         LD (PlayerSavedAttr+2), A   ; inf-izq
187+  80F9 23               INC HL
188+  80FA 7E               LD A, (HL)
189+  80FB 32 33 81         LD (PlayerSavedAttr+3), A   ; inf-der
190+  80FE C9               RET
191+  80FF
192+  80FF              ; ==============================================================================
193+  80FF              ; RestoreSavedAttr - Restaura los 4 atributos guardados a VRAM
194+  80FF              ; ==============================================================================
195+  80FF              ; Escribe los valores de PlayerSavedAttr de vuelta a VRAM.
196+  80FF              ; Se llama ANTES de borrar el sprite para limpiar los attrs blancos.
197+  80FF              ;
198+  80FF              ; Entrada: D = Y pixel (alineado a 8), E = X pixel (alineado a 8)
199+  80FF              ; ==============================================================================
200+  80FF              RestoreSavedAttr:
201+  80FF 7A               LD A, D
202+  8100 0F               RRCA
203+  8101 0F               RRCA
204+  8102 0F               RRCA
205+  8103 E6 1F            AND $1F
206+  8105 6F               LD L, A
207+  8106 26 00            LD H, 0
208+  8108 29               ADD HL, HL
209+  8109 29               ADD HL, HL
210+  810A 29               ADD HL, HL
211+  810B 29               ADD HL, HL
212+  810C 29               ADD HL, HL
213+  810D 7B               LD A, E
214+  810E 0F               RRCA
215+  810F 0F               RRCA
216+  8110 0F               RRCA
217+  8111 E6 1F            AND $1F
218+  8113 B5               OR L
219+  8114 6F               LD L, A
220+  8115 01 00 58         LD BC, ATTR_BASE
221+  8118 09               ADD HL, BC
222+  8119                  ; Escribir 4 atributos
223+  8119 3A 30 81         LD A, (PlayerSavedAttr)
224+  811C 77               LD (HL), A
225+  811D 23               INC HL
226+  811E 3A 31 81         LD A, (PlayerSavedAttr+1)
227+  8121 77               LD (HL), A
228+  8122 01 1F 00         LD BC, 31
229+  8125 09               ADD HL, BC
230+  8126 3A 32 81         LD A, (PlayerSavedAttr+2)
231+  8129 77               LD (HL), A
232+  812A 23               INC HL
233+  812B 3A 33 81         LD A, (PlayerSavedAttr+3)
234+  812E 77               LD (HL), A
235+  812F C9               RET
236+  8130
237+  8130              ; Buffer para 4 atributos del sprite del jugador
238+  8130 00 00 00 00  PlayerSavedAttr: DEFS 4
239+  8134
240+  8134              ; ==============================================================================
241+  8134              ; CalcPixelAddr - Calcula dir VRAM para coordenadas alineadas a 8px
242+  8134              ; ==============================================================================
243+  8134              ; Entrada: D=Y pixel, E=X pixel (ambos alineados a 8)
244+  8134              ; Salida: HL=direccion en VRAM
245+  8134              ; Formato VRAM: H=010 Y7Y6 Y2Y1Y0, L=Y5Y4Y3 X4X3X2X1X0
246+  8134              ; ==============================================================================
247+  8134              CalcPixelAddr:
248+  8134 7A               LD A, D
249+  8135 E6 C0            AND $C0                     ; Y7 Y6
250+  8137 1F               RRA
251+  8138 1F               RRA
252+  8139 1F               RRA                         ; >> 3
253+  813A F6 40            OR $40                      ; + SCREEN_BASE ($4000)
254+  813C 67               LD H, A
255+  813D
256+  813D 7A               LD A, D
257+  813E E6 07            AND $07                     ; Y2 Y1 Y0 (linea dentro del char)
258+  8140 B4               OR H
259+  8141 67               LD H, A
260+  8142
261+  8142 7A               LD A, D
262+  8143 E6 38            AND $38                     ; Y5 Y4 Y3 (fila de caracter)
263+  8145 87               ADD A, A
264+  8146 87               ADD A, A                    ; << 2, ahora en bits 7-5 de L
265+  8147 6F               LD L, A
266+  8148
267+  8148 7B               LD A, E
268+  8149 1F               RRA
269+  814A 1F               RRA
270+  814B 1F               RRA
271+  814C E6 1F            AND $1F                     ; X / 8 = columna
272+  814E B5               OR L
273+  814F 6F               LD L, A
274+  8150 C9               RET
275+  8151
276+  8151              ; ==============================================================================
277+  8151              ; DrawDebugInfo - Muestra coordenadas de pantalla en esquina sup-izq
278+  8151              ; ==============================================================================
279+  8151              ; Formato: "X,Y" en hexadecimal (ej: "8,8" para pantalla central)
280+  8151              ; Usa fuente ROM directamente sobre VRAM
281+  8151              ; ==============================================================================
282+  8151              DrawDebugInfo:
283+  8151                  ; ScreenX en columna 0
284+  8151 3A 46 80         LD A, (CurrentScreenX)
285+  8154 1E 00            LD E, 0
286+  8156 CD 73 81         CALL .drawHexDigit
287+  8159
288+  8159                  ; Coma en columna 1
289+  8159 3E 2C            LD A, ','
290+  815B 1E 01            LD E, 1
291+  815D CD 7F 81         CALL .drawChar
292+  8160
293+  8160                  ; ScreenY en columna 2
294+  8160 3A 47 80         LD A, (CurrentScreenY)
295+  8163 1E 02            LD E, 2
296+  8165 CD 73 81         CALL .drawHexDigit
297+  8168
298+  8168                  ; Atributos: bright blanco sobre negro para las 3 celdas
299+  8168 21 00 58         LD HL, ATTR_BASE
300+  816B 3E 47            LD A, WHITE | $40
301+  816D 77               LD (HL), A
302+  816E 23               INC HL
303+  816F 77               LD (HL), A
304+  8170 23               INC HL
305+  8171 77               LD (HL), A
306+  8172 C9               RET
307+  8173
308+  8173              .drawHexDigit:
309+  8173 E6 0F            AND $0F
310+  8175 FE 0A            CP 10
311+  8177 38 04            JR C, .isNum
312+  8179 C6 37            ADD A, 'A' - 10
313+  817B 18 02            JR .drawChar
314+  817D              .isNum:
315+  817D C6 30            ADD A, '0'
316+  817F              .drawChar:
317+  817F                  ; A = codigo ASCII, E = columna (0-31)
318+  817F                  ; Buscar bitmap del caracter en fuente ROM ($3C00 + ascii*8)
319+  817F 6F               LD L, A
320+  8180 26 00            LD H, 0
321+  8182 29               ADD HL, HL
322+  8183 29               ADD HL, HL
323+  8184 29               ADD HL, HL
324+  8185 01 00 3C         LD BC, $3C00
325+  8188 09               ADD HL, BC              ; HL = dir bitmap del caracter
326+  8189
327+  8189                  ; VRAM fila 0, columna E: dir = $4000 + E
328+  8189 16 40            LD D, $40
329+  818B 06 08            LD B, 8
330+  818D              .charLoop:
331+  818D 7E               LD A, (HL)
332+  818E 12               LD (DE), A
333+  818F 23               INC HL
334+  8190 14               INC D                   ; siguiente scanline ($40->$41->...$47)
335+  8191 10 FA            DJNZ .charLoop
336+  8193 C9               RET
