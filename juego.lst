506+  8416              ; ==============================================================================
507+  8416              ; DrawPlayer - Dibuja el sprite del jugador con animacion
508+  8416              ; ==============================================================================
509+  8416              ; Flujo:
510+  8416              ;   1. Si ScreenJustRedrawn: saltar restore/erase (pantalla recien pintada)
511+  8416              ;   2. Restaurar attrs guardados en posicion anterior
512+  8416              ;   3. Borrar sprite anterior
513+  8416              ;   4. Guardar attrs del fondo en posicion nueva
514+  8416              ;   5. Dibujar sprite nuevo
515+  8416              ;   6. Poner attrs blancos sobre el sprite
516+  8416              ; ==============================================================================
517+  8416              DrawPlayer:
518+  8416                  ; Comprobar si la pantalla fue recien dibujada
519+  8416 3A 4C 80         LD A, (ScreenJustRedrawn)
520+  8419 B7               OR A
521+  841A 20 20            JR NZ, .afterTransition
522+  841C
523+  841C                  ; --- Restaurar atributos guardados en posicion anterior ---
524+  841C 3A 80 84         LD A, (PlayerOldYHi)
525+  841F E6 F8            AND $F8
526+  8421 57               LD D, A
527+  8422 3A 7F 84         LD A, (PlayerOldXHi)
528+  8425 E6 F8            AND $F8
529+  8427 5F               LD E, A
530+  8428 CD FF 80         CALL RestoreSavedAttr
531+  842B
532+  842B                  ; --- Borrar sprite anterior ---
533+  842B 3A 80 84         LD A, (PlayerOldYHi)
534+  842E E6 F8            AND $F8
535+  8430 57               LD D, A
536+  8431 3A 7F 84         LD A, (PlayerOldXHi)
537+  8434 E6 F8            AND $F8
538+  8436 5F               LD E, A
539+  8437 CD 86 80         CALL EraseSprite
540+  843A 18 04            JR .drawNew
541+  843C
542+  843C              .afterTransition:
543+  843C AF               XOR A
544+  843D 32 4C 80         LD (ScreenJustRedrawn), A   ; Limpiar flag
545+  8440
546+  8440              .drawNew:
547+  8440                  ; --- Guardar posicion actual como "old" ---
548+  8440 3A 38 80         LD A, (PlayerXHi)
549+  8443 32 7F 84         LD (PlayerOldXHi), A
550+  8446 3A 3A 80         LD A, (PlayerYHi)
551+  8449 32 80 84         LD (PlayerOldYHi), A
552+  844C
553+  844C                  ; --- Obtener sprite actual segun animacion ---
554+  844C CD C0 83         CALL GetCurrentSpriteAddr   ; IX = datos del sprite
555+  844F
556+  844F                  ; --- Guardar atributos del fondo ANTES de pintar ---
557+  844F 3A 3A 80         LD A, (PlayerYHi)
558+  8452 E6 F8            AND $F8
559+  8454 57               LD D, A
560+  8455 3A 38 80         LD A, (PlayerXHi)
561+  8458 E6 F8            AND $F8
562+  845A 5F               LD E, A
563+  845B CD CE 80         CALL SaveSpriteAttr
564+  845E
565+  845E                  ; --- Dibujar sprite en posicion actual ---
566+  845E 3A 3A 80         LD A, (PlayerYHi)
567+  8461 E6 F8            AND $F8
568+  8463 57               LD D, A
569+  8464 3A 38 80         LD A, (PlayerXHi)
570+  8467 E6 F8            AND $F8
571+  8469 5F               LD E, A
572+  846A CD 51 80         CALL DrawSprite             ; Dibuja 16x16 con XOR
573+  846D
574+  846D                  ; --- Poner atributo blanco en las 2x2 celdas del sprite ---
575+  846D 3A 3A 80         LD A, (PlayerYHi)
576+  8470 E6 F8            AND $F8
577+  8472 57               LD D, A
578+  8473 3A 38 80         LD A, (PlayerXHi)
579+  8476 E6 F8            AND $F8
580+  8478 5F               LD E, A
581+  8479 3E 47            LD A, WHITE | $40           ; Bright blanco
582+  847B CD A7 80         CALL SetSpriteAttr
583+  847E C9               RET
584+  847F
585+  847F              ; --- Variables de posicion anterior del player ---
586+  847F 78           PlayerOldXHi:   DEFB START_PLAYER_X
587+  8480 58           PlayerOldYHi:   DEFB START_PLAYER_Y
