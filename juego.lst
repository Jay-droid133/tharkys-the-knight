 59   8481                  INCLUDE "screen_system.asm"
# file opened: screen_system.asm
  1+  8481              ; ==============================================================================
  2+  8481              ; SISTEMA DE PANTALLAS (estilo Sabre Wulf - flick-screen)
  3+  8481              ; ==============================================================================
  4+  8481              ; Mapa de 256 pantallas (16x16). Cada pantalla es un "room" definido como
  5+  8481              ; lista de sprites de fondo (BgSprites). La colision se hace iterando la
  6+  8481              ; lista de sprites del room actual (como la rutina B873 de Sabre Wulf).
  7+  8481              ; ==============================================================================
  8+  8481
  9+  8481              ; ==============================================================================
 10+  8481              ; InitScreenSystem - Inicializa el sistema de pantallas
 11+  8481              ; ==============================================================================
 12+  8481              InitScreenSystem:
 13+  8481 3E 08            LD A, START_SCREEN_X
 14+  8483 32 46 80         LD (CurrentScreenX), A
 15+  8486 3E 08            LD A, START_SCREEN_Y
 16+  8488 32 47 80         LD (CurrentScreenY), A
 17+  848B 3E 01            LD A, 1
 18+  848D 32 4B 80         LD (ScreenDirty), A         ; Forzar dibujado inicial
 19+  8490 AF               XOR A
 20+  8491 32 4A 80         LD (ScreenTransition), A
 21+  8494 CD 98 84         CALL CalcScreenAddress
 22+  8497 C9               RET
 23+  8498
 24+  8498              ; ==============================================================================
 25+  8498              ; CalcScreenAddress - Lee MapTable y RoomTable para obtener puntero al room
 26+  8498              ; ==============================================================================
 27+  8498              ; MapTable[Y*16+X] = indice de room -> RoomTable[indice] = puntero a room data
 28+  8498              ; ==============================================================================
 29+  8498              CalcScreenAddress:
 30+  8498 3A 47 80         LD A, (CurrentScreenY)
 31+  849B 6F               LD L, A
 32+  849C 26 00            LD H, 0
 33+  849E 29               ADD HL, HL                  ; x2
 34+  849F 29               ADD HL, HL                  ; x4
 35+  84A0 29               ADD HL, HL                  ; x8
 36+  84A1 29               ADD HL, HL                  ; x16
 37+  84A2 3A 46 80         LD A, (CurrentScreenX)
 38+  84A5 5F               LD E, A
 39+  84A6 16 00            LD D, 0
 40+  84A8 19               ADD HL, DE                  ; HL = Y*16 + X
 41+  84A9 11 4B 88         LD DE, MapTable
 42+  84AC 19               ADD HL, DE                  ; HL = &MapTable[index]
 43+  84AD 7E               LD A, (HL)                  ; A = room index (0-47)
 44+  84AE                  ; Lookup en RoomTable (tabla de DEFWs)
 45+  84AE 6F               LD L, A
 46+  84AF 26 00            LD H, 0
 47+  84B1 29               ADD HL, HL                  ; index * 2
 48+  84B2 11 EB 87         LD DE, RoomTable
 49+  84B5 19               ADD HL, DE
 50+  84B6 5E               LD E, (HL)
 51+  84B7 23               INC HL
 52+  84B8 56               LD D, (HL)                  ; DE = puntero a room data
 53+  84B9 ED 53 48 80      LD (CurrentScreenAddr), DE
 54+  84BD C9               RET
 55+  84BE
 56+  84BE              ; ==============================================================================
 57+  84BE              ; CheckScreenTransition - Detecta si el jugador debe cambiar de pantalla
 58+  84BE              ; ==============================================================================
 59+  84BE              CheckScreenTransition:
 60+  84BE AF               XOR A
 61+  84BF 32 4A 80         LD (ScreenTransition), A
 62+  84C2
 63+  84C2                  ; --- Comprobar borde OESTE (izquierdo) ---
 64+  84C2 3A 38 80         LD A, (PlayerXHi)
 65+  84C5 FE 04            CP TRANSITION_ZONE
 66+  84C7 30 16            JR NC, .noWest
 67+  84C9 3A 46 80         LD A, (CurrentScreenX)
 68+  84CC B7               OR A
 69+  84CD 28 10            JR Z, .noWest
 70+  84CF 3D               DEC A
 71+  84D0 32 46 80         LD (CurrentScreenX), A
 72+  84D3 3E 08            LD A, DIR_W
 73+  84D5 32 4A 80         LD (ScreenTransition), A
 74+  84D8 3E E8            LD A, SCREEN_MAX_X - 8
 75+  84DA 32 38 80         LD (PlayerXHi), A
 76+  84DD 18 57            JR .doTransition
 77+  84DF
 78+  84DF              .noWest:
 79+  84DF                  ; --- Comprobar borde ESTE (derecho) ---
 80+  84DF 3A 38 80         LD A, (PlayerXHi)
 81+  84E2 FE F0            CP SCREEN_MAX_X
 82+  84E4 38 17            JR C, .noEast
 83+  84E6 3A 46 80         LD A, (CurrentScreenX)
 84+  84E9 FE 0F            CP MAP_WIDTH - 1
 85+  84EB 28 10            JR Z, .noEast
 86+  84ED 3C               INC A
 87+  84EE 32 46 80         LD (CurrentScreenX), A
 88+  84F1 3E 04            LD A, DIR_E
 89+  84F3 32 4A 80         LD (ScreenTransition), A
 90+  84F6 3E 05            LD A, TRANSITION_ZONE + 1
 91+  84F8 32 38 80         LD (PlayerXHi), A
 92+  84FB 18 39            JR .doTransition
 93+  84FD
 94+  84FD              .noEast:
 95+  84FD                  ; --- Comprobar borde NORTE (superior) ---
 96+  84FD 3A 3A 80         LD A, (PlayerYHi)
 97+  8500 FE 04            CP TRANSITION_ZONE
 98+  8502 30 16            JR NC, .noNorth
 99+  8504 3A 47 80         LD A, (CurrentScreenY)
100+  8507 B7               OR A
101+  8508 28 10            JR Z, .noNorth
102+  850A 3D               DEC A
103+  850B 32 47 80         LD (CurrentScreenY), A
104+  850E 3E 01            LD A, DIR_N
105+  8510 32 4A 80         LD (ScreenTransition), A
106+  8513 3E 98            LD A, SCREEN_MAX_Y - 8
107+  8515 32 3A 80         LD (PlayerYHi), A
108+  8518 18 1C            JR .doTransition
109+  851A
110+  851A              .noNorth:
111+  851A                  ; --- Comprobar borde SUR (inferior) ---
112+  851A 3A 3A 80         LD A, (PlayerYHi)
113+  851D FE A0            CP SCREEN_MAX_Y
114+  851F 38 33            JR C, .noSouth
115+  8521 3A 47 80         LD A, (CurrentScreenY)
116+  8524 FE 0F            CP MAP_HEIGHT - 1
117+  8526 28 2C            JR Z, .noSouth
118+  8528 3C               INC A
119+  8529 32 47 80         LD (CurrentScreenY), A
120+  852C 3E 02            LD A, DIR_S
121+  852E 32 4A 80         LD (ScreenTransition), A
122+  8531 3E 05            LD A, TRANSITION_ZONE + 1
123+  8533 32 3A 80         LD (PlayerYHi), A
124+  8536
125+  8536              .doTransition:
126+  8536 AF               XOR A
127+  8537 32 37 80         LD (PlayerXLo), A
128+  853A 32 39 80         LD (PlayerYLo), A
129+  853D 3A 38 80         LD A, (PlayerXHi)
130+  8540 32 7F 84         LD (PlayerOldXHi), A
131+  8543 3A 3A 80         LD A, (PlayerYHi)
132+  8546 32 80 84         LD (PlayerOldYHi), A
133+  8549 CD 98 84         CALL CalcScreenAddress
134+  854C 3E 01            LD A, 1
135+  854E 32 4B 80         LD (ScreenDirty), A
136+  8551 32 4C 80         LD (ScreenJustRedrawn), A
137+  8554              .noSouth:
138+  8554 C9               RET
139+  8555
140+  8555              ; ==============================================================================
141+  8555              ; DrawScreen - Dibuja la pantalla actual iterando sprites de fondo
142+  8555              ; ==============================================================================
143+  8555              ; Itera la lista de sprites del room y pinta rectangulos de atributos.
144+  8555              ; Solo se ejecuta cuando ScreenDirty=1 (cambio de pantalla).
145+  8555              ; ==============================================================================
146+  8555              DrawScreen:
147+  8555 3A 4B 80         LD A, (ScreenDirty)
148+  8558 B7               OR A
149+  8559 C8               RET Z
150+  855A
151+  855A                  ; --- Limpiar pixeles ---
152+  855A 21 00 40         LD HL, SCREEN_BASE
153+  855D 11 01 40         LD DE, SCREEN_BASE + 1
154+  8560 01 FF 17         LD BC, 6143
155+  8563 AF               XOR A
156+  8564 77               LD (HL), A
157+  8565 ED B0            LDIR
158+  8567
159+  8567                  ; --- Limpiar TODOS los atributos a negro ---
160+  8567 21 00 58         LD HL, ATTR_BASE
161+  856A 11 01 58         LD DE, ATTR_BASE + 1
162+  856D 01 FF 02         LD BC, ATTR_SIZE - 1
163+  8570 AF               XOR A
164+  8571 77               LD (HL), A
165+  8572 ED B0            LDIR
166+  8574
167+  8574                  ; --- Iterar sprites del room y pintar atributos ---
168+  8574 2A 48 80         LD HL, (CurrentScreenAddr)
169+  8577              .sprLoop:
170+  8577                  ; Leer DEFW sprite_ptr
171+  8577 5E               LD E, (HL)
172+  8578 23               INC HL
173+  8579 56               LD D, (HL)
174+  857A 23               INC HL
175+  857B                  ; Terminador?
176+  857B 7A               LD A, D
177+  857C B3               OR E
178+  857D 28 11            JR Z, .drawDone
179+  857F                  ; Leer posicion
180+  857F 46               LD B, (HL)                  ; B = x_char
181+  8580 23               INC HL
182+  8581 4E               LD C, (HL)                  ; C = y_char
183+  8582 23               INC HL
184+  8583 E5               PUSH HL                     ; Guardar puntero a siguiente entrada
185+  8584                  ; Leer definicion del sprite desde DE
186+  8584 EB               EX DE, HL                   ; HL = sprite def
187+  8585 56               LD D, (HL)                  ; D = width_chars
188+  8586 23               INC HL
189+  8587 5E               LD E, (HL)                  ; E = height_chars
190+  8588 23               INC HL
191+  8589 7E               LD A, (HL)                  ; A = attr
192+  858A                  ; Pintar rectangulo de atributos
193+  858A CD 95 85         CALL DrawRoomSprite
194+  858D E1               POP HL                      ; Restaurar puntero room data
195+  858E 18 E7            JR .sprLoop
196+  8590
197+  8590              .drawDone:
198+  8590 AF               XOR A
199+  8591 32 4B 80         LD (ScreenDirty), A
200+  8594 C9               RET
201+  8595
202+  8595              ; ==============================================================================
203+  8595              ; DrawRoomSprite - Pinta un rectangulo de atributos en VRAM
204+  8595              ; ==============================================================================
205+  8595              ; Entrada: B=x_char, C=y_char, D=width, E=height, A=attr
206+  8595              ; ==============================================================================
207+  8595              DrawRoomSprite:
208+  8595 F5               PUSH AF                     ; Guardar atributo
209+  8596                  ; Calcular dir VRAM: ATTR_BASE + y*32 + x
210+  8596 79               LD A, C
211+  8597 6F               LD L, A
212+  8598 26 00            LD H, 0
213+  859A 29               ADD HL, HL
214+  859B 29               ADD HL, HL
215+  859C 29               ADD HL, HL
216+  859D 29               ADD HL, HL
217+  859E 29               ADD HL, HL                  ; HL = y * 32
218+  859F 78               LD A, B
219+  85A0 85               ADD A, L
220+  85A1 6F               LD L, A
221+  85A2 30 01            JR NC, .noCarry
222+  85A4 24               INC H
223+  85A5              .noCarry:
224+  85A5 01 00 58         LD BC, ATTR_BASE
225+  85A8 09               ADD HL, BC                  ; HL = dir atributo VRAM
226+  85A9 F1               POP AF                      ; A = attr
227+  85AA                  ; Pintar E filas de D columnas
228+  85AA              .rowLoop:
229+  85AA 42               LD B, D                     ; B = ancho (contador columnas)
230+  85AB E5               PUSH HL                     ; Guardar inicio de fila
231+  85AC              .colLoop:
232+  85AC 77               LD (HL), A
233+  85AD 23               INC HL
234+  85AE 10 FC            DJNZ .colLoop
235+  85B0 E1               POP HL                      ; Restaurar inicio de fila
236+  85B1                  ; Siguiente fila: +32
237+  85B1 D5               PUSH DE
238+  85B2 11 20 00         LD DE, 32
239+  85B5 19               ADD HL, DE
240+  85B6 D1               POP DE
241+  85B7 1D               DEC E
242+  85B8 20 F0            JR NZ, .rowLoop
243+  85BA C9               RET
244+  85BB
245+  85BB              ; ==============================================================================
246+  85BB              ; IsPointBlocked - Comprueba si un punto pixel esta bloqueado por un sprite solido
247+  85BB              ; ==============================================================================
248+  85BB              ; Estilo Sabre Wulf (rutina B873): itera la lista de sprites del room,
249+  85BB              ; comprueba si el punto cae dentro del bounding box de algun sprite solido.
250+  85BB              ;
251+  85BB              ; Entrada: B = X pixel, C = Y pixel
252+  85BB              ; Salida: Z = libre, NZ = bloqueado
253+  85BB              ; Preserva: BC (punto), DE (para el caller)
254+  85BB              ; ==============================================================================
255+  85BB              IsPointBlocked:
256+  85BB D5               PUSH DE
257+  85BC 2A 48 80         LD HL, (CurrentScreenAddr)
258+  85BF              .loop:
259+  85BF                  ; Leer DEFW sprite_ptr
260+  85BF 5E               LD E, (HL)
261+  85C0 23               INC HL
262+  85C1 56               LD D, (HL)
263+  85C2 23               INC HL
264+  85C3                  ; Terminador?
265+  85C3 7A               LD A, D
266+  85C4 B3               OR E
267+  85C5 28 55            JR Z, .free
268+  85C7                  ; Leer posicion
269+  85C7 7E               LD A, (HL)
270+  85C8 23               INC HL
271+  85C9 32 1F 86         LD (.sprX), A
272+  85CC 7E               LD A, (HL)
273+  85CD 23               INC HL
274+  85CE 32 20 86         LD (.sprY), A
275+  85D1 E5               PUSH HL                     ; Guardar puntero a siguiente entrada
276+  85D2                  ; Cargar definicion del sprite desde DE
277+  85D2 EB               EX DE, HL
278+  85D3 7E               LD A, (HL)                  ; width_chars
279+  85D4 32 21 86         LD (.sprW), A
280+  85D7 23               INC HL
281+  85D8 7E               LD A, (HL)                  ; height_chars
282+  85D9 32 22 86         LD (.sprH), A
283+  85DC 23               INC HL
284+  85DD 23               INC HL                      ; saltar attr
285+  85DE 7E               LD A, (HL)                  ; flags
286+  85DF CB 47            BIT 0, A
287+  85E1 28 36            JR Z, .skip                 ; No es solido, siguiente
288+  85E3
289+  85E3                  ; === Comprobar X ===
290+  85E3                  ; charCol = B / 8, comprobar sprX <= charCol < sprX + sprW
291+  85E3 78               LD A, B
292+  85E4 0F               RRCA
293+  85E5 0F               RRCA
294+  85E6 0F               RRCA
295+  85E7 E6 1F            AND $1F                     ; A = charCol
296+  85E9 57               LD D, A                     ; D = charCol
297+  85EA 3A 1F 86         LD A, (.sprX)
298+  85ED 5F               LD E, A                     ; E = sprX
299+  85EE 7A               LD A, D                     ; A = charCol
300+  85EF 93               SUB E                       ; A = charCol - sprX (carry si charCol < sprX)
301+  85F0 38 27            JR C, .skip                 ; Fuera por la izquierda
302+  85F2                  ; A = offset horizontal dentro del sprite
303+  85F2 5F               LD E, A                     ; E = offset
304+  85F3 3A 21 86         LD A, (.sprW)
305+  85F6 BB               CP E                        ; sprW - offset
306+  85F7 28 20            JR Z, .skip                 ; En el borde derecho = fuera
307+  85F9 38 1E            JR C, .skip                 ; offset > sprW = fuera
308+  85FB
309+  85FB                  ; === Comprobar Y ===
310+  85FB                  ; charRow = C / 8, comprobar sprY <= charRow < sprY + sprH
311+  85FB 79               LD A, C
312+  85FC 0F               RRCA
313+  85FD 0F               RRCA
314+  85FE 0F               RRCA
315+  85FF E6 1F            AND $1F                     ; A = charRow
316+  8601 57               LD D, A                     ; D = charRow
317+  8602 3A 20 86         LD A, (.sprY)
318+  8605 5F               LD E, A
319+  8606 7A               LD A, D
320+  8607 93               SUB E                       ; A = charRow - sprY
321+  8608 38 0F            JR C, .skip                 ; Fuera por arriba
322+  860A 5F               LD E, A
323+  860B 3A 22 86         LD A, (.sprH)
324+  860E BB               CP E
325+  860F 28 08            JR Z, .skip                 ; En el borde inferior = fuera
326+  8611 38 06            JR C, .skip                 ; offset > sprH = fuera
327+  8613
328+  8613                  ; Punto dentro de sprite solido!
329+  8613 E1               POP HL
330+  8614 3E 01            LD A, 1
331+  8616 B7               OR A                        ; NZ = bloqueado
332+  8617 D1               POP DE
333+  8618 C9               RET
334+  8619
335+  8619              .skip:
336+  8619 E1               POP HL
337+  861A 18 A3            JR .loop
338+  861C
339+  861C              .free:
340+  861C AF               XOR A                       ; Z = libre
341+  861D D1               POP DE
342+  861E C9               RET
343+  861F
