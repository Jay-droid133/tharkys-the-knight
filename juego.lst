212+  884B              ; MAPTABLE - 256 bytes, indice de room por celda del grid 16x16
213+  884B              ; ==============================================================================
214+  884B              ; MapTable[Y*16 + X] = indice en RoomTable (0-47)
215+  884B              ; Mapa actual: cruz centrada en (8,8)
216+  884B              ;                (8,7) = Norte
217+  884B              ;   (7,8) = Oeste  (8,8) = Hub  (9,8) = Este
218+  884B              ;                (8,9) = Sur
219+  884B              ; ==============================================================================
220+  884B              MapTable:
221+  884B                  ; Filas Y=0..6 (112 bytes)
222+  884B 00 00 00...      DEFS 112, 0
223+  88BB                  ; Fila Y=7: X=8 -> Room_North (2)
224+  88BB 00 00 00 00      DEFB 0,0,0,0,0,0,0,0, 2, 0,0,0,0,0,0,0
224+  88BF 00 00 00 00
224+  88C3 02 00 00 00
224+  88C7 00 00 00 00
225+  88CB                  ; Fila Y=8: X=7 -> West(3), X=8 -> Hub(1), X=9 -> East(4)
226+  88CB 00 00 00 00      DEFB 0,0,0,0,0,0,0, 3, 1, 4, 0,0,0,0,0,0
226+  88CF 00 00 00 03
226+  88D3 01 04 00 00
226+  88D7 00 00 00 00
227+  88DB                  ; Fila Y=9: X=8 -> Room_South (5)
228+  88DB 00 00 00 00      DEFB 0,0,0,0,0,0,0,0, 5, 0,0,0,0,0,0,0
228+  88DF 00 00 00 00
228+  88E3 05 00 00 00
228+  88E7 00 00 00 00
229+  88EB                  ; Filas Y=10..15 (96 bytes)
230+  88EB 00 00 00...      DEFS 96, 0
