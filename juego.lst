# file closed: engine_graphics.asm
 58   8194                  INCLUDE "logic_game.asm"
# file opened: logic_game.asm
  1+  8194              ; ==============================================================================
  2+  8194              ; LOGICA DEL JUEGO - Sistema de Movimiento estilo Sabre Wulf
  3+  8194              ; ==============================================================================
  4+  8194              ; Caracteristicas implementadas:
  5+  8194              ; - Posicion 16-bit (subpixel) para movimiento suave
  6+  8194              ; - Velocidades distintas corriendo vs peleando (como Sabre Wulf)
  7+  8194              ; - 8 direcciones via teclado QAOP
  8+  8194              ; - Direccion de ataque retenida al moverse Norte/Sur
  9+  8194              ; - Animacion con delays configurables por estado
 10+  8194              ; - Limites de pantalla
 11+  8194              ; ==============================================================================
 12+  8194
 13+  8194              ; ==============================================================================
 14+  8194              ; ReadInput - Lee teclado y genera direccion + fuego
 15+  8194              ; ==============================================================================
 16+  8194              ; Esquema de teclado ZX Spectrum:
 17+  8194              ;   Q = Arriba, A = Abajo, O = Izquierda, P = Derecha, SPACE = Fuego
 18+  8194              ; Salida: InputDirection y InputFire actualizados
 19+  8194              ; ==============================================================================
 20+  8194              ReadInput:
 21+  8194 AF               XOR A
 22+  8195 32 44 80         LD (InputDirection), A      ; Limpiar direccion
 23+  8198 32 45 80         LD (InputFire), A           ; Limpiar fuego
 24+  819B
 25+  819B                  ; --- Leer Q (Arriba) ---
 26+  819B                  ; Fila Q,W,E,R,T = puerto $FBFE, bit 0 = Q
 27+  819B 01 FE FB         LD BC, $FBFE
 28+  819E ED 78            IN A, (C)
 29+  81A0 CB 47            BIT 0, A
 30+  81A2 20 08            JR NZ, .noUp
 31+  81A4 3A 44 80         LD A, (InputDirection)
 32+  81A7 F6 01            OR DIR_N
 33+  81A9 32 44 80         LD (InputDirection), A
 34+  81AC              .noUp:
 35+  81AC
 36+  81AC                  ; --- Leer A (Abajo) ---
 37+  81AC                  ; Fila A,S,D,F,G = puerto $FDFE, bit 0 = A
 38+  81AC 01 FE FD         LD BC, $FDFE
 39+  81AF ED 78            IN A, (C)
 40+  81B1 CB 47            BIT 0, A
 41+  81B3 20 08            JR NZ, .noDown
 42+  81B5 3A 44 80         LD A, (InputDirection)
 43+  81B8 F6 02            OR DIR_S
 44+  81BA 32 44 80         LD (InputDirection), A
 45+  81BD              .noDown:
 46+  81BD
 47+  81BD                  ; --- Leer O (Izquierda) ---
 48+  81BD                  ; Fila P,O,I,U,Y = puerto $DFFE, bit 1 = O
 49+  81BD 01 FE DF         LD BC, $DFFE
 50+  81C0 ED 78            IN A, (C)
 51+  81C2 CB 4F            BIT 1, A
 52+  81C4 20 08            JR NZ, .noLeft
 53+  81C6 3A 44 80         LD A, (InputDirection)
 54+  81C9 F6 08            OR DIR_W
 55+  81CB 32 44 80         LD (InputDirection), A
 56+  81CE              .noLeft:
 57+  81CE
 58+  81CE                  ; --- Leer P (Derecha) ---
 59+  81CE                  ; Fila P,O,I,U,Y = puerto $DFFE, bit 0 = P
 60+  81CE 01 FE DF         LD BC, $DFFE
 61+  81D1 ED 78            IN A, (C)
 62+  81D3 CB 47            BIT 0, A
 63+  81D5 20 08            JR NZ, .noRight
 64+  81D7 3A 44 80         LD A, (InputDirection)
 65+  81DA F6 04            OR DIR_E
 66+  81DC 32 44 80         LD (InputDirection), A
 67+  81DF              .noRight:
 68+  81DF
 69+  81DF                  ; --- Leer SPACE (Fuego) ---
 70+  81DF                  ; Fila SPACE,SS,M,N,B = puerto $7FFE, bit 0 = SPACE
 71+  81DF 01 FE 7F         LD BC, $7FFE
 72+  81E2 ED 78            IN A, (C)
 73+  81E4 CB 47            BIT 0, A
 74+  81E6 20 05            JR NZ, .noFire
 75+  81E8 3E 01            LD A, 1
 76+  81EA 32 45 80         LD (InputFire), A
 77+  81ED              .noFire:
 78+  81ED
 79+  81ED                  ; --- Cancelar direcciones opuestas simultaneas ---
 80+  81ED 3A 44 80         LD A, (InputDirection)
 81+  81F0 47               LD B, A
 82+  81F1
 83+  81F1                  ; Si N y S a la vez, cancelar ambos
 84+  81F1 E6 03            AND DIR_N | DIR_S
 85+  81F3 FE 03            CP DIR_N | DIR_S
 86+  81F5 20 04            JR NZ, .noVertCancel
 87+  81F7 78               LD A, B
 88+  81F8 E6 FC            AND ~(DIR_N | DIR_S) & $FF
 89+  81FA 47               LD B, A
 90+  81FB              .noVertCancel:
 91+  81FB
 92+  81FB                  ; Si E y W a la vez, cancelar ambos
 93+  81FB 78               LD A, B
 94+  81FC E6 0C            AND DIR_E | DIR_W
 95+  81FE FE 0C            CP DIR_E | DIR_W
 96+  8200 20 04            JR NZ, .noHorizCancel
 97+  8202 78               LD A, B
 98+  8203 E6 F3            AND ~(DIR_E | DIR_W) & $FF
 99+  8205 47               LD B, A
100+  8206              .noHorizCancel:
101+  8206
102+  8206 78               LD A, B
103+  8207 32 44 80         LD (InputDirection), A
104+  820A C9               RET
105+  820B
106+  820B              ; ==============================================================================
107+  820B              ; UpdateLogic - Actualiza movimiento y animacion del jugador
108+  820B              ; ==============================================================================
109+  820B              UpdateLogic:
110+  820B CD 15 82         CALL UpdatePlayerState
111+  820E CD 4E 82         CALL UpdatePlayerMovement
112+  8211 CD 3C 83         CALL UpdatePlayerAnimation
113+  8214 C9               RET
114+  8215
115+  8215              ; ==============================================================================
116+  8215              ; UpdatePlayerState - Determina estado (idle/running/fighting) y direccion
117+  8215              ; ==============================================================================
118+  8215              UpdatePlayerState:
119+  8215 3A 44 80         LD A, (InputDirection)
120+  8218 47               LD B, A                     ; B = direccion del input
121+  8219 3A 45 80         LD A, (InputFire)
122+  821C 4F               LD C, A                     ; C = fuego
123+  821D
124+  821D                  ; Si no hay direccion ni fuego -> idle
125+  821D 78               LD A, B
126+  821E B1               OR C
127+  821F 20 0B            JR NZ, .notIdle
128+  8221
129+  8221                  ; --- Estado IDLE ---
130+  8221 3E 00            LD A, STATE_IDLE
131+  8223 32 3D 80         LD (PlayerState), A
132+  8226 3E 00            LD A, DIR_NONE
133+  8228 32 3B 80         LD (PlayerDir), A
134+  822B C9               RET
135+  822C
136+  822C              .notIdle:
137+  822C                  ; Guardar direccion del input como direccion de movimiento
138+  822C 78               LD A, B
139+  822D 32 3B 80         LD (PlayerDir), A
140+  8230
141+  8230                  ; Actualizar ultima direccion horizontal si hay componente E/W
142+  8230 E6 0C            AND DIR_E | DIR_W
143+  8232 28 03            JR Z, .noHorizUpdate
144+  8234 32 3C 80         LD (PlayerLastHDir), A
145+  8237              .noHorizUpdate:
146+  8237
147+  8237                  ; Determinar si esta peleando o corriendo
148+  8237 79               LD A, C
149+  8238 B7               OR A
150+  8239 28 09            JR Z, .stateRunning
151+  823B
152+  823B                  ; --- Estado FIGHTING ---
153+  823B                  ; Sabre Wulf: al pelear N/S, se retiene la ultima dir horizontal
154+  823B 3E 02            LD A, STATE_FIGHTING
155+  823D 32 3D 80         LD (PlayerState), A
156+  8240 32 3E 80         LD (PlayerFire), A          ; Marcar fuego activo
157+  8243 C9               RET
158+  8244
159+  8244              .stateRunning:
160+  8244 3E 01            LD A, STATE_RUNNING
161+  8246 32 3D 80         LD (PlayerState), A
162+  8249 AF               XOR A
163+  824A 32 3E 80         LD (PlayerFire), A          ; Fuego inactivo
164+  824D C9               RET
165+  824E
166+  824E              ; ==============================================================================
167+  824E              ; UpdatePlayerMovement - Aplica velocidad 16-bit a la posicion
168+  824E              ; ==============================================================================
169+  824E              ; Como en Sabre Wulf:
170+  824E              ; - Posiciones en 16 bits (Hi=pixel, Lo=subpixel)
171+  824E              ; - Velocidad se suma/resta segun direccion
172+  824E              ; - Velocidad distinta corriendo vs peleando
173+  824E              ; ==============================================================================
174+  824E              UpdatePlayerMovement:
175+  824E 3A 3B 80         LD A, (PlayerDir)
176+  8251 B7               OR A
177+  8252 C8               RET Z                       ; Sin movimiento si DIR_NONE
178+  8253
179+  8253                  ; Obtener velocidades segun estado
180+  8253 CD A5 82         CALL GetCurrentSpeed        ; DE = speedX, HL = speedY
181+  8256
182+  8256                  ; --- Movimiento Horizontal (con colision) ---
183+  8256 2A 37 80         LD HL, (PlayerXLo)          ; L=XLo, H=XHi (adyacentes en RAM)
184+  8259 22 A1 82         LD (SavedPosX), HL
185+  825C
186+  825C 3A 3B 80         LD A, (PlayerDir)
187+  825F CB 57            BIT 2, A                    ; Bit 2 = DIR_E
188+  8261 28 03            JR Z, .noEast
189+  8263 CD C6 82         CALL MoveEast
190+  8266              .noEast:
191+  8266 3A 3B 80         LD A, (PlayerDir)
192+  8269 CB 5F            BIT 3, A                    ; Bit 3 = DIR_W
193+  826B 28 03            JR Z, .noWest
194+  826D CD E5 82         CALL MoveWest
195+  8270              .noWest:
196+  8270 CD D6 83         CALL CheckPlayerCollision
197+  8273 28 06            JR Z, .xOk
198+  8275 2A A1 82         LD HL, (SavedPosX)          ; Colision: revertir X
199+  8278 22 37 80         LD (PlayerXLo), HL
200+  827B              .xOk:
201+  827B
202+  827B                  ; --- Movimiento Vertical (con colision) ---
203+  827B 2A 39 80         LD HL, (PlayerYLo)
204+  827E 22 A3 82         LD (SavedPosY), HL
205+  8281
206+  8281 3A 3B 80         LD A, (PlayerDir)
207+  8284 CB 47            BIT 0, A                    ; Bit 0 = DIR_N
208+  8286 28 03            JR Z, .noNorth
209+  8288 CD 1F 83         CALL MoveNorth
210+  828B              .noNorth:
211+  828B 3A 3B 80         LD A, (PlayerDir)
212+  828E CB 4F            BIT 1, A                    ; Bit 1 = DIR_S
213+  8290 28 03            JR Z, .noSouth
214+  8292 CD 02 83         CALL MoveSouth
215+  8295              .noSouth:
216+  8295 CD D6 83         CALL CheckPlayerCollision
217+  8298 28 06            JR Z, .yOk
218+  829A 2A A3 82         LD HL, (SavedPosY)          ; Colision: revertir Y
219+  829D 22 39 80         LD (PlayerYLo), HL
220+  82A0              .yOk:
221+  82A0 C9               RET
222+  82A1
223+  82A1              ; --- Variables temporales para colision ---
224+  82A1 00 00        SavedPosX:  DEFW 0
225+  82A3 00 00        SavedPosY:  DEFW 0
226+  82A5
227+  82A5              ; ==============================================================================
228+  82A5              ; GetCurrentSpeed - Devuelve velocidades segun estado
229+  82A5              ; Salida: DE = velocidad X, HL = velocidad Y (guardadas en SpeedCache)
230+  82A5              ; ==============================================================================
231+  82A5              GetCurrentSpeed:
232+  82A5 3A 3D 80         LD A, (PlayerState)
233+  82A8 FE 02            CP STATE_FIGHTING
234+  82AA 28 08            JR Z, .fightSpeed
235+  82AC
236+  82AC                  ; Velocidad de correr
237+  82AC 11 A0 02         LD DE, SPEED_RUN_X
238+  82AF 21 30 02         LD HL, SPEED_RUN_Y
239+  82B2 18 06            JR .storeSpeed
240+  82B4
241+  82B4              .fightSpeed:
242+  82B4 11 30 02         LD DE, SPEED_FIGHT_X
243+  82B7 21 C0 01         LD HL, SPEED_FIGHT_Y
244+  82BA
245+  82BA              .storeSpeed:
246+  82BA ED 53 C2 82      LD (SpeedCacheX), DE
247+  82BE 22 C4 82         LD (SpeedCacheY), HL
248+  82C1 C9               RET
249+  82C2
250+  82C2              ; --- Variables temporales de velocidad ---
251+  82C2 00 00        SpeedCacheX:    DEFW 0
252+  82C4 00 00        SpeedCacheY:    DEFW 0
253+  82C6
254+  82C6              ; ==============================================================================
255+  82C6              ; MoveEast - Sumar velocidad X a la posicion
256+  82C6              ; ==============================================================================
257+  82C6              MoveEast:
258+  82C6 ED 5B C2 82      LD DE, (SpeedCacheX)        ; DE = velocidad X (16-bit)
259+  82CA 3A 37 80         LD A, (PlayerXLo)
260+  82CD 83               ADD A, E
261+  82CE 32 37 80         LD (PlayerXLo), A
262+  82D1 3A 38 80         LD A, (PlayerXHi)
263+  82D4 8A               ADC A, D
264+  82D5                  ; Comprobar limite derecho
265+  82D5 FE F0            CP SCREEN_MAX_X
266+  82D7 38 08            JR C, .okEast
267+  82D9 3E F0            LD A, SCREEN_MAX_X          ; Clamp al limite
268+  82DB AF               XOR A
269+  82DC 32 37 80         LD (PlayerXLo), A           ; Limpiar subpixel al hacer clamp
270+  82DF 3E F0            LD A, SCREEN_MAX_X
271+  82E1              .okEast:
272+  82E1 32 38 80         LD (PlayerXHi), A
273+  82E4 C9               RET
274+  82E5
275+  82E5              ; ==============================================================================
276+  82E5              ; MoveWest - Restar velocidad X de la posicion
277+  82E5              ; ==============================================================================
278+  82E5              MoveWest:
279+  82E5 ED 5B C2 82      LD DE, (SpeedCacheX)
280+  82E9 3A 37 80         LD A, (PlayerXLo)
281+  82EC 93               SUB E
282+  82ED 32 37 80         LD (PlayerXLo), A
283+  82F0 3A 38 80         LD A, (PlayerXHi)
284+  82F3 9A               SBC A, D
285+  82F4                  ; Comprobar limite izquierdo
286+  82F4 30 08            JR NC, .okWest
287+  82F6 AF               XOR A                       ; Clamp a 0
288+  82F7 32 37 80         LD (PlayerXLo), A
289+  82FA 32 38 80         LD (PlayerXHi), A
290+  82FD C9               RET
291+  82FE              .okWest:
292+  82FE 32 38 80         LD (PlayerXHi), A
293+  8301 C9               RET
294+  8302
295+  8302              ; ==============================================================================
296+  8302              ; MoveSouth - Sumar velocidad Y a la posicion
297+  8302              ; ==============================================================================
298+  8302              MoveSouth:
299+  8302 ED 5B C4 82      LD DE, (SpeedCacheY)
300+  8306 3A 39 80         LD A, (PlayerYLo)
301+  8309 83               ADD A, E
302+  830A 32 39 80         LD (PlayerYLo), A
303+  830D 3A 3A 80         LD A, (PlayerYHi)
304+  8310 8A               ADC A, D
305+  8311 FE A0            CP SCREEN_MAX_Y
306+  8313 38 06            JR C, .okSouth
307+  8315 AF               XOR A
308+  8316 32 39 80         LD (PlayerYLo), A
309+  8319 3E A0            LD A, SCREEN_MAX_Y
310+  831B              .okSouth:
311+  831B 32 3A 80         LD (PlayerYHi), A
312+  831E C9               RET
313+  831F
314+  831F              ; ==============================================================================
315+  831F              ; MoveNorth - Restar velocidad Y de la posicion
316+  831F              ; ==============================================================================
317+  831F              MoveNorth:
318+  831F ED 5B C4 82      LD DE, (SpeedCacheY)
319+  8323 3A 39 80         LD A, (PlayerYLo)
320+  8326 93               SUB E
321+  8327 32 39 80         LD (PlayerYLo), A
322+  832A 3A 3A 80         LD A, (PlayerYHi)
323+  832D 9A               SBC A, D
324+  832E 30 08            JR NC, .okNorth
325+  8330 AF               XOR A
326+  8331 32 39 80         LD (PlayerYLo), A
327+  8334 32 3A 80         LD (PlayerYHi), A
328+  8337 C9               RET
329+  8338              .okNorth:
330+  8338 32 3A 80         LD (PlayerYHi), A
331+  833B C9               RET
332+  833C
333+  833C              ; ==============================================================================
334+  833C              ; UpdatePlayerAnimation - Selecciona animacion segun estado/direccion
335+  833C              ; ==============================================================================
336+  833C              ; Estilo Sabre Wulf: tabla de acciones indexada por estado+direccion.
337+  833C              ; Cada entrada define: puntero base en SpriteFrameTable, num frames, delay.
338+  833C              ; Al cambiar de animacion se reinicia el frame.
339+  833C              ; ==============================================================================
340+  833C              UpdatePlayerAnimation:
341+  833C                  ; Determinar animacion segun estado y direccion
342+  833C 3A 3D 80         LD A, (PlayerState)
343+  833F FE 02            CP STATE_FIGHTING
344+  8341 28 0D            JR Z, .animFight
345+  8343 FE 01            CP STATE_RUNNING
346+  8345 28 1E            JR Z, .animRun
347+  8347
348+  8347                  ; --- IDLE ---
349+  8347 21 00 00         LD HL, ANIM_IDX_IDLE
350+  834A 06 02            LD B, 2                     ; 2 frames idle
351+  834C 0E 08            LD C, ANIM_DELAY_IDLE
352+  834E 18 3A            JR .applyAnim
353+  8350
354+  8350              .animFight:
355+  8350                  ; Pelear usa la ultima dir horizontal retenida (como Sabre Wulf)
356+  8350 3A 3C 80         LD A, (PlayerLastHDir)
357+  8353 FE 08            CP DIR_W
358+  8355 28 05            JR Z, .fightW
359+  8357 21 1C 00         LD HL, ANIM_IDX_FIGHT_E
360+  835A 18 03            JR .fightSet
361+  835C              .fightW:
362+  835C 21 20 00         LD HL, ANIM_IDX_FIGHT_W
363+  835F              .fightSet:
364+  835F 06 02            LD B, 2                     ; 2 frames fight
365+  8361 0E 04            LD C, ANIM_DELAY_RUN
366+  8363 18 25            JR .applyAnim
367+  8365
368+  8365              .animRun:
369+  8365 3A 3B 80         LD A, (PlayerDir)
370+  8368                  ; Prioridad: si hay componente E/W, usar esa animacion
371+  8368 CB 57            BIT 2, A                    ; DIR_E?
372+  836A 20 0D            JR NZ, .runE
373+  836C CB 5F            BIT 3, A                    ; DIR_W?
374+  836E 20 0E            JR NZ, .runW
375+  8370 CB 47            BIT 0, A                    ; DIR_N?
376+  8372 20 0F            JR NZ, .runN
377+  8374                  ; DIR_S o fallback
378+  8374 21 16 00         LD HL, ANIM_IDX_WALK_S
379+  8377 18 0D            JR .runSet
380+  8379              .runE:
381+  8379 21 04 00         LD HL, ANIM_IDX_WALK_E
382+  837C 18 08            JR .runSet
383+  837E              .runW:
384+  837E 21 0A 00         LD HL, ANIM_IDX_WALK_W
385+  8381 18 03            JR .runSet
386+  8383              .runN:
387+  8383 21 10 00         LD HL, ANIM_IDX_WALK_N
388+  8386              .runSet:
389+  8386 06 03            LD B, 3                     ; 3 frames walk
390+  8388 0E 04            LD C, ANIM_DELAY_RUN
391+  838A
392+  838A              .applyAnim:
393+  838A                  ; HL = offset en SpriteFrameTable, B = num frames, C = delay
394+  838A                  ; Comprobar si cambio la animacion
395+  838A 3A 42 80         LD A, (PlayerAnimBase)
396+  838D BD               CP L
397+  838E 20 06            JR NZ, .newAnim
398+  8390 3A 43 80         LD A, (PlayerAnimBase+1)
399+  8393 BC               CP H
400+  8394 28 10            JR Z, .sameAnim
401+  8396
402+  8396              .newAnim:
403+  8396                  ; Animacion nueva -> reiniciar
404+  8396 22 42 80         LD (PlayerAnimBase), HL
405+  8399 78               LD A, B
406+  839A 32 41 80         LD (PlayerAnimNumFrames), A
407+  839D AF               XOR A
408+  839E 32 3F 80         LD (PlayerAnimFrame), A
409+  83A1 79               LD A, C
410+  83A2 32 40 80         LD (PlayerAnimDelay), A
411+  83A5 C9               RET
412+  83A6
413+  83A6              .sameAnim:
414+  83A6                  ; Decrementar delay
415+  83A6 3A 40 80         LD A, (PlayerAnimDelay)
416+  83A9 3D               DEC A
417+  83AA 20 10            JR NZ, .noAdvance
418+  83AC
419+  83AC                  ; Avanzar frame
420+  83AC 79               LD A, C
421+  83AD 32 40 80         LD (PlayerAnimDelay), A
422+  83B0 3A 3F 80         LD A, (PlayerAnimFrame)
423+  83B3 3C               INC A
424+  83B4 B8               CP B
425+  83B5 38 01            JR C, .frameOk
426+  83B7 AF               XOR A
427+  83B8              .frameOk:
428+  83B8 32 3F 80         LD (PlayerAnimFrame), A
429+  83BB C9               RET
430+  83BC
431+  83BC              .noAdvance:
432+  83BC 32 40 80         LD (PlayerAnimDelay), A
433+  83BF C9               RET
434+  83C0
435+  83C0              ; ==============================================================================
436+  83C0              ; GetCurrentSpriteAddr - Devuelve puntero al sprite actual
437+  83C0              ; ==============================================================================
438+  83C0              ; Salida: IX = puntero a los datos bitmap del sprite
439+  83C0              ; ==============================================================================
440+  83C0              GetCurrentSpriteAddr:
441+  83C0 2A 42 80         LD HL, (PlayerAnimBase)     ; HL = offset en la tabla
442+  83C3 3A 3F 80         LD A, (PlayerAnimFrame)
443+  83C6 87               ADD A, A                    ; * 2 (cada entrada es DEFW)
444+  83C7 5F               LD E, A
445+  83C8 16 00            LD D, 0
446+  83CA 19               ADD HL, DE                  ; HL = offset del frame actual
447+  83CB 11 8B 8B         LD DE, SpriteFrameTable
448+  83CE 19               ADD HL, DE                  ; HL = direccion en SpriteFrameTable
449+  83CF 5E               LD E, (HL)
450+  83D0 23               INC HL
451+  83D1 56               LD D, (HL)                  ; DE = puntero al sprite
452+  83D2 D5               PUSH DE
453+  83D3 DD E1            POP IX                      ; IX = puntero al sprite
454+  83D5 C9               RET
455+  83D6
456+  83D6              ; ==============================================================================
457+  83D6              ; CheckPlayerCollision - Comprueba si el jugador colisiona con tiles solidos
458+  83D6              ; ==============================================================================
459+  83D6              ; Comprueba las 4 esquinas del bounding box del sprite (con 2px de margen
460+  83D6              ; interior) contra la tabla de solidez de tiles.
461+  83D6              ; Comprobar X e Y por separado permite deslizarse por paredes.
462+  83D6              ;
463+  83D6              ; Salida: Z = sin colision, NZ = colision
464+  83D6              ; ==============================================================================
465+  83D6              CheckPlayerCollision:
466+  83D6                  ; Esquina sup-izq (X+2, Y+2)
467+  83D6 3A 38 80         LD A, (PlayerXHi)
468+  83D9 C6 02            ADD A, 2
469+  83DB 47               LD B, A
470+  83DC 3A 3A 80         LD A, (PlayerYHi)
471+  83DF C6 02            ADD A, 2
472+  83E1 4F               LD C, A
473+  83E2 CD BB 85         CALL IsPointBlocked
474+  83E5 C0               RET NZ
475+  83E6
476+  83E6                  ; Esquina sup-der (X+13, Y+2)
477+  83E6 3A 38 80         LD A, (PlayerXHi)
478+  83E9 C6 0D            ADD A, 13
479+  83EB 47               LD B, A
480+  83EC 3A 3A 80         LD A, (PlayerYHi)
481+  83EF C6 02            ADD A, 2
482+  83F1 4F               LD C, A
483+  83F2 CD BB 85         CALL IsPointBlocked
484+  83F5 C0               RET NZ
485+  83F6
486+  83F6                  ; Esquina inf-izq (X+2, Y+13)
487+  83F6 3A 38 80         LD A, (PlayerXHi)
488+  83F9 C6 02            ADD A, 2
489+  83FB 47               LD B, A
490+  83FC 3A 3A 80         LD A, (PlayerYHi)
491+  83FF C6 0D            ADD A, 13
492+  8401 4F               LD C, A
493+  8402 CD BB 85         CALL IsPointBlocked
494+  8405 C0               RET NZ
495+  8406
496+  8406                  ; Esquina inf-der (X+13, Y+13)
497+  8406 3A 38 80         LD A, (PlayerXHi)
498+  8409 C6 0D            ADD A, 13
499+  840B 47               LD B, A
500+  840C 3A 3A 80         LD A, (PlayerYHi)
501+  840F C6 0D            ADD A, 13
502+  8411 4F               LD C, A
503+  8412 CD BB 85         CALL IsPointBlocked
504+  8415 C9               RET                         ; Z/NZ del ultimo check
