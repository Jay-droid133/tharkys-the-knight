{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar y Jugar",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/code"
            },
            "command": "cmd",
            "args": [
                "/c",
                "build_and_spectaculator.bat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Abrir Editores",
            "type": "process",
            "command": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
            "args": [
                "${workspaceFolder}\\tools\\level_editor.html",
                "${workspaceFolder}\\tools\\BG_editor.html"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
